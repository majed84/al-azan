ld have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\",\"Your sounds\":\"Your sounds\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"All copyrights for adhan voices belong to their respective owners.\\nSpecial thanks to translation.io (lingui.js) for their wonderful services.\\nThanks to all open source community members who made all these wonderful libraries that made making this app possible.\",\"about.credits.google\":\"Most of icons used in this app are from google material icons.\",\"about_settings\":\"About\",\"adjustment.hint\":\"Number of minutes that will be added to the calculated times\",\"after\":\"after\",\"ago\":\"ago\",\"asr.prayer\":\"Asr\",\"backup_settings\":\"Backup\",\"before\":\"before\",\"calculation_adjustments_settings\":\"Adjustments\",\"calculation_advanced_settings\":\"Advanced Calculation Settings\",\"calculation_settings\":\"Calculation\",\"counter.fast\":\"Fast\",\"date.day\":\"day\",\"date.hour\":\"hour\",\"date.minute\":\"minute\",\"date.second\":\"second\",\"dev_settings\":\"Developer\",\"dhuhr.prayer\":\"Dhuhr\",\"display_settings\":\"Display\",\"fajr.prayer\":\"Fajr\",\"favorite_location\":\"Favorite Locations\",\"forces all numbers to be in the selected system\":\"forces all numbers to be in the selected system\",\"from North\":\"from North\",\"from settings\":\"from settings\",\"fullscreen_alarm\":\"Playing Adhan\",\"hijri.adjustment.hint\":\"Number of days that will be added to the lunar calendar\",\"home\":\"Home\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\",\"intro\":\"intro\",\"is prayer time hidden?\":\"is prayer time hidden?\",\"isha.prayer\":\"Isha\",\"later\":\"later\",\"location_settings\":\"Location\",\"maghrib.prayer\":\"Maghrib\",\"masjid_an_nabawi\":\"Masjid An Nabawi\",\"minutes\":\"minutes\",\"moazen_zade\":\"Moazen Zade\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"Monthly View\",\"muezzin_settings\":\"Muezzin\",\"notification_advanced_settings\":\"Advanced Settings\",\"notification_settings\":\"Notification & Sound\",\"qada_counter\":\"Qada Counter\",\"qibla_compass\":\"Qibla Compass\",\"qibla_finder\":\"Qibla Finder\",\"qibla_map\":\"Qibla Map\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"Reminders\",\"settings\":\"Settings\",\"should notification widget be shown?\":\"should notification widget be shown?\",\"should {prayerName} be hidden?\":[\"should \",[\"prayerName\"],\" be hidden?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\",\"sunnah.midnight\":\"Midnight\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"Sunrise\",\"sunset\":\"Sunset\",\"widget_settings\":\"Widget Settings\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" min after \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" min before \",[\"prayer\"]],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" notification will be shown\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" sound will be played\"]}")}),626,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 \u062f\u0642\u06cc\u0642\u0647\",\"15 min\":\"15 \u062f\u0642\u06cc\u0642\u0647\",\"30 min\":\"30 \u062f\u0642\u06cc\u0642\u0647\",\"30 minutes is added to Isha time during Ramadan in this method\":\"\u062f\u0631 \u0627\u06cc\u0646 \u0631\u0648\u0634 30 \u062f\u0642\u06cc\u0642\u0647 \u0628\u0647 \u0632\u0645\u0627\u0646 \u0639\u0634\u0627 \u062f\u0631 \u0645\u0627\u0647 \u0631\u0645\u0636\u0627\u0646 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc \u0634\u0648\u062f\",\"5 min\":\"5 \u062f\u0642\u06cc\u0642\u0647\",\"60 min\":\"60 \u062f\u0642\u06cc\u0642\u0647\",\"90 min\":\"90 \u062f\u0642\u06cc\u0642\u0647\",\"ADHAN_CHANNEL_NAME\":\"\u0627\u0630\u0627\u0646\",\"Abyad\":\"\u0633\u0641\u06cc\u062f\",\"Accuracy\":\"\u062f\u0642\u062a\",\"Ad-Free\":\"\u0639\u0627\u0631\u06cc \u0627\u0632 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\",\"Adaptive Charging\":\"\u0634\u0627\u0631\u0698 \u062a\u0637\u0628\u06cc\u0642\u06cc\",\"Add\":\"\u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0646\",\"Add Custom Adhan\":\"\u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0646 \u0627\u0630\u0627\u0646 \u062f\u0644\u062e\u0648\u0627\u0647\",\"Add Custom Audio\":\"\u0627\u0641\u0632\u0648\u062f\u0646 \u0635\u062f\u0627\u06cc \u062f\u0644\u062e\u0648\u0627\u0647\",\"Add Reminder\":\" \u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0646 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\",\"Add Silent Mode\":\"\u0627\u0641\u0632\u0648\u062f\u0646 \u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627\",\"Add new counter\":\"\u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0646 \u0634\u0645\u0627\u0631\u0646\u062f\u0647 \u062c\u062f\u06cc\u062f\",\"Add new location\":\"\u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0646 \u0645\u06a9\u0627\u0646 \u062c\u062f\u06cc\u062f\",\"Adhan\":\"\u0627\u0630\u0627\u0646\",\"Adhan audio file is not downloaded yet\":\"\u0641\u0627\u06cc\u0644 \u0635\u0648\u062a\u06cc \u0627\u0630\u0627\u0646 \u0647\u0646\u0648\u0632 \u062f\u0627\u0646\u0644\u0648\u062f \u0646\u0634\u062f\u0647 \u0627\u0633\u062a\",\"Adjustments\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0632\u0645\u0627\u0646\",\"Advanced\":\"\u067e\u06cc\u0634\u0631\u0641\u062a\u0647\",\"Advanced Calculation Settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0645\u062d\u0627\u0633\u0628\u0647\",\"Advanced Settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u067e\u06cc\u0634\u0631\u0641\u062a\u0647\",\"Ahmer\":\"\u0642\u0631\u0645\u0632\",\"Al-Azan\":\"\u0627\u0644\u0623\u0630\u0627\u0646\",\"Al-Azan - Prayer Times\":\"\u0627\u0644\u0623\u0630\u0627\u0646 - \u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"\u0627\u0644\u0627\u0630\u0627\u0646 \u0628\u0647 \u0627\u06cc\u0646 \u0627\u0645\u06cc\u062f \u06a9\u0647 \u0645\u0641\u06cc\u062f \u0628\u0627\u0634\u062f\u060c \u0627\u0645\u0627 \u0628\u062f\u0648\u0646 \u0636\u0645\u0627\u0646\u062a \u062a\u0648\u0632\u06cc\u0639 \u0645\u06cc \u0634\u0648\u062f. \u062d\u062a\u06cc \u0628\u062f\u0648\u0646 \u0636\u0645\u0627\u0646\u062a \u0636\u0645\u0646\u06cc \u062a\u062c\u0627\u0631\u062a \u06cc\u0627 \u062a\u0646\u0627\u0633\u0628 \u0628\u0631\u0627\u06cc \u06cc\u06a9 \u0647\u062f\u0641 \u062e\u0627\u0635. \u0628\u0631\u0627\u06cc \u062c\u0632\u0626\u06cc\u0627\u062a \u0628\u06cc\u0634\u062a\u0631 \u0628\u0647 \u0645\u062c\u0648\u0632 \u0639\u0645\u0648\u0645\u06cc GNU Affero \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"\u0627\u0644\u0623\u0630\u0627\u0646 \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0627\u0633\u062a: \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u0646 \u0631\u0627 \u0645\u062c\u062f\u062f\u0627\u064b \u062a\u0648\u0632\u06cc\u0639 \u06a9\u0646\u06cc\u062f \u0648/\u06cc\u0627 \u062a\u062d\u062a \u0634\u0631\u0627\u06cc\u0637 \u0645\u062c\u0648\u0632 \u0639\u0645\u0648\u0645\u06cc GNU Affero (v3.0) \u06a9\u0647 \u062a\u0648\u0633\u0637 \u0628\u0646\u06cc\u0627\u062f \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631 \u0622\u0632\u0627\u062f \u0645\u0646\u062a\u0634\u0631 \u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u0622\u0646 \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f.\",\"Alarms Permission\":\"\u0645\u062c\u0648\u0632 \u0647\u0634\u062f\u0627\u0631\u0647\u0627\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"\u062a\u0645\u0627\u0645 \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647 \u0628\u0647 \u0627\u0644\u0623\u0630\u0627\u0646 \u0641\u0642\u0637 \u0628\u0647 \u0635\u0648\u0631\u062a \u0645\u062d\u0644\u06cc \u062f\u0631 \u062f\u0633\u062a\u06af\u0627\u0647 \u0634\u0645\u0627 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc \u0634\u0648\u062f. \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u062f\u0631 \u062c\u0627\u06cc\u06cc \u0622\u067e\u0644\u0648\u062f \u0646\u0645\u06cc \u0634\u0648\u062f. \u062a\u0648\u0633\u0639\u0647 \u062f\u0647\u0646\u062f\u06af\u0627\u0646 \u0627\u0644\u0623\u0630\u0627\u0646 \u0628\u0647 \u0622\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc \u0646\u062f\u0627\u0631\u0646\u062f. \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0634\u0645\u0627 \u0628\u0627 \u0647\u06cc\u0686 \u0634\u062e\u0635 \u062b\u0627\u0644\u062b\u06cc \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06af\u0630\u0627\u0634\u062a\u0647 \u0646\u0645\u06cc \u0634\u0648\u062f. \u0627\u0644\u0623\u0630\u0627\u0646 \u0647\u06cc\u0686 \u06af\u0648\u0646\u0647 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u06cc \u06cc\u0627 \u06a9\u062f \u0631\u062f\u06cc\u0627\u0628\u06cc (\u062a\u062c\u0632\u06cc\u0647 \u0648 \u062a\u062d\u0644\u06cc\u0644) \u0634\u062e\u0635 \u062b\u0627\u0644\u062b \u0645\u0627\u0646\u0646\u062f Google Analytics \u06cc\u0627 Facebook SDK \u0631\u0627 \u0634\u0627\u0645\u0644 \u0646\u0645\u06cc \u0634\u0648\u062f.\",\"An error occured while playing the current track\":\"\u0647\u0646\u06af\u0627\u0645 \u067e\u062e\u0634 \u0635\u0648\u062a \u0641\u0639\u0644\u06cc \u062e\u0637\u0627\u06cc\u06cc \u0631\u0648\u06cc \u062f\u0627\u062f\",\"App features\":\"\u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u0647\",\"Arabic\":\"\u0639\u0631\u0628\u06cc\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\u0622\u06cc\u0627 \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f \u06a9\u0647 \u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \\\"\",[\"0\"],\"\\\" \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f\u061f\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\u0622\u06cc\u0627 \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f \u06a9\u0647 \u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \\\"\",[\"itemName\"],\"\\\" \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f\u061f\"],\"Are you sure you want to delete this?\":\"\u0622\u06cc\u0627 \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f \u06a9\u0647 \u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \u0627\u06cc\u0646 \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f\u061f\",\"Asr Calculation\":\"\u0645\u062d\u0627\u0633\u0628\u0647 \u0639\u0635\u0631\",\"At least one prayer time must be shown\":\"\u062d\u062f\u0627\u0642\u0644 \u06cc\u06a9 \u0648\u0642\u062a \u0634\u0631\u0639\u06cc \u0628\u0627\u06cc\u062f \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\",\"Attention\":\"\u062a\u0648\u062c\u0647\",\"Auto (Default)\":\"\u062e\u0648\u062f\u06a9\u0627\u0631 (\u067e\u06cc\u0634\u200c\u0641\u0631\u0636)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"\xab\u0645\u0632\u0627\u062d\u0645 \u0646\u0634\u0648\u06cc\u062f\xbb \u0631\u0627 \u062f\u0648\u0631 \u0628\u0632\u0646\u062f\u061f\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"\u0645\u062d\u0627\u0633\u0628\u0647 \u0627\u0630\u0627\u0646 \u0631\u0648\u0634 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\u06cc \u062f\u0627\u0631\u062f. \u0647\u0631 \u0631\u0648\u0634 \u0646\u062a\u0627\u06cc\u062c \u0645\u062a\u0641\u0627\u0648\u062a\u06cc \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc \u062f\u0647\u062f. \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u062c\u0633\u062a\u062c\u0648 \u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0631\u0648\u0634 \u0635\u062d\u06cc\u062d \u0628\u0627 \u0634\u0645\u0627\u0633\u062a.\",\"Calculation\":\"\u0645\u062d\u0627\u0633\u0628\u0647\",\"Calculation Method\":\"\u0646\u062d\u0648\u0647 \u0645\u062d\u0627\u0633\u0628\u0647\",\"Calendar\":\"\u062a\u0642\u0648\u06cc\u0645\",\"Cancel\":\"\u0644\u063a\u0648\",\"Cancel Alarm\":\"\u0644\u063a\u0648 \u0632\u0646\u06af \u0647\u0634\u062f\u0627\u0631\",\"Cancel download\":\"\u0644\u063a\u0648 \u062f\u0627\u0646\u0644\u0648\u062f\",\"Choose Asr Calculation Madhab\":\"\u0645\u0630\u0647\u0628 \u0645\u062d\u0627\u0633\u0628\u0647 \u0639\u0635\u0631 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose Calculation Method\":\"\u0631\u0648\u0634 \u0645\u062d\u0627\u0633\u0628\u0647 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose High Latitude Setting\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0639\u0631\u0636 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0628\u0627\u0644\u0627 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose Language\":\"\u0627\u0646\u062a\u062e\u0627\u0628 \u0632\u0628\u0627\u0646\",\"Choose Polar Resolution\":\"\u0646\u062d\u0648\u0647 \u0645\u062d\u0627\u0633\u0628\u0647 \u0645\u0646\u0627\u0637\u0642 \u0642\u0637\u0628\u06cc \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose Shafaq method\":\"\u0631\u0648\u0634 \\\"\u0634\u0641\u0642\\\" \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose calculation rounding method\":\"\u0631\u0648\u0634 \u06af\u0631\u062f \u06a9\u0631\u062f\u0646 \u0627\u0639\u062f\u0627\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose calendar type\":\"\u0646\u0648\u0639 \u062a\u0642\u0648\u06cc\u0645 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose lunar calendar language\":\"\u0632\u0628\u0627\u0646 \u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose midnight calculation method\":\"\u0631\u0648\u0634 \u0645\u062d\u0627\u0633\u0628\u0647 \u0646\u06cc\u0645\u0647 \u0634\u0628 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose numbering system\":\"\u0633\u06cc\u0633\u062a\u0645 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Choose which calendar to replace\":\"\u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f \u06a9\u062f\u0627\u0645 \u062a\u0642\u0648\u06cc\u0645 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0634\u0648\u062f\",\"City/Area\":\"\u0634\u0647\u0631/\u0646\u0627\u062d\u06cc\u0647\",\"Clear the coordinates\":\"\u0645\u062e\u062a\u0635\u0627\u062a \u0631\u0627 \u067e\u0627\u06a9 \u06a9\u0646\u06cc\u062f\",\"Clear the location\":\"\u0645\u06a9\u0627\u0646 \u0631\u0627 \u067e\u0627\u06a9 \u06a9\u0646\u06cc\u062f\",\"Clipboard data does not contain coordinates\":\"\u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u06a9\u0644\u06cc\u067e \u0628\u0648\u0631\u062f \u062d\u0627\u0648\u06cc \u0645\u062e\u062a\u0635\u0627\u062a \u0646\u06cc\u0633\u062a\u0646\u062f\",\"Close\":\"\u0628\u0633\u062a\u0646\",\"Closest City\":\"\u0646\u0632\u062f\u06cc\u06a9 \u062a\u0631\u06cc\u0646 \u0634\u0647\u0631\",\"Closest Date\":\"\u0646\u0632\u062f\u06cc\u06a9 \u062a\u0631\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e\",\"Compass Lock\":\"\u0642\u0641\u0644 \u0642\u0637\u0628 \u0646\u0645\u0627\",\"Compass sensor unavailable\":\"\u0633\u0646\u0633\u0648\u0631 \u0642\u0637\u0628 \u0646\u0645\u0627 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a\",\"Confirm\":\"\u062a\u0627\u06cc\u06cc\u062f\",\"Continuous\":\"\u0645\u062f\u0627\u0648\u0645\",\"Coordinates updated\":\"\u0645\u062e\u062a\u0635\u0627\u062a \u0628\u0647 \u0631\u0648\u0632 \u0634\u062f\",\"Copy\":\"\u06a9\u067e\u06cc\",\"Count\":\"\u062a\u0639\u062f\u0627\u062f\",\"Country\":\"\u06a9\u0634\u0648\u0631\",\"Custom\":\"\u062f\u0644\u062e\u0648\u0627\u0647\",\"Custom sounds and muezzins will not be exported\":\"\u0635\u062f\u0627\u0647\u0627\u06cc \u062f\u0644\u062e\u0648\u0627\u0647 \u0648 \u0645\u0648\u0630\u0646 \u0647\u0627 \u062e\u0631\u0648\u062c\u06cc \u06af\u0631\u0641\u062a\u0647 \u0646\u0645\u06cc \u0634\u0648\u062f\",\"Custom upcoming alarm time\":\"\u0632\u0645\u0627\u0646 \u062f\u0644\u062e\u0648\u0627\u0647 \u0647\u0634\u062f\u0627\u0631 \u0628\u0639\u062f\u06cc\",\"Dark\":\"\u062a\u0627\u0631\u06cc\u06a9\",\"Date\":\"\u062a\u0627\u0631\u06cc\u062e\",\"Decrement\":\"\u06a9\u0627\u0647\u0634\",\"Default\":\"\u067e\u06cc\u0634 \u0641\u0631\u0636\",\"Delete\":\"\u062d\u0630\u0641\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"\u0628\u0633\u062a\u0647 \u0628\u0647 \u062f\u0633\u062a\u06af\u0627\u0647 \u0648 \u0646\u0633\u062e\u0647 \u0627\u0646\u062f\u0631\u0648\u06cc\u062f \u0634\u0645\u0627\u060c \u06af\u0627\u0647\u06cc \u0627\u0648\u0642\u0627\u062a \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062f\u0633\u062a\u06af\u0627\u0647 \u0634\u0645\u0627 \u0628\u0631\u0627\u06cc \u0635\u0631\u0641\u0647 \u062c\u0648\u06cc\u06cc \u062f\u0631 \u0628\u0627\u062a\u0631\u06cc\u060c \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0628\u0628\u0646\u062f\u062f. \u0627\u06cc\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u062f \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u0647\u0634\u062f\u0627\u0631\u0647\u0627/\u0627\u0639\u0644\u0627\u0646 \u0647\u0627 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u062f.\",\"Deselect as Fajr Adhan\":\"\u0644\u063a\u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u0630\u0627\u0646 \u0641\u062c\u0631\",\"Device sounds\":\"\u0635\u062f\u0627\u0647\u0627\u06cc \u062f\u0633\u062a\u06af\u0627\u0647\",\"Disabled\":\"\u063a\u06cc\u0631\u0641\u0639\u0627\u0644\",\"Disclaimer\":\"\u0633\u0644\u0628 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\",\"Dismiss\":\"\u0631\u062f \u06a9\u0631\u062f\u0646\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"\u0631\u0648\u0634 \u062f\u06cc\u0627\u0646\u062a \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647 \u062f\u0631 \u0627\u0644\u0627\u0630\u0627\u0646 \u062a\u0642\u0631\u06cc\u0628\u06cc \u0627\u0632 \u0627\u0648\u0642\u0627\u062a \u0631\u0633\u0645\u06cc \u0627\u0633\u062a. \u0627\u0632 \u0622\u0646\u062c\u0627\u06cc\u06cc \u06a9\u0647 \u0627\u0633\u0646\u0627\u062f \u06a9\u0627\u0641\u06cc \u062f\u0631 \u0645\u0648\u0631\u062f \u0646\u062d\u0648\u0647 \u0645\u062d\u0627\u0633\u0628\u0647 \u062f\u0642\u06cc\u0642 \u0632\u0645\u0627\u0646 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f\u060c \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0632\u0645\u0627\u0646 \u0647\u0627 \u0628\u0627 \u0648\u0628 \u0633\u0627\u06cc\u062a \u0631\u0633\u0645\u06cc \u062f\u06cc\u0627\u0646\u062a\u060c \u0628\u0647 \u0648\u06cc\u0698\u0647 \u062e\u0627\u0631\u062c \u0627\u0632 \u062a\u0631\u06a9\u06cc\u0647\u060c \u0645\u0637\u0627\u0628\u0642\u062a \u0646\u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u0646\u062f.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"\u0631\u06cc\u0627\u0633\u062a \u0627\u0645\u0648\u0631 \u0645\u0630\u0647\u0628\u06cc\u060c \u062a\u0631\u06a9\u06cc\u0647\",\"Doesn't use any kind of trackers\":\"\u0627\u0632 \u0647\u06cc\u0686 \u0646\u0648\u0639 \u0631\u062f\u06cc\u0627\u0628\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u06cc \u06a9\u0646\u062f\",\"Don't ask again\":\"\u062f\u06cc\u06af\u0647 \u0646\u067e\u0631\u0633\",\"Don't show again\":\"\u062f\u06cc\u06af\u0631 \u0646\u0634\u0627\u0646 \u0646\u062f\u0647\",\"Don't show alarm screen?\":\"\u0635\u0641\u062d\u0647 \u0632\u0646\u06af \u0647\u0634\u062f\u0627\u0631 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0646\u0634\u0648\u062f\u061f\",\"Done\":\"\u0627\u062a\u0645\u0627\u0645\",\"Download\":\"\u062f\u0627\u0646\u0644\u0648\u062f\",\"Eastern Arabic\":\"\u0639\u0631\u0628\u06cc \u0634\u0631\u0642\u06cc\",\"Edit\":\"\u0648\u06cc\u0631\u0627\u06cc\u0634\",\"Edit Calculation Parameters\":\"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u067e\u0627\u0631\u0627\u0645\u062a\u0631\u0647\u0627\u06cc \u0645\u062d\u0627\u0633\u0628\u0647\",\"Edit Counter\":\"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0634\u0645\u0627\u0631\u0646\u062f\u0647\",\"Edit Location\":\"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0645\u06a9\u0627\u0646\",\"Edit Reminder\":\"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\",\"Edit Silent Mode\":\"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627\",\"Egyptian General Survey Authority\":\"\u0627\u062f\u0627\u0631\u0647 \u06a9\u0644 \u0628\u0631\u0631\u0633\u06cc \u0645\u0635\u0631\",\"Enabled\":\"\u0641\u0639\u0627\u0644\",\"End after prayer (minutes)\":\"\u067e\u0627\u06cc\u0627\u0646 \u0628\u0639\u062f \u0627\u0632 \u0646\u0645\u0627\u0632 (\u062f\u0642\u06cc\u0642\u0647)\",\"Error getting clipboard data\":\"\u062e\u0637\u0627 \u062f\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u06a9\u0644\u06cc\u067e \u0628\u0648\u0631\u062f\",\"Error in loading countries\":\"\u062e\u0637\u0627 \u062f\u0631 \u0628\u0627\u0631\u06af\u06cc\u0631\u06cc \u06a9\u0634\u0648\u0631\u0647\u0627\",\"Error while downloading audio\":\"\u062e\u0637\u0627 \u0647\u0646\u06af\u0627\u0645 \u062f\u0627\u0646\u0644\u0648\u062f \u0635\u0648\u062a\",\"Error while getting coordinates\":\"\u062e\u0637\u0627 \u0647\u0646\u06af\u0627\u0645 \u06af\u0631\u0641\u062a\u0646 \u0645\u062e\u062a\u0635\u0627\u062a\",\"Error: failed to open file\":\"\u062e\u0637\u0627: \u0641\u0627\u06cc\u0644 \u0628\u0627\u0632 \u0646\u0634\u062f\",\"Ethiopic\":\"\u0627\u062a\u06cc\u0648\u067e\u06cc\u0627\u06cc\u06cc\",\"Export app data\":\"\u062e\u0631\u0648\u062c\u06cc \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u0647\",\"Export data\":\"\u062e\u0631\u0648\u062c\u06cc \u062f\u0627\u062f\u0647 \u0647\u0627\",\"Fajr Angle\":\"\u0632\u0627\u0648\u06cc\u0647 \u0641\u062c\u0631\",\"Find My Location\":\"\u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0645\u06a9\u0627\u0646 \u0645\u0646\",\"Fix Common Problems\":\"\u0631\u0641\u0639 \u0645\u0634\u06a9\u0644\u0627\u062a \u0631\u0627\u06cc\u062c\",\"France angle 15\":\"\u0641\u0631\u0627\u0646\u0633\u0647 \u0632\u0627\u0648\u06cc\u0647 15\",\"France angle 18\":\"\u0641\u0631\u0627\u0646\u0633\u0647 \u0632\u0627\u0648\u06cc\u0647 18\",\"Friday\":\"\u062c\u0645\u0639\u0647\",\"General (default)\":\"\u0639\u0645\u0648\u0645\u06cc (\u067e\u06cc\u0634 \u0641\u0631\u0636)\",\"Getting coordinates\":\"\u062f\u0631\u062d\u0627\u0644 \u06af\u0631\u0641\u062a\u0646 \u0645\u062e\u062a\u0635\u0627\u062a\",\"Got it\":\"\u0641\u0647\u0645\u06cc\u062f\u0645\",\"Gregorian\":\"\u0645\u06cc\u0644\u0627\u062f\u06cc\",\"Gulf region\":\"\u0645\u0646\u0637\u0642\u0647 \u062e\u0644\u06cc\u062c\",\"Hanafi\":\"\u062d\u0646\u0641\u06cc\",\"Hidden?\":\"\u067e\u0646\u0647\u0627\u0646\u061f\",\"Hide Prayer Times\":\"\u0645\u062e\u0641\u06cc \u06a9\u0631\u062f\u0646 \u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc\",\"Hide times you don't need\":\" \u067e\u0646\u0647\u0627\u0646 \u06a9\u0631\u062f\u0646 \u0648\u0642\u062a \u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0646\u06cc\u0627\u0632 \u0646\u062f\u0627\u0631\u06cc\u062f\",\"High\":\"\u0628\u0627\u0644\u0627\",\"High Latitude\":\"\u0639\u0631\u0636 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0628\u0627\u0644\u0627\",\"Highlight current prayer\":\"\u0646\u0645\u0627\u0632 \u0641\u0639\u0644\u06cc \u0631\u0627 \u0628\u0631\u062c\u0633\u062a\u0647 \u06a9\u0646\",\"Home\":\"\u062e\u0627\u0646\u0647\",\"Homescreen and notification Widgets\":\"\u0648\u06cc\u062c\u062a \u0647\u0627\u06cc \u0635\u0641\u062d\u0647 \u0646\u0645\u0627\u06cc\u0634 \u0648 \u0627\u0639\u0644\u0627\u0646\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"\u0628\u0627 \u0627\u06cc\u0646 \u062d\u0627\u0644\u060c \u0647\u0646\u06af\u0627\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0633\u0631\u0648\u06cc\u0633\u200c\u0647\u0627\u06cc \u0622\u0646\u0644\u0627\u06cc\u0646\u060c \u0645\u0627\u0646\u0646\u062f \u0646\u0642\u0634\u0647 \u0642\u0628\u0644\u0647\u060c \u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062d\u062f\u0627\u0642\u0644 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0644\u0627\u0632\u0645 \u0631\u0627 \u0645\u0646\u062a\u0642\u0644 \u06a9\u0646\u062f \u06a9\u0647 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u0637\u0648\u0631 \u0645\u0646\u062d\u0635\u0631\u0628\u0647\u200c\u0641\u0631\u062f \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u06a9\u0646\u062f \u06cc\u0627 \u0646\u06a9\u0646\u062f. \u0644\u0637\u0641\u0627\u064b \u0647\u0646\u06af\u0627\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u06cc\u0646 \u0631\u0627 \u062f\u0631 \u0646\u0638\u0631 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f.\",\"I Understand\":\"\u0645\u062a\u0648\u062c\u0647 \u0627\u0645\",\"IMPORTANT_CHANNEL_ID\":\"\u0645\u0647\u0645\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"\u062f\u0631 \u0635\u0648\u0631\u062a \u0641\u0639\u0627\u0644 \u0628\u0648\u062f\u0646\u060c \u0647\u0646\u06af\u0627\u0645\u06cc \u06a9\u0647 \u0627\u0639\u0644\u0627\u0646 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\u060c \u062d\u0627\u0648\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0628\u0631\u0627\u06cc \u0648\u0642\u062a \u0646\u0645\u0627\u0632 \u0628\u0639\u062f\u06cc \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"\u0627\u06af\u0631 \xab\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u200c\u06af\u06cc\u0631\u06cc \u0648 \u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc\xbb \u0631\u0627 \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u06af\u0648\u0634\u06cc \u062e\u0648\u062f \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f (\u062a\u0646\u0638\u06cc\u0645\u0627\u062a / \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u200c\u06af\u06cc\u0631\u06cc \u0648 \u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc / \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u200c\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0646)\u060c \u0628\u0627\u06cc\u062f \u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u062e\u0648\u062f \u0627\u0646\u062f\u0631\u0648\u06cc\u062f (\u0646\u0647 \u0627\u0644\u0623\u0630\u0627\u0646) \u0628\u0647 \u0637\u0648\u0631 \u062f\u0648\u0631\u0647\u200c\u0627\u06cc \u06cc\u06a9 \u06a9\u067e\u06cc \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0631\u0627 \u062f\u0631 Google \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0633\u0631\u0648\u0631\u0647\u0627 \u0627\u06cc\u0646 \u0628\u0647 Android \u0627\u062c\u0627\u0632\u0647 \u0645\u06cc \u062f\u0647\u062f \u062a\u0627 \u062f\u0631 \u0635\u0648\u0631\u062a \u0622\u0633\u06cc\u0628 \u062f\u06cc\u062f\u0646 \u062f\u0633\u062a\u06af\u0627\u0647 \u06cc\u0627 \u062e\u0631\u06cc\u062f \u062f\u0633\u062a\u06af\u0627\u0647 \u062c\u062f\u06cc\u062f\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u06a9\u0646\u062f. \u062a\u0648\u0633\u0639\u0647 \u062f\u0647\u0646\u062f\u06af\u0627\u0646 \u0627\u0644\u0623\u0630\u0627\u0646 \u0628\u0647 \u0627\u06cc\u0646 \u062f\u0627\u062f\u0647 \u0647\u0627 \u062f\u0633\u062a\u0631\u0633\u06cc \u0646\u062f\u0627\u0631\u0646\u062f.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"\u0627\u06af\u0631 \u067e\u0633 \u0627\u0632 \u0645\u062f\u062a\u06cc \u0647\u0645\u0686\u0646\u0627\u0646 \u0628\u0627 \u062a\u0648\u0642\u0641 \u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u0634\u06a9\u0644 \u062f\u0627\u0634\u062a\u06cc\u062f\u060c \u0644\u0637\u0641\u0627\u064b \u0628\u0631\u0627\u06cc \u0631\u0627\u0647 \u062d\u0644 \u0647\u0627\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0628\u0647 dontkillmyapp.com \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"\u0627\u06af\u0631 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u06cc\u062f \u06a9\u0647 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u062a\u0648\u0627\u0646\u062f \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u06a9\u0627\u0631 \u06a9\u0646\u062f\u060c \u0628\u0627\u06cc\u062f \u0628\u0647\u06cc\u0646\u0647\u200c\u0633\u0627\u0632\u06cc \u0646\u06cc\u0631\u0648 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f. \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0645\u0631\u0628\u0648\u0637\u0647 \u0631\u0627 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062f\u06a9\u0645\u0647 \u0632\u06cc\u0631 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"\u0627\u06af\u0631 \u062f\u0633\u062a\u06af\u0627\u0647 \u0634\u0645\u0627 \u0645\u0627\u0646\u0646\u062f Google Pixel \u062f\u0627\u0631\u0627\u06cc \u0634\u0627\u0631\u0698 \u062a\u0637\u0628\u06cc\u0642\u06cc \u0627\u0633\u062a \u0648 \u0646\u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u200c\u0647\u0627 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0632\u0646\u06af \u0647\u0634\u062f\u0627\u0631 \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0634\u0648\u0646\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0631\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f.\",\"Import\":\"\u0648\u0627\u0631\u062f \u0643\u0631\u062f\u0646\",\"Import app data\":\"\u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f\",\"Import successful\":\"\u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"\u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u0646\u0645\u0627\u0632 \u0647\u0627\u06cc \u067e\u0646\u062c\u06af\u0627\u0646\u0647\u060c \u0642\u0627\u0628\u0644\u06cc\u062a \u0646\u0645\u0627\u06cc\u0634 \u0637\u0644\u0648\u0639\u060c \u063a\u0631\u0648\u0628\u060c \u0646\u06cc\u0645\u0647 \u0634\u0628 \u0648 \u0646\u0645\u0627\u0632 \u0634\u0628 (\u062a\u0647\u062c\u062f) \u0631\u0627 \u062f\u0627\u0631\u062f\",\"Increment\":\"\u0627\u0641\u0632\u0627\u06cc\u0634\",\"Info\":\"\u0627\u0637\u0644\u0627\u0639\u0627\u062a\",\"Internet connection\":\"\u0627\u062a\u0635\u0627\u0644 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"\u0627\u062a\u0635\u0627\u0644 \u0628\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u06a9\u0631\u062f \u0646\u0642\u0634\u0647 \u0642\u0628\u0644\u0647 \u0636\u0631\u0648\u0631\u06cc \u0627\u0633\u062a. \u0644\u0637\u0641\u0627\u064b wifi \u06cc\u0627 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0645\u0648\u0628\u0627\u06cc\u0644 \u062e\u0648\u062f \u0631\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f \u0648 \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f.\",\"Iran\":\"\u0627\u06cc\u0631\u0627\u0646\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0628\u0647 \u0632\u0628\u0627\u0646 \u0647\u0627\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc\u060c \u0641\u0627\u0631\u0633\u06cc\u060c \u0639\u0631\u0628\u06cc\u060c \u062a\u0631\u06a9\u06cc\u060c \u0627\u0646\u062f\u0648\u0646\u0632\u06cc\u0627\u06cc\u06cc\u060c \u0641\u0631\u0627\u0646\u0633\u0648\u06cc\u060c \u0627\u0631\u062f\u0648\u060c \u0647\u0646\u062f\u06cc\u060c \u0622\u0644\u0645\u0627\u0646\u06cc\u060c \u0628\u0648\u0633\u0646\u06cc\u0627\u06cc\u06cc\u060c \u0648\u06cc\u062a\u0646\u0627\u0645\u06cc\u060c \u0628\u0646\u06af\u0644\u0627 \u062a\u0631\u062c\u0645\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a\",\"Isha Angle\":\"\u0632\u0627\u0648\u06cc\u0647 \u0639\u0634\u0627\u0621\",\"Isha Interval\":\"\u0641\u0627\u0635\u0644\u0647 \u0639\u0634\u0627\",\"Islamic\":\"\u0627\u0633\u0644\u0627\u0645\u06cc\",\"Islamic (Saudi Arabia sighting)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc)\",\"Islamic (Umm al-Qura)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0627\u0645 \u0627\u0644\u0642\u0631\u06cc)\",\"Islamic (civil)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0645\u062f\u0646\u06cc)\",\"Islamic (tabular)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u062c\u062f\u0648\u0644\u06cc)\",\"Islamic Society of North America (ISNA)\":\"\u062c\u0627\u0645\u0639\u0647 \u0627\u0633\u0644\u0627\u0645\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc \u0634\u0645\u0627\u0644\u06cc (\u0627\u06cc\u0633\u0646\u0627)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"\u0628\u0647 \u0646\u0638\u0631 \u0645\u06cc \u0631\u0633\u062f \u06a9\u0647 \u06cc\u06a9 \u0646\u0633\u062e\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0647 \u0627\u06cc\u062f\u060c \u0641\u0631\u0627\u0645\u0648\u0634 \u0646\u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0628\u0647\u06cc\u0646\u0647 \u0633\u0627\u0632\u06cc \u0628\u0627\u062a\u0631\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f\",\"Just now\":\"\u0647\u0645\u06cc\u0646 \u0627\u0644\u0627\u0646\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"\u0648\u0632\u0627\u0631\u062a \u062f\u06cc\u0646 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0646\u062f\u0648\u0646\u0632\u06cc (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (\u0628\u0631\u0648\u0646\u0626\u06cc \u062f\u0627\u0631\u0627\u0644\u0633\u0644\u0627\u0645)\",\"Kuwait\":\"\u06a9\u0648\u06cc\u062a\",\"Label\":\"\u0628\u0631\u0686\u0633\u0628\",\"Language\":\"\u0632\u0628\u0627\u0646\",\"Latitude\":\"\u0639\u0631\u0636 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc\",\"Latitude is invalid\":\"\u0639\u0631\u0636 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0646\u0627\u0645\u0639\u062a\u0628\u0631 \u0627\u0633\u062a\",\"License\":\"\u0644\u0627\u06cc\u0633\u0646\u0633\",\"Light\":\"\u0631\u0648\u0634\u0646\",\"Light and Dark theme\":\"\u062a\u0645 \u0631\u0648\u0634\u0646 \u0648 \u062a\u0627\u0631\u06cc\u06a9\",\"Light/Dark theme\":\"\u062a\u0645 \u0631\u0648\u0634\u0646 \u0648 \u062a\u0627\u0631\u06cc\u06a9\\n\",\"List is empty\":\"\u0644\u06cc\u0633\u062a \u062e\u0627\u0644\u06cc \u0627\u0633\u062a\",\"Loading\":\"\u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc\",\"Location\":\"\u0645\u0648\u0642\u0639\u06cc\u062a\",\"Location settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0645\u06a9\u0627\u0646\",\"Longitude\":\"\u0637\u0648\u0644 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc\",\"Longitude is invalid\":\"\u0637\u0648\u0644 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0646\u0627\u0645\u0639\u062a\u0628\u0631 \u0627\u0633\u062a\",\"Low\":\"\u06a9\u0645\",\"Lunar Calendar\":\"\u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc\",\"Lunar Calendar Language\":\"\u0632\u0628\u0627\u0646 \u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc\",\"Maghrib Angle\":\"\u0632\u0627\u0648\u06cc\u0647 \u0645\u063a\u0631\u0628\",\"Make a Copy\":\"\u0627\u06cc\u062c\u0627\u062f \u06a9\u067e\u06cc\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"\u06af\u0632\u06cc\u0646\u0647 \u0647\u0627\u06cc \u0628\u0633\u06cc\u0627\u0631 \u0628\u0631\u0627\u06cc \u0645\u062d\u0627\u0633\u0628\u0647 \u0648\u0642\u062a \u0627\u0630\u0627\u0646\\n\",\"Medium\":\"\u0645\u062a\u0648\u0633\u0637\",\"Middle of the Night\":\"\u0646\u06cc\u0645\u0647 \u0634\u0628 \u0634\u0631\u0639\u06cc\",\"Midnight Method\":\"\u0631\u0648\u0634 \u0646\u06cc\u0645\u0647 \u0634\u0628\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"\u0648\u0632\u0627\u0631\u062a \u0627\u0645\u0648\u0631 \u062f\u06cc\u0646\u06cc \u0648 \u0648\u0642\u0641 \u0627\u0644\u062c\u0632\u0627\u06cc\u0631\",\"Ministry of Religious Affairs of Tunisia\":\"\u0648\u0632\u0627\u0631\u062a \u0627\u0645\u0648\u0631 \u062f\u06cc\u0646\u06cc \u062a\u0648\u0646\u0633\",\"Mobile Data\":\"\u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0645\u0648\u0628\u0627\u06cc\u0644\",\"Modified\":\"\u062a\u063a\u06cc\u06cc\u0631 \u06cc\u0627\u0641\u062a\u0647\",\"Monday\":\"\u062f\u0648\u0634\u0646\u0628\u0647\",\"Moonsighting Committee\":\"\u06a9\u0645\u06cc\u062a\u0647 \u0631\u0648\u06cc\u062a \u0647\u0644\u0627\u0644 \u0645\u0627\u0647\",\"Muslim World League\":\"\u0644\u06cc\u06af \u062c\u0647\u0627\u0646\u06cc \u0645\u0633\u0644\u0645\u0627\u0646\u0627\u0646\",\"Name\":\"\u0646\u0627\u0645\",\"Nearest\":\"\u0646\u0632\u062f\u06cc\u06a9\u062a\u0631\u06cc\u0646\",\"New Counter\":\"\u0634\u0645\u0627\u0631\u0646\u062f\u0647 \u062c\u062f\u06cc\u062f\",\"New Location\":\"\u0645\u06a9\u0627\u0646 \u062c\u062f\u06cc\u062f\",\"New Reminder\":\"\u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062c\u062f\u06cc\u062f\",\"New Silent Mode\":\"\u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627\u06cc \u062c\u062f\u06cc\u062f\",\"Next\":\"\u0628\u0639\u062f\u06cc\",\"Next Day\":\"\u0631\u0648\u0632 \u0628\u0639\u062f\",\"Next Month\":\"\u0645\u0627\u0647 \u0628\u0639\u062f\",\"No\":\"\u062e\u06cc\u0631\",\"No Data\":\"\u0628\u062f\u0648\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\",\"No Results\":\"\u0646\u062a\u06cc\u062c\u0647 \u0627\u06cc \u06cc\u0627\u0641\u062a \u0646\u0634\u062f\",\"None\":\"\u0647\u06cc\u0686\u06a9\u062f\u0627\u0645\",\"None (Automatic)\":\"\u0647\u06cc\u0686\u06a9\u062f\u0627\u0645 (\u0627\u062a\u0648\u0645\u0627\u062a\u06cc\u06a9)\",\"Normal mode restored\":\"\u062d\u0627\u0644\u062a \u0639\u0627\u062f\u06cc \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0647 \u0634\u062f\",\"Not now\":\"\u0627\u0644\u0627\u0646 \u0646\u0647\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"\u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u062e\u0637\u0627\u0647\u0627\u06cc \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631\u06cc \u0648 \u0633\u062e\u062a \u0627\u0641\u0632\u0627\u0631\u06cc\u060c \u062c\u0647\u062a \u0642\u0628\u0644\u0647 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u062a\u0648\u0633\u0637 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\u060c \u0628\u0647 \u062e\u0635\u0648\u0635 \u062f\u0631 \u062d\u0627\u0644\u062a \u0642\u0637\u0628 \u0646\u0645\u0627\u060c \u0645\u06cc \u062a\u0648\u0627\u0646\u062f \u0627\u0634\u062a\u0628\u0627\u0647 \u0628\u0627\u0634\u062f.\",\"Notification\":\"\u0627\u0639\u0644\u0627\u0646\",\"Notification & Sound\":\"\u0627\u0639\u0644\u0627\u0646 \u0648 \u0635\u062f\u0627\",\"Notifications Permission\":\"\u0645\u062c\u0648\u0632 \u0627\u0639\u0644\u0627\u0646\",\"Numbering system\":\"\u0633\u06cc\u0633\u062a\u0645 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc\",\"Off\":\"\u062e\u0627\u0645\u0648\u0634\",\"Okay\":\"\u0628\u0627\u0634\u0647\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"\u062f\u0631 \u0627\u0646\u062f\u0631\u0648\u06cc\u062f 12 \u0648 \u062c\u062f\u06cc\u062f\u062a\u0631\u060c \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0631\u0627\u06cc \u062f\u0631\u0633\u062a \u06a9\u0627\u0631 \u06a9\u0631\u062f\u0646 \u0628\u0647 \u0645\u062c\u0648\u0632 \u0632\u0646\u06af \u0647\u0634\u062f\u0627\u0631 \u0646\u06cc\u0632 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0628\u0627\u06cc\u062f \u0627\u06cc\u0646 \u0627\u062c\u0627\u0632\u0647 \u0631\u0627 \u0646\u06cc\u0632 \u0628\u062f\u0647\u06cc\u062f.\",\"Once\":\"\u06cc\u06a9 \u0628\u0627\u0631\",\"One-Seventh of the Night\":\"\u06cc\u06a9 \u0647\u0641\u062a\u0645 \u0634\u0628\",\"Only once?\":\"\u0641\u0642\u0637 \u06cc\u06a9 \u0628\u0627\u0631\u061f\",\"Only six items can be shown at the same time\":\"\u0641\u0642\u0637 \u0634\u0634 \u0645\u0648\u0631\u062f \u0631\u0627 \u0645\u06cc \u062a\u0648\u0627\u0646 \u0647\u0645\u0632\u0645\u0627\u0646 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\",\"Open Battery Optimization Settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u0647\u06cc\u0646\u0647 \u0633\u0627\u0632\u06cc \u0628\u0627\u062a\u0631\u06cc \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\",\"Open Power Manager Settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0646\u0631\u0698\u06cc \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\",\"Open source repository\":\"\u0645\u062e\u0632\u0646 \u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633\",\"Open-source\":\"\u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633 \u06cc\u0627 \u0645\u062a\u0646 \u0628\u0627\u0632\",\"Options\":\"\u06af\u0632\u06cc\u0646\u0647 \u0647\u0627\",\"Or if you have a backup, you can import it\":\"\u06cc\u0627 \u0627\u06af\u0631 \u0646\u0633\u062e\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u062f\u0627\u0631\u06cc\u062f\u060c \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u0646 \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f\",\"Orientation Lock: Landscape\":\"\u0642\u0641\u0644 \u062c\u0647\u062a: \u0627\u0641\u0642\u06cc\",\"Orientation Lock: Portrait\":\"\u0642\u0641\u0644 \u062c\u0647\u062a: \u0639\u0645\u0648\u062f\u06cc\",\"Orientation: Unlocked\":\"\u062c\u0647\u062a: \u0642\u0641\u0644 \u0646\u0634\u062f\u0647\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"\u0633\u0627\u06cc\u0631 \u062f\u0633\u062a\u06af\u0627\u0647 \u0647\u0627\u06cc \u0645\u063a\u0646\u0627\u0637\u06cc\u0633\u06cc \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0628\u0627 \u0642\u0637\u0628 \u0646\u0645\u0627\u06cc \u062a\u0644\u0641\u0646 \u0634\u0645\u0627 \u062a\u062f\u0627\u062e\u0644 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u0646\u062f \u0648 \u0642\u0637\u0628 \u0646\u0645\u0627\u06cc \u0634\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0646\u06cc\u0627\u0632 \u0628\u0647 \u062a\u0646\u0638\u06cc\u0645 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f.\",\"PRAYER_MODE_CHANNEL_NAME\":\"\u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627\",\"PRE_ADHAN_CHANNEL_NAME\":\"\u0647\u0634\u062f\u0627\u0631 \u0628\u0639\u062f\u06cc\",\"PRE_REMINDER_CHANNEL_NAME\":\"\u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0628\u0639\u062f\u06cc\",\"Pakistan\":\"\u067e\u0627\u06a9\u0633\u062a\u0627\u0646\",\"Paste\":\"\u0686\u0633\u0628\u0627\u0646\u062f\u0646\",\"Persian\":\"\u0641\u0627\u0631\u0633\u06cc\",\"Phone State Permission\":\"\u0645\u062c\u0648\u0632 \u0648\u0636\u0639\u06cc\u062a \u062a\u0644\u0641\u0646\",\"Play\":\"\u067e\u062e\u0634\",\"Please enable location service\":\"\u0644\u0637\u0641\u0627\u064b \u0633\u0631\u0648\u06cc\u0633 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0631\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"\u0644\u0637\u0641\u0627\u064b \u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0628\u0627\u0639\u062b \u0634\u0648\u062f \u0627\u0630\u0627\u0646 \u0648 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0647\u0627 \u0628\u0627 \u062a\u0623\u062e\u06cc\u0631 \u0641\u0639\u0627\u0644 \u0634\u0648\u0646\u062f \u06cc\u0627 \u062f\u0631 \u0628\u0631\u062e\u06cc \u0645\u0648\u0627\u0631\u062f \u0627\u0635\u0644\u0627\u064b \u0627\u062c\u0631\u0627 \u0646\u0634\u0648\u062f. \u0627\u06cc\u0646 \u0631\u0627 \u0628\u0627 \u0627\u062d\u062a\u06cc\u0627\u0637 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f.\",\"Polar Resolution\":\"\u0645\u062d\u0627\u0633\u0628\u0647 \u0645\u0646\u0627\u0637\u0642 \u0642\u0637\u0628\u06cc\",\"Power Manager\":\"\u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0646\u0631\u0698\u06cc\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"\u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc\",\"Prayer list\":\"\u0641\u0647\u0631\u0633\u062a \u0646\u0645\u0627\u0632\u0647\u0627\",\"Press to search\":\"\u0628\u0631\u0627\u06cc \u062c\u0633\u062a\u062c\u0648 \u0644\u0645\u0633 \u06a9\u0646\u06cc\u062f\",\"Press to select a method\":\"\u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0644\u0645\u0633 \u06a9\u0646\u06cc\u062f\",\"Prev Day\":\"\u0631\u0648\u0632 \u0642\u0628\u0644\",\"Prev Month\":\"\u0645\u0627\u0647 \u0642\u0628\u0644\",\"Privacy Policy\":\"\u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"\u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633 \u0627\u0630\u0627\u0646 (\u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc) \u0648 \u0642\u0628\u0644\u0647 \u06cc\u0627\u0628 \u0628\u0627 \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\",\"Qada counter\":\"\u0634\u0645\u0627\u0631\u0646\u062f\u0647 \u0642\u0636\u0627\",\"Qatar\":\"\u0642\u0637\u0631\",\"Qibla\":\"\u0642\u0628\u0644\u0647\",\"Qibla finder\":\"\u0642\u0628\u0644\u0647 \u06cc\u0627\u0628\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"\u0642\u0628\u0644\u0647 \u06cc\u0627\u0628 \u0628\u0647 \u062e\u062f\u0645\u0627\u062a \u0645\u0648\u0642\u0639\u06cc\u062a \u06cc\u0627\u0628\u06cc \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u062f. \u0627\u06af\u0631 \u0641\u0639\u0627\u0644 \u0646\u0628\u0627\u0634\u062f\u060c \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0627\u0632 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"\u0646\u0642\u0634\u0647 \u0642\u0628\u0644\u0647 \u062f\u0631 \u062d\u0627\u0644 \u062d\u0627\u0636\u0631 \u062f\u0631 \u0646\u0633\u062e\u0647 \u0647\u0627\u06cc F-Droid \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a. \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062f\u0631 \u0628\u0647 \u0631\u0648\u0632 \u0631\u0633\u0627\u0646\u06cc \u0647\u0627\u06cc \u0622\u06cc\u0646\u062f\u0647 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0642\u0631\u0627\u0631 \u06af\u06cc\u0631\u062f.\",\"REMINDER_CHANNEL_NAME\":\"\u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\",\"Ramadan is ending,\":\"\u0645\u0627\u0647 \u0645\u0628\u0627\u0631\u06a9 \u0631\u0645\u0636\u0627\u0646 \u0631\u0648 \u0628\u0647 \u0627\u062a\u0645\u0627\u0645 \u0627\u0633\u062a\u060c\",\"Ramadan is near,\":\"\u0645\u0627\u0647 \u0645\u0628\u0627\u0631\u06a9 \u0631\u0645\u0636\u0627\u0646 \u0646\u0632\u062f\u06cc\u06a9 \u0627\u0633\u062a\u060c\",\"Remaining till\":\"\u0645\u0627\u0646\u062f\u0647 \u062a\u0627\",\"Remind me next year\":\"\u0633\u0627\u0644 \u0628\u0639\u062f \u0628\u0647 \u0645\u0646 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u06a9\u0646\",\"Reminder\":\"\u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\",\"Repeat\":\"\u062a\u06a9\u0631\u0627\u0631\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0645\u0648\u0631\u062f \u0646\u06cc\u0627\u0632 \u0646\u0627\u0642\u0635 \u0647\u0633\u062a\u0646\u062f. \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646\u06a9\u0647 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc \u0631\u0627 \u0646\u0634\u0627\u0646 \u062f\u0647\u062f\u060c \u0628\u0639\u062f\u0627\u064b \u0628\u0627\u06cc\u062f \u0622\u0646 \u0631\u0627 \u0627\u0632 \u0635\u0641\u062d\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f.\",\"Rounding Method\":\"\u0631\u0648\u0634 \u06af\u0631\u062f \u06a9\u0631\u062f\u0646\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"\u062f\u0633\u062a\u06af\u0627\u0647 \u0647\u0627\u06cc \u0633\u0627\u0645\u0633\u0648\u0646\u06af \u062f\u0627\u0631\u0627\u06cc \xab\u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0646\u0631\u0698\u06cc\xbb (Power Manager) \u0633\u0641\u0627\u0631\u0634\u06cc \u062e\u0648\u062f \u0628\u0647 \u0646\u0627\u0645 \xab\u0645\u0631\u0627\u0642\u0628\u062a \u0627\u0632 \u062f\u0633\u062a\u06af\u0627\u0647\xbb (Device Care) \u0647\u0633\u062a\u0646\u062f. \u067e\u0633 \u0627\u0632 \u0641\u0634\u0627\u0631 \u062f\u0627\u062f\u0646 \u062f\u06a9\u0645\u0647 \u0632\u06cc\u0631\u060c \u0628\u0647 \u0645\u0646\u0648\u06cc  \u0645\u0631\u0627\u0642\u0628\u062a \u0627\u0632 \u0628\u0627\u062a\u0631\u06cc \u062f\u0633\u062a\u06af\u0627\u0647 \u062e\u0648\u062f \u0647\u062f\u0627\u06cc\u062a \u062e\u0648\u0627\u0647\u06cc\u062f \u0634\u062f. \u062f\u0631 \u0645\u0646\u0648\u06cc \u0628\u0627\u062a\u0631\u06cc \u0631\u0648\u06cc \u06af\u0632\u06cc\u0646\u0647 \xab\u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0646\u0631\u0698\u06cc \u0628\u0631\u0646\u0627\u0645\u0647\xbb (App power management) \u0648 \u0633\u067e\u0633 \xab\u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0647 \u062d\u0627\u0644\u062a \u062e\u0648\u0627\u0628 \u0646\u0645\u06cc\u200c\u0631\u0648\u0646\u062f\xbb (Apps that won't be put to sleep) \u0628\u0632\u0646\u06cc\u062f \u0648 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u0628\u0647 \u0644\u06cc\u0633\u062a \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.\",\"Saturday\":\"\u0634\u0646\u0628\u0647\",\"Saudi Arabia\":\"\u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc\",\"Search\":\"\u062c\u0633\u062a\u062c\u0648\",\"Secondary Calendar\":\"\u062a\u0642\u0648\u06cc\u0645 \u062b\u0627\u0646\u0648\u06cc\u0647\",\"See favorite locations\":\"\u0645\u06a9\u0627\u0646 \u0647\u0627\u06cc \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647 \u0631\u0627 \u0628\u0628\u06cc\u0646\u06cc\u062f\",\"Select as Fajr Adhan\":\"\u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u0630\u0627\u0646 \u0641\u062c\u0631 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f\",\"Select different Adhan audio for Fajr namaz\":\"\u0627\u0646\u062a\u062e\u0627\u0628 \u0627\u0630\u0627\u0646 \u0645\u062a\u0641\u0627\u0648\u062a \u0628\u0631\u0627\u06cc \u0646\u0645\u0627\u0632 \u0635\u0628\u062d\",\"Selected\":\"\u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647\",\"Selected as adhan\":\"\u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u0630\u0627\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\",\"Selected as fajr adhan\":\"\u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u0630\u0627\u0646 \u0641\u062c\u0631 \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\",\"Selecting a name is required\":\"\u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0627\u0645 \u0627\u0644\u0632\u0627\u0645\u06cc \u0627\u0633\u062a\",\"Set custom Adhan audio\":\"\u0627\u0646\u062a\u062e\u0627\u0628 \u0635\u062f\u0627\u06cc \u062f\u0644\u062e\u0648\u0627\u0647 \u0628\u0631\u0627\u06cc \u0627\u0630\u0627\u0646\",\"Set reminders before or after a prayer time\":\"\u0627\u06cc\u062c\u0627\u062f \u06cc\u0627\u062f \u0622\u0648\u0631\u06cc \u0642\u0628\u0644 \u06cc\u0627 \u0628\u0639\u062f \u0627\u0632 \u0647\u0631 \u0648\u0642\u062a \u0634\u0631\u0639\u06cc\",\"Shafaq\":\"\u0634\u0641\u0642\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\\\"\u0634\u0641\u0642\\\" \u062f\u0631 \u0631\u0648\u0634 \u0645\u062d\u0627\u0633\u0628\u0647 \\\"\u06a9\u0645\u06cc\u062a\u0647 \u0631\u0648\u06cc\u062a \u0647\u0644\u0627\u0644 \u0645\u0627\u0647\\\" \u0628\u0631\u0627\u06cc \u062a\u0639\u06cc\u06cc\u0646 \u0646\u0648\u0639 \u06af\u0631\u06af \u0648 \u0645\u06cc\u0634 \u0628\u0631\u0627\u06cc \u062a\u0639\u06cc\u06cc\u0646 \u0632\u0645\u0627\u0646 \u0639\u0634\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f.\",\"Shafi, Maliki, Hanbali (Default)\":\"\u0634\u0627\u0641\u0639\u06cc\u060c \u0645\u0627\u0644\u06a9\u06cc\u060c \u062d\u0646\u0628\u0644\u06cc (\u067e\u06cc\u0634\u200c\u0641\u0631\u0636)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u0634\u06cc\u0639\u0647 \u0627\u062b\u0646\u0627 \u0639\u0634\u0631\u06cc\u060c \u0645\u0624\u0633\u0633\u0647 \u0644\u0648\u0627\u060c \u0642\u0645\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u0634\u06cc\u0639\u0647\u060c \u0645\u0648\u0633\u0633\u0647 \u0698\u0626\u0648\u0641\u06cc\u0632\u06cc\u06a9 \u062f\u0627\u0646\u0634\u06af\u0627\u0647 \u062a\u0647\u0631\u0627\u0646\",\"Should app highlight current prayer instead of next prayer?\":\"\u0622\u06cc\u0627 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u06cc\u062f \u0646\u0645\u0627\u0632 \u0641\u0639\u0644\u06cc \u0631\u0627 \u0628\u0647 \u062c\u0627\u06cc \u0646\u0645\u0627\u0632 \u0628\u0639\u062f\u06cc \u0628\u0631\u062c\u0633\u062a\u0647 \u06a9\u0646\u062f\u061f\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\u0648\u0642\u062a\u06cc \xab\u0645\u0632\u0627\u062d\u0645 \u0646\u0634\u0648\u06cc\u062f\xbb \u0641\u0639\u0627\u0644 \u0627\u0633\u062a\u060c \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0645\u0686\u0646\u0627\u0646 \u0628\u0627\u06cc\u062f \u0627\u0630\u0627\u0646 \u067e\u062e\u0634 \u06a9\u0646\u062f\u061f\",\"Should app stop playing adhan when the volume button is pressed?\":\"\u0622\u06cc\u0627 \u0628\u0627 \u0641\u0634\u0627\u0631 \u062f\u0627\u062f\u0646 \u062f\u06a9\u0645\u0647 \u0635\u062f\u0627\u060c \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u06cc\u062f \u067e\u062e\u0634 \u0627\u0630\u0627\u0646 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u06a9\u0646\u062f\u061f\",\"Should phone vibrate when adhan or reminder starts playing?\":\"\u0622\u06cc\u0627 \u0647\u0646\u06af\u0627\u0645 \u0634\u0631\u0648\u0639 \u067e\u062e\u0634 \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u062a\u0644\u0641\u0646 \u0628\u0627\u06cc\u062f \u0628\u0644\u0631\u0632\u062f\u061f\",\"Show Adhan Options\":\"\u0646\u0645\u0627\u06cc\u0634 \u06af\u0632\u06cc\u0646\u0647 \u0647\u0627\u06cc \u0627\u0630\u0627\u0646\",\"Show Today\":\"\u0646\u0645\u0627\u06cc\u0634 \u0627\u0645\u0631\u0648\u0632\",\"Show countdown?\":\"\u0634\u0645\u0627\u0631\u0634 \u0645\u0639\u06a9\u0648\u0633 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\u061f\",\"Show current\":\"\u0646\u0645\u0627\u06cc\u0634 \u0641\u0639\u0644\u06cc\",\"Show me\":\"\u0646\u0634\u0627\u0646\u0645 \u0628\u062f\u0647\",\"Show next in notification?\":\"\u0628\u0639\u062f\u06cc \u062f\u0631 \u0627\u0639\u0644\u0627\u0646 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\u061f\",\"Show notification widget?\":\"\u0627\u0628\u0632\u0627\u0631\u06a9 \u0627\u0639\u0644\u0627\u0646 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\u061f\",\"Show settings\":\"\u0646\u0645\u0627\u06cc\u0634 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a\",\"Show upcoming alarm notification?\":\"\u0627\u0639\u0644\u0627\u0646 \u0647\u0634\u062f\u0627\u0631 \u0628\u0639\u062f\u06cc \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\u061f\",\"Silent\":\"\u0628\u06cc \u0635\u062f\u0627\",\"Silent Mode Ended\":\"\u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627 \u067e\u0627\u06cc\u0627\u0646 \u06cc\u0627\u0641\u062a\",\"Silent Mode Name\":\"\u0646\u0627\u0645 \u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627\",\"Silent Mode Started\":\"\u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627 \u0634\u0631\u0648\u0639 \u0634\u062f\",\"Silent mode activated\":\"\u062d\u0627\u0644\u062a \u0628\u06cc \u0635\u062f\u0627 \u0641\u0639\u0627\u0644 \u0634\u062f\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"\u0628\u0647 \u062f\u0644\u06cc\u0644 \u0627\u06cc\u0646\u06a9\u0647 \u0645\u0627 \u0627\u0632 \u0647\u06cc\u0686 \u06af\u0648\u0646\u0647 \u0631\u062f\u06cc\u0627\u0628\u06cc \u06cc\u0627 \u062a\u062c\u0632\u06cc\u0647 \u0648 \u062a\u062d\u0644\u06cc\u0644 \u062e\u0631\u0627\u0628\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u06cc \u06a9\u0646\u06cc\u0645\u060c \u0644\u0637\u0641\u0627 \u0645\u0634\u06a9\u0644\u0627\u062a \u062e\u0648\u062f\u062a\u0648\u0646\u060c \u06cc\u0627 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0627\u062a\u062a\u0648\u0646 \u0631\u0648 \u062f\u0631 \u0645\u062d\u0644 \u067e\u0631\u0648\u0698\u0647 \u06af\u06cc\u062a \u0647\u0627\u0628 \u0645\u0627 \u06af\u0632\u0627\u0631\u0634 \u06a9\u0646\u06cc\u062f\",\"Singapore\":\"\u0633\u0646\u06af\u0627\u067e\u0648\u0631\",\"Skip\":\"\u0631\u062f \u06a9\u0631\u062f\u0646\",\"Software License\":\"\u0645\u062c\u0648\u0632 \u0646\u0631\u0645 \u0627\u0641\u0632\u0627\u0631\",\"Solar Hijri\":\"\u0647\u062c\u0631\u06cc \u0634\u0645\u0633\u06cc\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"\u0628\u0631\u062e\u06cc \u0627\u0632 \u062f\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627 \u0628\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0636\u0627\u0641\u06cc \u062f\u0631 \\\"\u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0646\u0631\u0698\u06cc\\\" (Power Manager) \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u0646\u062f \u062a\u0627 \u0627\u0632 \u0628\u0633\u062a\u0647 \u0634\u062f\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u0646\u062f. \u062f\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a \u0647\u0631 \u06af\u0632\u06cc\u0646\u0647 \u0635\u0631\u0641\u0647 \u062c\u0648\u06cc\u06cc \u062f\u0631 \u0627\u0646\u0631\u0698\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f.\",\"Sound\":\"\u0635\u062f\u0627\",\"Spiritual Administration of Muslims of Russia\":\"\u0627\u062f\u0627\u0631\u0647 \u0645\u0639\u0646\u0648\u06cc \u0645\u0633\u0644\u0645\u0627\u0646\u0627\u0646 \u0631\u0648\u0633\u06cc\u0647\",\"Start before prayer (minutes)\":\"\u0634\u0631\u0648\u0639 \u0642\u0628\u0644 \u0627\u0632 \u0646\u0645\u0627\u0632 (\u062f\u0642\u06cc\u0642\u0647)\",\"Status\":\"\u0648\u0636\u0639\u06cc\u062a\",\"Stop\":\"\u062a\u0648\u0642\u0641\",\"Sunday\":\"\u06cc\u06a9\u0634\u0646\u0628\u0647\",\"Sunset to Fajr (Default)\":\"\u063a\u0631\u0648\u0628 \u0622\u0641\u062a\u0627\u0628 \u062a\u0627 \u0641\u062c\u0631 (\u067e\u06cc\u0634\u200c\u0641\u0631\u0636)\",\"Sunset to Sunrise\":\"\u063a\u0631\u0648\u0628 \u062a\u0627 \u0637\u0644\u0648\u0639 \u062e\u0648\u0631\u0634\u06cc\u062f\",\"System Default\":\"\u067e\u06cc\u0634 \u0641\u0631\u0636 \u0633\u06cc\u0633\u062a\u0645\",\"Tahajjud time mentioned in the app is the last third of the night\":\"\u0632\u0645\u0627\u0646 \u062a\u0647\u062c\u062f \u0630\u06a9\u0631 \u0634\u062f\u0647 \u062f\u0631 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646\u060c \u062b\u0644\u062b \u0622\u062e\u0631 \u0634\u0628 \u0627\u0633\u062a\",\"Thai Solar\":\"\u062e\u0648\u0631\u0634\u06cc\u062f\u06cc \u062a\u0627\u06cc\u0644\u0646\u062f\u06cc\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"\u0628\u0627 \u062a\u0634\u06a9\u0631 \u0627\u0632 \u0627\u0646\u062a\u062e\u0627\u0628 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647! \u06a9\u0627\u0631\u0647\u0627\u06cc\u06cc \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f \u06a9\u0647 \u0628\u0627\u06cc\u062f \u0642\u0628\u0644 \u0627\u0632 \u0627\u06cc\u0646 \u06a9\u0647 \u0628\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f.\",\"The Gulf Region (Dubai)\":\"\u0645\u0646\u0637\u0642\u0647 \u062e\u0644\u06cc\u062c (\u062f\u0628\u06cc)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"\u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0632 \u0642\u0628\u0644 \u0645\u062d\u0627\u0633\u0628\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a \u0648 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062f\u0642\u06cc\u0642 \u0646\u0628\u0627\u0634\u062f \u0632\u06cc\u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0631\u0624\u06cc\u062a \u0645\u0627\u0647 \u0646\u06cc\u0633\u062a. \u062a\u0648\u062c\u0647 \u0628\u0647 \u0627\u06cc\u0646 \u0645\u0648\u0636\u0648\u0639 \u0628\u0631\u0627\u06cc \u0634\u0631\u0648\u0639 \u0648 \u067e\u0627\u06cc\u0627\u0646 \u0645\u0627\u0647 \u0645\u0628\u0627\u0631\u06a9 \u0631\u0645\u0636\u0627\u0646 \u0628\u0633\u06cc\u0627\u0631 \u0645\u0647\u0645 \u0627\u0633\u062a.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"\u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0645\u062a\u0646 \u06cc\u0627\u0641\u062a \u0634\u062f\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0648\u0628 \u0633\u0627\u06cc\u062a \u0648 \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631 \u0633\u0627\u06cc\u0631 \u0632\u0628\u0627\u0646 \u0647\u0627 \u062f\u0642\u06cc\u0642 \u0646\u0628\u0627\u0634\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u062f\u0631 \u0647\u0631 \u06af\u0648\u0646\u0647 \u0645\u0648\u0631\u062f\u060c \u0641\u0642\u0637 \u0646\u0633\u062e\u0647 \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0627\u06cc\u062f \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0634\u0648\u062f.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"\u0646\u0648\u0639 \u062a\u0642\u0648\u06cc\u0645\u06cc \u06a9\u0647 \u062f\u0631 \u0628\u0627\u0644\u0627\u06cc \u0635\u0641\u062d\u0647 \u0627\u0635\u0644\u06cc \u0648 \u062f\u0631 \u06a9\u0646\u0627\u0631 \u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc \u062f\u0631 \u0648\u06cc\u062c\u062a \u0647\u0627 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\",\"The type of lunar calendar shown in main screen and widgets\":\"\u0646\u0648\u0639 \u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u062f\u0631 \u0635\u0641\u062d\u0647 \u0627\u0635\u0644\u06cc \u0648 \u0648\u06cc\u062c\u062a \u0647\u0627\",\"Theme Color\":\"\u0631\u0646\u06af \u067e\u0648\u0633\u062a\u0647\",\"Thursday\":\"\u067e\u0646\u062c \u0634\u0646\u0628\u0647\",\"Time\":\"\u0648\u0642\u062a\",\"Time condition\":\"\u0634\u0631\u0627\u06cc\u0637 \u0632\u0645\u0627\u0646\u06cc\",\"Time format\":\"\u0642\u0627\u0644\u0628 \u0632\u0645\u0627\u0646\",\"Time list\":\"\u0644\u06cc\u0633\u062a \u0632\u0645\u0627\u0646\u06cc\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"\u0628\u0631\u0627\u06cc \u0645\u062d\u0627\u0633\u0628\u0647 \u0627\u0630\u0627\u0646\u060c \u0628\u0647 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0634\u0645\u0627 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u06cc\u0645. \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u062f\u06a9\u0645\u0647 \xab\u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0645\u06a9\u0627\u0646 \u0645\u0646\xbb \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u06cc\u0627 \u0627\u0632 \u062c\u0633\u062a\u062c\u0648\u06cc \u06a9\u0634\u0648\u0631 \u0648 \u0634\u0647\u0631/\u0645\u0646\u0637\u0642\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u06cc\u0627 \u0645\u062e\u062a\u0635\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u062f\u0633\u062a\u06cc \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f.\",\"To see notifications about adhan, we need your permission.\":\"\u0628\u0631\u0627\u06cc \u062f\u06cc\u062f\u0646 \u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627\u06cc \u0627\u0630\u0627\u0646\u060c \u0628\u0647 \u0627\u062c\u0627\u0632\u0647 \u0634\u0645\u0627 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u06cc\u0645.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"\u0628\u0631\u0627\u06cc \u062a\u0648\u0642\u0641 \u067e\u062e\u0634 \u0627\u0630\u0627\u0646 \u0647\u0646\u06af\u0627\u0645 \u062f\u0631\u06cc\u0627\u0641\u062a \u062a\u0645\u0627\u0633\u060c \u0628\u0627\u06cc\u062f \u0648\u0636\u0639\u06cc\u062a \u062a\u0644\u0641\u0646 \u0634\u0645\u0627 \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u0645. \u0627\u062c\u0627\u0632\u0647 \u0646\u062f\u0627\u062f\u0646 \u0628\u0647 \u0627\u06cc\u0646 \u0645\u062c\u0648\u0632 \u0628\u0647 \u0633\u0627\u062f\u06af\u06cc \u0627\u06cc\u0646 \u0648\u06cc\u0698\u06af\u06cc \u0631\u0627 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u0645\u06cc \u06a9\u0646\u062f.\",\"Tomorrow\":\"\u0641\u0631\u062f\u0627\",\"Tuesday\":\"\u0633\u0647 \u0634\u0646\u0628\u0647\",\"Turn Left\":\"\u0628\u0647 \u0686\u067e \u0628\u067e\u0631\u062e\",\"Turn Right\":\"\u0628\u0647 \u0631\u0627\u0633\u062a \u0628\u0686\u0631\u062e\",\"Turn history off\":\"\u062e\u0627\u0645\u0648\u0634 \u06a9\u0631\u062f\u0646 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647\",\"Turn history on\":\"\u0631\u0648\u0634\u0646 \u06a9\u0631\u062f\u0646 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647\",\"Twilight Angle\":\"\u0632\u0627\u0648\u06cc\u0647 \u06af\u0631\u06af \u0648 \u0645\u06cc\u0634\",\"Umm al-Qura University, Makkah\":\"\u062f\u0627\u0646\u0634\u06af\u0627\u0647 \u0627\u0645 \u0627\u0644\u0642\u0631\u06cc\u060c \u0645\u06a9\u0647\",\"Union Organization Islamic de France\":\"\u0633\u0627\u0632\u0645\u0627\u0646 \u0627\u062a\u062d\u0627\u062f\u06cc\u0647 \u0627\u0633\u0644\u0627\u0645\u06cc \u0641\u0631\u0627\u0646\u0633\u0647\",\"University of Islamic Sciences, Karachi\":\"\u062f\u0627\u0646\u0634\u06af\u0627\u0647 \u0639\u0644\u0648\u0645 \u0627\u0633\u0644\u0627\u0645\u06cc \u06a9\u0631\u0627\u0686\u06cc\",\"Unknown Error\":\"\u062e\u0637\u0627\u06cc \u0646\u0627\u0645\u0634\u062e\u0635\",\"Unreliable\":\"\u063a\u06cc\u0631 \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f\",\"Unresolved (default)\":\"\u062d\u0644 \u0646\u0634\u062f\u0647 (\u067e\u06cc\u0634 \u0641\u0631\u0636)\",\"Unsupported\":\"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0646\u0634\u062f\u0647\",\"Up\":\"\u0628\u0627\u0644\u0627\",\"Upcoming alarm\":\"\u0647\u0634\u062f\u0627\u0631 \u0628\u0639\u062f\u06cc\",\"Updating widgets\":\"\u062f\u0631 \u062d\u0627\u0644 \u0628\u0647 \u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0648\u06cc\u062c\u062a \u0647\u0627\",\"Use 24-Hour format\":\"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0642\u0627\u0644\u0628 24 \u0633\u0627\u0639\u062a\u0647\",\"Use Compass\":\"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0642\u0637\u0628 \u0646\u0645\u0627\",\"Use Map\":\"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0646\u0642\u0634\u0647\",\"Use a different alarm type?\":\"\u0627\u0632 \u0646\u0648\u0639 \u062f\u06cc\u06af\u0631\u06cc \u0627\u0632 \u0632\u0646\u06af \u0647\u0634\u062f\u0627\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0634\u0648\u062f\u061f\",\"Use adaptive theme?\":\"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0645 \u062a\u0637\u0628\u06cc\u0642\u06cc\u061f\",\"Use headphones when available?\":\"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0647\u062f\u0641\u0648\u0646 \u062f\u0631 \u0635\u0648\u0631\u062a \u0648\u062c\u0648\u062f\u061f\",\"Using Coordinates\":\"\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0645\u062e\u062a\u0635\u0627\u062a\",\"Using GPS\":\"\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 GPS\",\"Using Search\":\"\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062c\u0633\u062a\u062c\u0648\",\"Version\":\"\u0646\u0633\u062e\u0647\",\"Vibration Mode\":\"\u062d\u0627\u0644\u062a \u0648\u06cc\u0628\u0631\u0647\",\"Vibration on call\":\"\u0648\u06cc\u0628\u0631\u0647 \u0647\u0646\u06af\u0627\u0645 \u062a\u0645\u0627\u0633\",\"Volume button stops adhan\":\"\u062f\u06a9\u0645\u0647 \u0635\u062f\u0627 \u0627\u0630\u0627\u0646 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc \u06a9\u0646\u062f\",\"WIDGET_CHANNEL_NAME\":\"\u0648\u06cc\u062c\u062a\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"\u0628\u0647 \u0631\u0648\u0632 \u0631\u0633\u0627\u0646\u06cc \u0648\u06cc\u062c\u062a\",\"We'll help you do them quickly.\":\"\u0645\u0627 \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0622\u0646\u0647\u0627 \u0631\u0627 \u0633\u0631\u06cc\u0639 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f.\",\"Wednesday\":\"\u0686\u0647\u0627\u0631 \u0634\u0646\u0628\u0647\",\"Welcome\":\"\u062e\u0648\u0634 \u0622\u0645\u062f\u06cc\u062f\",\"Western Arabic\":\"\u0639\u0631\u0628\u06cc \u063a\u0631\u0628\u06cc\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"\u0647\u0646\u06af\u0627\u0645\u06cc \u06a9\u0647 \u0641\u0639\u0627\u0644 \u0628\u0627\u0634\u062f\u060c \u0628\u0627 \u0634\u0631\u0648\u0639 \u067e\u062e\u0634 \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u0635\u0641\u062d\u0647 \u062e\u0627\u0645\u0648\u0634 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f \u0648 \u0635\u0641\u062d\u0647 \u0632\u0646\u06af \u0647\u0634\u062f\u0627\u0631 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"\u0648\u0642\u062a\u06cc \u0641\u0639\u0627\u0644 \u0628\u0627\u0634\u062f\u060c \u0647\u0646\u06af\u0627\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0647\u062f\u0641\u0648\u0646\u060c \u062a\u0645\u0627\u0645 \u0635\u062f\u0627\u0647\u0627 \u0641\u0642\u0637 \u0631\u0648\u06cc \u0647\u062f\u0641\u0648\u0646 \u067e\u062e\u0634 \u0645\u06cc \u0634\u0648\u062f.\",\"Wifi\":\"Wifi\",\"Yes\":\"\u0628\u0644\u0647\",\"You are facing Kaaba\":\"\u0631\u0648 \u0628\u0647 \u0642\u0628\u0644\u0647 \u0647\u0633\u062a\u06cc\u062f\",\"You are not facing Kaaba\":\"\u0631\u0647 \u0628\u0647 \u0642\u0628\u0644\u0647 \u0646\u06cc\u0633\u062a\u06cc\u062f\",\"You can access your device Power Manager using the button below.\":\"\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062f\u06a9\u0645\u0647 \u0632\u06cc\u0631 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \\\"\u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0646\u0631\u0698\u06cc\\\" (Power Manager) \u062f\u0633\u062a\u06af\u0627\u0647 \u062e\u0648\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f.\",\"You can also paste coords from clipboard\":\"\u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u062e\u062a\u0635\u0627\u062a \u0631\u0627 \u0627\u0632 \u06a9\u0644\u06cc\u067e \u0628\u0648\u0631\u062f \u0628\u0686\u0633\u0628\u0627\u0646\u06cc\u062f\",\"You can change the language used for lunar calendar\":\"\u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0632\u0628\u0627\u0646 \u0645\u0648\u0631\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0628\u0631\u0627\u06cc \u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0632\u0645\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0627\u0639\u0644\u0627\u0646 \\\"\u0647\u0634\u062f\u0627\u0631 \u0628\u0639\u062f\u06cc\\\" \u0631\u0627 \u0642\u0628\u0644 \u0627\u0632 \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f\",\"You can choose to replace one of calendars with your current location\":\"\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06cc\u06a9\u06cc \u0627\u0632 \u062a\u0642\u0648\u06cc\u0645\u200c\u0647\u0627 \u0631\u0627 \u0628\u0627 \u0645\u06a9\u0627\u0646 \u0641\u0639\u0644\u06cc \u062e\u0648\u062f \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u06a9\u0646\u06cc\u062f\",\"You can hide prayer times you don't want to see in the main screen here:\":\"\u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc \u0631\u0627 \u06a9\u0647 \u0646\u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0631 \u0635\u0641\u062d\u0647 \u0627\u0635\u0644\u06cc \u0628\u0628\u06cc\u0646\u06cc\u062f \u067e\u0646\u0647\u0627\u0646 \u06a9\u0646\u06cc\u062f:\",\"You can hide prayer times you don't want to see in the widget here:\":\"\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0648\u0642\u0627\u062a \u0634\u0631\u0639\u06cc \u0631\u0627 \u06a9\u0647 \u0646\u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0631 \u0627\u0628\u0632\u0627\u0631\u06a9 \u0628\u0628\u06cc\u0646\u06cc\u062f \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u067e\u0646\u0647\u0627\u0646 \u06a9\u0646\u06cc\u062f:\",\"You can search for your location offline Or use GPS\":\"\u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u0622\u0641\u0644\u0627\u06cc\u0646 \u062c\u0633\u062a\u062c\u0648 \u06a9\u0646\u06cc\u062f \u06cc\u0627 \u0627\u0632 GPS \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"\u0634\u0645\u0627 \u0628\u0627\u06cc\u062f \u06cc\u06a9 \u0646\u0633\u062e\u0647 \u0627\u0632 \u0645\u062c\u0648\u0632 \u0639\u0645\u0648\u0645\u06cc GNU Affero \u0631\u0627 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc \u06a9\u0631\u062f\u06cc\u062f. \u0627\u06af\u0631 \u0646\u0647\u060c \u0628\u0647 https://www.gnu.org/licenses/ \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f.\",\"Your sounds\":\"\u0635\u062f\u0627\u0647\u0627\u06cc \u0634\u0645\u0627\",\"abdul_basit_abdus_samad\":\"\u0639\u0628\u062f \u0627\u0644\u0628\u0627\u0633\u0637 \u0639\u0628\u062f \u0627\u0644\u0635\u0645\u062f\",\"about.credits\":\"\u062a\u0645\u0627\u0645\u06cc \u062d\u0642\u0648\u0642 \u0635\u062f\u0627\u0647\u0627\u06cc \u0627\u0630\u0627\u0646 \u0645\u062a\u0639\u0644\u0642 \u0628\u0647 \u0635\u0627\u062d\u0628\u0627\u0646 \u0645\u0631\u0628\u0648\u0637\u0647 \u0645\u06cc \u0628\u0627\u0634\u062f.\\n\u062a\u0634\u06a9\u0631 \u0648\u06cc\u0698\u0647 \u0627\u0632 translation.io (lingui.js) \u0628\u0631\u0627\u06cc \u062e\u062f\u0645\u0627\u062a \u0641\u0648\u0642 \u0627\u0644\u0639\u0627\u062f\u0647 \u0622\u0646\u0647\u0627.\\n\u0645\u0645\u0646\u0648\u0646 \u0627\u0632 \u0647\u0645\u0647 \u0627\u0639\u0636\u0627\u06cc \u062c\u0627\u0645\u0639\u0647 \u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633 \u06a9\u0647 \u0647\u0645\u0647 \u0627\u06cc\u0646 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0647\u0627\u06cc \u0641\u0648\u0642 \u0627\u0644\u0639\u0627\u062f\u0647 \u0631\u0627 \u0627\u06cc\u062c\u0627\u062f \u06a9\u0631\u062f\u0646\u062f \u06a9\u0647 \u0633\u0627\u062e\u062a \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u0645\u0645\u06a9\u0646 \u06a9\u0631\u062f.\",\"about.credits.google\":\"\u0627\u06a9\u062b\u0631 \u0622\u06cc\u06a9\u0648\u0646 \u0647\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0634\u062f\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0632 \u0622\u06cc\u06a9\u0648\u0646 \u0647\u0627\u06cc \u0645\u062a\u0631\u06cc\u0627\u0644 \u06af\u0648\u06af\u0644 \u0647\u0633\u062a\u0646\u062f.\",\"about_settings\":\"\u062f\u0631\u0628\u0627\u0631\u0647\",\"adjustment.hint\":\"\u062a\u0639\u062f\u0627\u062f \u062f\u0642\u06cc\u0642\u0647 \u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0647 \u0632\u0645\u0627\u0646 \u0647\u0627\u06cc \u0645\u062d\u0627\u0633\u0628\u0647 \u0634\u062f\u0647 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc \u0634\u0648\u062f\",\"after\":\"\u0628\u0639\u062f \u0627\u0632\",\"ago\":\"\u067e\u06cc\u0634\",\"asr.prayer\":\"\u0639\u0635\u0631\",\"backup_settings\":\"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u06af\u06cc\u0631\u06cc\",\"before\":\"\u0642\u0628\u0644 \u0627\u0632\",\"calculation_adjustments_settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0632\u0645\u0627\u0646\",\"calculation_advanced_settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0645\u062d\u0627\u0633\u0628\u0647\",\"calculation_settings\":\"\u0645\u062d\u0627\u0633\u0628\u0647\",\"counter.fast\":\"\u0631\u0648\u0632\u0647\",\"date.day\":\"\u0631\u0648\u0632\",\"date.hour\":\"\u0633\u0627\u0639\u062a\",\"date.minute\":\"\u062f\u0642\u06cc\u0642\u0647\",\"date.second\":\"\u062b\u0627\u0646\u06cc\u0647\",\"dev_settings\":\"\u062a\u0648\u0633\u0639\u0647 \u062f\u0647\u0646\u062f\u0647\",\"dhuhr.prayer\":\"\u0638\u0647\u0631\",\"display_settings\":\"\u0646\u0645\u0627\u06cc\u0634\",\"fajr.prayer\":\"\u0641\u062c\u0631\",\"favorite_location\":\"\u0645\u06a9\u0627\u0646 \u0647\u0627\u06cc \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647\",\"forces all numbers to be in the selected system\":\"\u0647\u0645\u0647 \u0627\u0639\u062f\u0627\u062f \u0631\u0627 \u0645\u062c\u0628\u0648\u0631 \u0645\u06cc \u06a9\u0646\u062f \u06a9\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0628\u0627\u0634\u0646\u062f\",\"from North\":\"\u0627\u0632 \u0634\u0645\u0627\u0644\",\"from settings\":\"\u0627\u0632 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a\",\"fullscreen_alarm\":\"\u062f\u0631 \u062d\u0627\u0644 \u067e\u062e\u0634 \u0627\u0630\u0627\u0646\",\"hijri.adjustment.hint\":\"\u062a\u0639\u062f\u0627\u062f \u0631\u0648\u0632\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0647 \u062a\u0642\u0648\u06cc\u0645 \u0642\u0645\u0631\u06cc \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc \u0634\u0648\u062f\",\"home\":\"\u062e\u0627\u0646\u0647\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"\u0627\u06af\u0631 \u0641\u0639\u0627\u0644 \u0628\u0627\u0634\u062f\u060c \u06cc\u06a9 \u0627\u0639\u0644\u0627\u0646 \u062d\u062f\u0648\u062f \u06cc\u06a9 \u0633\u0627\u0639\u062a \u0642\u0628\u0644 \u0627\u0632 \u0647\u0631 \u0648\u0642\u062a \u0646\u0645\u0627\u0632 \u06cc\u0627 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u06a9\u0647 \u062f\u0627\u0631\u0627\u06cc \u0635\u062f\u0627 \u0628\u0627\u0634\u062f \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f\",\"intro\":\"\u0645\u0642\u062f\u0645\u0647\",\"is prayer time hidden?\":\"\u0622\u06cc\u0627 \u0648\u0642\u062a \u0646\u0645\u0627\u0632 \u067e\u0646\u0647\u0627\u0646 \u0627\u0633\u062a\u061f\",\"isha.prayer\":\"\u0639\u0634\u0627\u0621\",\"later\":\"\u0628\u0639\u062f\",\"location_settings\":\"\u0645\u0648\u0642\u0639\u06cc\u062a\",\"maghrib.prayer\":\"\u0645\u063a\u0631\u0628\",\"masjid_an_nabawi\":\"\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u06cc\",\"minutes\":\"\u062f\u0642\u06cc\u0642\u0647\",\"moazen_zade\":\"\u0645\u0648\u0630\u0646 \u0632\u0627\u062f\u0647\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"\u0646\u0645\u0627\u06cc\u0634 \u0645\u0627\u0647\u0627\u0646\u0647\",\"muezzin_settings\":\"\u0645\u0624\u0630\u0646\",\"notification_advanced_settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u067e\u06cc\u0634\u0631\u0641\u062a\u0647\",\"notification_settings\":\"\u0627\u0639\u0644\u0627\u0646 \u0648 \u0635\u062f\u0627\",\"qada_counter\":\"\u0634\u0645\u0627\u0631\u0646\u062f\u0647 \u0642\u0636\u0627\",\"qibla_compass\":\"\u0642\u0628\u0644\u0647 \u0646\u0645\u0627\",\"qibla_finder\":\"\u0642\u0628\u0644\u0647 \u06cc\u0627\u0628\",\"qibla_map\":\"\u0646\u0642\u0634\u0647 \u0642\u0628\u0644\u0647\",\"ragheb_mustafa_ghalwash\":\"\u0631\u0627\u063a\u0628 \u0645\u0635\u0637\u0641\u06cc \u063a\u0644\u0648\u0634\",\"reminders_settings\":\"\u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0647\u0627\",\"settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a\",\"should notification widget be shown?\":\"\u0622\u06cc\u0627 \u0627\u0628\u0632\u0627\u0631\u06a9 \u0627\u0639\u0644\u0627\u0646 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\u061f\",\"should {prayerName} be hidden?\":[\"\u0622\u06cc\u0627 \",[\"prayerName\"],\" \u0628\u0627\u06cc\u062f \u067e\u0646\u0647\u0627\u0646 \u0634\u0648\u062f\u061f\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"\u0627\u0632 \u0622\u0646\u062c\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0642\u0648\u06cc\u0645 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0632 \u0642\u0628\u0644 \u0645\u062d\u0627\u0633\u0628\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a \u0648 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0631\u0624\u06cc\u062a \u0645\u0627\u0647 \u0646\u06cc\u0633\u062a\u060c \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062a\u0627\u0631\u06cc\u062e \u0634\u0631\u0648\u0639 \u0648 \u067e\u0627\u06cc\u0627\u0646 \u0645\u0627\u0647 \u0631\u0645\u0636\u0627\u0646 \u0631\u0627 \u0646\u0627\u062f\u0631\u0633\u062a \u0646\u0634\u0627\u0646 \u062f\u0647\u062f.\",\"sunnah.midnight\":\"\u0646\u06cc\u0645\u0647 \u0634\u0628\",\"sunnah.tahajjud\":\"\u062a\u0647\u062c\u062f\",\"sunrise\":\"\u0637\u0644\u0648\u0639\",\"sunset\":\"\u063a\u0631\u0648\u0628\",\"widget_settings\":\"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0628\u0632\u0627\u0631\u06a9\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" \u062f\u0642\u06cc\u0642\u0647 \u0628\u0639\u062f \u0627\u0632 \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" \u062f\u0642\u06cc\u0642\u0647 \u0642\u0628\u0644 \u0627\u0632 \",[\"prayer\"]],\"{prayerName} notification will be shown\":[\"\u0627\u0639\u0644\u0627\u0646 \",[\"prayerName\"],\" \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f\"],\"{prayerName} sound will be played\":[\"\u0635\u062f\u0627\u06cc \",[\"prayerName\"],\" \u067e\u062e\u0634 \u062e\u0648\u0627\u0647\u062f \u0634\u062f\"]}")}),627,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 \u062f\u0642\u064a\u0642\u0629\",\"15 min\":\"15 \u062f\u0642\u064a\u0642\u0629\",\"30 min\":\"30 \u062f\u0642\u064a\u0642\u0629\",\"30 minutes is added to Isha time during Ramadan in this method\":\"\u064a\u062a\u0645 \u0625\u0636\u0627\u0641\u0629 30 \u062f\u0642\u064a\u0642\u0629 \u0625\u0644\u0649 \u0648\u0642\u062a \u0635\u0644\u0627\u0629 \u0627\u0644\u0639\u0634\u0627\u0621 \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u0631\u0645\u0636\u0627\u0646\",\"5 min\":\"5 \u062f\u0642\u064a\u0642\u0629\",\"60 min\":\"60 \u062f\u0642\u064a\u0642\u0629\",\"90 min\":\"90 \u062f\u0642\u064a\u0642\u0629\",\"ADHAN_CHANNEL_NAME\":\"\u0623\u0630\u0627\u0646\",\"Abyad\":\"\u0623\u0628\u064a\u0636\",\"Accuracy\":\"\u062f\u0642\u0629\",\"Ad-Free\":\"\u062e\u0627\u0644\u064d \u0645\u0646 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a\",\"Adaptive Charging\":\"\u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u062a\u0643\u064a\u0641\",\"Add\":\"\u0625\u0636\u0627\u0641\u0629\",\"Add Custom Adhan\":\"\u0625\u0636\u0627\u0641\u0629 \u0623\u0630\u0627\u0646 \u0645\u062e\u0635\u0635\",\"Add Custom Audio\":\"\u0625\u0636\u0627\u0641\u0629 \u0635\u0648\u062a \u0645\u062e\u0635\u0635\",\"Add Reminder\":\"\u0625\u0636\u0627\u0641\u0629 \u062a\u0630\u0643\u064a\u0631\",\"Add Silent Mode\":\"\u0625\u0636\u0627\u0641\u0629 \u0648\u0636\u0639 \u0635\u0627\u0645\u062a\",\"Add new counter\":\"\u0625\u0636\u0627\u0641\u0629 \u0639\u062f\u0627\u062f \u062c\u062f\u064a\u062f\",\"Add new location\":\"\u0623\u0636\u0641 \u0645\u0648\u0642\u0639\u064b\u0627 \u062c\u062f\u064a\u062f\u064b\u0627\",\"Adhan\":\"\u0623\u0630\u0627\u0646\",\"Adhan audio file is not downloaded yet\":\"\u0644\u0645 \u064a\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0645\u0644\u0641 \u0635\u0648\u062a \u0627\u0644\u0623\u0630\u0627\u0646 \u0628\u0639\u062f\",\"Adjustments\":\"\u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\",\"Advanced\":\"\u0645\u062a\u0642\u062f\u0645\",\"Advanced Calculation Settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629\",\"Advanced Settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062a\u0642\u062f\u0645\u0629\",\"Ahmer\":\"\u0623\u062d\u0645\u0631\",\"Al-Azan\":\"\u0627\u0644\u0623\u0630\u0627\u0646\",\"Al-Azan - Prayer Times\":\"\u0627\u0644\u0627\u0630\u0627\u0646 - \u0645\u0648\u0627\u0642\u064a\u062a \u0627\u0644\u0635\u0644\u0627\u0629\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"\u062a\u0645 \u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0623\u0630\u0627\u0646 \u0639\u0644\u0649 \u0623\u0645\u0644 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u0641\u064a\u062f\u064b\u0627\u060c \u0648\u0644\u0643\u0646 \u0628\u062f\u0648\u0646 \u0623\u064a \u0636\u0645\u0627\u0646\u061b \u0628\u062f\u0648\u0646 \u0623\u064a \u0636\u0645\u0627\u0646 \u0636\u0645\u0646\u064a \u0644\u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0623\u0648 \u0627\u0644\u0645\u0644\u0627\u0621\u0645\u0629 \u0644\u063a\u0631\u0636 \u0645\u0639\u064a\u0646. \u0631\u0627\u062c\u0639 \u0631\u062e\u0635\u0629 \u062c\u0646\u0648 \u0623\u0641\u064a\u0631\u0648 \u0627\u0644\u0639\u0645\u0648\u0645\u064a\u0629 \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"\u0627\u0644\u0623\u0630\u0627\u0646 \u0647\u0648 \u0628\u0631\u0646\u0627\u0645\u062c \u062d\u0631: \u064a\u0645\u0643\u0646\u0643 \u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0632\u064a\u0639\u0647 \u0648/\u0623\u0648 \u062a\u0639\u062f\u064a\u0644\u0647 \u0628\u0645\u0648\u062c\u0628 \u0634\u0631\u0648\u0637 \u0631\u062e\u0635\u0629 \u062c\u0646\u0648 \u0627\u0644\u0639\u0645\u0648\u0645\u064a\u0629 \u0623\u0641\u064a\u0631\u0648 (\u0627\u0644\u0625\u0635\u062f\u0627\u0631 3.0) \u0643\u0645\u0627 \u0646\u0634\u0631\u062a\u0647\u0627 \u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0627\u0644\u062d\u0631\u0629.\",\"Alarms Permission\":\"\u0625\u0630\u0646 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"\u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0644\u0644\u0623\u0630\u0627\u0646 \u064a\u062a\u0645 \u062a\u062e\u0632\u064a\u0646\u0647\u0627 \u0645\u062d\u0644\u064a\u064b\u0627 \u0641\u0642\u0637 \u0641\u064a \u062c\u0647\u0627\u0632\u0643. \u0644\u0627 \u064a\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0641\u064a \u0623\u064a \u0645\u0643\u0627\u0646. \u0644\u0627 \u064a\u0645\u062a\u0644\u0643 \u0645\u0637\u0648\u0631\u0648 \u0627\u0644\u0623\u0630\u0627\u0646 \u0648\u0635\u0648\u0644\u064b\u0627 \u0625\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0643. \u0644\u0627 \u064a\u062a\u0645 \u0645\u0634\u0627\u0631\u0643\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0645\u0639 \u0623\u064a \u062c\u0647\u0627\u062a \u062b\u0627\u0644\u062b\u0629. \u0644\u0627 \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0623\u0630\u0627\u0646 \u0623\u064a \u0645\u0643\u062a\u0628\u0627\u062a \u0625\u0639\u0644\u0627\u0646\u064a\u0629 \u0623\u0648 \u0623\u064a \u0631\u0645\u0632 \u0644\u062a\u062a\u0628\u0639 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u062b\u0627\u0644\u062b\u0629 (\u062a\u062d\u0644\u064a\u0644\u0627\u062a)\u060c \u0645\u062b\u0644 Google Analytics \u0623\u0648 Facebook SDK.\",\"An error occured while playing the current track\":\"\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0642\u0637\u0639 \u0627\u0644\u062d\u0627\u0644\u064a\",\"App features\":\"\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\",\"Arabic\":\"\u0639\u0631\u0628\u064a\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \\\"\",[\"0\"],\"\\\"\u061f\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \\\"\",[\"itemName\"],\"\\\"\u061f\"],\"Are you sure you want to delete this?\":\"\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0647\u0630\u0627\u061f\",\"Asr Calculation\":\"\u0637\u0631\u064a\u0642\u0629 \u062d\u0633\u0627\u0628 \u0623\u0630\u0627\u0646 \u0627\u0644\u0639\u0635\u0631\",\"At least one prayer time must be shown\":\"\u064a\u062c\u0628 \u0625\u0638\u0647\u0627\u0631 \u0648\u0642\u062a \u0635\u0644\u0627\u0629 \u0648\u0627\u062d\u062f \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\",\"Attention\":\"\u0627\u0646\u062a\u0628\u0627\u0647\",\"Auto (Default)\":\"\u062a\u0644\u0642\u0627\u0626\u064a (\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"\u062a\u062c\u0627\u0648\u0632 \u0648\u0636\u0639 \\\"\u0639\u062f\u0645 \u0627\u0644\u0625\u0632\u0639\u0627\u062c\\\"\u061f\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"\u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0630\u0627\u0646 \u064a\u062a\u0628\u0639 \u0637\u0631\u0642 \u0645\u062a\u0639\u062f\u062f\u0629 \u0648\u0645\u062e\u062a\u0644\u0641\u0629. \u062a\u0642\u062f\u0645 \u0643\u0644 \u0637\u0631\u064a\u0642\u0629 \u0646\u062a\u0627\u0626\u062c \u0645\u062e\u062a\u0644\u0641\u0629. \u0645\u0646 \u0645\u0633\u0624\u0648\u0644\u064a\u062a\u0643 \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629.\",\"Calculation\":\"\u062d\u0633\u0627\u0628\",\"Calculation Method\":\"\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\",\"Calendar\":\"\u0627\u0644\u062a\u0642\u0648\u064a\u0645\",\"Cancel\":\"\u0625\u0644\u063a\u0627\u0621\",\"Cancel Alarm\":\"\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0645\u0646\u0628\u0647\",\"Cancel download\":\"\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0646\u0632\u064a\u0644\",\"Choose Asr Calculation Madhab\":\"\u0627\u062e\u062a\u0631 \u0645\u0630\u0647\u0628 \u062d\u0633\u0627\u0628 \u0623\u0630\u0627\u0646 \u0627\u0644\u0639\u0635\u0631\",\"Choose Calculation Method\":\"\u0627\u062e\u062a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\",\"Choose High Latitude Setting\":\"\u0627\u062e\u062a\u0631 \u0625\u0639\u062f\u0627\u062f \u062e\u0637 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0627\u0644\u064a\",\"Choose Language\":\"\u0627\u062e\u062a\u0631 \u0627\u0644\u0644\u063a\u0629\",\"Choose Polar Resolution\":\"\u0627\u062e\u062a\u0631 \u062f\u0642\u0629 \u0627\u0644\u0623\u0642\u0637\u0627\u0628\",\"Choose Shafaq method\":\"\u0627\u062e\u062a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0634\u0641\u0642\",\"Choose calculation rounding method\":\"\u0627\u062e\u062a\u0631 \u0637\u0631\u064a\u0642\u0629 \u062a\u0642\u0631\u064a\u0628 \u0627\u0644\u062d\u0633\u0627\u0628\",\"Choose calendar type\":\"\u0627\u062e\u062a\u0631 \u0646\u0648\u0639 \u0627\u0644\u062a\u0642\u0648\u064a\u0645\",\"Choose lunar calendar language\":\"\u0627\u062e\u062a\u0631 \u0644\u063a\u0629 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a\",\"Choose midnight calculation method\":\"\u0627\u062e\u062a\u0631 \u0637\u0631\u064a\u0642\u0629 \u062d\u0633\u0627\u0628 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644\",\"Choose numbering system\":\"\u0627\u062e\u062a\u0631 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0631\u0642\u064a\u0645\",\"Choose which calendar to replace\":\"\u0627\u062e\u062a\u0631 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0630\u064a \u062a\u0631\u064a\u062f \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\",\"City/Area\":\"\u0645\u062f\u064a\u0646\u0629/\u0645\u0646\u0637\u0642\u0629\",\"Clear the coordinates\":\"\u0645\u0633\u062d \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\",\"Clear the location\":\"\u0645\u0633\u062d \u0627\u0644\u0645\u0648\u0642\u0639\",\"Clipboard data does not contain coordinates\":\"\u0644\u0627 \u062a\u062d\u062a\u0648\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\",\"Close\":\"\u0625\u063a\u0644\u0627\u0642\",\"Closest City\":\"\u0623\u0642\u0631\u0628 \u0645\u062f\u064a\u0646\u0629\",\"Closest Date\":\"\u0623\u0642\u0631\u0628 \u062a\u0627\u0631\u064a\u062e\",\"Compass Lock\":\"\u0642\u0641\u0644 \u0627\u0644\u0628\u0648\u0635\u0644\u0629\",\"Compass sensor unavailable\":\"\u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0628\u0648\u0635\u0644\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631\",\"Confirm\":\"\u062a\u0623\u0643\u064a\u062f\",\"Continuous\":\"\u0645\u0633\u062a\u0645\u0631\",\"Coordinates updated\":\"\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\",\"Copy\":\"\u0646\u0633\u062e\",\"Count\":\"\u0639\u062f\u062f\",\"Country\":\"\u062f\u0648\u0644\u0629\",\"Custom\":\"\u0645\u062e\u0635\u0635\",\"Custom sounds and muezzins will not be exported\":\"\u0644\u0646 \u064a\u062a\u0645 \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0623\u0635\u0648\u0627\u062a \u0648\u0627\u0644\u0645\u0624\u0630\u0646\u064a\u0646 \u0627\u0644\u0645\u062e\u0635\u0635\u0629\",\"Custom upcoming alarm time\":\"\u0648\u0642\u062a \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0645\u062e\u0635\u0635 \u0627\u0644\u0642\u0627\u062f\u0645\",\"Dark\":\"\u062f\u0627\u06a9\u0646\",\"Date\":\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"Decrement\":\"\u0625\u0646\u0642\u0627\u0635\",\"Default\":\"\u0627\u0641\u062a\u0631\u0627\u0636\u064a\",\"Delete\":\"\u0627\u062d\u0630\u0641\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"\u0627\u0639\u062a\u0645\u0627\u062f\u064b\u0627 \u0639\u0644\u0649 \u062c\u0647\u0627\u0632\u0643 \u0648\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0623\u0646\u062f\u0631\u0648\u06cc\u062f\u060c \u0642\u062f \u064a\u0642\u0648\u0645 \u062c\u0647\u0627\u0632\u0643 \u0623\u062d\u064a\u0627\u0646\u064b\u0627 \u0628\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0644\u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629. \u0647\u0630\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0645\u0646\u0639 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a.\",\"Deselect as Fajr Adhan\":\"\u0625\u0644\u063a\u0627\u0621 \u062a\u062d\u062f\u064a\u062f \u0643\u0623\u0630\u0627\u0646 \u0627\u0644\u0641\u062c\u0631\",\"Device sounds\":\"\u0623\u0635\u0648\u0627\u062a \u0627\u0644\u062c\u0647\u0627\u0632\",\"Disabled\":\"\u063a\u064a\u0631 \u0645\u0641\u0639\u0651\u0644\",\"Disclaimer\":\"\u062a\u0646\u0648\u064a\u0647\",\"Dismiss\":\"\u062a\u062c\u0627\u0647\u0644\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"\u0637\u0631\u064a\u0642\u0629 \\\"\u0627\u0644\u062f\u064a\u0627\u0646\u0629\\\" \u0627\u0644\u0645\u062a\u0648\u0641\u0631\u0629 \u0641\u064a \u0627\u0644\u0623\u0630\u0627\u0646\u060c \u062a\u0642\u0631\u064a\u0628\u064a\u0629 \u0644\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629. \u0646\u0638\u0631\u064b\u0627 \u0644\u0639\u062f\u0645 \u062a\u0648\u0641\u0631 \u0648\u062b\u0627\u0626\u0642 \u0643\u0627\u0641\u064a\u0629 \u062d\u0648\u0644 \u0643\u064a\u0641\u064a\u0629 \u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0628\u062f\u0642\u0629\u060c \u0641\u0642\u062f \u0644\u0627 \u062a\u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0645\u0639 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u062e\u0627\u0635\u0629 \u062e\u0627\u0631\u062c \u062a\u0631\u0643\u064a\u0627.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"\u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629\u060c \u062a\u0631\u0643\u064a\u0627\",\"Doesn't use any kind of trackers\":\"\u0644\u0627 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u064a \u0646\u0648\u0639 \u0645\u0646 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062a\u062a\u0628\u0639\",\"Don't ask again\":\"\u0644\u0627 \u062a\u0633\u0623\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649\",\"Don't show again\":\"\u0644\u0627 \u062a\u0638\u0647\u0631 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649\",\"Don't show alarm screen?\":\"\u0639\u062f\u0645 \u0639\u0631\u0636 \u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0646\u0628\u0647\u061f\",\"Done\":\"\u062a\u0645\",\"Download\":\"\u062a\u062d\u0645\u064a\u0644\",\"Eastern Arabic\":\"\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629\",\"Edit\":\"\u062a\u0639\u062f\u064a\u0644\",\"Edit Calculation Parameters\":\"\u062a\u062d\u0631\u064a\u0631 \u0645\u0639\u0644\u0645\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628\",\"Edit Counter\":\"\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0639\u062f\u0627\u062f\",\"Edit Location\":\"\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0648\u0642\u0639\",\"Edit Reminder\":\"\u062a\u062d\u0631\u064a\u0631 \u062a\u0630\u0643\u064a\u0631\",\"Edit Silent Mode\":\"\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"Egyptian General Survey Authority\":\"\u0627\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u0645\u0635\u0631\u064a\u0629 \u0644\u0644\u0645\u0633\u0627\u062d\u0629\",\"Enabled\":\"\u0645\u0641\u0639\u0651\u0644\",\"End after prayer (minutes)\":\"\u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0628\u0639\u062f \u0627\u0644\u0635\u0644\u0627\u0629 (\u062f\u0642\u0627\u0626\u0642)\",\"Error getting clipboard data\":\"\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0627\u0641\u0638\u0629\",\"Error in loading countries\":\"\u062e\u0637\u0623 \u0641\u064a \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062f\u0648\u0644\",\"Error while downloading audio\":\"\u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u0635\u0648\u062a\",\"Error while getting coordinates\":\"\u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\",\"Error: failed to open file\":\"\u062e\u0637\u0623: \u0641\u0634\u0644 \u0641\u064a \u0641\u062a\u062d \u0627\u0644\u0645\u0644\u0641\",\"Ethiopic\":\"\u0625\u062b\u064a\u0648\u0628\u064a\",\"Export app data\":\"\u062a\u0635\u062f\u064a\u0631 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\",\"Export data\":\"\u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\",\"Fajr Angle\":\"\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0641\u062c\u0631\",\"Find My Location\":\"\u0627\u0628\u062d\u062b \u0639\u0646 \u0645\u0648\u0642\u0639\u064a\",\"Fix Common Problems\":\"\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u0634\u0627\u0626\u0639\u0629\",\"France angle 15\":\"\u0641\u0631\u0646\u0633\u0627 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 15\",\"France angle 18\":\"\u0641\u0631\u0646\u0633\u0627 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 18\",\"Friday\":\"\u0627\u0644\u062c\u0645\u0639\u0629\",\"General (default)\":\"\u0639\u0627\u0645 (\u0627\u0641\u062a\u0631\u0627\u0636\u064a)\",\"Getting coordinates\":\"\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\",\"Got it\":\"\u0641\u0647\u0645\u062a\u0647\u0627\",\"Gregorian\":\"\u0645\u064a\u0644\u0627\u062f\u064a\",\"Gulf region\":\"\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062e\u0644\u064a\u062c\",\"Hanafi\":\"\u062d\u0646\u0641\u064a\",\"Hidden?\":\"\u0625\u062e\u0641\u0627\u0621\u061f\",\"Hide Prayer Times\":\"\u0625\u062e\u0641\u0627\u0621 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u0629\",\"Hide times you don't need\":\"\u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u062d\u062a\u0627\u062c\u0647\u0627\",\"High\":\"\u0639\u0627\u0644\u064a\",\"High Latitude\":\"\u062e\u0637 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0627\u0644\u064a\",\"Highlight current prayer\":\"\u062a\u0633\u0644\u064a\u0637 \u0627\u0644\u0636\u0648\u0621 \u0639\u0644\u0649 \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629\",\"Home\":\"\u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\",\"Homescreen and notification Widgets\":\"\u0627\u0644\u0645\u0635\u063a\u0631 \u0648 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"\u0648\u0645\u0639 \u0630\u0644\u0643\u060c \u0639\u0646\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\u060c \u0645\u062b\u0644 \u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0642\u0628\u0644\u0629\u060c \u0642\u062f \u064a\u0646\u0642\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0636\u0631\u0648\u0631\u064a\u0629 \u0627\u0644\u062a\u064a \u0642\u062f \u062a\u062d\u062f\u062f \u0623\u0648 \u0644\u0627 \u062a\u062d\u062f\u062f \u0647\u0648\u064a\u062a\u0643 \u0628\u0634\u0643\u0644 \u0641\u0631\u064a\u062f. \u064a\u0631\u062c\u0649 \u0648\u0636\u0639 \u0630\u0644\u0643 \u0641\u064a \u0627\u0644\u0627\u0639\u062a\u0628\u0627\u0631 \u0623\u062b\u0646\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\",\"I Understand\":\"\u0623\u0641\u0647\u0645\",\"IMPORTANT_CHANNEL_ID\":\"\u0645\u0647\u0645\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"\u0625\u0630\u0627 \u062a\u0645 \u062a\u0645\u0643\u064a\u0646\u0647\u060c \u0639\u0646\u062f \u0639\u0631\u0636 \u0625\u0634\u0639\u0627\u0631\u060c \u0633\u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0644\u0648\u0642\u062a \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"\u0625\u0630\u0627 \u0642\u0645\u062a \u0628\u062a\u0641\u0639\u064a\u0644 \\\"\u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646\\\" \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0647\u0627\u062a\u0641\u0643 (\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a / \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646 / \u0646\u0633\u062e \u0628\u064a\u0627\u0646\u0627\u062a\u064a \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u064b\u0627)\u060c \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0639\u0644\u0649 \u0639\u0644\u0645 \u0628\u0623\u0646 \u0646\u0638\u0627\u0645 Android \u0646\u0641\u0633\u0647 (\u0648\u0644\u064a\u0633 \u0627\u0644\u0623\u0630\u0627\u0646) \u0633\u064a\u062d\u0641\u0638 \u0646\u0633\u062e\u0629 \u0645\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u0647\u0627\u062a\u0641\u0643 \u0641\u064a \u062e\u0648\u0627\u062f\u0645 Google. \u064a\u0633\u0645\u062d \u0647\u0630\u0627 \u0644\u0646\u0638\u0627\u0645 Android \u0628\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0641\u064a \u062d\u0627\u0644\u0629 \u062a\u0644\u0641 \u062c\u0647\u0627\u0632\u0643 \u0623\u0648 \u0634\u0631\u0627\u0621 \u062c\u0647\u0627\u0632 \u062c\u062f\u064a\u062f. \u0644\u0627 \u064a\u0645\u0644\u0643 \u0645\u0637\u0648\u0631\u0648 \u0627\u0644\u0623\u0630\u0627\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"\u0625\u0630\u0627 \u0643\u0646\u062a \u0644\u0627 \u062a\u0632\u0627\u0644 \u062a\u0648\u0627\u062c\u0647 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u062a\u0648\u0642\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0639\u062f \u0645\u0631\u0648\u0631 \u0628\u0639\u0636 \u0627\u0644\u0648\u0642\u062a\u060c \u0641\u064a\u0631\u062c\u0649 \u0632\u064a\u0627\u0631\u0629 dontkillmyapp.com \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062d\u0644\u0648\u0644.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0639\u0645\u0644 \u0628\u0634\u0643\u0644 \u0645\u0648\u062b\u0648\u0642\u060c \u0641\u0639\u0644\u064a\u0643 \u062a\u0639\u0637\u064a\u0644 \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0637\u0627\u0642\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u064a\u0645\u0643\u0646\u0643 \u0641\u062a\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u0635\u0644\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0632\u0631 \u0623\u062f\u0646\u0627\u0647.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"\u0625\u0630\u0627 \u0643\u0627\u0646 \u062c\u0647\u0627\u0632\u0643 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0634\u062d\u0646 \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0643\u064a\u0641\u060c \u0645\u062b\u0644 Google Pixel\u060c \u0648\u0644\u0627 \u062a\u0631\u064a\u062f \u0623\u0646 \u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0630\u0627\u0646 \u0623\u0648 \u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0639\u0644\u0649 \u0623\u0646\u0647\u0627 \u0625\u0646\u0630\u0627\u0631\u060c \u0641\u064a\u0645\u0643\u0646\u0643 \u062a\u0645\u0643\u064a\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631.\",\"Import\":\"\u0627\u0633\u062a\u064a\u0631\u0627\u062f\",\"Import app data\":\"\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\",\"Import successful\":\"\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0628\u0646\u062c\u0627\u062d\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0635\u0644\u0648\u0627\u062a \u0627\u0644\u062e\u0645\u0633 \u0627\u0644\u064a\u0648\u0645\u064a\u0629\u060c \u064a\u0648\u062c\u062f \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u0644\u0634\u0631\u0648\u0642 \u0648\u0627\u0644\u063a\u0631\u0648\u0628 \u0648\u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644 \u0648\u0635\u0644\u0627\u0629 \u0627\u0644\u0644\u064a\u0644 (\u0627\u0644\u062a\u0647\u062c\u062f)\",\"Increment\":\"\u0632\u064a\u0627\u062f\u0629\",\"Info\":\"\u0645\u0639\u0644\u0648\u0645\u0627\u062a\",\"Internet connection\":\"\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0636\u0631\u0648\u0631\u064a \u0644\u0639\u0645\u0644 \u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0642\u0628\u0644\u0629. \u064a\u0631\u062c\u0649 \u062a\u0645\u0643\u064a\u0646 wifi \u0623\u0648 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062c\u0648\u0627\u0644 \u0648\u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.\",\"Iran\":\"\u0625\u064a\u0631\u0627\u0646\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0645\u062a\u0631\u062c\u0645 \u0625\u0644\u0649 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629\u060c \u0627\u0644\u0641\u0627\u0631\u0633\u064a\u0629\u060c \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0627\u0644\u062a\u0631\u0643\u064a\u0629\u060c \u0627\u0644\u0625\u0646\u062f\u0648\u0646\u064a\u0633\u064a\u0629\u060c \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629\u060c \u0627\u0644\u0623\u0631\u062f\u064a\u0629\u060c \u0627\u0644\u0647\u0646\u062f\u064a\u0629\u060c \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629\u060c \u0627\u0644\u0628\u0648\u0633\u0646\u064a\u0629\u060c \u0627\u0644\u0641\u064a\u062a\u0646\u0627\u0645\u064a\u0629\u060c \u0627\u0644\u0628\u0646\u063a\u0627\u0644\u064a\u0629\",\"Isha Angle\":\"\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0639\u0634\u0627\u0621\",\"Isha Interval\":\"\u062a\u0627\u062e\u06cc\u0631 \u0627\u0644\u0639\u0634\u0627\u0621\",\"Islamic\":\"\u0625\u0633\u0644\u0627\u0645\u064a\",\"Islamic (Saudi Arabia sighting)\":\"\u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a (\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629)\",\"Islamic (Umm al-Qura)\":\"\u0625\u0633\u0644\u0627\u0645\u064a (\u0623\u0645 \u0627\u0644\u0642\u0631\u0649)\",\"Islamic (civil)\":\"\u0625\u0633\u0644\u0627\u0645\u064a (\u0645\u062f\u0646\u064a)\",\"Islamic (tabular)\":\"\u0625\u0633\u0644\u0627\u0645\u064a (\u062c\u062f\u0648\u0644\u064a)\",\"Islamic Society of North America (ISNA)\":\"\u0627\u0644\u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0644\u0623\u0645\u0631\u064a\u0643\u0627 \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629 (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"\u064a\u0628\u062f\u0648 \u0623\u0646\u0643 \u0642\u0645\u062a \u0628\u0625\u0633\u062a\u064a\u0631\u0627\u062f \u0646\u0633\u062e\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629\u060c \u0644\u0627 \u062a\u0646\u0633\u0649 \u062a\u0639\u0637\u064a\u0644 \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\",\"Just now\":\"\u0627\u0644\u0622\u0646\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629 \u0644\u062c\u0645\u0647\u0648\u0631\u064a\u0629 \u0625\u0646\u062f\u0648\u0646\u064a\u0633\u064a\u0627\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629 (\u0628\u0631\u0648\u0646\u0627\u064a \u062f\u0627\u0631 \u0627\u0644\u0633\u0644\u0627\u0645)\",\"Kuwait\":\"\u0627\u0644\u0643\u0648\u064a\u062a\",\"Label\":\"\u062a\u0633\u0645\u064a\u0629\",\"Language\":\"\u0644\u063a\u0629\",\"Latitude\":\"\u062e\u0637 \u0627\u0644\u0639\u0631\u0636\",\"Latitude is invalid\":\"\u062e\u0637 \u0627\u0644\u0639\u0631\u0636 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\",\"License\":\"\u0631\u062e\u0635\u0629\",\"Light\":\"\u0641\u0627\u062a\u062d\",\"Light and Dark theme\":\"\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0641\u0627\u062a\u062d \u0648\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u062f\u0627\u0643\u0646\",\"Light/Dark theme\":\"\u0648\u0636\u0639 \u0627\u0644\u0646\u0645\u0637 \u0627\u0644\u0641\u0627\u062a\u062d/\u0627\u0644\u0646\u0645\u0637 \u0627\u0644\u062f\u0627\u0643\u0646\",\"List is empty\":\"\u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0641\u0627\u0631\u063a\u0629\",\"Loading\":\"\u062c\u0627\u0631\u064a \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\",\"Location\":\"\u0645\u0648\u0642\u0639\",\"Location settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639\",\"Longitude\":\"\u062e\u0637 \u0627\u0644\u0637\u0648\u0644\",\"Longitude is invalid\":\"\u062e\u0637 \u0627\u0644\u0637\u0648\u0644 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\",\"Low\":\"\u0642\u0644\u064a\u0644\",\"Lunar Calendar\":\"\u062a\u0642\u0648\u064a\u0645 \u0642\u0645\u0631\u064a\",\"Lunar Calendar Language\":\"\u0644\u063a\u0629 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a\",\"Maghrib Angle\":\"\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0645\u063a\u0631\u0628\",\"Make a Copy\":\"\u0623\u0646\u0634\u0626 \u0646\u0633\u062e\u0629\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"\u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0630\u0627\u0646\",\"Medium\":\"\u0645\u062a\u0648\u0633\u0637\",\"Middle of the Night\":\"\u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644\",\"Midnight Method\":\"\u0637\u0631\u064a\u0642\u0629 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629 \u0648\u0627\u0644\u0623\u0648\u0642\u0627\u0641 (\u0627\u0644\u062c\u0632\u0627\u0626\u0631)\",\"Ministry of Religious Affairs of Tunisia\":\"\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629 \u0627\u0644\u062a\u0648\u0646\u0633\u064a\u0629\",\"Mobile Data\":\"\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062c\u0648\u0627\u0644\",\"Modified\":\"\u0645\u0639\u062f\u0644\",\"Monday\":\"\u0627\u0644\u0625\u062b\u0646\u064a\u0646\",\"Moonsighting Committee\":\"\u0644\u062c\u0646\u0629 \u0631\u0624\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644\",\"Muslim World League\":\"\u0631\u0627\u0628\u0637\u0629 \u0627\u0644\u0639\u0627\u0644\u0645 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\",\"Name\":\"\u0627\u0633\u0645\",\"Nearest\":\"\u0627\u0644\u0623\u0642\u0631\u0628\",\"New Counter\":\"\u0639\u062f\u0627\u062f \u062c\u062f\u064a\u062f\",\"New Location\":\"\u0625\u0636\u0627\u0641\u0629 \u0645\u0648\u0642\u0639 \u062c\u062f\u064a\u062f\",\"New Reminder\":\"\u062a\u0630\u0643\u064a\u0631 \u062c\u062f\u064a\u062f\",\"New Silent Mode\":\"\u0648\u0636\u0639 \u0635\u0627\u0645\u062a \u062c\u062f\u064a\u062f\",\"Next\":\"\u0627\u0644\u062a\u0627\u0644\u064a\",\"Next Day\":\"\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062a\u0627\u0644\u064a\",\"Next Month\":\"\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0642\u0627\u062f\u0645\",\"No\":\"\u0644\u0627\",\"No Data\":\"\u0644\u0627\u064a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a\",\"No Results\":\"\u0644\u0627 \u064a\u0648\u062c\u062f \u0646\u062a\u0627\u0626\u062c\",\"None\":\"\u0644\u0627 \u0634\u064a\u0621\",\"None (Automatic)\":\"\u0644\u0627 \u0634\u064a\u0621 (\u062a\u0644\u0642\u0627\u0626\u064a)\",\"Normal mode restored\":\"\u062a\u0645 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0639\u0627\u062f\u064a\",\"Not now\":\"\u0644\u064a\u0633 \u0627\u0644\u0627\u0646\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"\u064a\u064f\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0647 \u0646\u0638\u0631\u064b\u0627 \u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0648\u0627\u0644\u0623\u062c\u0647\u0632\u0629\u060c \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0627\u062a\u062c\u0627\u0647 \u0627\u0644\u0642\u0628\u0644\u0629 \u0627\u0644\u0630\u064a \u064a\u0639\u0631\u0636\u0647 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0628\u062e\u0627\u0635\u0629 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u0628\u0648\u0635\u0644\u0629\u060c \u063a\u064a\u0631 \u0635\u062d\u064a\u062d.\",\"Notification\":\"\u0625\u0634\u0639\u0627\u0631\",\"Notification & Sound\":\"\u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648 \u0627\u0644\u0635\u0648\u062a\",\"Notifications Permission\":\"\u0625\u0630\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\",\"Numbering system\":\"\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0631\u0642\u064a\u0645\",\"Off\":\"\u063a\u064a\u0631 \u0645\u0641\u0639\u0651\u0644\",\"Okay\":\"\u0645\u0648\u0627\u0641\u0642\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"\u0639\u0644\u0649 \u0623\u0646\u062f\u0631\u0648\u064a\u062f 12 \u0648\u0627\u0644\u0623\u062d\u062f\u062b\u060c \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u064a\u0636\u064b\u0627 \u0625\u0644\u0649 \u0625\u0630\u0646 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0644\u0644\u0639\u0645\u0644 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d\u060c \u0644\u0630\u0627 \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0627\u0644\u0633\u0645\u0627\u062d \u0628\u0647\u0630\u0627 \u0623\u064a\u0636\u064b\u0627.\",\"Once\":\"\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\",\"One-Seventh of the Night\":\"\u0633\u0628\u0639 \u0627\u0644\u0644\u064a\u0644\",\"Only once?\":\"\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637\u061f\",\"Only six items can be shown at the same time\":\"\u064a\u0645\u0643\u0646 \u0639\u0631\u0636 \u0633\u062a\u0629 \u0639\u0646\u0627\u0635\u0631 \u0641\u0642\u0637 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a\",\"Open Battery Optimization Settings\":\"\u0627\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629\",\"Open Power Manager Settings\":\"\u0627\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062f\u064a\u0631 \u0627\u0644\u0637\u0627\u0642\u0629\",\"Open source repository\":\"\u0645\u0633\u062a\u0648\u062f\u0639 \u0645\u0641\u062a\u0648\u062d \u0627\u0644\u0645\u0635\u062f\u0631\",\"Open-source\":\"\u0645\u0641\u062a\u0648\u062d \u0627\u0644\u0645\u0635\u062f\u0631\",\"Options\":\"\u062e\u064a\u0627\u0631\u0627\u062a\",\"Or if you have a backup, you can import it\":\"\u0623\u0648 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0646\u0633\u062e\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629\u060c \u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u064a\u0631\u0627\u062f\u0647\u0627\",\"Orientation Lock: Landscape\":\"\u0642\u0641\u0644 \u0627\u0644\u0627\u062a\u062c\u0627\u0647: \u0623\u0641\u0642\u064a\",\"Orientation Lock: Portrait\":\"\u0642\u0641\u0644 \u0627\u0644\u0627\u062a\u062c\u0627\u0647: \u0639\u0645\u0648\u062f\u064a\",\"Orientation: Unlocked\":\"\u0627\u0644\u0627\u062a\u062c\u0627\u0647: \u0645\u0641\u062a\u0648\u062d\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"\u0642\u062f \u064a\u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u063a\u0646\u0627\u0637\u064a\u0633\u064a\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0645\u0639 \u0628\u0648\u0635\u0644\u0629 \u0647\u0627\u062a\u0641\u0643 \u0648\u0642\u062f \u062a\u062d\u062a\u0627\u062c \u0628\u0648\u0635\u0644\u062a\u0643 \u0625\u0644\u0649 \u0645\u0639\u0627\u064a\u0631\u0629.\",\"PRAYER_MODE_CHANNEL_NAME\":\"\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"PRE_ADHAN_CHANNEL_NAME\":\"\u0627\u0644\u0622\u0630\u0627\u0646 \u0627\u0644\u0642\u0627\u062f\u0645\",\"PRE_REMINDER_CHANNEL_NAME\":\"\u0627\u0644\u062a\u0630\u0643\u064a\u0631 \u0627\u0644\u0642\u0627\u062f\u0645\",\"Pakistan\":\"\u0628\u0627\u0643\u0633\u062a\u0627\u0646\",\"Paste\":\"\u0644\u0635\u0642\",\"Persian\":\"\u0627\u0644\u0641\u0627\u0631\u0633\u064a\u0629\",\"Phone State Permission\":\"\u0625\u0630\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0647\u0627\u062a\u0641\",\"Play\":\"\u062a\u0634\u063a\u064a\u0644\",\"Please enable location service\":\"\u064a\u064f\u0631\u062c\u0649 \u062a\u0645\u0643\u064a\u0646 \u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0648\u0642\u0639\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"\u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646 \u062a\u0645\u0643\u064a\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0642\u062f \u064a\u062a\u0633\u0628\u0628 \u0641\u064a \u062a\u0623\u062e\u064a\u0631 \u0623\u0648 \u0639\u062f\u0645 \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0623\u0630\u0627\u0646 \u0648\u0627\u0644\u062a\u0630\u0643\u064a\u0631 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a. \u064a\u0631\u062c\u0649 \u062a\u0641\u0639\u064a\u0644\u0647 \u0628\u062d\u0630\u0631.\",\"Polar Resolution\":\"\u062f\u0642\u0629 \u0627\u0644\u0623\u0642\u0637\u0627\u0628\",\"Power Manager\":\"\u0645\u062f\u064a\u0631 \u0627\u0644\u0637\u0627\u0642\u0629\",\"Prayer\":\"\u0627\u0644\u0635\u0644\u0627\u0629\",\"Prayer Times\":\"\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u0629\",\"Prayer list\":\"\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0635\u0644\u0627\u0629\",\"Press to search\":\"\u0627\u0636\u063a\u0637 \u0644\u0644\u0628\u062d\u062b\",\"Press to select a method\":\"\u0627\u0636\u063a\u0637 \u0644\u062a\u062d\u062f\u064a\u062f \u0637\u0631\u064a\u0642\u0629\",\"Prev Day\":\"\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\",\"Prev Month\":\"\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642\",\"Privacy Policy\":\"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0623\u0630\u0627\u0646 \u0648\u0627\u0644\u0642\u0628\u0644\u0629 \u0648\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u062d\u062a\u0631\u0645 \u0644\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u0627\u0644\u0645\u0641\u062a\u0648\u062d \u0627\u0644\u0645\u0635\u062f\u0631\",\"Qada counter\":\"\u0639\u062f\u0627\u062f \u0627\u0644\u0642\u0636\u0627\u0621\",\"Qatar\":\"\u062f\u0648\u0644\u0629 \u0642\u0637\u0631\",\"Qibla\":\"\u0627\u0644\u0642\u0628\u0644\u0629\",\"Qibla finder\":\"\u0645\u064f\u062d\u062f\u062f \u0627\u0644\u0642\u0628\u0644\u0629\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"\u064a\u062d\u062a\u0627\u062c \u0645\u064f\u062d\u062f\u062f \u0627\u0644\u0642\u0628\u0644\u0629 \u0625\u0644\u0649 \u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0648\u0642\u0639. \u0625\u0630\u0627 \u0644\u0645 \u064a\u062a\u0645 \u062a\u0645\u0643\u064a\u0646\u0647\u0627\u060c \u0633\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u062d\u062f\u062f \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0642\u0628\u0644\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631\u0629 \u062d\u0627\u0644\u064a\u064b\u0627 \u0641\u064a \u0646\u0633\u062e F-Droid. \u0642\u062f \u062a\u0635\u0628\u062d \u0645\u062a\u0627\u062d\u0629 \u0641\u064a \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0645\u0633\u062a\u0642\u0628\u0644\u064a\u0629.\",\"REMINDER_CHANNEL_NAME\":\"\u062a\u0630\u0643\u064a\u0631\",\"Ramadan is ending,\":\"\u0634\u0647\u0631 \u0631\u0645\u0636\u0627\u0646 \u064a\u0646\u062a\u0647\u064a\u060c\",\"Ramadan is near,\":\"\u0634\u0647\u0631 \u0631\u0645\u0636\u0627\u0646 \u0642\u0631\u064a\u0628\u060c\",\"Remaining till\":\"\u0627\u0644\u0645\u062a\u0628\u0642\u064a \u062d\u062a\u0649\",\"Remind me next year\":\"\u0630\u0643\u0631\u0646\u064a \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0645\u0642\u0628\u0644\",\"Reminder\":\"\u062a\u0630\u0643\u064a\u0631\",\"Repeat\":\"\u064a\u0643\u0631\u0631\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0637\u0644\u0648\u0628\u0629 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629. \u0644\u0643\u064a \u064a\u062a\u0645\u0643\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646 \u0639\u0631\u0636 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u062a\u0647\u064a\u0626\u062a\u0647\u0627 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u0627\u062d\u0642\u064b\u0627.\",\"Rounding Method\":\"\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"\u062a\u062d\u062a\u0648\u064a \u0623\u062c\u0647\u0632\u0629 Samsung \u0639\u0644\u0649 \u0645\u062f\u064a\u0631 \u0637\u0627\u0642\u0629 \u0645\u062e\u0635\u0635 \u064a\u0633\u0645\u0649 \u201cDevice Care\u201d. \u0628\u0639\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0632\u0631 \u0623\u062f\u0646\u0627\u0647\u060c \u0633\u062a\u062a\u0645 \u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u062c\u064a\u0647\u0643 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0641\u064a Device Care. \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u201c\u0625\u062f\u0627\u0631\u0629 \u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u201d\u060c \u062b\u0645 \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u201c\u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u0646 \u062a\u062f\u062e\u0644 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u0633\u0643\u0648\u0646\u201d\u060c \u0648\u0623\u0636\u0641 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0625\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629.\",\"Saturday\":\"\u0627\u0644\u0633\u0628\u062a\",\"Saudi Arabia\":\"\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\",\"Search\":\"\u0628\u062d\u062b\",\"Secondary Calendar\":\"\u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u062b\u0627\u0646\u0648\u064a\",\"See favorite locations\":\"\u0634\u0627\u0647\u062f \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0645\u0641\u0636\u0644\u0629\",\"Select as Fajr Adhan\":\"\u0627\u062e\u062a\u0631 \u0623\u0630\u0627\u0646 \u0627\u0644\u0641\u062c\u0631\",\"Select different Adhan audio for Fajr namaz\":\"\u0627\u062e\u062a\u0631 \u0635\u0648\u062a \u0623\u0630\u0627\u0646 \u0645\u062e\u062a\u0644\u0641 \u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u0641\u062c\u0631\",\"Selected\":\"\u0645\u062d\u062f\u062f\",\"Selected as adhan\":\"\u062a\u0645 \u062a\u062d\u062f\u064a\u062f\u0647 \u0643\u0622\u0630\u0627\u0646\",\"Selected as fajr adhan\":\"\u062a\u0645 \u0627\u062e\u062a\u064a\u0627\u0631\u0647 \u0643\u0623\u0630\u0627\u0646 \u0627\u0644\u0641\u062c\u0631\",\"Selecting a name is required\":\"\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0627\u0633\u0645 \u0645\u0637\u0644\u0648\u0628\",\"Set custom Adhan audio\":\"\u062a\u0639\u064a\u064a\u0646 \u0635\u0648\u062a \u0623\u0630\u0627\u0646 \u0645\u062e\u0635\u0635\",\"Set reminders before or after a prayer time\":\"\u0627\u0636\u0628\u0637 \u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0642\u0628\u0644 \u0623\u0648 \u0628\u0639\u062f \u0648\u0642\u062a \u0627\u0644\u0635\u0644\u0627\u0629\",\"Shafaq\":\"\u0634\u0641\u0642\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0634\u0641\u0642 \u0628\u0648\u0627\u0633\u0637\u0629 \u0637\u0631\u064a\u0642\u0629 \\\"\u0644\u062c\u0646\u0629 \u0631\u0624\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644\\\" \u0644\u062a\u062d\u062f\u064a\u062f \u0646\u0648\u0639 \u0627\u0644\u0634\u0641\u0642 \u0627\u0644\u0630\u064a \u064a\u062c\u0628 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u0644\u062a\u062d\u062f\u064a\u062f \u0648\u0642\u062a \u0627\u0644\u0639\u0634\u0627\u0621.\",\"Shafi, Maliki, Hanbali (Default)\":\"\u0634\u0627\u0641\u0639\u064a \u060c \u0645\u0627\u0644\u0643\u064a \u060c \u062d\u0646\u0628\u0644\u064a (\u0627\u0641\u062a\u0631\u0627\u0636\u064a)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u0627\u0644\u0634\u064a\u0639\u0629 \u0627\u0644\u0625\u062b\u0646\u0627 \u0639\u0634\u0631\u064a\u0629\u060c \u0645\u0639\u0647\u062f \u0644\u064a\u0641\u0627\u060c \u0642\u0645\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u0627\u0644\u0634\u064a\u0639\u0629\u060c \u0645\u0639\u0647\u062f \u0627\u0644\u062c\u064a\u0648\u0641\u064a\u0632\u064a\u0627\u0621\u060c \u062c\u0627\u0645\u0639\u0629 \u0637\u0647\u0631\u0627\u0646\",\"Should app highlight current prayer instead of next prayer?\":\"\u0647\u0644 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u0631\u0632 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u061f\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\u0647\u0644 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0633\u062a\u0645\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0630\u0627\u0646 \u0639\u0646\u062f\u0645\u0627 \u064a\u0643\u0648\u0646 \u0648\u0636\u0639 \\\"\u0639\u062f\u0645 \u0627\u0644\u0625\u0632\u0639\u0627\u062c\\\" \u0646\u0634\u0637\u064b\u0627\u061f\",\"Should app stop playing adhan when the volume button is pressed?\":\"\u0647\u0644 \u064a\u062c\u0628 \u0623\u0646 \u064a\u062a\u0648\u0642\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0646 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0630\u0627\u0646 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0635\u0648\u062a\u061f\",\"Should phone vibrate when adhan or reminder starts playing?\":\"\u0647\u0644 \u064a\u0647\u062a\u0632 \u0627\u0644\u0647\u0627\u062a\u0641 \u0639\u0646\u062f\u0645\u0627 \u064a\u0628\u062f\u0623 \u0627\u0644\u0623\u0630\u0627\u0646 \u0623\u0648 \u0627\u0644\u062a\u0630\u0643\u064a\u0631\u061f\",\"Show Adhan Options\":\"\u0625\u0638\u0647\u0627\u0631 \u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0623\u0630\u0627\u0646\",\"Show Today\":\"\u0639\u0631\u0636 \u0627\u0644\u064a\u0648\u0645\",\"Show countdown?\":\"\u0639\u0631\u0636 \u0627\u0644\u0639\u062f \u0627\u0644\u062a\u0646\u0627\u0632\u0644\u064a\u061f\",\"Show current\":\"\u0639\u0631\u0636 \u0627\u0644\u062d\u0627\u0644\u064a\",\"Show me\":\"\u0639\u0631\u0636\",\"Show next in notification?\":\"\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0623\u0630\u0627\u0646 \u0627\u0644\u062a\u0627\u0644\u064a \u0641\u064a \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u061f\",\"Show notification widget?\":\"\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u063a\u0651\u0631 \u0641\u064a \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\u061f\",\"Show settings\":\"\u0627\u0639\u0631\u0636 \u0625\u0639\u062f\u0627\u062f\u0627\u062a\",\"Show upcoming alarm notification?\":\"\u0625\u0638\u0647\u0627\u0631 \u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0642\u0627\u062f\u0645\u061f\",\"Silent\":\"\u0635\u0627\u0645\u062a\",\"Silent Mode Ended\":\"\u062a\u0645 \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"Silent Mode Name\":\"\u0627\u0633\u0645 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"Silent Mode Started\":\"\u062a\u0645 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"Silent mode activated\":\"\u062a\u0645 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"\u0646\u0638\u0631\u064b\u0627 \u0644\u0623\u0646\u0646\u0627 \u0644\u0627 \u0646\u0633\u062a\u062e\u062f\u0645 \u0623\u064a \u0646\u0648\u0639 \u0645\u0646 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u062a\u0639\u0642\u0628 \u0623\u0648 \u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0627\u0644\u0623\u0639\u0637\u0627\u0644\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0623\u064a \u0645\u0634\u0643\u0644\u0629 \u0623\u0648  \u0627\u0642\u062a\u0631\u0627\u062d \u0644\u062f\u064a\u0643 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u062f\u0639 github \u0627\u0644\u062e\u0627\u0635 \u0628\u0646\u0627\",\"Singapore\":\"\u0633\u0646\u063a\u0627\u0641\u0648\u0631\u0629\",\"Skip\":\"\u062a\u062e\u0637\u0649\",\"Software License\":\"\u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c\",\"Solar Hijri\":\"\u0647\u062c\u0631\u064a \u0634\u0645\u0633\u064a\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"\u0628\u0639\u0636 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u062f\u0627\u062e\u0644 \u0645\u062f\u064a\u0631 \u0627\u0644\u0637\u0627\u0642\u0629 \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646 \u0627\u0644\u0625\u063a\u0644\u0627\u0642 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629. \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062d\u0627\u0644\u0629 \u060c \u0642\u0645 \u0628\u062a\u0639\u0637\u064a\u0644 \u0623\u064a \u062e\u064a\u0627\u0631 \u0644\u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0637\u0627\u0642\u0629 \u0644\u0644\u062a\u0637\u0628\u064a\u0642\",\"Sound\":\"\u0635\u0648\u062a\",\"Spiritual Administration of Muslims of Russia\":\"\u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0631\u0648\u062d\u064a\u0629 \u0644\u0645\u0633\u0644\u0645\u064a \u0631\u0648\u0633\u064a\u0627\",\"Start before prayer (minutes)\":\"\u0627\u0644\u0628\u062f\u0621 \u0642\u0628\u0644 \u0627\u0644\u0635\u0644\u0627\u0629 (\u062f\u0642\u0627\u0626\u0642)\",\"Status\":\"\u062d\u0627\u0644\u0629\",\"Stop\":\"\u0642\u0641\",\"Sunday\":\"\u0627\u0644\u0623\u062d\u062f\",\"Sunset to Fajr (Default)\":\"\u0645\u0646 \u063a\u0631\u0648\u0628 \u0627\u0644\u0634\u0645\u0633 \u0625\u0644\u0649 \u0627\u0644\u0641\u062c\u0631 (\u0627\u0641\u062a\u0631\u0627\u0636\u064a)\",\"Sunset to Sunrise\":\"\u0645\u0646 \u063a\u0631\u0648\u0628 \u0627\u0644\u0634\u0645\u0633 \u0625\u0644\u0649 \u0634\u0631\u0648\u0642\u0647\u0627\",\"System Default\":\"\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0627\u0644\u0646\u0638\u0627\u0645\",\"Tahajjud time mentioned in the app is the last third of the night\":\"\u0648\u0642\u062a \u0627\u0644\u062a\u0647\u062c\u0651\u062f \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0647\u0648 \u0627\u0644\u062b\u0644\u062b \u0627\u0644\u0623\u062e\u064a\u0631 \u0645\u0646 \u0627\u0644\u0644\u064a\u0644\",\"Thai Solar\":\"\u0634\u0645\u0633\u064a \u062a\u0627\u064a\u0644\u0627\u0646\u062f\u064a\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"\u0634\u0643\u0631\u0627 \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642! \u0647\u0646\u0627\u0643 \u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0642\u062f \u062a\u0643\u0648\u0646 \u0645\u0641\u064a\u062f\u0629 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\",\"The Gulf Region (Dubai)\":\"\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062e\u0644\u064a\u062c (\u062f\u0628\u064a)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"\u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062d\u0633\u0648\u0628 \u0645\u0633\u0628\u0642\u064b\u0627 \u0648\u0642\u062f \u0644\u0627 \u064a\u0643\u0648\u0646 \u062f\u0642\u064a\u0642\u064b\u0627 \u0644\u0623\u0646\u0647 \u0644\u0627 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0631\u0624\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644. \u0647\u0630\u0627 \u0645\u0647\u0645 \u062c\u062f\u064b\u0627 \u0644\u0644\u0645\u0644\u0627\u062d\u0638\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0628\u062f\u0627\u064a\u0629 \u0648\u0646\u0647\u0627\u064a\u0629 \u0631\u0645\u0636\u0627\u0646.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"\u0642\u062f \u0644\u0627 \u064a\u0643\u0648\u0646 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062f\u0642\u064a\u0642\u064b\u0627 \u0628\u0644\u063a\u0627\u062a \u0623\u062e\u0631\u0649\u060c \u0644\u0630\u0644\u0643 \u0641\u064a \u0623\u064a \u062d\u0627\u0644\u060c \u064a\u062c\u0628 \u0645\u0631\u0627\u0639\u0627\u0629 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0641\u0642\u0637.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"\u0646\u0648\u0639 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0630\u064a \u064a\u0638\u0647\u0631 \u0623\u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u0628\u062c\u0627\u0646\u0628 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a \u0641\u064a \u0627\u0644\u0645\u0635\u063a\u0631\",\"The type of lunar calendar shown in main screen and widgets\":\"\u0646\u0648\u0639 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a \u0627\u0644\u0630\u064a \u064a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\",\"Theme Color\":\"\u0644\u0648\u0646 \u0627\u0644\u0633\u0645\u0629\",\"Thursday\":\"\u0627\u0644\u062e\u0645\u064a\u0633\",\"Time\":\"\u0648\u0642\u062a\",\"Time condition\":\"\u0634\u0631\u0637 \u0627\u0644\u0648\u0642\u062a\",\"Time format\":\"\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0648\u0642\u062a\",\"Time list\":\"\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0648\u0642\u062a\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0630\u0627\u0646\u060c \u0646\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0645\u0648\u0642\u0639\u0643. \u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0632\u0631 \\\"\u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u064a\\\"\u060c \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0628\u0644\u062f \u0648\u0627\u0644\u0645\u062f\u064a\u0646\u0629/ \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u0623\u0648 \u0625\u062f\u062e\u0627\u0644 \u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\u0643 \u064a\u062f\u0648\u064a\u064b\u0627.\",\"To see notifications about adhan, we need your permission.\":\"\u0644\u0631\u0624\u064a\u0629 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062d\u0648\u0644 \u0627\u0644\u0623\u0630\u0627\u0646\u060c \u0646\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0630\u0646\u0643.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"\u0644\u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0630\u0627\u0646 \u0639\u0646\u062f \u062a\u0644\u0642\u064a \u0645\u0643\u0627\u0644\u0645\u0629\u060c \u0646\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0642\u0631\u0627\u0621\u0629 \u062d\u0627\u0644\u0629 \u0647\u0627\u062a\u0641\u0643. \u0639\u062f\u0645 \u0627\u0644\u0633\u0645\u0627\u062d \u0628\u0647\u0630\u0627 \u0627\u0644\u0625\u0630\u0646 \u064a\u0624\u062f\u064a \u0628\u0628\u0633\u0627\u0637\u0629 \u0625\u0644\u0649 \u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u0645\u064a\u0632\u0629.\",\"Tomorrow\":\"\u063a\u062f\u064b\u0627\",\"Tuesday\":\"\u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621\",\"Turn Left\":\"\u0627\u0646\u0639\u0637\u0641 \u0644\u0644\u064a\u0633\u0627\u0631\",\"Turn Right\":\"\u0627\u0646\u0639\u0637\u0641 \u064a\u0645\u064a\u0646\u0627\",\"Turn history off\":\"\u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u062c\u0644\",\"Turn history on\":\"\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u062c\u0644 (\u0627\u0644\u062a\u0627\u0631\u064a\u062e)\",\"Twilight Angle\":\"\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0634\u0641\u0642\",\"Umm al-Qura University, Makkah\":\"\u062c\u0627\u0645\u0639\u0629 \u0623\u0645 \u0627\u0644\u0642\u0631\u0649 \u0628\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629\",\"Union Organization Islamic de France\":\"\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629\",\"University of Islamic Sciences, Karachi\":\"\u062c\u0627\u0645\u0639\u0629 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0628\u0643\u0631\u0627\u062a\u0634\u064a\",\"Unknown Error\":\"\u062e\u0637\u0623 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\",\"Unreliable\":\"\u063a\u064a\u0631 \u0645\u0648\u062b\u0642\",\"Unresolved (default)\":\"\u0644\u0645 \u064a\u062a\u0645 \u062d\u0644\u0647\u0627 (\u0627\u0641\u062a\u0631\u0627\u0636\u064a)\",\"Unsupported\":\"\u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\",\"Up\":\"\u0623\u0639\u0644\u0649\",\"Upcoming alarm\":\"\u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0642\u0627\u062f\u0645\",\"Updating widgets\":\"\u062a\u062d\u062f\u06cc\u062b \u0627\u0644\u0645\u0635\u063a\u0651\u0631\",\"Use 24-Hour format\":\"\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0646\u0633\u064a\u0642 24 \u0633\u0627\u0639\u0629\",\"Use Compass\":\"\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0628\u0648\u0635\u0644\u0629\",\"Use Map\":\"\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062e\u0631\u064a\u0637\u0629\",\"Use a different alarm type?\":\"\u0627\u0633\u062a\u062e\u062f\u0645 \u0646\u0648\u0639 \u0625\u0646\u0630\u0627\u0631 \u0645\u062e\u062a\u0644\u0641\u061f\",\"Use adaptive theme?\":\"\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0633\u0645\u0629 \u0627\u0644\u0645\u062a\u0643\u064a\u0641\u0629\u061f\",\"Use headphones when available?\":\"\u0647\u0644 \u062a\u0631\u063a\u0628 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u0639\u0646\u062f \u062a\u0648\u0641\u0631\u0647\u0627\u061f\",\"Using Coordinates\":\"\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a\",\"Using GPS\":\"\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0640GPS\",\"Using Search\":\"\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u062d\u062b\",\"Version\":\"\u0625\u0635\u062f\u0627\u0631\",\"Vibration Mode\":\"\u0648\u0636\u0639 \u0627\u0644\u0627\u0647\u062a\u0632\u0627\u0632\",\"Vibration on call\":\"\u0627\u0647\u062a\u0632\u0627\u0632 \u0639\u0646\u062f \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629\",\"Volume button stops adhan\":\"\u0632\u0631 \u0627\u0644\u0635\u0648\u062a \u064a\u0648\u0642\u0641 \u0627\u0644\u0623\u0630\u0627\u0646\",\"WIDGET_CHANNEL_NAME\":\"\u0627\u0644\u0645\u0635\u063a\u0631\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"\u062a\u062d\u062f\u06cc\u062b \u0627\u0644\u0645\u0635\u063a\u0651\u0631\",\"We'll help you do them quickly.\":\"\u0633\u0646\u0633\u0627\u0639\u062f\u0643 \u0641\u064a \u0625\u0646\u062c\u0627\u0632\u0647\u0627 \u0628\u0633\u0631\u0639\u0629.\",\"Wednesday\":\"\u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621\",\"Welcome\":\"\u0645\u0631\u062d\u0628\u0627\",\"Western Arabic\":\"\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u063a\u0631\u0628\u064a\u0629\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"\u0639\u0646\u062f \u0627\u0644\u062a\u0645\u0643\u064a\u0646\u060c \u0633\u062a\u0638\u0644 \u0627\u0644\u0634\u0627\u0634\u0629 \u0645\u063a\u0644\u0642\u0629 \u0639\u0646\u062f \u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0630\u0627\u0646 \u0623\u0648 \u0627\u0644\u062a\u0630\u0643\u064a\u0631\u060c \u0648\u0644\u0646 \u062a\u0638\u0647\u0631 \u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0646\u0628\u0647\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"\u0639\u0646\u062f \u0627\u0644\u062a\u0645\u0643\u064a\u0646\u060c \u0639\u0646\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0631\u0623\u0633\u060c \u0633\u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0643\u0644 \u0627\u0644\u0635\u0648\u062a \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0631\u0623\u0633 \u0641\u0642\u0637.\",\"Wifi\":\"Wi-Fi\",\"Yes\":\"\u0646\u0639\u0645\",\"You are facing Kaaba\":\"\u0623\u0646\u062a \u062a\u0648\u0627\u062c\u0647 \u0627\u0644\u0643\u0639\u0628\u0629\",\"You are not facing Kaaba\":\"\u0623\u0646\u062a \u0644\u0627 \u062a\u0648\u0627\u062c\u0647 \u0627\u0644\u0643\u0639\u0628\u0629\",\"You can access your device Power Manager using the button below.\":\"\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \\\"\u0645\u062f\u064a\u0631 \u0627\u0644\u0637\u0627\u0642\u0629\\\" (Power Manager) \u0628\u062c\u0647\u0627\u0632\u0643 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0632\u0631 \u0623\u062f\u0646\u0627\u0647.\",\"You can also paste coords from clipboard\":\"\u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u0644\u0635\u0642 \u0627\u0644\u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a \u0645\u0646 \u0627\u0644\u062d\u0627\u0641\u0638\u0629\",\"You can change the language used for lunar calendar\":\"\u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0644\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"\u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0648\u0642\u062a \u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0642\u0627\u062f\u0645 \u0642\u0628\u0644 \u0627\u0644\u0623\u0630\u0627\u0646 \u0623\u0648 \u0627\u0644\u062a\u0630\u0643\u064a\u0631\",\"You can choose to replace one of calendars with your current location\":\"\u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0623\u062d\u062f \u0627\u0644\u062a\u0642\u0627\u0648\u064a\u0645 \u0628\u0645\u0648\u0642\u0639\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\",\"You can hide prayer times you don't want to see in the main screen here:\":\"\u064a\u0645\u0643\u0646\u0643 \u0625\u062e\u0641\u0627\u0621 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u0631\u064a\u062f \u0631\u0624\u064a\u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0647\u0646\u0627:\",\"You can hide prayer times you don't want to see in the widget here:\":\"\u064a\u0645\u0643\u0646\u0643 \u0625\u062e\u0641\u0627\u0621 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u0631\u064a\u062f \u0631\u0624\u064a\u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0635\u063a\u0631 \u0647\u0646\u0627:\",\"You can search for your location offline Or use GPS\":\"\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0645\u0648\u0642\u0639\u0643 \u0641\u064a \u0648\u0636\u0639 \u0639\u062f\u0645 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 GPS\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"\u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0642\u062f \u062a\u0644\u0642\u064a\u062a \u0646\u0633\u062e\u0629 \u0645\u0646 \u0631\u062e\u0635\u0629 \u062c\u0646\u0648 \u0623\u0641\u064a\u0631\u0648 \u0627\u0644\u0639\u0645\u0648\u0645\u064a\u0629 \u0645\u0639 \u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c. \u0625\u0630\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0643\u0630\u0644\u0643\u060c \u0631\u0627\u062c\u0639 https://www.gnu.org/licenses/.\",\"Your sounds\":\"\u0623\u0635\u0648\u0627\u062a\u0643\",\"abdul_basit_abdus_samad\":\"\u0639\u0628\u062f \u0627\u0644\u0628\u0627\u0633\u0637 \u0639\u0628\u062f \u0627\u0644\u0635\u0645\u062f\",\"about.credits\":\"\u062c\u0645\u064a\u0639 \u062d\u0642\u0648\u0642 \u0646\u0634\u0631 \u0627\u0644\u0623\u0635\u0648\u0627\u062a \u0627\u0644\u0623\u0630\u0627\u0646 \u062a\u0646\u062a\u0645\u064a \u0625\u0644\u0649 \u0623\u0635\u062d\u0627\u0628\u0647\u0627.\\n\u0634\u0643\u0631 \u062e\u0627\u0635 \u0644\u0640 translation.io (lingui.js) \u0639\u0644\u0649 \u062e\u062f\u0645\u0627\u062a\u0647\u0645 \u0627\u0644\u0631\u0627\u0626\u0639\u0629.\\n\u0634\u0643\u0631 \u062e\u0627\u0635 \u0644\u062c\u0645\u064a\u0639 \u0623\u0639\u0636\u0627\u0621 \u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0645\u0641\u062a\u0648\u062d\u0629 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0630\u064a\u0646 \u0642\u0627\u0645\u0648\u0627 \u0628\u0625\u0646\u0634\u0627\u0621 \u0647\u0630\u0647 \u0627\u0644\u0645\u0643\u062a\u0628\u0627\u062a \u0627\u0644\u0631\u0627\u0626\u0639\u0629 \u0627\u0644\u062a\u064a \u0633\u0647\u0651\u0644\u062a \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0635\u0646\u0639 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\",\"about.credits.google\":\"\u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0647\u064a \u0645\u0646 Google Material Icons.\",\"about_settings\":\"\u0639\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\",\"adjustment.hint\":\"\u0639\u062f\u062f \u0627\u0644\u062f\u0642\u0627\u0626\u0642 \u0627\u0644\u062a\u064a \u0633\u062a\u0636\u0627\u0641 \u0625\u0644\u0649 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u062d\u0633\u0648\u0628\u0629\",\"after\":\"\u0628\u0639\u062f\",\"ago\":\"\u0645\u0646\u0630\",\"asr.prayer\":\"\u0639\u0635\u0631\",\"backup_settings\":\"\u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\",\"before\":\"\u0642\u0628\u0644\",\"calculation_adjustments_settings\":\"\u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a\",\"calculation_advanced_settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629\",\"calculation_settings\":\"\u062d\u0633\u0627\u0628\",\"counter.fast\":\"\u0635\u064a\u0627\u0645\",\"date.day\":\"\u064a\u0648\u0645\",\"date.hour\":\"\u0633\u0627\u0639\u0629\",\"date.minute\":\"\u062f\u0642\u064a\u0642\u0629\",\"date.second\":\"\u062b\u0627\u0646\u064a\u0629\",\"dev_settings\":\"\u0645\u0637\u0648\u0631\",\"dhuhr.prayer\":\"\u0638\u0647\u0631\",\"display_settings\":\"\u0627\u0644\u0639\u0631\u0636\",\"fajr.prayer\":\"\u0641\u062c\u0631\",\"favorite_location\":\"\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0645\u0641\u0636\u0644\u0629\",\"forces all numbers to be in the selected system\":\"\u064a\u0641\u0631\u0636 \u0623\u0646 \u062a\u0643\u0648\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u062d\u062f\u062f\",\"from North\":\"\u0645\u0646 \u0627\u0644\u0634\u0645\u0627\u0644\",\"from settings\":\"\u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\",\"fullscreen_alarm\":\"\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0630\u0627\u0646\",\"hijri.adjustment.hint\":\"\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u064a \u0633\u062a\u062a\u0645 \u0625\u0636\u0627\u0641\u062a\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0642\u0645\u0631\u064a\",\"home\":\"\u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"\u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0645\u0643\u064a\u0646\u060c \u0633\u064a\u062a\u0645 \u0639\u0631\u0636 \u0625\u0634\u0639\u0627\u0631 \u0642\u0628\u0644 \u062d\u0648\u0627\u0644\u064a \u0633\u0627\u0639\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0623\u064a \u0648\u0642\u062a \u0635\u0644\u0627\u0629 \u0623\u0648 \u062a\u0630\u0643\u064a\u0631 \u0628\u0647 \u0635\u0648\u062a\",\"intro\":\"\u0645\u0642\u062f\u0645\u0629\",\"is prayer time hidden?\":\"\u0647\u0644 \u0648\u0642\u062a \u0627\u0644\u0635\u0644\u0627\u0629 \u0645\u062e\u0641\u064a\u061f\",\"isha.prayer\":\"\u0639\u0634\u0627\u0621\",\"later\":\"\u0644\u0627\u062d\u0642\u0627\u064b\",\"location_settings\":\"\u0645\u0648\u0642\u0639\",\"maghrib.prayer\":\"\u0645\u063a\u0631\u0628\",\"masjid_an_nabawi\":\"\u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a\",\"minutes\":\"\u062f\u0642\u064a\u0642\u0629\",\"moazen_zade\":\"\u0645\u0624\u0630\u0646 \u0632\u0627\u062f\u0647\",\"modes_settings\":\"\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u0627\u0645\u062a\",\"monthly_view\":\"\u0639\u0631\u0636 \u0634\u0647\u0631\u064a\",\"muezzin_settings\":\"\u0627\u0644\u0645\u0624\u0630\u0646\",\"notification_advanced_settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062a\u0642\u062f\u0645\u0629\",\"notification_settings\":\"\u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648 \u0627\u0644\u0635\u0648\u062a\",\"qada_counter\":\"\u0639\u062f\u0627\u062f \u0627\u0644\u0642\u0636\u0627\u0621\",\"qibla_compass\":\"\u0628\u0648\u0635\u0644\u0629 \u0627\u0644\u0642\u0628\u0644\u0629\",\"qibla_finder\":\"\u0645\u064f\u062d\u062f\u062f \u0627\u0644\u0642\u0628\u0644\u0629\",\"qibla_map\":\"\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0642\u0628\u0644\u0629\",\"ragheb_mustafa_ghalwash\":\"\u0631\u0627\u063a\u0628 \u0645\u0635\u0637\u0641\u0649 \u063a\u0644\u0648\u0634\",\"reminders_settings\":\"\u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a\",\"settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a\",\"should notification widget be shown?\":\"\u0647\u0644 \u064a\u062c\u0628 \u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u063a\u0631 \u0641\u064a \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a\u061f\",\"should {prayerName} be hidden?\":[\"\u0647\u0644 \u064a\u062c\u0628 \u0625\u062e\u0641\u0627\u0621 \u0627\u0644\",[\"prayerName\"],\"\u061f\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"\u0646\u0638\u0631\u064b\u0627 \u0644\u0623\u0646 \u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062d\u0633\u0648\u0628 \u0645\u0633\u0628\u0642\u064b\u0627 \u0648\u0644\u064a\u0633 \u0645\u0628\u0646\u064a\u064b\u0627 \u0639\u0644\u0649 \u0631\u0624\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644\u060c \u0642\u062f \u064a\u0639\u0631\u0636 \u062a\u0627\u0631\u064a\u062e\u064b\u0627 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d\u064b\u0627 \u0644\u0628\u062f\u0627\u064a\u0629 \u0648\u0646\u0647\u0627\u064a\u0629 \u0631\u0645\u0636\u0627\u0646.\",\"sunnah.midnight\":\"\u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644\",\"sunnah.tahajjud\":\"\u062a\u0647\u062c\u0651\u062f\",\"sunrise\":\"\u0634\u0631\u0648\u0642 \u0627\u0644\u0634\u0645\u0633\",\"sunset\":\"\u063a\u0631\u0648\u0628 \u0627\u0644\u0634\u0645\u0633\",\"widget_settings\":\"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0635\u063a\u0631\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" \u062f\u0642\u064a\u0642\u0629 \u0628\u0639\u062f \u0627\u0644\",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" \u062f\u0642\u064a\u0642\u0629 \u0642\u0628\u0644 \u0627\u0644\",[\"prayer\"]],\"{prayerName} notification will be shown\":[\"\u0633\u064a\u062a\u0645 \u0639\u0631\u0636 \u0625\u0634\u0639\u0627\u0631 \u0627\u0644\",[\"prayerName\"]],\"{prayerName} sound will be played\":[\"\u0633\u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0635\u0648\u062a \u0627\u0644\",[\"prayerName\"]]}")}),628,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 min\",\"15 min\":\"15 min\",\"30 min\":\"30 min\",\"30 minutes is added to Isha time during Ramadan in this method\":\"Bei dieser Methode werden w\xe4hrend des Ramadan 30 Minuten zur Isha-Zeit hinzugef\xfcgt\",\"5 min\":\"5 min\",\"60 min\":\"60 min\",\"90 min\":\"90 min\",\"ADHAN_CHANNEL_NAME\":\"Adhan\",\"Abyad\":\"Abyad\",\"Accuracy\":\"Genauigkeit\",\"Ad-Free\":\"Frei von Werbung\",\"Adaptive Charging\":\"Adaptives Laden\",\"Add\":\"Hinzuf\xfcgen\",\"Add Custom Adhan\":\"Benutzerdefinierten Adhan hinzuf\xfcgen\",\"Add Custom Audio\":\"Benutzerdefiniertes Audio hinzuf\xfcgen\",\"Add Reminder\":\"Erinnerung hinzuf\xfcgen\",\"Add Silent Mode\":\"Stummschaltung hinzuf\xfcgen\",\"Add new counter\":\"Neuen Z\xe4hler hinzuf\xfcgen\",\"Add new location\":\"Neuen Standort hinzuf\xfcgen\",\"Adhan\":\"Adhan\",\"Adhan audio file is not downloaded yet\":\"Die Adhan-Audiodatei wurde noch nicht heruntergeladen\",\"Adjustments\":\"Einstellungen\",\"Advanced\":\"Erweitert\",\"Advanced Calculation Settings\":\"Erweiterte Berechnungseinstellungen\",\"Advanced Settings\":\"Erweiterte Einstellungen\",\"Ahmer\":\"Ahmer\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Gebetszeiten\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan wird in der Hoffnung verteilt, dass es n\xfctzlich ist, aber OHNE JEGLICHE GARANTIE; sogar ohne die implizite Garantie der MARKTREIFE oder der EIGNUNG F\xdcR EINEN BESTIMMTEN ZWECK. Weitere Einzelheiten finden sie in der GNU Affero General Public License.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan ist freie Software: Sie k\xf6nnen sie unter den Bedingungen der GNU Affero General Public License (v3.0), wie von der Free Software Foundation ver\xf6ffentlicht, weitergeben und/oder ver\xe4ndern.\",\"Alarms Permission\":\"Erlaubnis f\xfcr Alarme\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"Alle an Al-Azan \xfcbermittelten Daten werden nur lokal auf ihrem Ger\xe4t gespeichert. Ihre Daten werden nirgendwo hochgeladen. Die Entwickler von Al-Azan haben keinen Zugriff auf ihre Daten. Ihre Daten werden nicht an Dritte weitergegeben. Al-Azan enth\xe4lt keine Werbebibliotheken oder Tracking- bzw. Analyse-Werkzeuge von Drittanbietern, wie z. B. Google Analytics oder Facebook SDK.\",\"An error occured while playing the current track\":\"Bei der Wiedergabe des aktuellen Titels ist ein Fehler aufgetreten\",\"App features\":\"Features der App\",\"Arabic\":\"Arabisch\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"Sind Sie sicher, dass Sie \\\"\",[\"0\"],\"\\\" l\xf6schen wollen? ?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"Sind Sie sicher, dass Sie \\\"\",[\"itemName\"],\"\\\" l\xf6schen wollen?\"],\"Are you sure you want to delete this?\":\"Sind Sie sicher, dass Sie dies l\xf6schen wollen?\",\"Asr Calculation\":\"Asr-Berechnung\",\"At least one prayer time must be shown\":\"Mindestens eine Gebetszeit muss angezeigt werden\",\"Attention\":\"Achtung\",\"Auto (Default)\":\"Automatisch (Standard)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"Soll der Hinweis \\\"Bitte nicht st\xf6ren\\\" umgangen werden?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"F\xfcr die Berechnung des Adhan gibt es viele verschiedene Methoden. Jede Methode liefert unterschiedliche Ergebnisse. Es liegt in Ihrer Verantwortung, die richtige Methode zu finden und auszuw\xe4hlen.\",\"Calculation\":\"Berechnung\",\"Calculation Method\":\"Berechnungsmethode\",\"Calendar\":\"Kalender\",\"Cancel\":\"Abbrechen\",\"Cancel Alarm\":\"Alarm abbrechen\",\"Cancel download\":\"Download abbrechen\",\"Choose Asr Calculation Madhab\":\"Asr-Berechnung ausw\xe4hlen\",\"Choose Calculation Method\":\"Berechnungsmethode ausw\xe4hlen\",\"Choose High Latitude Setting\":\"Hohen Breitengrad festlegen\",\"Choose Language\":\"Sprache ausw\xe4hlen\",\"Choose Polar Resolution\":\"Polaraufl\xf6sung ausw\xe4hlen\",\"Choose Shafaq method\":\"Shafaq-Methode ausw\xe4hlen\",\"Choose calculation rounding method\":\"W\xe4hlen Sie eine Rundungsmethode aus\",\"Choose calendar type\":\"Kalendertyp ausw\xe4hlen\",\"Choose lunar calendar language\":\"Sprache des Mondkalenders ausw\xe4hlen\",\"Choose midnight calculation method\":\"Berechnungsmethode f\xfcr Mitternacht w\xe4hlen\",\"Choose numbering system\":\"Nummerierungssystem ausw\xe4hlen\",\"Choose which calendar to replace\":\"W\xe4hlen Sie den zu ersetzenden Kalender\",\"City/Area\":\"Stadt/Gebiet\",\"Clear the coordinates\":\"Koordinaten l\xf6schen\",\"Clear the location\":\"Standort l\xf6schen\",\"Clipboard data does not contain coordinates\":\"Die Zwischenablage enth\xe4lt keine Koordinaten\",\"Close\":\"Schlie\xdfen\",\"Closest City\":\"N\xe4chstgelegene Stadt\",\"Closest Date\":\"N\xe4chstes Datum\",\"Compass Lock\":\"Kompass-Sperre\",\"Compass sensor unavailable\":\"Der Kompass-Sensor ist nicht verf\xfcgbar\",\"Confirm\":\"Best\xe4tigen\",\"Continuous\":\"Kontinuierlich\",\"Coordinates updated\":\"Die Koordinaten wurden aktualisiert\",\"Copy\":\"Kopieren\",\"Count\":\"Z\xe4hlen\",\"Country\":\"Land\",\"Custom\":\"Benutzerdefiniert\",\"Custom sounds and muezzins will not be exported\":\"Benutzerdefinierte T\xf6ne und Muezzin-Rufe werden nicht exportiert\",\"Custom upcoming alarm time\":\"Benutzerdefinierte bevorstehende Alarmzeit\",\"Dark\":\"Dunkel\",\"Date\":\"Datum\",\"Decrement\":\"Reduzieren\",\"Default\":\"Standard\",\"Delete\":\"L\xf6schen\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"Je nach Ger\xe4t und Android-Version kann es vorkommen, dass Ihr Ger\xe4t die App im Hintergrund beendet, um Akku-Laufzeit zu sparen. Dies kann dazu f\xfchren, dass Alarme/Benachrichtigungen nicht zugestellt werden.\",\"Deselect as Fajr Adhan\":\"Als Fajr-Adhan abw\xe4hlen\",\"Device sounds\":\"Ger\xe4tet\xf6ne\",\"Disabled\":\"Deaktiviert\",\"Disclaimer\":\"Haftungsausschluss\",\"Dismiss\":\"Ablehnen\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"Die in Al-Azan angegebene Diyanet-Methode ist ein N\xe4herungswert f\xfcr die offiziellen Zeiten. Da nicht ausreichend dokumentiert ist, wie die Zeiten genau berechnet werden, stimmen die Zeiten m\xf6glicherweise nicht mit denen der offiziellen Website \xfcberein, insbesondere au\xdferhalb der T\xfcrkei.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, T\xfcrkei\",\"Doesn't use any kind of trackers\":\"Verwendet keine Tracking-Methoden\",\"Don't ask again\":\"Nicht erneut nachfragen\",\"Don't show again\":\"Nicht erneut anzeigen\",\"Don't show alarm screen?\":\"Soll der Alarm nicht angezeigt werden?\",\"Done\":\"Erledigt\",\"Download\":\"Herunterladen\",\"Eastern Arabic\":\"Ostarabisch\",\"Edit\":\"Bearbeiten\",\"Edit Calculation Parameters\":\"Berechnungsparameter bearbeiten\",\"Edit Counter\":\"Z\xe4hler bearbeiten\",\"Edit Location\":\"Standort bearbeiten\",\"Edit Reminder\":\"Erinnerung bearbeiten\",\"Edit Silent Mode\":\"Stummschaltung bearbeiten\",\"Egyptian General Survey Authority\":\"\xc4gyptische Generalvermessungsbeh\xf6rde\",\"Enabled\":\"Aktiviert\",\"End after prayer (minutes)\":\"Ende nach dem Gebet (Minuten)\",\"Error getting clipboard data\":\"Fehler beim Abrufen der Zwischenablage\",\"Error in loading countries\":\"Fehler beim Laden der L\xe4nder\",\"Error while downloading audio\":\"Fehler beim Herunterladen der Audio-Dateien\",\"Error while getting coordinates\":\"Fehler beim Abrufen der Koordinaten\",\"Error: failed to open file\":\"Fehler: Die Datei kann nicht ge\xf6ffnet werden\",\"Ethiopic\":\"\xc4thiopisch\",\"Export app data\":\"App-Daten exportieren\",\"Export data\":\"Daten exportieren\",\"Fajr Angle\":\"Fajr-Winkel\",\"Find My Location\":\"Meinen Standort finden\",\"Fix Common Problems\":\"H\xe4ufige Probleme beheben\",\"France angle 15\":\"Frankreich Winkel 15\",\"France angle 18\":\"Frankreich Winkel 18\",\"Friday\":\"Freitag\",\"General (default)\":\"Allgemein (Standard)\",\"Getting coordinates\":\"Koordinaten ermitteln\",\"Got it\":\"Verstanden\",\"Gregorian\":\"Gregorianisch\",\"Gulf region\":\"Golfregion\",\"Hanafi\":\"Hanafi\",\"Hidden?\":\"Versteckt?\",\"Hide Prayer Times\":\"Gebetszeiten ausblenden\",\"Hide times you don't need\":\"Ausblenden nicht ben\xf6tigter Gebetszeiten m\xf6glich\",\"High\":\"Hoch\",\"High Latitude\":\"Hoher Breitengrad\",\"Highlight current prayer\":\"Aktuelles Gebet hervorheben\",\"Home\":\"Startseite\",\"Homescreen and notification Widgets\":\"Startbildschirm- und Benachrichtigungs-Widgets\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Bei der Nutzung von Online-Diensten, wie z. B. der Qibla-Karte, werden daf\xfcr notwendige Daten \xfcbertragen, die Sie m\xf6glicherweise eindeutig identifizieren. Bitte bedenken Sie dies bei der Nutzung der App.\",\"I Understand\":\"Ich verstehe\",\"IMPORTANT_CHANNEL_ID\":\"Wichtig\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"Wenn diese Option aktiviert ist, enth\xe4lt die Benachrichtigung Informationen \xfcber die n\xe4chste Gebetszeit\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"Wenn Sie in den Einstellungen Ihres Telefons \\\"Sichern & Zur\xfccksetzen\\\" aktiviert haben (Einstellungen / Sichern & Zur\xfccksetzen / Meine Daten sichern), sollten Sie wissen, dass Android selbst (nicht die App Al-Azan) regelm\xe4\xdfig eine Kopie der Daten Ihres Telefons auf den Servern von Google speichert. So kann Android Ihre Daten wiederherstellen, falls Ihr Ger\xe4t besch\xe4digt wird oder Sie ein neues Ger\xe4t kaufen. Die Entwickler von Al-Azan haben keinen Zugriff auf diese Daten.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"Wenn Sie immer noch das Problem haben, dass die App nach einiger Zeit stoppt, besuchen Sie bitte dontkillmyapp.com f\xfcr weitere L\xf6sungen.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"Wenn Sie sicherstellen m\xf6chten, dass die App zuverl\xe4ssig funktioniert, m\xfcssen Sie die Energieoptimierung f\xfcr diese App deaktivieren. Sie k\xf6nnen die entsprechenden Einstellungen \xfcber die Schaltfl\xe4che unten \xf6ffnen.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"Aktivieren Sie diese Option, wenn Ihr Ger\xe4t, beispielsweise das Google Pixel, \xfcber adaptives Laden verf\xfcgt und Sie nicht m\xf6chten, dass der Adhan oder Erinnerungen als Alarm erkannt werden.\",\"Import\":\"Importieren\",\"Import app data\":\"App-Daten importieren\",\"Import successful\":\"Import erfolgreich\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"Neben den f\xfcnf Gebeten gibt es Einstellungen f\xfcr den Sonnenaufgang und -untergang, f\xfcr die Mitternacht und das Abendgebet (Tahajjud)\",\"Increment\":\"Erh\xf6hen\",\"Info\":\"Info\",\"Internet connection\":\"Internetverbindung\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"Damit die Qibla-Karte funktioniert, ist eine Internetverbindung erforderlich. Bitte aktivieren Sie Ihr WLAN oder Ihre mobilen Daten und versuchen Sie es erneut.\",\"Iran\":\"Iran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"Ist lokalisiert in Englisch, Persisch, Arabisch, T\xfcrkisch, Indonesisch, Franz\xf6sisch, Urdu, Hindi, Deutsch, Bosnisch, Vietnamesisch, Bengalisch\",\"Isha Angle\":\"Isha-Winkel\",\"Isha Interval\":\"Isha-Intervall\",\"Islamic\":\"Islamisch\",\"Islamic (Saudi Arabia sighting)\":\"Islamisch (Sichtung in Saudi-Arabien)\",\"Islamic (Umm al-Qura)\":\"Islamisch (Umm al-Qura)\",\"Islamic (civil)\":\"Islamisch (zivil)\",\"Islamic (tabular)\":\"Islamisch (tabellarisch)\",\"Islamic Society of North America (ISNA)\":\"Islamische Gesellschaft Nordamerikas (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"Es scheint, dass Sie eine Sicherung importiert haben. Vergessen Sie nicht, die Akku-Optimierung f\xfcr diese App zu deaktivieren\",\"Just now\":\"jetzt gerade\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Kementrian Agama Republik Indonesien (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\",\"Kuwait\":\"Kuwait\",\"Label\":\"Bezeichnung\",\"Language\":\"Sprache\",\"Latitude\":\"Breitengrad\",\"Latitude is invalid\":\"Der Breitengrad ist ung\xfcltig\",\"License\":\"Lizenz\",\"Light\":\"Hell\",\"Light and Dark theme\":\"Heller und dunkler Farbmodus\",\"Light/Dark theme\":\"Heller und dunkler Farbmodus\",\"List is empty\":\"Liste ist leer\",\"Loading\":\"Laden\",\"Location\":\"Standort\",\"Location settings\":\"Standort-Einstellungen\",\"Longitude\":\"L\xe4ngengrad\",\"Longitude is invalid\":\"Der L\xe4ngengrad ist ung\xfcltig\",\"Low\":\"Niedrig\",\"Lunar Calendar\":\"Mondkalender\",\"Lunar Calendar Language\":\"Sprache des Mondkalenders\",\"Maghrib Angle\":\"Maghrib-Winkel\",\"Make a Copy\":\"Eine Kopie erstellen\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Mehrere Methoden f\xfcr die Berechnung des Adhan (\u0627\u0630\u0627\u0646)\\n\",\"Medium\":\"Mittel\",\"Middle of the Night\":\"Mitten in der Nacht\",\"Midnight Method\":\"Mitternachtsmethode\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"Ministerium f\xfcr religi\xf6se Angelegenheiten und Wakfs, Algerien\",\"Ministry of Religious Affairs of Tunisia\":\"Ministerium f\xfcr religi\xf6se Angelegenheiten von Tunesien\",\"Mobile Data\":\"Mobile Daten\",\"Modified\":\"Ge\xe4ndert\",\"Monday\":\"Montag\",\"Moonsighting Committee\":\"Ausschuss f\xfcr Mondsichtung\",\"Muslim World League\":\"Islamische Weltliga\",\"Name\":\"Name\",\"Nearest\":\"N\xe4chstgelegen\",\"New Counter\":\"Neuer Z\xe4hler\",\"New Location\":\"Neuer Standort\",\"New Reminder\":\"Neue Erinnerung\",\"New Silent Mode\":\"Neue Stummschaltung\",\"Next\":\"Weiter\",\"Next Day\":\"N\xe4chster Tag\",\"Next Month\":\"N\xe4chster Monat\",\"No\":\"Nein\",\"No Data\":\"Keine Daten\",\"No Results\":\"Keine Ergebnisse\",\"None\":\"Keine\",\"None (Automatic)\":\"Keine (automatisch)\",\"Normal mode restored\":\"Normaler Modus wiederhergestellt\",\"Not now\":\"Nicht jetzt\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"Beachten Sie, dass aufgrund von Software- und Hardware-Fehlern die von dieser App angezeigte Qibla-Richtung, insbesondere im Kompassmodus, falsch sein kann.\",\"Notification\":\"Benachrichtigung\",\"Notification & Sound\":\"Benachrichtigung & Ton\",\"Notifications Permission\":\"Benachrichtigungserlaubnis\",\"Numbering system\":\"Nummerierungssystem\",\"Off\":\"Aus\",\"Okay\":\"OK\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"Ab Android 12 ben\xf6tigt die App auch die Erlaubnis f\xfcr Alarme, um ordnungsgem\xe4\xdf zu funktionieren, also m\xfcssen Sie diese auch erlauben.\",\"Once\":\"Einmal\",\"One-Seventh of the Night\":\"Ein Siebtel der Nacht\",\"Only once?\":\"Nur einmal?\",\"Only six items can be shown at the same time\":\"Es k\xf6nnen nur sechs Elemente gleichzeitig angezeigt werden\",\"Open Battery Optimization Settings\":\"Einstellungen f\xfcr die Akku-Optimierung \xf6ffnen\",\"Open Power Manager Settings\":\"Einstellungen f\xfcr die Energieverwaltung \xf6ffnen\",\"Open source repository\":\"Open-Source Repository\",\"Open-source\":\"Open-Source\",\"Options\":\"Optionen\",\"Or if you have a backup, you can import it\":\"Wenn Sie eine Sicherungskopie haben, k\xf6nnen Sie diese auch importieren\",\"Orientation Lock: Landscape\":\"Ausrichtungssperre: Querformat\",\"Orientation Lock: Portrait\":\"Ausrichtungssperre: Hochformat\",\"Orientation: Unlocked\":\"Ausrichtung: Entriegelt\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"Andere magnetische Ger\xe4te k\xf6nnen den Kompass Ihres Smartphones st\xf6ren. Ihr Kompass muss in dem Fall m\xf6glicherweise neu kalibriert werden.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Stummschaltung\",\"PRE_ADHAN_CHANNEL_NAME\":\"Bevorstehender Adhan\",\"PRE_REMINDER_CHANNEL_NAME\":\"Kommende Erinnerung\",\"Pakistan\":\"Pakistan\",\"Paste\":\"Einf\xfcgen\",\"Persian\":\"Persisch\",\"Phone State Permission\":\"Erlaubnis f\xfcr den Telefonstatus\",\"Play\":\"Spielen\",\"Please enable location service\":\"Bitte aktivieren Sie den Standortdienst\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"Bitte beachten Sie, dass die Aktivierung dieser Option dazu f\xfchren kann, dass Adhan und Erinnerungen in einigen F\xe4llen verz\xf6gert oder gar nicht ausgel\xf6st werden. Aktivieren Sie diese Option mit Bedacht.\",\"Polar Resolution\":\"Polaraufl\xf6sung\",\"Power Manager\":\"Energieverwaltung\",\"Prayer\":\"Gebet\",\"Prayer Times\":\"Gebetszeiten\",\"Prayer list\":\"Gebetsliste\",\"Press to search\":\"Zum Suchen dr\xfccken\",\"Press to select a method\":\"Zur Auswahl einer Methode dr\xfccken\",\"Prev Day\":\"Voriger Tag\",\"Prev Month\":\"Voriger Monat\",\"Privacy Policy\":\"Datenschutzbestimmungen\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"Datenschutzfreundliche Open-Source App f\xfcr den Adhan (Gebetszeit) und die Qibla\",\"Qada counter\":\"Qada-Z\xe4hler\",\"Qatar\":\"Katar\",\"Qibla\":\"Qibla\",\"Qibla finder\":\"Ermittlung der Qibla\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"Der Qibla-Finder ben\xf6tigt einen Standortdienst. Falls nicht aktiviert, wird der Standort aus den App-Einstellungen verwendet.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"Die Qibla-Karte ist in F-Droid-Builds derzeit nicht verf\xfcgbar. Sie wird m\xf6glicherweise in zuk\xfcnftigen Updates verf\xfcgbar sein.\",\"REMINDER_CHANNEL_NAME\":\"Erinnerung\",\"Ramadan is ending,\":\"Der Ramadan geht zu Ende,\",\"Ramadan is near,\":\"Der Ramadan ist nah,\",\"Remaining till\":\"Verbleibend bis\",\"Remind me next year\":\"Erinnern Sie mich n\xe4chstes Jahr daran\",\"Reminder\":\"Erinnerung\",\"Repeat\":\"Wiederholen\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"Die erforderlichen Einstellungen sind unvollst\xe4ndig. Damit die App die Gebetszeiten anzeigen kann, m\xfcssen Sie diese sp\xe4ter in den Einstellungen konfigurieren.\",\"Rounding Method\":\"Rundungsmethode\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"Samsung-Ger\xe4te verf\xfcgen \xfcber eine eigene Energieverwaltung namens Device Care.\\n\xdcber die untere Schaltfl\xe4che gelangen Sie in das Men\xfc \\\"Akku\\\" von Device Care. Tippen Sie in dem Men\xfc zun\xe4chst auf \\\"App-Energieverwaltung\\\", dann auf \\\"Apps, die nicht in den Ruhezustand versetzt werden sollen\\\" und f\xfcgen Sie anschlie\xdfend diese App zu der Liste hinzu.\",\"Saturday\":\"Samstag\",\"Saudi Arabia\":\"Saudi-Arabien\",\"Search\":\"Suchen\",\"Secondary Calendar\":\"Sekund\xe4rer Kalender\",\"See favorite locations\":\"Lieblingsorte anzeigen\",\"Select as Fajr Adhan\":\"Als Fajr-Adhan ausw\xe4hlen\",\"Select different Adhan audio for Fajr namaz\":\"Unterst\xfctzt unterschiedliche Adhan-Stimmen f\xfcr das Fajr-Gebet\",\"Selected\":\"Ausgew\xe4hlt\",\"Selected as adhan\":\"Ausgew\xe4hlt als Adhan\",\"Selected as fajr adhan\":\"Ausgew\xe4hlt als Fajr-Adhan\",\"Selecting a name is required\":\"Die Auswahl eines Namens ist erforderlich\",\"Set custom Adhan audio\":\"Benutzerdefinierte Adhan-Stimmen ausw\xe4hlbar\",\"Set reminders before or after a prayer time\":\"Erstellung von Erinnerungen vor und nach den Gebetszeiten\",\"Shafaq\":\"Shafaq\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"Shafaq wird von der Methode des Ausschusses f\xfcr Mondsichtung verwendet um \\ndie Art der D\xe4mmerung zu bestimmen, woraus die\\ndie Zeit f\xfcr Isha abgeleitet wird\",\"Shafi, Maliki, Hanbali (Default)\":\"Shafi, Maliki, Hanbali (Standard)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"Shia Ithna Ashari, Leva-Institut, Qom\",\"Shia, Institute of Geophysics, University of Tehran\":\"Shia, Institut f\xfcr Geophysik, Universit\xe4t von Teheran\",\"Should app highlight current prayer instead of next prayer?\":\"Soll die App das aktuelle Gebet anstelle des n\xe4chsten Gebets hervorheben?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"Soll die App weiterhin den Adhan abspielen, wenn \\\"Nicht st\xf6ren\\\" aktiviert ist?\",\"Should app stop playing adhan when the volume button is pressed?\":\"Soll die App das Abspielen des Adhan beenden, wenn die Lautst\xe4rketaste gedr\xfcckt wird?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"Soll das Telefon vibrieren, wenn der Adhan oder eine Erinnerung abgespielt wird?\",\"Show Adhan Options\":\"Adhan-Optionen anzeigen\",\"Show Today\":\"Heute anzeigen\",\"Show countdown?\":\"Countdown anzeigen?\",\"Show current\":\"Heute anzeigen\",\"Show me\":\"Zeigen\",\"Show next in notification?\":\"Als n\xe4chstes in der Benachrichtigung anzeigen?\",\"Show notification widget?\":\"Benachrichtigungs-Widget anzeigen?\",\"Show settings\":\"Einstellungen anzeigen\",\"Show upcoming alarm notification?\":\"Benachrichtigung \xfcber den bevorstehenden Alarm anzeigen?\",\"Silent\":\"Stumm\",\"Silent Mode Ended\":\"Stummschaltung beendet\",\"Silent Mode Name\":\"Name der Stummschaltung\",\"Silent Mode Started\":\"Stummschaltung gestartet\",\"Silent mode activated\":\"Stummschaltung aktiviert\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"Da in der App keine Tracker und Analysewerkzeuge eingebaut sind, melden Sie Fehler oder Vorschl\xe4ge bitte an das folgende GitHub-Repository\",\"Singapore\":\"Singapur\",\"Skip\":\"\xdcberspringen\",\"Software License\":\"Software-Lizenz\",\"Solar Hijri\":\"Iranischer Kalender (Hijri)\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"Um zu verhindern, dass die Anwendung im Hintergrund beendet wird, ben\xf6tigen einige Ger\xe4te zus\xe4tzliche Einstellungen in der Energieverwaltung. Deaktivieren Sie in diesem Fall alle Energie-Einsparoptionen f\xfcr die App.\",\"Sound\":\"Ton\",\"Spiritual Administration of Muslims of Russia\":\"Geistliche Verwaltung der Muslime Russlands\",\"Start before prayer (minutes)\":\"Beginn vor dem Gebet (Minuten)\",\"Status\":\"Status\",\"Stop\":\"Stopp\",\"Sunday\":\"Sonntag\",\"Sunset to Fajr (Default)\":\"Sonnenuntergang bis Fajr (Standard)\",\"Sunset to Sunrise\":\"Sonnenuntergang bis Sonnenaufgang\",\"System Default\":\"Systemvoreinstellung\",\"Tahajjud time mentioned in the app is the last third of the night\":\"Die in der App genannte Tahajjud-Zeit ist das letzte Drittel der Nacht\",\"Thai Solar\":\"Thail\xe4ndischer Kalender (Suriyakati)\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"Danke, dass Sie sich f\xfcr diese App entschieden haben! Es gibt mehrere Dinge, die Sie einstellen m\xfcssen, bevor Sie diese App verwenden k\xf6nnen.\",\"The Gulf Region (Dubai)\":\"Die Golfregion (Dubai)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"Der Mondkalender der App ist vorberechnet und m\xf6glicherweise nicht genau, da er nicht auf Mondsichtungen basiert. Dies ist vor allem f\xfcr den Beginn und das Ende des Ramadan wichtig zu beachten.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"Der Text auf dieser Website und in der App ist in anderen Sprachen m\xf6glicherweise nicht korrekt, daher sollte in jedem Fall nur die englische Version ber\xfccksichtigt werden.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Die Art des Kalenders, der oben auf dem Startbildschirm und neben dem Mondkalender in Widgets angezeigt wird\",\"The type of lunar calendar shown in main screen and widgets\":\"Der Typ des Mondkalenders, der im Hauptbildschirm und in den Widgets angezeigt wird\",\"Theme Color\":\"Farbschema\",\"Thursday\":\"Donnerstag\",\"Time\":\"Zeit\",\"Time condition\":\"Zeitbedingung\",\"Time format\":\"Zeitformat\",\"Time list\":\"Zeitliste\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"Um den Adhan zu berechnen, ben\xf6tigen wir Ihren Standort. Sie k\xf6nnen die Schaltfl\xe4che \\\"Meinen Standort finden\\\" verwenden, die Suche nach Land und Stadt/Gebiet nutzen oder Ihre Koordinaten manuell eingeben.\",\"To see notifications about adhan, we need your permission.\":\"Um Benachrichtigungen \xfcber den Adhan anzuzeigen, ben\xf6tigen wir Ihre Zustimmung.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"Um das Abspielen des Adhan bei einem Anruf zu stoppen, m\xfcssen wir Ihren Telefonstatus auslesen. Wenn Sie diese Berechtigung nicht zulassen, wird die Funktion einfach deaktiviert.\",\"Tomorrow\":\"Morgen\",\"Tuesday\":\"Dienstag\",\"Turn Left\":\"Nach links bewegen\",\"Turn Right\":\"Nach rechts bewegen\",\"Turn history off\":\"Verlauf deaktivieren\",\"Turn history on\":\"Verlauf aktivieren\",\"Twilight Angle\":\"D\xe4mmerungswinkel\",\"Umm al-Qura University, Makkah\":\"Universit\xe4t Umm al-Qura, Mekka\",\"Union Organization Islamic de France\":\"Islamische Union Frankreichs\",\"University of Islamic Sciences, Karachi\":\"Universit\xe4t f\xfcr Islamische Wissenschaften, Karatschi\",\"Unknown Error\":\"Unbekannter Fehler\",\"Unreliable\":\"Unzuverl\xe4ssig\",\"Unresolved (default)\":\"Ungel\xf6st (Standard)\",\"Unsupported\":\"Ohne Unterst\xfctzung\",\"Up\":\"Nach oben\",\"Upcoming alarm\":\"Bevorstehender Alarm\",\"Updating widgets\":\"Widgets aktualisieren\",\"Use 24-Hour format\":\"Das 24-Stunden-Format verwenden\",\"Use Compass\":\"Kompass verwenden\",\"Use Map\":\"Karte verwenden\",\"Use a different alarm type?\":\"Einen anderen Alarmtyp verwenden?\",\"Use adaptive theme?\":\"Adaptives Thema verwenden?\",\"Use headphones when available?\":\"Kopfh\xf6rer verwenden, wenn verf\xfcgbar?\",\"Using Coordinates\":\"Koordinaten verwenden\",\"Using GPS\":\"GPS verwenden\",\"Using Search\":\"Suche verwenden\",\"Version\":\"Version\",\"Vibration Mode\":\"Vibrationsmodus\",\"Vibration on call\":\"Vibration bei Anruf\",\"Volume button stops adhan\":\"Lautst\xe4rketaste stoppt Adhan\",\"WIDGET_CHANNEL_NAME\":\"Widget\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"Widget-Aktualisierung\",\"We'll help you do them quickly.\":\"Wir helfen Ihnen dabei, sie schnell zu erledigen.\",\"Wednesday\":\"Mittwoch\",\"Welcome\":\"Willkommen\",\"Western Arabic\":\"Westarabisch\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Wenn diese Funktion aktiviert ist, bleibt der Bildschirm ausgeschaltet, wenn der Adhan oder die Erinnerung abgespielt wird. Der Alarmbildschirm wird nicht angezeigt\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"Wenn diese Option aktiviert ist, werden bei der Verwendung von Kopfh\xf6rern alle Audiosignale nur \xfcber die Kopfh\xf6rer wiedergegeben.\",\"Wifi\":\"Wi-Fi\",\"Yes\":\"Ja\",\"You are facing Kaaba\":\"Sie stehen in Richtung der Kaaba\",\"You are not facing Kaaba\":\"Sie stehen nicht in Richtung der Kaaba\",\"You can access your device Power Manager using the button below.\":\"\xdcber die untere Schaltfl\xe4che k\xf6nnen Sie auf die Energieverwaltung Ihres Ger\xe4ts zugreifen.\",\"You can also paste coords from clipboard\":\"Sie k\xf6nnen die Koordinaten auch aus der Zwischenablage einf\xfcgen\",\"You can change the language used for lunar calendar\":\"Sie k\xf6nnen die f\xfcr den Mondkalender verwendete Sprache \xe4ndern\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"Sie k\xf6nnen festlegen, wann die Benachrichtigung \xfcber einen bevorstehenden Alarm vor dem Adhan oder der Erinnerung gesendet wird\",\"You can choose to replace one of calendars with your current location\":\"Sie k\xf6nnen w\xe4hlen, ob Sie einen der Kalender durch Ihren aktuellen Standort ersetzen m\xf6chten\",\"You can hide prayer times you don't want to see in the main screen here:\":\"Hier k\xf6nnen Sie die Gebetszeiten ausblenden, die Sie nicht auf dem Hauptbildschirm sehen m\xf6chten:\",\"You can hide prayer times you don't want to see in the widget here:\":\"Sie k\xf6nnen die Gebetszeiten, die Sie nicht sehen m\xf6chten, hier ausblenden:\",\"You can search for your location offline Or use GPS\":\"Sie k\xf6nnen offline nach Ihrem Standort suchen oder GPS verwenden\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"Sie sollten zusammen mit diesem Programm eine Kopie der GNU Affero General Public License erhalten haben. Falls nicht, siehe https://www.gnu.org/licenses/.\",\"Your sounds\":\"Deine T\xf6ne\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"Alle Urheberrechte f\xfcr Adhan-Stimmen geh\xf6ren ihren jeweiligen Eigent\xfcmern.\\nBesonderer Dank geht an translation.io (lingui.js) f\xfcr ihre wunderbaren Dienste.\\nDank an alle Open-Source-Community-Mitglieder, die all diese wunderbaren Bibliotheken und diese App m\xf6glich gemacht haben.\",\"about.credits.google\":\"Die meisten in der App verwendeten Icons stammen von Google Material Icons.\",\"about_settings\":\"\xdcber\",\"adjustment.hint\":\"Anzahl der Minuten, die zu den berechneten Zeiten hinzugef\xfcgt werden\",\"after\":\"nach\",\"ago\":\"vergangen\",\"asr.prayer\":\"Asr\",\"backup_settings\":\"Sicherung\",\"before\":\"vor\",\"calculation_adjustments_settings\":\"Einstellungen\",\"calculation_advanced_settings\":\"Erweiterte Berechnungseinstellungen\",\"calculation_settings\":\"Berechnung\",\"counter.fast\":\"Fasten\",\"date.day\":\"Tag\",\"date.hour\":\"Stunde\",\"date.minute\":\"Minute\",\"date.second\":\"Sekunde\",\"dev_settings\":\"Entwickler\",\"dhuhr.prayer\":\"Dhuhr\",\"display_settings\":\"Anzeige\",\"fajr.prayer\":\"Fajr\",\"favorite_location\":\"Lieblingsorte\",\"forces all numbers to be in the selected system\":\"Erzwingt, dass alle Nummern im ausgew\xe4hlten System sind\",\"from North\":\"aus dem Norden\",\"from settings\":\"aus den Einstellungen\",\"fullscreen_alarm\":\"Adhan abspielen\",\"hijri.adjustment.hint\":\"Anzahl der Tage, die dem Mondkalender hinzugef\xfcgt werden\",\"home\":\"Startseite\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"wenn aktiviert, wird eine Benachrichtigung etwa eine Stunde vor einer Gebetszeit oder einer Erinnerung mit Ton angezeigt\",\"intro\":\"Einleitung\",\"is prayer time hidden?\":\"Ist die Gebetszeit versteckt?\",\"isha.prayer\":\"Isha\",\"later\":\"sp\xe4ter\",\"location_settings\":\"Standort\",\"maghrib.prayer\":\"Maghrib\",\"masjid_an_nabawi\":\"Masjid an-Nabawi\",\"minutes\":\"Minuten\",\"moazen_zade\":\"Moazen Zade\",\"modes_settings\":\"Stummschaltung\",\"monthly_view\":\"Monatsansicht\",\"muezzin_settings\":\"Muezzin\",\"notification_advanced_settings\":\"Erweiterte Einstellungen\",\"notification_settings\":\"Benachrichtigung & Ton\",\"qada_counter\":\"Qada-Z\xe4hler\",\"qibla_compass\":\"Qibla-Kompass\",\"qibla_finder\":\"Ermittlung der Qibla\",\"qibla_map\":\"Qibla-Karte\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"Erinnerungen\",\"settings\":\"Einstellungen\",\"should notification widget be shown?\":\"Soll das Benachrichtigungs-Widget angezeigt werden?\",\"should {prayerName} be hidden?\":[\"Soll das \",[\"prayerName\"],\"-Gebet ausgeblendet werden?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"Der Kalender der App ist vorberechnet und basiert nicht auf der Mondsichtung, weswegen m\xf6glicherweise ein falsches Anfangs- und Enddatum f\xfcr den Ramadan angezeigt wird.\",\"sunnah.midnight\":\"Mitternacht\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"Sonnenaufgang\",\"sunset\":\"Sonnenuntergang\",\"widget_settings\":\"Widget-Einstellungen\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" Minuten vor dem \",[\"prayer\"],\"-Gebet - \",[\"1\"],\" Minuten nach dem \",[\"prayer\"],\"-Gebet\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" Minuten nach dem \",[\"prayer\"],\"-Gebet\"],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" Minuten vor dem \",[\"prayer\"],\"-Gebet\"],\"{prayerName} notification will be shown\":[[\"prayerName\"],\"-Benachrichtigung wird angezeigt\"],\"{prayerName} sound will be played\":[\"Der Ton f\xfcr das \",[\"prayerName\"],\"-Gebet wird abgespielt\"]}")}),629,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 min\",\"15 min\":\"15 min\",\"30 min\":\"30 min\",\"30 minutes is added to Isha time during Ramadan in this method\":\"Cette m\xe9thode permet d'ajouter 30 minutes \xe0 l'heure de l'Isha pendant le Ramadan\",\"5 min\":\"5 min\",\"60 min\":\"60 min\",\"90 min\":\"90 min\",\"ADHAN_CHANNEL_NAME\":\"Adhan\",\"Abyad\":\"Abyad\",\"Accuracy\":\"Pr\xe9cision\",\"Ad-Free\":\"Sans publicit\xe9\",\"Adaptive Charging\":\"Chargement adaptatif\",\"Add\":\"Ajouter\",\"Add Custom Adhan\":\"Ajouter un Adhan personnalis\xe9\",\"Add Custom Audio\":\"Ajouter un son personnalis\xe9\",\"Add Reminder\":\"Ajouter un rappel\",\"Add Silent Mode\":\"Ajouter Mode Silencieux\",\"Add new counter\":\"Ajouter un nouveau compteur\",\"Add new location\":\"Ajouter un nouveau lieu\",\"Adhan\":\"Adhan\",\"Adhan audio file is not downloaded yet\":\"Le fichier audio pour l'Adhan n'est pas encore t\xe9l\xe9charg\xe9\",\"Adjustments\":\"Ajustements\",\"Advanced\":\"Avanc\xe9\",\"Advanced Calculation Settings\":\"Param\xe8tres de calcul avanc\xe9s\",\"Advanced Settings\":\"Param\xe8tres avanc\xe9s\",\"Ahmer\":\"Ahmer\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Horaires de pri\xe8re\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan est distribu\xe9 dans l'espoir d'\xeatre utile, mais SANS AUCUNE GARANTIE ; sans m\xeame la garantie implicite de COMMERCIALISATION ou d'ADAPTATION \xc0 UN USAGE PARTICULIER. Voir la licence publique g\xe9n\xe9rale GNU Affero pour plus de d\xe9tails.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan est un logiciel libre : vous pouvez le redistribuer et/ou le modifier selon les termes de la licence publique g\xe9n\xe9rale GNU Affero (v3.0) publi\xe9e par la Free Software Foundation.\",\"Alarms Permission\":\"Autorisation des alarmes\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"Toutes les donn\xe9es fournies \xe0 Al-Azan sont uniquement stock\xe9es localement sur votre appareil. Vos donn\xe9es ne sont t\xe9l\xe9charg\xe9es nulle part. Les d\xe9veloppeurs d'Al-Azan n'y ont pas acc\xe8s. Vos donn\xe9es ne sont pas partag\xe9es avec des tiers. Al-Azan inclut ni biblioth\xe8que publicitaire ni code de suivi (analytique) de tiers comme par exemple Google Analytics ou Facebook SDK.\",\"An error occured while playing the current track\":\"Une erreur s'est produite pendant la lecture de la piste en cours\",\"App features\":\"Caract\xe9ristiques de l'application\",\"Arabic\":\"Arabe\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\xcates-vous s\xfbr de vouloir supprimer \\\"\",[\"0\"],\"\\\" ?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\xcates-vous s\xfbr de vouloir supprimer \\\"\",[\"itemName\"],\"\\\" ?\"],\"Are you sure you want to delete this?\":\"\xcates-vous s\xfbr de vouloir supprimer ceci ?\",\"Asr Calculation\":\"Calcul du Asr\",\"At least one prayer time must be shown\":\"Au moins un temps de pri\xe8re doit \xeatre affich\xe9\",\"Attention\":\"Attention\",\"Auto (Default)\":\"Automatique (par d\xe9faut)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"Contourner \\\"Ne pas d\xe9ranger\\\" ?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"Le calcul de l'Adhan peut se faire selon de nombreuses m\xe9thodes diff\xe9rentes. Chaque m\xe9thode fournit des r\xe9sultats diff\xe9rents. Il est de votre responsabilit\xe9 de rechercher et d'utiliser la bonne m\xe9thode.\",\"Calculation\":\"Calcul\",\"Calculation Method\":\"M\xe9thode de calcul\",\"Calendar\":\"Calendrier\",\"Cancel\":\"Annuler\",\"Cancel Alarm\":\"Annuler l'alarme\",\"Cancel download\":\"Annuler le t\xe9l\xe9chargement\",\"Choose Asr Calculation Madhab\":\"Choisir le madhab pour le calcul d'Asr\",\"Choose Calculation Method\":\"Choisir la m\xe9thode de calcul\",\"Choose High Latitude Setting\":\"Choisir le r\xe9glage de la latitude \xe9lev\xe9e\",\"Choose Language\":\"Choisir la langue\",\"Choose Polar Resolution\":\"Choisir la r\xe9solution polaire\",\"Choose Shafaq method\":\"Choisir la m\xe9thode Shafaq\",\"Choose calculation rounding method\":\"Choisir la m\xe9thode d'arrondi des calculs\",\"Choose calendar type\":\"Choisir le type de calendrier\",\"Choose lunar calendar language\":\"Choisir la langue du calendrier lunaire\",\"Choose midnight calculation method\":\"Choisir la m\xe9thode de calcul de minuit\",\"Choose numbering system\":\"Choisir le syst\xe8me de num\xe9rotation\",\"Choose which calendar to replace\":\"Choisir le calendrier \xe0 remplacer\",\"City/Area\":\"Ville/Zone\",\"Clear the coordinates\":\"Effacer les coordonn\xe9es\",\"Clear the location\":\"Effacer l'emplacement\",\"Clipboard data does not contain coordinates\":\"Les donn\xe9es du presse-papiers ne contiennent pas de coordonn\xe9es\",\"Close\":\"Fermer\",\"Closest City\":\"Ville la plus proche\",\"Closest Date\":\"Date la plus proche\",\"Compass Lock\":\"Verrouillage boussole\",\"Compass sensor unavailable\":\"Boussole non disponible\",\"Confirm\":\"Confirmer\",\"Continuous\":\"Continu\",\"Coordinates updated\":\"Coordonn\xe9es mises \xe0 jour\",\"Copy\":\"Copier\",\"Count\":\"Compte\",\"Country\":\"Pays\",\"Custom\":\"Personnalis\xe9\",\"Custom sounds and muezzins will not be exported\":\"Les sons et les Muazzins personnalis\xe9s ne seront pas export\xe9s\",\"Custom upcoming alarm time\":\"Personnalisation de l'heure d'alarme \xe0 venir\",\"Dark\":\"Nuit\",\"Date\":\"Date\",\"Decrement\":\"D\xe9croissance\",\"Default\":\"D\xe9faut\",\"Delete\":\"Supprimer\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"En fonction de votre appareil et de la version d'Android, il peut arriver que votre appareil arr\xeate l'application en arri\xe8re-plan pour \xe9conomiser de la batterie. Cela peut emp\xeacher le fonctionnement des alarmes et notifications.\",\"Deselect as Fajr Adhan\":\"D\xe9s\xe9lectionner comme Adhan du Fajr\",\"Device sounds\":\"Sons de l'appareil\",\"Disabled\":\"D\xe9sactiv\xe9\",\"Disclaimer\":\"Clause de non-responsabilit\xe9\",\"Dismiss\":\"Passer\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"La m\xe9thode Diyanet fournie dans Al-Azan est une approximation des horaires officiels. \xc9tant donn\xe9 qu'il n'existe pas suffisamment de documentation sur la mani\xe8re dont les heures sont calcul\xe9es, il se peut que les heures ne correspondent pas \xe0 celles du site web officiel, en particulier en dehors de la Turquie.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turquie\",\"Doesn't use any kind of trackers\":\"N'utilise aucun type de traqueur\",\"Don't ask again\":\"Ne pas demander \xe0 nouveau\",\"Don't show again\":\"Ne pas montrer \xe0 nouveau\",\"Don't show alarm screen?\":\"L'\xe9cran d'alarme ne s'affiche pas ?\",\"Done\":\"Termin\xe9\",\"Download\":\"T\xe9l\xe9charger\",\"Eastern Arabic\":\"Arabe oriental\",\"Edit\":\"Modifier\",\"Edit Calculation Parameters\":\"Modifier les param\xe8tres de calcul\",\"Edit Counter\":\"Modifier le compteur\",\"Edit Location\":\"Modifier l'emplacement\",\"Edit Reminder\":\"Modifier le rappel\",\"Edit Silent Mode\":\"Modifier Mode Silencieux\",\"Egyptian General Survey Authority\":\"Autorit\xe9 \xe9gyptienne d'\xe9tudes g\xe9n\xe9rales\",\"Enabled\":\"Activ\xe9\",\"End after prayer (minutes)\":\"Finir apr\xe8s la pri\xe8re (minutes)\",\"Error getting clipboard data\":\"Erreur dans la r\xe9cup\xe9ration des donn\xe9es du presse-papiers\",\"Error in loading countries\":\"Erreur dans le chargement des pays\",\"Error while downloading audio\":\"Erreur lors du t\xe9l\xe9chargement d'un fichier audio\",\"Error while getting coordinates\":\"Erreur lors de l'obtention des coordonn\xe9es\",\"Error: failed to open file\":\"Erreur : le fichier n'a pas pu \xeatre ouvert\",\"Ethiopic\":\"\xc9thiopique\",\"Export app data\":\"Exporter les donn\xe9es de l'application\",\"Export data\":\"Exporter les donn\xe9es\",\"Fajr Angle\":\"Angle Fajr\",\"Find My Location\":\"Trouver ma position\",\"Fix Common Problems\":\"R\xe9soudre les probl\xe8mes courants\",\"France angle 15\":\"France angle 15\",\"France angle 18\":\"France angle 18\",\"Friday\":\"Vendredi\",\"General (default)\":\"G\xe9n\xe9ral (par d\xe9faut)\",\"Getting coordinates\":\"Obtenir des coordonn\xe9es\",\"Got it\":\"Bien re\xe7u\",\"Gregorian\":\"Gr\xe9gorien\",\"Gulf region\":\"R\xe9gion du Golfe\",\"Hanafi\":\"Hanafi\",\"Hidden?\":\"Masqu\xe9?\",\"Hide Prayer Times\":\"Masquer des horaires de pri\xe8re\",\"Hide times you don't need\":\"Cacher les horaires de pri\xe8re dont vous n'avez pas besoin\",\"High\":\"Haute Pr\xe9cision\",\"High Latitude\":\"Latitude \xe9lev\xe9e\",\"Highlight current prayer\":\"Mettre en \xe9vidence la pri\xe8re en cours\",\"Home\":\"Accueil\",\"Homescreen and notification Widgets\":\"Widgets pour l'\xe9cran d'accueil et les notifications\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Cependant, lors de l'utilisation de services en ligne tels que la carte Qibla, l'application peut transmettre un minimum de donn\xe9es n\xe9cessaires qui peuvent ou non vous identifier de mani\xe8re unique. Veuillez garder cela \xe0 l'esprit lorsque vous utilisez l'application.\",\"I Understand\":\"Je comprends\",\"IMPORTANT_CHANNEL_ID\":\"Important\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"En activant cette option, une notification affich\xe9e contiendra des informations sur le prochain horaire de pri\xe8re\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"Si vous avez activ\xe9 la fonction \\\"Sauvegarde et r\xe9initialisation\\\" dans les param\xe8tres de votre t\xe9l\xe9phone (Param\xe8tres / Sauvegarde et r\xe9initialisation / Sauvegarde de mes donn\xe9es), vous devez savoir qu'Android lui-m\xeame (et non Al-Azan) enregistre p\xe9riodiquement une copie des donn\xe9es de votre t\xe9l\xe9phone dans les serveurs de Google. Cela permet \xe0 Android de r\xe9cup\xe9rer vos donn\xe9es si votre appareil est endommag\xe9 ou si vous achetez un nouvel appareil. Les d\xe9veloppeurs d'Al-Azan n'ont pas acc\xe8s \xe0 ces donn\xe9es.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"Si vous avez toujours un probl\xe8me avec l'application qui s'arr\xeate apr\xe8s un certain temps, veuillez visiter le site dontkillmyapp.com pour plus de solutions.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"Si vous voulez vous assurer que l'application fonctionne de mani\xe8re fiable, vous devez d\xe9sactiver l'optimisation de l'alimentation pour cette application. Vous pouvez ouvrir les param\xe8tres associ\xe9s en utilisant le bouton ci-dessous.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"Si votre appareil est dot\xe9 d'une fonction de charge adaptative, comme le Google Pixel, et que vous ne souhaitez pas que l'adhan ou les rappels soient reconnus comme des alarmes, vous pouvez activer cette option.\",\"Import\":\"Importer\",\"Import app data\":\"Importer les donn\xe9es de l'application\",\"Import successful\":\"Importation r\xe9ussie\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"En plus des cinq pri\xe8res quotidiennes, il y a des r\xe9glages pour le lever du soleil, le coucher du soleil, minuit et la pri\xe8re de nuit (Tahajjud)\",\"Increment\":\"Incr\xe9ment\",\"Info\":\"Info\",\"Internet connection\":\"Connexion Internet\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"Une connexion Internet est n\xe9cessaire pour que la carte de la qibla fonctionne. Veuillez activer votre wifi ou vos donn\xe9es mobiles et r\xe9essayer.\",\"Iran\":\"Iran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"Est localis\xe9 en anglais, persan, arabe, turc, indon\xe9sien, fran\xe7ais, urdu, hindi, allemand, bosniaque, vietnamien, bengali\",\"Isha Angle\":\"Angle Isha\",\"Isha Interval\":\"Intervalle Isha\",\"Islamic\":\"Islamique\",\"Islamic (Saudi Arabia sighting)\":\"Islamique (rep\xe9rage en Arabie Saoudite)\",\"Islamic (Umm al-Qura)\":\"Islamique (Umm al-Qura)\",\"Islamic (civil)\":\"Islamique (civil)\",\"Islamic (tabular)\":\"Islamique (tabulaire)\",\"Islamic Society of North America (ISNA)\":\"Soci\xe9t\xe9 islamique d'Am\xe9rique du Nord (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"Il semble que vous ayez import\xe9 une sauvegarde, n'oubliez pas de d\xe9sactiver les optimisations de batterie pour cette application\",\"Just now\":\"\xc0 l'instant\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Kementrian Agama Republik Indonesia (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\",\"Kuwait\":\"Kowe\xeft\",\"Label\":\"Intitul\xe9\",\"Language\":\"Langue\",\"Latitude\":\"Latitude\",\"Latitude is invalid\":\"La latitude n'est pas valide\",\"License\":\"Licence\",\"Light\":\"Clair\",\"Light and Dark theme\":\"Th\xe8me clair/fonc\xe9\",\"Light/Dark theme\":\"Th\xe8me clair/fonc\xe9\",\"List is empty\":\"La liste est vide\",\"Loading\":\"Chargement\",\"Location\":\"Localisation\",\"Location settings\":\"Param\xe8tres de localisation\",\"Longitude\":\"Longitude\",\"Longitude is invalid\":\"La longitude n'est pas valide\",\"Low\":\"Faible pr\xe9cison\",\"Lunar Calendar\":\"Calendrier lunaire\",\"Lunar Calendar Language\":\"Langue du calendrier lunaire\",\"Maghrib Angle\":\"Angle Maghrib\",\"Make a Copy\":\"Faire une copie\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Nombreuses options pour le calcul de l'Adhan (\u0627\u0630\u0627\u0646)\",\"Medium\":\"Pr\xe9cision moyenne\",\"Middle of the Night\":\"Le milieu de la nuit\",\"Midnight Method\":\"M\xe9thode de minuit\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"Minist\xe8re des affaires religieuses et des wakfs, Alg\xe9rie\",\"Ministry of Religious Affairs of Tunisia\":\"Minist\xe8re des affaires religieuses de Tunisie\",\"Mobile Data\":\"Donn\xe9es mobiles\",\"Modified\":\"Modifi\xe9\",\"Monday\":\"Lundi\",\"Moonsighting Committee\":\"Comit\xe9 d'observation de la lune\",\"Muslim World League\":\"Ligue islamique mondiale\",\"Name\":\"Nom\",\"Nearest\":\"Le plus proche\",\"New Counter\":\"Nouveau compteur\",\"New Location\":\"Nouvelle localisation\",\"New Reminder\":\"Nouveau rappel\",\"New Silent Mode\":\"Nouveau Mode Silencieux\",\"Next\":\"Suivant\",\"Next Day\":\"Jour suivant\",\"Next Month\":\"Mois suivant\",\"No\":\"Non\",\"No Data\":\"Pas de donn\xe9es\",\"No Results\":\"Aucun r\xe9sultat\",\"None\":\"Aucun\",\"None (Automatic)\":\"Aucun (automatique)\",\"Normal mode restored\":\"Mode normal restaur\xe9\",\"Not now\":\"Pas maintenant\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"Notez qu'en raison d'erreurs de logiciel et d'erreurs physiques, la direction de la Qibla indiqu\xe9e par cette application, en particulier en mode boussole, peut \xeatre erron\xe9e.\",\"Notification\":\"Notification\",\"Notification & Sound\":\"Notification et son\",\"Notifications Permission\":\"Permission de notifications\",\"Numbering system\":\"Syst\xe8me de num\xe9rotation\",\"Off\":\"Off\",\"Okay\":\"Ok\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"Sur Android 12 et plus r\xe9cent, l'application a \xe9galement besoin de l'autorisation des alarmes pour fonctionner correctement, vous devez donc l'autoriser \xe9galement.\",\"Once\":\"Une fois\",\"One-Seventh of the Night\":\"Un septi\xe8me de la nuit\",\"Only once?\":\"R\xe9p\xe9ter qu'une seule fois\",\"Only six items can be shown at the same time\":\"Seuls six \xe9l\xe9ments peuvent \xeatre affich\xe9s en m\xeame temps\",\"Open Battery Optimization Settings\":\"Ouvrir les param\xe8tres d'optimisation de la batterie\",\"Open Power Manager Settings\":\"Ouvrir les param\xe8tres de gestion d'\xe9nergie\",\"Open source repository\":\"R\xe9positoire open source\",\"Open-source\":\"Open-source\",\"Options\":\"Options\",\"Or if you have a backup, you can import it\":\"Ou si vous disposez d'une sauvegarde, vous pouvez l'importer\",\"Orientation Lock: Landscape\":\"Verrouillage de l'orientation : Paysage\",\"Orientation Lock: Portrait\":\"Verrouillage de l'orientation : Portrait\",\"Orientation: Unlocked\":\"Orientation : D\xe9verrouill\xe9e\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"D'autres dispositifs magn\xe9tiques peuvent interf\xe9rer avec la boussole de votre t\xe9l\xe9phone et votre boussole pourrait avoir besoin d'\xeatre calibr\xe9e.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Mode Silencieux\",\"PRE_ADHAN_CHANNEL_NAME\":\"Adhan \xe0 venir\",\"PRE_REMINDER_CHANNEL_NAME\":\"Prochain rappel\",\"Pakistan\":\"Pakistan\",\"Paste\":\"Coller\",\"Persian\":\"Perse\",\"Phone State Permission\":\"Permission d'acc\xe8s \xe0 l'\xe9tat du t\xe9l\xe9phone\",\"Play\":\"Jouer\",\"Please enable location service\":\"Veuillez activer le service de localisation\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"Veuillez noter qu'en activant cette option, l'adhan et les rappels peuvent se d\xe9clencher avec un certain retard ou ne pas se d\xe9clencher du tout dans certains cas. Activez cette option avec prudence.\",\"Polar Resolution\":\"R\xe9solution polaire\",\"Power Manager\":\"Gestionnaire d'\xe9nergie\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"Horaire de pri\xe8re\",\"Prayer list\":\"Liste de pri\xe8res\",\"Press to search\":\"Appuyer pour effectuer une recherche\",\"Press to select a method\":\"Appuyer pour s\xe9lectionner une m\xe9thode\",\"Prev Day\":\"Jour pr\xe9c\xe9dent\",\"Prev Month\":\"Mois pr\xe9c\xe9dent\",\"Privacy Policy\":\"Politique de confidentialit\xe9\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"Application Adhan et Qibla qui respecte la vie priv\xe9e, open-source, sans publicit\xe9!\",\"Qada counter\":\"Compteur de Qada\",\"Qatar\":\"Qatar\",\"Qibla\":\"Qibla\",\"Qibla finder\":\"Recherche de Qibla\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"La recherche de Qibla n\xe9cessite le service de localisation. S'il n'est pas activ\xe9, la localisation provenant des param\xe8tres de l'application sera utilis\xe9e.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"La carte Qibla n'est actuellement pas disponible dans les versions de F-Droid. Elle pourrait \xeatre disponible dans les prochaines mises \xe0 jour.\",\"REMINDER_CHANNEL_NAME\":\"Rappel\",\"Ramadan is ending,\":\"Le ramadan se termine,\",\"Ramadan is near,\":\"Le ramadan est proche,\",\"Remaining till\":\"Restant jusqu'au\",\"Remind me next year\":\"Rappelez-moi l'ann\xe9e prochaine\",\"Reminder\":\"Rappel\",\"Repeat\":\"R\xe9p\xe9ter\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"Les param\xe8tres requis sont incomplets. Pour que l'application affiche les horaires de pri\xe8res, vous devrez les configurer \xe0 partir de param\xe8tres ult\xe9rieurement.\",\"Rounding Method\":\"M\xe9thode d'arrondissement\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"Les appareils Samsung ont leur propre gestionnaire d'alimentation personnalis\xe9 appel\xe9 \\\"Device Care\\\".\\nApr\xe8s avoir appuy\xe9 sur le bouton ci-dessous, vous serez dirig\xe9 vers le menu Batterie Device Care.\\nDans le menu Batterie, appuyez sur \\\"Gestion de l'alimentation des applications\\\", puis sur \\\"Applications \xe0 ne pas mettre en veille\\\",\\net ajoutez cette application \xe0 la liste.\",\"Saturday\":\"Samedi\",\"Saudi Arabia\":\"Arabie Saoudite\",\"Search\":\"Recherche\",\"Secondary Calendar\":\"Calendrier secondaire\",\"See favorite locations\":\"Voir les lieux pr\xe9f\xe9r\xe9s\",\"Select as Fajr Adhan\":\"S\xe9lectionner comme Adhan du Fajr\",\"Select different Adhan audio for Fajr namaz\":\"S\xe9lectionnez un son Adhan diff\xe9rent pour Fajr\",\"Selected\":\"S\xe9lectionn\xe9\",\"Selected as adhan\":\"S\xe9lectionn\xe9 comme adhan\",\"Selected as fajr adhan\":\"S\xe9lectionn\xe9 comme adhan du fajr\",\"Selecting a name is required\":\"La s\xe9lection d'un nom est obligatoire\",\"Set custom Adhan audio\":\"D\xe9finir l'audio personnalis\xe9 pour l'Adhan\",\"Set reminders before or after a prayer time\":\"D\xe9finir des rappels avant ou apr\xe8s un temps de pri\xe8re\",\"Shafaq\":\"Shafaq\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"Le Shafaq est utilis\xe9 par la m\xe9thode du Comit\xe9 d'observation de la lune pour \\nd\xe9terminer quel type de cr\xe9puscule utiliser afin de\\nd\xe9terminer l'heure d'Isha\",\"Shafi, Maliki, Hanbali (Default)\":\"Shafi, Maliki, Hanbali (Par d\xe9faut)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"Shia Ithna Ashari, Institut Leva, Qum\",\"Shia, Institute of Geophysics, University of Tehran\":\"Shia, Institut de g\xe9ophysique, Universit\xe9 de T\xe9h\xe9ran\",\"Should app highlight current prayer instead of next prayer?\":\"L'application doit-elle mettre en \xe9vidence la pri\xe8re en cours au lieu de la pri\xe8re suivante ?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"L'application doit-elle continuer \xe0 jouer l'adhan lorsque la fonction \\\"Ne pas d\xe9ranger\\\" est activ\xe9e ?\",\"Should app stop playing adhan when the volume button is pressed?\":\"Arr\xeater la lecture de l'Adhan en appuyant sur le bouton de volume\",\"Should phone vibrate when adhan or reminder starts playing?\":\"Le t\xe9l\xe9phone doit-il vibrer lorsque l'adhan ou le rappel commence \xe0 retentir ?\",\"Show Adhan Options\":\"Afficher les options pour l'Adhan\",\"Show Today\":\"Montrer le jour d'aujourd'hui\",\"Show countdown?\":\"Montrer le compte \xe0 rebours\",\"Show current\":\"Afficher le courant\",\"Show me\":\"Montrez-moi\",\"Show next in notification?\":\"Montrer la prochaine pri\xe8re dans la notification\",\"Show notification widget?\":\"Afficher le widget dans les notifications\",\"Show settings\":\"Afficher les param\xe8tres\",\"Show upcoming alarm notification?\":\"Afficher la notification d'alarme \xe0 venir\",\"Silent\":\"Silencieux\",\"Silent Mode Ended\":\"Mode Silencieux Termin\xe9\",\"Silent Mode Name\":\"Nom du Mode Silencieux\",\"Silent Mode Started\":\"Mode Silencieux Commenc\xe9\",\"Silent mode activated\":\"Mode silencieux activ\xe9\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"Puisque nous n'utilisons aucune sorte de traqueur ou de crash analytics, merci de nous faire part de tout probl\xe8me ou suggestion sur notre r\xe9positoire GitHub\",\"Singapore\":\"Singapour\",\"Skip\":\"Passer\",\"Software License\":\"Licence de logiciel\",\"Solar Hijri\":\"Solaire Hijri\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"Certains appareils ont besoin de param\xe8tres suppl\xe9mentaires dans leur gestionnaire d'\xe9nergie \\npour \xe9viter que l'application soit arr\xeat\xe9e en arri\xe8re-plan.\\nDans ce cas, d\xe9sactivez toute option d'\xe9conomie d'\xe9nergie pour l'application.\",\"Sound\":\"Son\",\"Spiritual Administration of Muslims of Russia\":\"Administration spirituelle des musulmans de Russie\",\"Start before prayer (minutes)\":\"Commencer avant la pri\xe8re (minutes)\",\"Status\":\"Statut\",\"Stop\":\"Arr\xeater\",\"Sunday\":\"Dimanche\",\"Sunset to Fajr (Default)\":\"Du coucher du soleil au Fajr (par d\xe9faut)\",\"Sunset to Sunrise\":\"Du coucher au lever du soleil\",\"System Default\":\"Th\xe8me par d\xe9faut\",\"Tahajjud time mentioned in the app is the last third of the night\":\"L'heure de Tahajjud mentionn\xe9e dans l'application est le dernier tiers de la nuit\",\"Thai Solar\":\"Thai Solaire\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"Merci d'avoir choisi cette application! Il y a des choses que vous devez faire avant de commencer \xe0 utiliser cette application.\",\"The Gulf Region (Dubai)\":\"La r\xe9gion du Golfe (Duba\xef)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"Le calendrier lunaire de l'application est pr\xe9calcul\xe9 et peut ne pas \xeatre exact car il n'est pas bas\xe9 sur les observations de la lune. Ceci est particuli\xe8rement important pour le d\xe9but et la fin du Ramadan.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"Le texte figurant sur ce site web et dans l'application peut ne pas \xeatre exact dans d'autres langues, seule la version anglaise doit donc \xeatre prise en compte dans tous les cas.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Le type de calendrier qui s'affiche en haut de l'\xe9cran d'accueil et \xe0 c\xf4t\xe9 du calendrier lunaire dans les widgets\",\"The type of lunar calendar shown in main screen and widgets\":\"Le type de calendrier lunaire affich\xe9 dans l'\xe9cran principal et les widgets\",\"Theme Color\":\"Couleur du th\xe8me\",\"Thursday\":\"Jeudi\",\"Time\":\"Temps\",\"Time condition\":\"Condition du temps\",\"Time format\":\"Format du temps\",\"Time list\":\"Liste d'horaires\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"Pour calculer l'Adhan, nous avons besoin de votre position. Vous pouvez utiliser le bouton \\\"Trouver ma position\\\" ou utiliser la recherche par pays et ville/r\xe9gion, ou encore entrer vos coordonn\xe9es manuellement.\",\"To see notifications about adhan, we need your permission.\":\"Nous avons besoin de votre permission pour voir les notifications de l'Adhan.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"Pour arr\xeater la lecture de l'Adhan lorsque vous recevez un appel, nous devons avoir acc\xe8s \xe0 l'\xe9tat de votre t\xe9l\xe9phone. Ne pas autoriser cette permission d\xe9sactive simplement la fonction.\",\"Tomorrow\":\"Demain\",\"Tuesday\":\"Mardi\",\"Turn Left\":\"Tourner \xe0 gauche\",\"Turn Right\":\"Tourner \xe0 droite\",\"Turn history off\":\"D\xe9sactiver l'historique\",\"Turn history on\":\"Activer l'historique\",\"Twilight Angle\":\"Angle du cr\xe9puscule\",\"Umm al-Qura University, Makkah\":\"Universit\xe9 d'Umm al-Qura, La Mecque\",\"Union Organization Islamic de France\":\"Union Organisation Islamique de France\",\"University of Islamic Sciences, Karachi\":\"Universit\xe9 des sciences islamiques, Karachi\",\"Unknown Error\":\"Erreur inconnue\",\"Unreliable\":\"Pr\xe9cision peu fiable\",\"Unresolved (default)\":\"Non r\xe9solu (par d\xe9faut)\",\"Unsupported\":\"Non pris en charge\",\"Up\":\"Haut de la page\",\"Upcoming alarm\":\"Alarme \xe0 venir\",\"Updating widgets\":\"Mise \xe0 jour des widgets\",\"Use 24-Hour format\":\"Utiliser le format 24 heures\",\"Use Compass\":\"Utiliser la boussole\",\"Use Map\":\"Utiliser la carte\",\"Use a different alarm type?\":\"Utiliser un autre type d'alarme ?\",\"Use adaptive theme?\":\"Utiliser un th\xe8me adaptatif ?\",\"Use headphones when available?\":\"Utiliser les \xe9couteurs lorsqu'ils sont disponibles\",\"Using Coordinates\":\"Utilisation des coordonn\xe9es\",\"Using GPS\":\"Utilisation du GPS\",\"Using Search\":\"Utilisation de la recherche\",\"Version\":\"Version\",\"Vibration Mode\":\"Mode vibration\",\"Vibration on call\":\"Vibration lors d'appel\",\"Volume button stops adhan\":\"Le bouton de volume arr\xeate l'Adhan\",\"WIDGET_CHANNEL_NAME\":\"Widget\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"Mise \xe0 jour du widget\",\"We'll help you do them quickly.\":\"Nous vous aiderons \xe0 les r\xe9aliser rapidement.\",\"Wednesday\":\"Mercredi\",\"Welcome\":\"Bienvenue\",\"Western Arabic\":\"Arabe occidental\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Lorsque cette option est activ\xe9e, l'\xe9cran reste \xe9teint lorsque l'adhan ou le rappel commence \xe0 \xeatre diffus\xe9 et l'\xe9cran d'alarme ne s'affiche pas\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"En activant cette option, tous les sons seront jou\xe9s uniquement sur le casque lorsque vous utilisez un casque.\",\"Wifi\":\"Wifi\",\"Yes\":\"Oui\",\"You are facing Kaaba\":\"Vous \xeates en direction de la Kaaba\",\"You are not facing Kaaba\":\"Vous n'\xeates pas en direction de la Kaaba\",\"You can access your device Power Manager using the button below.\":\"Vous pouvez acc\xe9der au gestionnaire d'\xe9nergie de votre appareil en utilisant le bouton ci-dessous.\",\"You can also paste coords from clipboard\":\"Vous pouvez \xe9galement coller les coordonn\xe9es \xe0 partir du presse-papiers\",\"You can change the language used for lunar calendar\":\"Vous pouvez changer la langue utilis\xe9e pour le calendrier lunaire\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"Vous pouvez modifier le moment o\xf9 la notification de l'alarme \xe0 venir est envoy\xe9e avant l'adhan ou le rappel\",\"You can choose to replace one of calendars with your current location\":\"Vous pouvez choisir de remplacer l'un des calendriers avec votre position actuelle\",\"You can hide prayer times you don't want to see in the main screen here:\":\"Vous pouvez masquer les horaires de pri\xe8re que vous ne souhaitez pas voir appara\xeetre sur l'\xe9cran principal ici :\",\"You can hide prayer times you don't want to see in the widget here:\":\"Vous pouvez masquer les horaires de pri\xe8re que vous ne voulez pas voir dans le widget ici :\",\"You can search for your location offline Or use GPS\":\"Vous pouvez rechercher votre position hors ligne ou utiliser le GPS\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"Vous devriez avoir re\xe7u une copie de la licence publique g\xe9n\xe9rale GNU Affero avec ce programme. Si ce n'est pas le cas, consultez https://www.gnu.org/licenses/.\",\"Your sounds\":\"Vos sons\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"Tous les droits d'auteur pour les voix d'Adhan appartiennent \xe0 leurs propri\xe9taires respectifs.\\nRemerciements particuliers \xe0 translation.io (lingui.js) pour leurs merveilleux services.\\nMerci \xe0 tous les membres de la communaut\xe9 open source qui ont cr\xe9\xe9 toutes ces merveilleuses biblioth\xe8ques qui ont rendu cette application possible.\",\"about.credits.google\":\"La plupart des ic\xf4nes utilis\xe9es dans cette application proviennent des ic\xf4nes google material.\",\"about_settings\":\"\xc0 propos de\",\"adjustment.hint\":\"Nombre de minutes qui seront ajout\xe9es aux temps calcul\xe9s\",\"after\":\"apr\xe8s\",\"ago\":\"auparavant\",\"asr.prayer\":\"Asr\",\"backup_settings\":\"Sauvegarde\",\"before\":\"avant\",\"calculation_adjustments_settings\":\"Ajustements\",\"calculation_advanced_settings\":\"Param\xe8tres de calcul avanc\xe9s\",\"calculation_settings\":\"Calcul\",\"counter.fast\":\"Je\xfbne\",\"date.day\":\"jour\",\"date.hour\":\"heure\",\"date.minute\":\"minute\",\"date.second\":\"seconde\",\"dev_settings\":\"D\xe9veloppeur\",\"dhuhr.prayer\":\"Dhuhr\",\"display_settings\":\"Affichage\",\"fajr.prayer\":\"Fajr\",\"favorite_location\":\"Lieux pr\xe9f\xe9r\xe9s\",\"forces all numbers to be in the selected system\":\"Force tous les num\xe9ros \xe0 \xeatre dans le syst\xe8me s\xe9lectionn\xe9\",\"from North\":\"du Nord\",\"from settings\":\"\xe0 partir des param\xe8tres\",\"fullscreen_alarm\":\"Jouer l'Adhan\",\"hijri.adjustment.hint\":\"Nombre de jours qui seront ajout\xe9s au calendrier lunaire\",\"home\":\"Accueil\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"En activant cette option, une notification sera affich\xe9e environ une heure avant l'horaire de la pri\xe8re ou le rappel sonore\",\"intro\":\"intro\",\"is prayer time hidden?\":\"Le temps de pri\xe8re est-il cach\xe9 ?\",\"isha.prayer\":\"Isha\",\"later\":\"plus tard\",\"location_settings\":\"Localisation\",\"maghrib.prayer\":\"Maghrib\",\"masjid_an_nabawi\":\"Masjid An Nabawi\",\"minutes\":\"minutes\",\"moazen_zade\":\"Moazen Zade\",\"modes_settings\":\"Mode Silencieux\",\"monthly_view\":\"Vue mensuelle\",\"muezzin_settings\":\"Adhan\",\"notification_advanced_settings\":\"Param\xe8tres avanc\xe9s\",\"notification_settings\":\"Notification et son\",\"qada_counter\":\"Compteur Qada\",\"qibla_compass\":\"Boussole pour la Qibla\",\"qibla_finder\":\"Chercheur de Qibla\",\"qibla_map\":\"Carte pour la Qibla\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"Rappels\",\"settings\":\"Param\xe8tres\",\"should notification widget be shown?\":\"Le widget de notification doit-il \xeatre affich\xe9 ?\",\"should {prayerName} be hidden?\":[[\"prayerName\"],\" doit-il \xeatre cach\xe9e ?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"le calendrier de l'application \xe9tant pr\xe9calcul\xe9 et non bas\xe9 sur l'observation de la lune, il peut afficher des dates incorrectes pour le d\xe9but et la fin du Ramadan.\",\"sunnah.midnight\":\"Minuit\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"Lever du soleil\",\"sunset\":\"Coucher du soleil\",\"widget_settings\":\"Param\xe8tres des widgets\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" min apr\xe8s \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" min avant \",[\"prayer\"]],\"{prayerName} notification will be shown\":[\"La notification du \",[\"prayerName\"],\" sera affich\xe9e\"],\"{prayerName} sound will be played\":[\"Le son du \",[\"prayerName\"],\" sera jou\xe9\"]}")}),630,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 \u092e\u093f\u0928\u091f\",\"15 min\":\"15 \u092e\u093f\u0928\u091f\",\"30 min\":\"30 \u092e\u093f\u0928\u091f\",\"30 minutes is added to Isha time during Ramadan in this method\":\"\u0907\u0938 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0930\u092e\u091c\u093e\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0908\u0936\u093e \u0915\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 30 \u092e\u093f\u0928\u091f \u091c\u094b\u0921\u093c\u093e \u091c\u093e\u0924\u093e \u0939\u0948\",\"5 min\":\"5 \u092e\u093f\u0928\u091f\",\"60 min\":\"60 \u092e\u093f\u0928\u091f\",\"90 min\":\"90 \u092e\u093f\u0928\u091f\",\"ADHAN_CHANNEL_NAME\":\"\u0905\u091c\u093c\u093e\u0928\",\"Abyad\":\"\u0905\u092c\u094d\u092f\u0926\",\"Accuracy\":\"\u0936\u0941\u0926\u094d\u0927\u0924\u093e\",\"Ad-Free\":\"\u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u092e\u0941\u0915\u094d\u0924\",\"Adaptive Charging\":\"\u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917\",\"Add\":\"\u091c\u094b\u0921\u093c\u0947\u0902\",\"Add Custom Adhan\":\"\u0915\u0938\u094d\u091f\u092e \u0905\u091c\u093c\u093e\u0928 \u091c\u094b\u0921\u093c\u0947\u0902\",\"Add Custom Audio\":\"\u0915\u0938\u094d\u091f\u092e \u0911\u0921\u093f\u092f\u094b \u091c\u094b\u0921\u093c\u0947\u0902\",\"Add Reminder\":\"\u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u091c\u094b\u0921\u093c\u0947\u0902\",\"Add Silent Mode\":\"Add Silent Mode\",\"Add new counter\":\"\u0928\u092f\u093e \u0915\u093e\u0909\u0902\u091f\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\",\"Add new location\":\"\u0928\u092f\u093e \u0938\u094d\u0925\u093e\u0928 \u091c\u094b\u0921\u093c\u0947\u0902\",\"Adhan\":\"\u0905\u091c\u093c\u093e\u0928 \",\"Adhan audio file is not downloaded yet\":\"\u0905\u091c\u093c\u093e\u0928 \u0915\u0940 \u0911\u0921\u093f\u092f\u094b \u092b\u093c\u093e\u0907\u0932 \u0905\u092d\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u0941\u0908 \u0939\u0948\",\"Adjustments\":\"\u0938\u092e\u093e\u092f\u094b\u091c\u0928\",\"Advanced\":\"\u0935\u093f\u0915\u0938\u093f\u0924\",\"Advanced Calculation Settings\":\"\u0909\u0928\u094d\u0928\u0924 \u0917\u0923\u0928\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938\",\"Advanced Settings\":\"\u090f\u0921\u0935\u093e\u0902\u0938 \u0938\u0947\u091f\u093f\u0902\u0917\",\"Ahmer\":\"\u0905\u0939\u092e\u0930 \",\"Al-Azan\":\"\u0905\u0932-\u0905\u091c\u093c\u093e\u0928\",\"Al-Azan - Prayer Times\":\"\u0905\u0932-\u0905\u091c\u093c\u093e\u0928 - \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u093e \u0938\u092e\u092f\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"\u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u0907\u0938 \u0909\u092e\u094d\u092e\u0940\u0926 \u092e\u0947\u0902 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u092f\u0939 \u0909\u092a\u092f\u094b\u0917\u0940 \u0939\u094b\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u0947; \u0935\u094d\u092f\u093e\u092a\u093e\u0930\u093f\u0915\u0924\u093e \u092f\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u0936\u0947\u0937 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u0941\u0915\u094d\u0924\u0924\u093e \u0915\u0940 \u0928\u093f\u0939\u093f\u0924 \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u0947 \u092c\u093f\u0928\u093e \u092d\u0940\u0964 \u0905\u0927\u093f\u0915 \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u091c\u0940\u090f\u0928\u092f\u0942 \u090f\u092b\u0947\u0930\u094b \u091c\u0928\u0930\u0932 \u092a\u092c\u094d\u0932\u093f\u0915 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0926\u0947\u0916\u0947\u0902\u0964\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"\u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u092e\u0941\u092b\u093c\u094d\u0924 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0939\u0948: \u0906\u092a \u0907\u0938\u0947 \u092b\u093c\u094d\u0930\u0940 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u092b\u093c\u093e\u0909\u0902\u0921\u0947\u0936\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u091c\u0940\u090f\u0928\u092f\u0942 \u090f\u092b\u093c\u0947\u0930\u094b \u091c\u0928\u0930\u0932 \u092a\u092c\u094d\u0932\u093f\u0915 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 (v3.0) \u0915\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0947 \u0924\u0939\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093f\u0924\u0930\u093f\u0924 \u0914\u0930/\u092f\u093e \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\",\"Alarms Permission\":\"\u0905\u0932\u093e\u0930\u094d\u092e \u0905\u0928\u0941\u092e\u0924\u093f\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"\u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u0915\u094b \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0938\u092d\u0940 \u0921\u0947\u091f\u093e \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0930\u0942\u092a \u0938\u0947 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u093e \u0921\u0947\u091f\u093e \u0915\u0939\u0940\u0902 \u0905\u092a\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0921\u0947\u0935\u0932\u092a\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0907\u0938\u0915\u0940 \u092a\u0939\u0941\u0902\u091a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0906\u092a\u0915\u093e \u0921\u0947\u091f\u093e \u0915\u093f\u0938\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u092f\u093e \u0915\u094b\u0908 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 (\u090f\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938) \u0915\u094b\u0921 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u091c\u0948\u0938\u0947 \u0915\u093f Google Analytics \u092f\u093e Facebook SDK\u0964\",\"An error occured while playing the current track\":\"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u091f\u094d\u0930\u0948\u0915 \u091a\u0932\u093e\u0924\u0947 \u0938\u092e\u092f \u090f\u0915 \u0917\u0932\u0924\u0940 \u0939\u0941\u0908\",\"App features\":\"\u0910\u092a \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901\",\"Arabic\":\"\u0905\u0930\u092c\u0940\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \\\"\",[\"0\"],\"\\\" \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \\\"\",[\"itemName\"],\"\\\" \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?\"],\"Are you sure you want to delete this?\":\"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0907\u0938\u0947 \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?\",\"Asr Calculation\":\"\u0905\u0938\u0930 \u0915\u0940 \u0917\u0923\u0928\u093e\",\"At least one prayer time must be shown\":\"\u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0928\u092e\u093e\u091c\u093c \u0915\u093e \u0938\u092e\u092f \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\",\"Attention\":\"\u0927\u094d\u092f\u093e\u0928\",\"Auto (Default)\":\"\u0938\u094d\u0935\u0924\u0903 (\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"\u092c\u093e\u092f\u092a\u093e\u0938 \\\"\u0921\u0942 \u0928\u0949\u091f \u0921\u093f\u0938\u094d\u091f\u0930\u094d\u092c\\\"?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"\u0905\u091c\u093c\u093e\u0928 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0915\u0908 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u093f\u0927\u093f \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u0930\u093f\u0923\u093e\u092e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0915\u0940 \u0916\u094b\u091c \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u093e \u0906\u092a\u0915\u0940 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0939\u0948\u0964\",\"Calculation\":\"\u0917\u0923\u0928\u093e\",\"Calculation Method\":\"\u0917\u0923\u0928\u093e \u0935\u093f\u0927\u093f\",\"Calendar\":\"\u092a\u0902\u091a\u093e\u0902\u0917\",\"Cancel\":\"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902\",\"Cancel Alarm\":\"\u0905\u0932\u093e\u0930\u094d\u092e \u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902\",\"Cancel download\":\"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902\",\"Choose Asr Calculation Madhab\":\"\u0905\u0938\u0930 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u093e \u092e\u091c\u093c\u0939\u092c \u091a\u0941\u0928\u0947\u0902\",\"Choose Calculation Method\":\"\u0917\u0923\u0928\u093e \u0935\u093f\u0927\u093f \u091a\u0941\u0928\u0947\u0902\",\"Choose High Latitude Setting\":\"\u0909\u091a\u094d\u091a \u0905\u0915\u094d\u0937\u093e\u0902\u0936 \u0938\u0947\u091f\u093f\u0902\u0917 \u091a\u0941\u0928\u0947\u0902\",\"Choose Language\":\"\u092d\u093e\u0937\u093e \u091a\u0941\u0928\u0947\u0902\",\"Choose Polar Resolution\":\"\u0927\u094d\u0930\u0941\u0935\u0940\u092f \u0930\u0947\u091c\u093c\u094b\u0932\u094d\u092f\u0942\u0936\u0928 \u091a\u0941\u0928\u0947\u0902\",\"Choose Shafaq method\":\"\u0936\u092b\u093e\u0915 \u0935\u093f\u0927\u093f \u091a\u0941\u0928\u0947\u0902\",\"Choose calculation rounding method\":\"\u0917\u0923\u0928\u093e \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915\u0928 \u0935\u093f\u0927\u093f \u091a\u0941\u0928\u0947\u0902\",\"Choose calendar type\":\"\u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0930 \u091a\u0941\u0928\u0947\u0902\",\"Choose lunar calendar language\":\"\u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092d\u093e\u0937\u093e \u091a\u0941\u0928\u0947\u0902\",\"Choose midnight calculation method\":\"\u092e\u0927\u094d\u092f\u0930\u093e\u0924\u094d\u0930\u093f \u0917\u0923\u0928\u093e \u092a\u0926\u094d\u0927\u0924\u093f \u091a\u0941\u0928\u0947\u0902\",\"Choose numbering system\":\"\u0928\u0902\u092c\u0930\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e \u091a\u0941\u0928\u0947\u0902\",\"Choose which calendar to replace\":\"\u091a\u0941\u0928\u0947\u0902 \u0915\u093f \u0915\u094c\u0928 \u0938\u093e \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092c\u0926\u0932\u0928\u093e \u0939\u0948\",\"City/Area\":\"\u0936\u0939\u0930/\u0915\u094d\u0937\u0947\u0924\u094d\u0930\",\"Clear the coordinates\":\"\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902\",\"Clear the location\":\"\u0938\u094d\u0925\u093e\u0928 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902\",\"Clipboard data does not contain coordinates\":\"\u0915\u094d\u0932\u093f\u092a\u092c\u094b\u0930\u094d\u0921 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\",\"Close\":\"\u092c\u0902\u0926 \u0915\u0930\u0928\u093e\",\"Closest City\":\"\u0928\u093f\u0915\u091f\u0924\u092e \u0936\u0939\u0930\",\"Closest Date\":\"\u0928\u093f\u0915\u091f\u0924\u092e \u0924\u093e\u0930\u0940\u0916 \",\"Compass Lock\":\"\u0915\u092e\u094d\u092a\u093e\u0938 \u0932\u0949\u0915\",\"Compass sensor unavailable\":\"\u0915\u092e\u094d\u092a\u093e\u0938 \u0938\u0947\u0902\u0938\u0930 \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927\",\"Confirm\":\"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \",\"Continuous\":\"\u0928\u093f\u0930\u0902\u0924\u0930\",\"Coordinates updated\":\"\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u090f \u0917\u090f\",\"Copy\":\"\u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f\",\"Count\":\"\u0917\u093f\u0928\u0924\u0940 \u0915\u0930\u0928\u093e\",\"Country\":\"\u0926\u0947\u0936\",\"Custom\":\"\u0930\u093f\u0935\u093e\u091c\u093c\",\"Custom sounds and muezzins will not be exported\":\"\u0915\u0938\u094d\u091f\u092e \u0927\u094d\u0935\u0928\u093f\u092f\u093e\u0901 \u0914\u0930 \u092e\u0941\u0905\u091c\u094d\u091c\u093f\u0928 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u090f \u091c\u093e\u090f\u0901\u0917\u0947\",\"Custom upcoming alarm time\":\"\u0915\u0938\u094d\u091f\u092e \u0906\u0917\u093e\u092e\u0940 \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u092e\u092f\",\"Dark\":\"\u0905\u0901\u0927\u0947\u0930\u093e\",\"Date\":\"\u0924\u093e\u0930\u0940\u0916\",\"Decrement\":\"\u0918\u091f\u0924\u0940\",\"Default\":\"\u0921\u093f\u092b\u0949\u0932\u094d\u091f \",\"Delete\":\"\u092e\u093f\u091f\u093e\u0928\u093e\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"\u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0914\u0930 \u090f\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u0935\u0930\u094d\u091c\u0928 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, \u092c\u0948\u091f\u0930\u0940 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940-\u0915\u092d\u0940 \u0906\u092a\u0915\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u0910\u092a \u0915\u094b \u092c\u0902\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0905\u0932\u093e\u0930\u094d\u092e/\u0938\u0942\u091a\u0928\u093e\u0913\u0902 \u0915\u094b \u0921\u093f\u0932\u0940\u0935\u0930 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\",\"Deselect as Fajr Adhan\":\"\u092b\u091c\u094d\u0930 \u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u091a\u092f\u0928 \u0939\u091f\u093e \u0926\u0940\u091c\u093f\u090f \",\"Device sounds\":\"\u0921\u093f\u0935\u093e\u0907\u0938 \u0932\u0917\u0924\u093e \u0939\u0948\",\"Disabled\":\"\u0905\u0915\u094d\u0937\u092e\",\"Disclaimer\":\"\u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923\",\"Dismiss\":\"\u0939\u091f\u093e \u0926\u0940\u091c\u093f\u090f\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"\u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908 \u0921\u093e\u092f\u0928\u0947\u091f \u092a\u0926\u094d\u0927\u0924\u093f \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0938\u092e\u092f \u0915\u093e \u090f\u0915 \u0905\u0928\u0941\u092e\u093e\u0928 \u0939\u0948\u0964 \u091a\u0942\u0902\u0915\u093f \u0938\u092e\u092f \u0915\u0940 \u0938\u091f\u0940\u0915 \u0917\u0923\u0928\u093e \u0915\u0948\u0938\u0947 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0907\u0938 \u092a\u0930 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0938\u092e\u092f \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0930\u0947\u0916\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948, \u0916\u093e\u0938\u0915\u0930 \u0924\u0941\u0930\u094d\u0915\u0940 \u0938\u0947 \u092c\u093e\u0939\u0930\u0964\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"\u0926\u093f\u092f\u093e\u0928\u0947\u091f\u094d\u091c\u093c \u0907\u0938\u0932\u0947\u0930\u0940 \u092c\u0936\u0915\u093e\u0902\u0917\u0932\u0942, \u0924\u0941\u0930\u094d\u0915\u0940\",\"Doesn't use any kind of trackers\":\"\u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u091f\u094d\u0930\u0948\u0915\u0930\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0939\u0948\",\"Don't ask again\":\"\u0926\u094b\u092c\u093e\u0930\u093e \u092e\u0924 \u092a\u0942\u091b\u094b\",\"Don't show again\":\"\u0926\u094b\u092c\u093e\u0930\u093e \u092e\u0924 \u0926\u093f\u0916\u093e\u0913\",\"Don't show alarm screen?\":\"\u0905\u0932\u093e\u0930\u094d\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0928 \u0926\u093f\u0916\u093e\u090f\u0902?\",\"Done\":\"\u0915\u0930 \u0926\u093f\u092f\u093e\",\"Download\":\"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u093e\",\"Eastern Arabic\":\"\u092a\u0942\u0930\u094d\u0935\u0940 \u0905\u0930\u092c\u0940\",\"Edit\":\"\u0938\u0902\u092a\u093e\u0926\u0928 \u0915\u0930\u0928\u093e\",\"Edit Calculation Parameters\":\"\u0917\u0923\u0928\u093e \u092a\u0948\u0930\u093e\u092e\u0940\u091f\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902\",\"Edit Counter\":\"\u0915\u093e\u0909\u0902\u091f\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902\",\"Edit Location\":\"\u0938\u094d\u0925\u093e\u0928 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902\",\"Edit Reminder\":\"\u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902\",\"Edit Silent Mode\":\"Edit Silent Mode\",\"Egyptian General Survey Authority\":\"\u092e\u093f\u0938\u094d\u0930 \u0915\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u0930\u094d\u0935\u0947\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923\",\"Enabled\":\"\u0938\u0915\u094d\u0930\u093f\u092f\",\"End after prayer (minutes)\":\"End after prayer (minutes)\",\"Error getting clipboard data\":\"\u0915\u094d\u0932\u093f\u092a\u092c\u094b\u0930\u094d\u0921 \u0921\u0947\u091f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0917\u0932\u0924\u0940\",\"Error in loading countries\":\"\u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0917\u0932\u0924\u0940\",\"Error while downloading audio\":\"\u0911\u0921\u093f\u092f\u094b \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0917\u0932\u0924\u0940\",\"Error while getting coordinates\":\"\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0917\u0932\u0924\u0940\",\"Error: failed to open file\":\"\u0924\u094d\u0930\u0941\u091f\u093f: \u092b\u093c\u093e\u0907\u0932 \u0916\u094b\u0932\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\",\"Ethiopic\":\"\u0907\u0925\u093f\u092f\u094b\u092a\u093f\u0915\",\"Export app data\":\"\u0910\u092a \u0921\u0947\u091f\u093e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0947\u0902\",\"Export data\":\"\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\",\"Fajr Angle\":\"\u092b\u091c\u094d\u0930 \u0915\u094b\u0923\",\"Find My Location\":\"\u092e\u0947\u0930\u093e \u0938\u094d\u0925\u093e\u0928 \u0916\u094b\u091c\u0947\u0902\",\"Fix Common Problems\":\"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u094b \u0920\u0940\u0915 \u0915\u0930\u0947\u0902\",\"France angle 15\":\"\u092b\u093c\u094d\u0930\u093e\u0902\u0938 \u0915\u094b\u0923 15\",\"France angle 18\":\"\u092b\u093c\u094d\u0930\u093e\u0902\u0938 \u0915\u094b\u0923 18\",\"Friday\":\"\u091c\u0941\u092e\u094d\u092e\u093e\",\"General (default)\":\"\u0938\u093e\u092e\u093e\u0928\u094d\u092f (\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f)\",\"Getting coordinates\":\"\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0930\u0939\u0947\",\"Got it\":\"\u0938\u092e\u091d \u0917\u090f\",\"Gregorian\":\"\u0917\u094d\u0930\u0947\u0917\u094b\u0930\u093f\u092f\u0928\",\"Gulf region\":\"\u0916\u093e\u0921\u093c\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\",\"Hanafi\":\"\u0939\u0928\u092b\u0940\",\"Hidden?\":\"\u091b\u0941\u092a\u0947 \u0939\u0941\u090f?\",\"Hide Prayer Times\":\"\u0928\u092e\u093e\u091c\u093c \u0915\u0947 \u0938\u092e\u092f \u091b\u0941\u092a\u093e\u090f\u0902\",\"Hide times you don't need\":\"\u0910\u0938\u0947 \u0938\u092e\u092f \u091b\u0941\u092a\u093e\u090f\u0902 \u091c\u093f\u0928\u0915\u0940 \u0906\u092a\u0915\u094b \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\",\"High\":\"\u0909\u091a\u094d\u091a\",\"High Latitude\":\"\u0909\u091a\u094d\u091a \u0905\u0915\u094d\u0937\u093e\u0902\u0936\",\"Highlight current prayer\":\"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u094b \u0939\u093e\u0907\u0932\u093e\u0907\u091f \u0915\u0930\u0947\u0902\",\"Home\":\"\u0918\u0930\",\"Homescreen and notification Widgets\":\"\u0939\u094b\u092e\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0914\u0930 \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0935\u093f\u091c\u0947\u091f\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"\u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0915\u093f\u092c\u0932\u093e \u092e\u093e\u0928\u091a\u093f\u0924\u094d\u0930 \u091c\u0948\u0938\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f, \u0910\u092a \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0906\u0935\u0936\u094d\u092f\u0915 \u0921\u0947\u091f\u093e \u0938\u0902\u091a\u093e\u0930\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u0939\u091a\u093e\u0928 \u0915\u0930 \u092d\u0940 \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092d\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0907\u0938\u0947 \u0927\u094d\u092f\u093e\u0928 \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964\",\"I Understand\":\"\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0901\",\"IMPORTANT_CHANNEL_ID\":\"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"\u092f\u0926\u093f \u0938\u0915\u094d\u0937\u092e \u0939\u0948, \u091c\u092c \u090f\u0915 \u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u0907\u0938\u092e\u0947\u0902 \u0905\u0917\u0932\u0940 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u0947 \u0938\u092e\u092f \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0939\u094b\u0917\u0940\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"\u092f\u0926\u093f \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0940 \u092b\u093c\u094b\u0928 \u0938\u0947\u091f\u093f\u0902\u0917 (\u0938\u0947\u091f\u093f\u0902\u0917 / \u092c\u0948\u0915\u0905\u092a \u0914\u0930 \u0930\u0940\u0938\u0947\u091f / \u092c\u0948\u0915\u0905\u092a \u092e\u0947\u0930\u0947 \u0921\u0947\u091f\u093e) \u092e\u0947\u0902 \\\"\u092c\u0948\u0915\u0905\u092a \u0914\u0930 \u0930\u0940\u0938\u0947\u091f\\\" \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0915\u093f Android \u0938\u094d\u0935\u092f\u0902 (\u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u0928\u0939\u0940\u0902) \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u0940 \u090f\u0915 \u092a\u094d\u0930\u0924\u093f Google \u092e\u0947\u0902 \u0938\u0939\u0947\u091c\u0947\u0917\u093e \u0938\u0930\u094d\u0935\u0930\u0964 \u092f\u0926\u093f \u0906\u092a\u0915\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094d\u0937\u0924\u093f\u0917\u094d\u0930\u0938\u094d\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948, \u092f\u093e \u0906\u092a \u090f\u0915 \u0928\u092f\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u0916\u0930\u0940\u0926\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 Android \u0915\u094b \u0906\u092a\u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0905\u0932-\u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0921\u0947\u0935\u0932\u092a\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0907\u0938 \u0921\u0947\u091f\u093e \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"\u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0915\u0941\u091b \u0938\u092e\u092f \u092c\u093e\u0926 \u092d\u0940 \u0910\u092a \u0915\u0947 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0939\u0948, \u0924\u094b \u0905\u0927\u093f\u0915 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e dontkillmyapp.com \u092a\u0930 \u091c\u093e\u090f\u0902\u0964\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"\u092f\u0926\u093f \u0906\u092a \u092f\u0947 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0910\u092a \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0947, \u0924\u094b \u0906\u092a \u0915\u094b \u0907\u0938 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0935\u0930 \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u0947\u0936\u0928 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0906\u092a \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092c\u091f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u092e\u0947\u0902 \u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0939\u0948, \u091c\u0948\u0938\u0947 Google \u092a\u093f\u0915\u094d\u0938\u0947\u0932, \u0914\u0930 \u0906\u092a \u0928\u0939\u0940\u0902 \u091a\u093e\u0939\u0924\u0947 \u0915\u093f \u090f\u0921\u0939\u093e\u0928 \u092f\u093e \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930\u094d\u0938 \u0915\u094b \u0905\u0932\u093e\u0930\u094d\u092e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0939\u091a\u093e\u0928\u093e \u091c\u093e\u090f, \u0924\u094b \u0906\u092a \u0907\u0938 \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\",\"Import\":\"\u0906\u092f\u093e\u0924\",\"Import app data\":\"\u0910\u092a \u0921\u0947\u091f\u093e \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902\",\"Import successful\":\"\u0906\u092f\u093e\u0924 \u0938\u092b\u0932 \u0930\u0939\u093e\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"\u092a\u093e\u0902\u091a \u0926\u0948\u0928\u093f\u0915 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e\u0913\u0902 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u0907\u0938\u092e\u0947\u0902 \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f, \u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924, \u092e\u0927\u094d\u092f\u0930\u093e\u0924\u094d\u0930\u093f \u0914\u0930 \u0930\u093e\u0924 \u0915\u0940 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e (\u0924\u0939\u091c\u094d\u091c\u0941\u0926) \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0939\u0948\u0902\u0964\",\"Increment\":\"\u0935\u0947\u0924\u0928 \u0935\u0943\u0926\u094d\u0927\u093f\",\"Info\":\"\u091c\u093e\u0928\u0915\u093e\u0930\u0940\",\"Internet connection\":\"\u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"\u0915\u093f\u092c\u0932\u093e \u092e\u0948\u092a \u0915\u0947 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0935\u093e\u0908\u092b\u093e\u0908 \u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0921\u0947\u091f\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964\",\"Iran\":\"\u0908\u0930\u093e\u0928\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940, \u092b\u093e\u0930\u0938\u0940, \u0905\u0930\u092c\u0940, \u0924\u0941\u0930\u094d\u0915\u0940, \u0907\u0902\u0921\u094b\u0928\u0947\u0936\u093f\u092f\u093e\u0908, \u092b\u094d\u0930\u0947\u0902\u091a, \u0909\u0930\u094d\u0926\u0942, \u0939\u093f\u0902\u0926\u0940, \u091c\u0930\u094d\u092e\u0928, \u092c\u094b\u0938\u094d\u0928\u093f\u092f\u093e\u0908, \u0935\u093f\u092f\u0924\u0928\u093e\u092e\u0940, \u092c\u093e\u0902\u0917\u094d\u0932\u093e \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u0928\u0940\u092f\u0915\u0943\u0924 \u0939\u0948\",\"Isha Angle\":\"\u0908\u0936\u093e \u0915\u094b\u0923\",\"Isha Interval\":\"\u0908\u0936\u093e \u0905\u0902\u0924\u0930\u093e\u0932\",\"Islamic\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u0940\",\"Islamic (Saudi Arabia sighting)\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u0940 (\u0938\u090a\u0926\u0940 \u0905\u0930\u092c \u0926\u093f\u0916\u0928\u093e)\",\"Islamic (Umm al-Qura)\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u0940 (\u0909\u092e\u094d\u092e \u0905\u0932-\u0915\u093c\u0941\u0930\u093e)\",\"Islamic (civil)\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u0940 (\u0938\u093f\u0935\u093f\u0932)\",\"Islamic (tabular)\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u0940 (\u0938\u093e\u0930\u0923\u0940\u092c\u0926\u094d\u0927)\",\"Islamic Society of North America (ISNA)\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u093f\u0915 \u0938\u094b\u0938\u093e\u092f\u091f\u0940 \u0911\u092b \u0928\u0949\u0930\u094d\u0925 \u0905\u092e\u0947\u0930\u093f\u0915\u093e (\u0906\u0908\u090f\u0938\u090f\u0928\u090f)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"\u0910\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u092c\u0948\u0915\u0905\u092a \u0906\u092f\u093e\u0924 \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948, \u0907\u0938 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u092c\u0948\u091f\u0930\u0940 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u093e \u0928 \u092d\u0942\u0932\u0947\u0902\",\"Just now\":\"\u092c\u0938 \u0905\u092c\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"\u0915\u0947\u092e\u0947\u0902\u091f\u094d\u0930\u093f\u092f\u0928 \u0905\u0917\u093e\u092e\u093e \u0930\u093f\u092a\u092c\u094d\u0932\u093f\u0915 \u0907\u0902\u0921\u094b\u0928\u0947\u0936\u093f\u092f\u093e (\u0915\u0947\u092e\u0947\u0928\u093e\u0917)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"\u0915\u0947\u092e\u0947\u0902\u091f\u094d\u0930\u093f\u092f\u0928 \u0939\u093e\u0932 \u090f\u0939\u0935\u093e\u0932 \u0909\u0917\u093e\u092e\u093e (\u092c\u094d\u0930\u0941\u0928\u0947\u0908 \u0926\u093e\u0930\u0941\u0938\u094d\u0938\u0932\u093e\u092e)\",\"Kuwait\":\"\u0915\u0941\u0935\u0948\u091f\",\"Label\":\"\u0932\u0947\u092c\u0932\",\"Language\":\"\u092d\u093e\u0937\u093e\",\"Latitude\":\"\u0905\u0915\u094d\u0937\u093e\u0902\u0936\",\"Latitude is invalid\":\"\u0905\u0915\u094d\u0937\u093e\u0902\u0936 \u0905\u092e\u093e\u0928\u094d\u092f \u0939\u0948\",\"License\":\"\u0932\u093e\u0907\u0938\u0947\u0902\u0938\",\"Light\":\"\u0930\u094b\u0936\u0928\u0940\",\"Light and Dark theme\":\"\u0932\u093e\u0907\u091f \u090f\u0902\u0921 \u0921\u093e\u0930\u094d\u0915 \u0925\u0940\u092e\",\"Light/Dark theme\":\"\u0932\u093e\u0907\u091f / \u0921\u093e\u0930\u094d\u0915 \u0925\u0940\u092e\",\"List is empty\":\"\u0938\u0942\u091a\u0940 \u0916\u093e\u0932\u0940 \u0939\u0948\",\"Loading\":\"\u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\",\"Location\":\"\u0938\u094d\u0925\u093e\u0928\",\"Location settings\":\"\u0938\u094d\u0925\u093e\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938\",\"Longitude\":\"\u0926\u0947\u0936\u093e\u0902\u0924\u0930\",\"Longitude is invalid\":\"\u0926\u0947\u0936\u093e\u0902\u0924\u0930 \u0905\u092e\u093e\u0928\u094d\u092f \u0939\u0948\",\"Low\":\"\u0915\u092e\",\"Lunar Calendar\":\"\u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930\",\"Lunar Calendar Language\":\"\u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092d\u093e\u0937\u093e\",\"Maghrib Angle\":\"\u092e\u0917\u0930\u093f\u092c \u0915\u094b\u0923\",\"Make a Copy\":\"\u090f\u0915 \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u092c\u0928\u093e \u0932\u094b\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"\u0905\u0926\u0928 (\u0627\u0630\u0627\u0646) \u0917\u0923\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0915\u0908 \u0935\u093f\u0915\u0932\u094d\u092a\",\"Medium\":\"\u092e\u0927\u094d\u092f\u092e\",\"Middle of the Night\":\"\u0906\u0927\u0940 \u0930\u093e\u0924 \u092e\u0947\u0902\",\"Midnight Method\":\"\u0906\u0927\u0940 \u0930\u093e\u0924 \u0915\u0940 \u0935\u093f\u0927\u093f\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"\u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u093e\u092e\u0932\u094b\u0902 \u0914\u0930 \u0935\u0915\u094d\u092b \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f, \u0905\u0932\u094d\u091c\u0940\u0930\u093f\u092f\u093e\",\"Ministry of Religious Affairs of Tunisia\":\"\u091f\u094d\u092f\u0942\u0928\u0940\u0936\u093f\u092f\u093e \u0915\u0947 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u093e \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f\",\"Mobile Data\":\"\u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\",\"Modified\":\"\u0938\u0902\u0936\u094b\u0927\u093f\u0924\",\"Monday\":\"\u0938\u094b\u092e\u0935\u093e\u0930\",\"Moonsighting Committee\":\"\u091a\u0902\u0926\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0938\u092e\u093f\u0924\u093f\",\"Muslim World League\":\"\u092e\u0941\u0938\u094d\u0932\u093f\u092e \u0935\u0930\u094d\u0932\u094d\u0921 \u0932\u0940\u0917\",\"Name\":\"\u0928\u093e\u092e\",\"Nearest\":\"\u0928\u093f\u0915\u091f\u0924\u092e\",\"New Counter\":\"\u0928\u092f\u093e \u0915\u093e\u0909\u0902\u091f\u0930\",\"New Location\":\"\u0928\u092f\u093e \u0938\u094d\u0925\u093e\u0928\",\"New Reminder\":\"\u0928\u092f\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915\",\"New Silent Mode\":\"New Silent Mode\",\"Next\":\"\u0905\u0917\u0932\u093e\",\"Next Day\":\"\u0905\u0917\u0932\u0947 \u0926\u093f\u0928\",\"Next Month\":\"\u0905\u0917\u0932\u0947 \u092e\u0939\u0940\u0928\u0947\",\"No\":\"\u0928\u0939\u0940\u0902\",\"No Data\":\"\u0915\u094b\u0908 \u0906\u0915\u0921\u093c\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\",\"No Results\":\"\u0915\u094b\u0908 \u092a\u0930\u093f\u0923\u093e\u092e \u0928\u0939\u0940\u0902\",\"None\":\"\u0915\u094b\u0908 \u0928\u0939\u0940\u0902\",\"None (Automatic)\":\"\u0915\u094b\u0908 \u0928\u0939\u0940\u0902 (\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924)\",\"Normal mode restored\":\"Normal mode restored\",\"Not now\":\"\u0905\u092d\u0940 \u0928\u0939\u0940\u0902\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"\u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902 \u0915\u093f \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0914\u0930 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923, \u0907\u0938 \u0910\u092a \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e \u0915\u093f\u092c\u0932\u093e \u0926\u093f\u0936\u093e, \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0915\u0902\u092a\u093e\u0938 \u092e\u094b\u0921 \u092e\u0947\u0902, \u0917\u0932\u0924 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964\",\"Notification\":\"\u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e\",\"Notification & Sound\":\"\u0938\u0942\u091a\u0928\u093e \u0927\u094d\u0935\u0928\u093f\",\"Notifications Permission\":\"\u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0905\u0928\u0941\u092e\u0924\u093f\",\"Numbering system\":\"\u0928\u0902\u092c\u0930\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e\",\"Off\":\"\u092c\u0902\u0926\",\"Okay\":\"\u0920\u0940\u0915\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"\u090f\u0902\u0921\u094d\u0930\u0949\u0907\u0921 12 \u0914\u0930 \u0928\u090f \u092a\u0930, \u0910\u092a \u0915\u094b \u0920\u0940\u0915 \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u093e\u0930\u094d\u092e \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u0940 \u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0907\u0938\u0947 \u092d\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0928\u0940 \u0939\u094b\u0917\u0940\u0964\",\"Once\":\"\u090f\u0915 \u092c\u093e\u0930\",\"One-Seventh of the Night\":\"\u0930\u093e\u0924 \u0915\u093e \u090f\u0915-\u0938\u093e\u0924\u0935\u093e\u0902 \u0939\u093f\u0938\u094d\u0938\u093e\",\"Only once?\":\"\u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930?\",\"Only six items can be shown at the same time\":\"\u090f\u0915 \u0939\u0940 \u0938\u092e\u092f \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u091b\u0939 \u091a\u0940\u091c\u093c\u0947\u0902 \u0926\u093f\u0916\u093e\u090f \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\",\"Open Battery Optimization Settings\":\"\u092c\u0948\u091f\u0930\u0940 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932\u0947\u0902\",\"Open Power Manager Settings\":\"\u092a\u093e\u0935\u0930 \u092e\u0948\u0928\u0947\u091c\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932\u0947\u0902\",\"Open source repository\":\"\u0913\u092a\u0928 \u0938\u094b\u0930\u094d\u0938 \u0930\u093f\u092a\u0949\u091c\u093f\u091f\u0930\u0940\",\"Open-source\":\"\u0916\u0941\u0932\u093e \u0938\u094d\u0924\u094d\u0930\u094b\u0924\",\"Options\":\"\u0935\u093f\u0915\u0932\u094d\u092a\",\"Or if you have a backup, you can import it\":\"\u092f\u093e \u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092c\u0948\u0915\u0905\u092a \u0939\u0948, \u0924\u094b \u0906\u092a \u0907\u0938\u0947 \u0906\u092f\u093e\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\",\"Orientation Lock: Landscape\":\"\u0913\u0930\u093f\u090f\u0902\u091f\u0947\u0936\u0928 \u0932\u0949\u0915: \u0932\u0948\u0902\u0921\u0938\u094d\u0915\u0947\u092a\",\"Orientation Lock: Portrait\":\"\u0913\u0930\u093f\u090f\u0902\u091f\u0947\u0936\u0928 \u0932\u0949\u0915: \u092a\u094b\u0930\u094d\u091f\u094d\u0930\u0947\u091f\",\"Orientation: Unlocked\":\"\u0926\u093f\u0936\u093e: \u0916\u0941\u0932\u093e\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"\u0905\u0928\u094d\u092f \u091a\u0941\u0902\u092c\u0915\u0940\u092f \u0909\u092a\u0915\u0930\u0923 \u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u0947 \u0915\u0902\u092a\u093e\u0938 \u092e\u0947\u0902 \u0939\u0938\u094d\u0924\u0915\u094d\u0937\u0947\u092a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a\u0915\u0947 \u0915\u0902\u092a\u093e\u0938 \u0915\u094b \u0905\u0902\u0936\u093e\u0902\u0915\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964\",\"PRAYER_MODE_CHANNEL_NAME\":\"Silent Mode\",\"PRE_ADHAN_CHANNEL_NAME\":\"\u0906\u0917\u093e\u092e\u0940 \u0905\u0927\u0928\",\"PRE_REMINDER_CHANNEL_NAME\":\"\u0906\u0917\u093e\u092e\u0940 \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915\",\"Pakistan\":\"\u092a\u093e\u0915\u093f\u0938\u094d\u0924\u093e\u0928\",\"Paste\":\"\u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\",\"Persian\":\"\u092b\u093c\u093e\u0930\u0938\u0940\",\"Phone State Permission\":\"\u092b\u094b\u0928 \u0930\u093e\u091c\u094d\u092f \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f\",\"Play\":\"\u0916\u0947\u0932\",\"Please enable location service\":\"\u0915\u0943\u092a\u092f\u093e \u0938\u094d\u0925\u093e\u0928 \u0938\u0947\u0935\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"\u0915\u0943\u092a\u092f\u093e \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902 \u0915\u093f \u0907\u0938 \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0938\u0947 \u090f\u0921\u0939\u093e\u0928 \u0914\u0930 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930\u094d\u0938 \u0926\u0947\u0930\u0940 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0915\u0941\u091b \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092d\u0940 \u0928\u0939\u0940\u0902\u0964 \u0907\u0938\u0947 \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964\",\"Polar Resolution\":\"\u0927\u094d\u0930\u0941\u0935\u0940\u092f \u0930\u0947\u091c\u093c\u094b\u0932\u094d\u092f\u0942\u0936\u0928 \",\"Power Manager\":\"\u092a\u093e\u0935\u0930 \u092e\u0948\u0928\u0947\u091c\u0930\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"\u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u093e \u0938\u092e\u092f\",\"Prayer list\":\"\u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0938\u0942\u091a\u0940\",\"Press to search\":\"\u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u092c\u093e\u090f\u0901\",\"Press to select a method\":\"\u0915\u094b\u0908 \u0935\u093f\u0927\u093f \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u092c\u093e\u090f\u0901\",\"Prev Day\":\"\u092a\u093f\u091b\u0932\u093e \u0926\u093f\u0928\",\"Prev Month\":\"\u092a\u093f\u091b\u0932\u093e \u092e\u0939\u0940\u0928\u093e\",\"Privacy Policy\":\"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e-\u092a\u094d\u0930\u0925\u092e \u0913\u092a\u0928-\u0938\u094b\u0930\u094d\u0938 \u092e\u0941\u0938\u094d\u0932\u093f\u092e \u0905\u0926\u0928 (\u0907\u0938\u094d\u0932\u093e\u092e\u093f\u0915 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0938\u092e\u092f) \u0914\u0930 \u0915\u093c\u093f\u092c\u0932\u093e \u0910\u092a\",\"Qada counter\":\"\u0915\u0921\u093c\u093e \u0915\u093e\u0909\u0902\u091f\u0930\",\"Qatar\":\"\u0915\u0924\u0930\",\"Qibla\":\"\u0915\u093f\u092c\u0932\u093e\",\"Qibla finder\":\"\u0915\u093f\u092c\u0932\u093e \u0916\u094b\u091c\u0915\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"\u0915\u093f\u092c\u0932\u093e \u0916\u094b\u091c\u0915 \u0915\u094b \u0938\u094d\u0925\u093e\u0928 \u0938\u0947\u0935\u093e \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u092f\u0926\u093f \u0938\u0915\u094d\u0937\u092e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0924\u094b \u0910\u092a \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u0947 \u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"Qibla \u0928\u0915\u094d\u0936\u093e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 F-Droid \u092c\u093f\u0932\u094d\u0921 \u092e\u0947\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u0947 \u0905\u092a\u0921\u0947\u091f \u092e\u0947\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964\",\"REMINDER_CHANNEL_NAME\":\"\u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915\",\"Ramadan is ending,\":\"\u0930\u092e\u091c\u093e\u0928 \u0916\u0924\u094d\u092e \u0939\u094b \u0930\u0939\u093e \u0939\u0948,\",\"Ramadan is near,\":\"\u0930\u092e\u091c\u093e\u0928 \u0915\u0930\u0940\u092c \u0939\u0948,\",\"Remaining till\":\"\u0924\u0915 \u0936\u0947\u0937 \u0939\u0948\",\"Remind me next year\":\"\u092e\u0941\u091d\u0947 \u0905\u0917\u0932\u0947 \u0938\u093e\u0932 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u090f\u0902\",\"Reminder\":\"\u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915\",\"Repeat\":\"\u0926\u094b\u0939\u0930\u093e\u0928\u093e\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"\u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0905\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0902\u0964 \u0910\u092a \u092e\u0947\u0902 \u0928\u092e\u093e\u091c\u093c \u0915\u093e \u0935\u0915\u094d\u0924 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b \u0907\u0938\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947 \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964\",\"Rounding Method\":\"\u0917\u094b\u0932 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0935\u093f\u0927\u093f\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"\u0938\u0948\u092e\u0938\u0902\u0917 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u093e \u0905\u092a\u0928\u093e \u0916\u0941\u0926 \u0915\u093e \u0915\u0938\u094d\u091f\u092e \u092a\u093e\u0935\u0930 \u092e\u0948\u0928\u0947\u091c\u0930 \u0939\u094b\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \\\"\u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947\u092f\u0930\\\" \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092c\u091f\u0928 \u0915\u094b \u0926\u092c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0906\u092a \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947\u092f\u0930 \u0915\u0947 \u092c\u0948\u091f\u0930\u0940 \u092e\u0947\u0928\u0942 \u092a\u0930 \u092a\u0939\u0941\u0902\u091a \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u092c\u0948\u091f\u0930\u0940 \u092e\u0947\u0928\u0942 \u092e\u0947\u0902 \\\"\u0910\u092a \u092a\u093e\u0935\u0930 \u092e\u0948\u0928\u0947\u091c\u092e\u0947\u0902\u091f\\\" \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 \\\"\u0910\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0938\u094d\u0932\u0940\u092a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0930\u0916\u093e \u091c\u093e\u090f\u0917\u093e\\\" \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0907\u0938 \u0910\u092a \u0915\u094b \u0909\u0938 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\",\"Saturday\":\"\u0936\u0928\u093f\u0935\u093e\u0930\",\"Saudi Arabia\":\"\u0938\u090a\u0926\u0940 \u0905\u0930\u092c\",\"Search\":\"\u0916\u094b\u091c\",\"Secondary Calendar\":\"\u092e\u093e\u0927\u094d\u092f\u092e\u093f\u0915 \u0915\u0948\u0932\u0947\u0902\u0921\u0930\",\"See favorite locations\":\"\u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0938\u094d\u0925\u093e\u0928 \u0926\u0947\u0916\u0947\u0902\",\"Select as Fajr Adhan\":\"\u092b\u091c\u094d\u0930 \u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u091a\u0941\u0928\u0947\u0902\",\"Select different Adhan audio for Fajr namaz\":\"\u092b\u091c\u094d\u0930 \u0928\u092e\u093e\u091c \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0905\u0926\u0928 \u0911\u0921\u093f\u092f\u094b \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\",\"Selected\":\"\u0917\u093f\u0928\u0947 \u091a\u0941\u0928\u0947\",\"Selected as adhan\":\"\u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091a\u0941\u0928\u093e \u0917\u092f\u093e\",\"Selected as fajr adhan\":\"\u092b\u091c\u094d\u0930 \u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091a\u0941\u0928\u093e \u0917\u092f\u093e\",\"Selecting a name is required\":\"\u0928\u093e\u092e \u091a\u0941\u0928\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\",\"Set custom Adhan audio\":\"\u0915\u0938\u094d\u091f\u092e \u0905\u0926\u0928 \u0911\u0921\u093f\u092f\u094b \u0938\u0947\u091f \u0915\u0930\u0947\u0902\",\"Set reminders before or after a prayer time\":\"\u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u0947 \u0938\u092e\u092f \u0938\u0947 \u092a\u0939\u0932\u0947 \u092f\u093e \u092c\u093e\u0926 \u092e\u0947\u0902 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\",\"Shafaq\":\"\u0936\u092b\u093c\u0915\u093c\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\u0907\u0936\u093e\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0930\u0942\u092f\u0924\u0947 \u0939\u093f\u0932\u093e\u0932 \u0915\u092e\u093f\u091f\u0940 \u0938\u093e\u0902\u091d \u0915\u0940 \u0935\u093f\u0927\u093f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0940 \u0939\u0948\",\"Shafi, Maliki, Hanbali (Default)\":\"\u0936\u093e\u092b\u0907, \u092e\u0932\u093f\u0915\u0940, \u0939\u0928\u092c\u0932\u0940 (\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u0936\u093f\u092f\u093e \u0907\u0925\u0928\u093e \u0905\u0936\u0930\u0940, \u0932\u0947\u0935\u093e \u0938\u0902\u0938\u094d\u0925\u093e\u0928, \u0916\u093c\u0941\u092e\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u0936\u093f\u092f\u093e, \u092d\u0942\u092d\u094c\u0924\u093f\u0915\u0940 \u0938\u0902\u0938\u094d\u0925\u093e\u0928, \u0924\u0947\u0939\u0930\u093e\u0928 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f\",\"Should app highlight current prayer instead of next prayer?\":\"\u0915\u094d\u092f\u093e \u0910\u092a \u0915\u094b \u0905\u0917\u0932\u0940 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u0947 \u092c\u091c\u093e\u092f \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u094b \u0939\u093e\u0907\u0932\u093e\u0907\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\u0915\u094d\u092f\u093e \\\"\u0921\u0942 \u0928\u0949\u091f \u0921\u093f\u0938\u094d\u091f\u0930\u094d\u092c\\\" \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b\u0928\u0947 \u092a\u0930 \u092d\u0940 \u0910\u092a \u0915\u094b \u0905\u0927\u093e\u0928 \u0916\u0947\u0932\u0928\u093e \u091a\u093e\u0939\u093f\u090f?\",\"Should app stop playing adhan when the volume button is pressed?\":\"\u0915\u094d\u092f\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u091f\u0928 \u0926\u092c\u093e\u090f \u091c\u093e\u0928\u0947 \u092a\u0930 \u0910\u092a \u0915\u094b \u090f\u0921\u0928 \u092c\u091c\u093e\u0928\u093e \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0928\u093e \u091a\u093e\u0939\u093f\u090f?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"\u0915\u094d\u092f\u093e \u0905\u091c\u093c\u093e\u0928 \u092f\u093e \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u092c\u091c\u0928\u0947 \u092a\u0930 \u092b\u093c\u094b\u0928 \u092e\u0947\u0902 \u0915\u0902\u092a\u0928 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f?\",\"Show Adhan Options\":\"\u0905\u091c\u093c\u093e\u0928 \u0915\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u0926\u093f\u0916\u093e\u090f\u0902\",\"Show Today\":\"\u0906\u091c \u0926\u093f\u0916\u093e\u090f\u0901\",\"Show countdown?\":\"\u0909\u0932\u091f\u0940 \u0917\u093f\u0928\u0924\u0940 \u0926\u093f\u0916\u093e\u090f\u0902?\",\"Show current\":\"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0926\u093f\u0916\u093e\u090f\u0901\",\"Show me\":\"\u092e\u0941\u091d\u0947 \u0926\u093f\u0916\u093e\u0913\",\"Show next in notification?\":\"\u0938\u0942\u091a\u0928\u093e \u092e\u0947\u0902 \u0905\u0917\u0932\u093e \u0926\u093f\u0916\u093e\u090f\u0902?\",\"Show notification widget?\":\"\u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0935\u093f\u091c\u0947\u091f \u0926\u093f\u0916\u093e\u090f\u0902?\",\"Show settings\":\"\u0938\u0947\u091f\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u090f\u0901\",\"Show upcoming alarm notification?\":\"\u0906\u0917\u093e\u092e\u0940 \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0916\u093e\u090f\u0902?\",\"Silent\":\"\u091a\u0941\u092a\u091a\u093e\u092a\",\"Silent Mode Ended\":\"Silent Mode Ended\",\"Silent Mode Name\":\"Silent Mode Name\",\"Silent Mode Started\":\"Silent Mode Started\",\"Silent mode activated\":\"Silent mode activated\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"\u091a\u0942\u0901\u0915\u093f \u0939\u092e \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u091f\u094d\u0930\u0948\u0915\u0930 \u092f\u093e \u0915\u094d\u0930\u0948\u0936 \u090f\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u093e\u0930\u0947 \u091c\u0940\u0925\u092c \u0930\u0947\u092a\u094b \u092a\u0930 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u092f\u093e \u0938\u0941\u091d\u093e\u0935 \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902\",\"Singapore\":\"\u0938\u093f\u0902\u0917\u093e\u092a\u0941\u0930\",\"Skip\":\"\u091b\u094b\u0921\u093c\u0947\u0902\",\"Software License\":\"\u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0932\u093e\u0907\u0938\u0947\u0902\u0938\",\"Solar Hijri\":\"\u0938\u094c\u0930 \u0939\u093f\u091c\u0930\u0940\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"\u0910\u092a \u0915\u094b \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0921\u093f\u0935\u093e\u0907\u0938\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0947 \u092a\u093e\u0935\u0930 \u092e\u0948\u0928\u0947\u091c\u0930 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0909\u0938 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u092d\u0940 \u092c\u093f\u091c\u0932\u0940 \u092c\u091a\u0924 \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964\",\"Sound\":\"\u0927\u094d\u0935\u0928\u093f\",\"Spiritual Administration of Muslims of Russia\":\"\u0930\u0942\u0938 \u0915\u0947 \u092e\u0941\u0938\u0932\u092e\u093e\u0928\u094b\u0902 \u0915\u093e \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092a\u094d\u0930\u0936\u093e\u0938\u0928\",\"Start before prayer (minutes)\":\"Start before prayer (minutes)\",\"Status\":\"\u0926\u0930\u094d\u091c\u093e\",\"Stop\":\"\u0930\u0941\u0915\u0928\u093e\",\"Sunday\":\"\u0930\u0935\u093f\u0935\u093e\u0930\",\"Sunset to Fajr (Default)\":\"\u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u0938\u0947 \u092b\u091c\u094d\u0930 \u0924\u0915 (\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f)\",\"Sunset to Sunrise\":\"\u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u0938\u0947 \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f \u0924\u0915\",\"System Default\":\"\u092a\u094d\u0930\u0923\u093e\u0932\u0940\u0917\u0924 \u0921\u093f\u092b\u0949\u0932\u094d\u091f\",\"Tahajjud time mentioned in the app is the last third of the night\":\"\u0910\u092a \u092e\u0947\u0902 \u0909\u0932\u094d\u0932\u093f\u0916\u093f\u0924 \u0924\u0939\u091c\u094d\u091c\u0941\u0926 \u0915\u093e \u0938\u092e\u092f \u0930\u093e\u0924 \u0915\u093e \u0906\u0916\u093f\u0930\u0940 \u0924\u0940\u0938\u0930\u093e \u0939\u0948\",\"Thai Solar\":\"\u0925\u093e\u0908 \u0938\u094b\u0932\u0930\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"\u0907\u0938 \u0910\u092a \u0915\u094b \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0927\u0928\u094d\u092f\u0935\u093e\u0926! \u0907\u0938 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u092a\u0915\u094b \u0915\u0941\u091b \u091a\u0940\u091c\u0947\u0902 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964\",\"The Gulf Region (Dubai)\":\"\u0916\u093e\u0921\u093c\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 (\u0926\u0941\u092c\u0908)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"\u0910\u092a \u0915\u093e \u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092a\u0942\u0930\u094d\u0935-\u0917\u0923\u0928\u093e \u0939\u0948 \u0914\u0930 \u0938\u091f\u0940\u0915 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u091a\u0902\u0926\u094d\u0930\u092e\u093e \u0915\u0947 \u0926\u0947\u0916\u0947 \u091c\u093e\u0928\u0947 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0930\u092e\u091c\u093e\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0914\u0930 \u0905\u0902\u0924 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0964\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"\u0907\u0938 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0914\u0930 \u0910\u092a \u092e\u0947\u0902 \u092a\u093e\u092f\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u092a\u093e\u0920 \u0905\u0928\u094d\u092f \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u091f\u0940\u0915 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"\u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u091c\u094b \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0947 \u0936\u0940\u0930\u094d\u0937 \u092a\u0930 \u0914\u0930 \u0935\u093f\u091c\u0947\u091f\u094d\u0938 \u092e\u0947\u0902 \u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0915\u0947 \u092c\u0917\u0932 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\",\"The type of lunar calendar shown in main screen and widgets\":\"\u092e\u0941\u0916\u094d\u092f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0914\u0930 \u0935\u093f\u091c\u0947\u091f\u094d\u0938 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e \u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930\",\"Theme Color\":\"\u0925\u0940\u092e \u0930\u0902\u0917\",\"Thursday\":\"\u0917\u0941\u0930\u0941\u0935\u093e\u0930\",\"Time\":\"\u0938\u092e\u092f\",\"Time condition\":\"\u0938\u092e\u092f \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f\",\"Time format\":\"\u0938\u092e\u092f \u092a\u094d\u0930\u093e\u0930\u0942\u092a\",\"Time list\":\"\u0938\u092e\u092f \u0938\u0942\u091a\u0940\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"\u0905\u091c\u093c\u093e\u0928 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e\u0947\u0902 \u0906\u092a \u0915\u0940 \u0932\u094b\u0915\u0947\u0936\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \\\"\u092e\u0947\u0930\u093e \u0938\u094d\u0925\u093e\u0928 \u0916\u094b\u091c\u0947\u0902\\\" \u092c\u091f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u092f\u093e \u0926\u0947\u0936 \u0914\u0930 \u0936\u0939\u0930/\u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0930\u094d\u091a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u092f\u093e \u0905\u092a\u0928\u0947 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932\u0940 \u0926\u0930\u094d\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\",\"To see notifications about adhan, we need your permission.\":\"\u092a\u093e\u0932\u0928 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u091a\u093e\u0939\u093f\u090f\u0964\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"\u091c\u092c \u0906\u092a \u0915\u0949\u0932 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0905\u0926\u0928 \u0916\u0947\u0932\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092b\u093c\u094b\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u092a\u0922\u093c\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947\u0928\u0947 \u0938\u0947 \u0938\u0941\u0935\u093f\u0927\u093e \u0905\u0915\u094d\u0937\u092e \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\",\"Tomorrow\":\"\u0915\u0932 \u0915\u093e \u0926\u093f\u0928\",\"Tuesday\":\"\u092e\u0902\u0917\u0932\u0935\u093e\u0930\",\"Turn Left\":\"\u092c\u093e\u0902\u090f \u092e\u0941\u0921\u093c\u093f\u090f\",\"Turn Right\":\"\u0926\u093e\u0902\u090f \u092e\u0941\u0921\u093c\u093f\u090f\",\"Turn history off\":\"\u0907\u0924\u093f\u0939\u093e\u0938 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902\",\"Turn history on\":\"\u0907\u0924\u093f\u0939\u093e\u0938 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\",\"Twilight Angle\":\"\u0917\u094b\u0927\u0942\u0932\u093f \u0915\u094b\u0923\",\"Umm al-Qura University, Makkah\":\"\u0909\u092e\u094d\u092e \u0905\u0932-\u0915\u093c\u0941\u0930\u093e \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092e\u0915\u094d\u0915\u093e\",\"Union Organization Islamic de France\":\"\u0938\u0902\u0918 \u0938\u0902\u0917\u0920\u0928 \u0907\u0938\u094d\u0932\u093e\u092e\u093f\u0915 \u0921\u0940 \u092b\u094d\u0930\u093e\u0902\u0938\",\"University of Islamic Sciences, Karachi\":\"\u0907\u0938\u094d\u0932\u093e\u092e\u0940 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u0915\u0930\u093e\u091a\u0940\",\"Unknown Error\":\"\u0905\u091c\u094d\u091e\u093e\u0924 \u0924\u094d\u0930\u0941\u091f\u093f\",\"Unreliable\":\"\u0905\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f\",\"Unresolved (default)\":\"\u0905\u0928\u0938\u0941\u0932\u091d\u093e (\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f)\",\"Unsupported\":\"\u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924\",\"Up\":\"\u090a\u092a\u0930\",\"Upcoming alarm\":\"\u0906\u0917\u093e\u092e\u0940 \u0905\u0932\u093e\u0930\u094d\u092e\",\"Updating widgets\":\"\u0935\u093f\u091c\u0947\u091f \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\",\"Use 24-Hour format\":\"24 \u0918\u0902\u091f\u0947 \u0915\u0947 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\",\"Use Compass\":\"\u0915\u092e\u094d\u092a\u093e\u0938 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\",\"Use Map\":\"\u092e\u093e\u0928\u091a\u093f\u0924\u094d\u0930 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\",\"Use a different alarm type?\":\"\u0915\u093f\u0938\u0940 \u092d\u093f\u0928\u094d\u0928 \u0905\u0932\u093e\u0930\u094d\u092e \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902?\",\"Use adaptive theme?\":\"\u090f\u0921\u093e\u092a\u094d\u091f\u093f\u0935 \u0925\u0940\u092e \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0947\u0902?\",\"Use headphones when available?\":\"\u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902?\",\"Using Coordinates\":\"\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093e\u0902\u0915 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\",\"Using GPS\":\"\u091c\u0940\u092a\u0940\u090f\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\",\"Using Search\":\"\u0916\u094b\u091c \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\",\"Version\":\"\u0938\u0902\u0938\u094d\u0915\u0930\u0923\",\"Vibration Mode\":\"\u0915\u0902\u092a\u0928 \u092e\u094b\u0921\",\"Vibration on call\":\"Vibration on call\",\"Volume button stops adhan\":\"\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u091f\u0928 \u0905\u0926\u0928 \u0915\u094b \u0930\u094b\u0915\u0924\u093e \u0939\u0948\",\"WIDGET_CHANNEL_NAME\":\"\u0935\u093f\u091c\u0947\u091f\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"\u0935\u093f\u091c\u0947\u091f \u0905\u0926\u094d\u092f\u0924\u0928\",\"We'll help you do them quickly.\":\"\u0939\u092e \u0909\u0928\u094d\u0939\u0947\u0902 \u091c\u0932\u094d\u0926\u0940 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902\u0917\u0947\u0964\",\"Wednesday\":\"\u092c\u0941\u0927\u0935\u093e\u0930\",\"Welcome\":\"\u0938\u094d\u0935\u093e\u0917\u0924\",\"Western Arabic\":\"\u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u0905\u0930\u092c\u0940\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"\u0938\u0915\u094d\u0937\u092e \u0939\u094b\u0928\u0947 \u092a\u0930, \u0905\u091c\u093c\u093e\u0928 \u092f\u093e \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u092c\u091c\u0928\u0947 \u092a\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092c\u0902\u0926 \u0930\u0939\u0947\u0917\u0940 \u0914\u0930 \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u090f\u0917\u0940\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"\u0938\u0915\u094d\u0937\u092e \u0939\u094b\u0928\u0947 \u092a\u0930, \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f, \u0938\u092d\u0940 \u0911\u0921\u093f\u092f\u094b \u0915\u0947\u0935\u0932 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092a\u0930 \u0939\u0940 \u091a\u0932\u0947\u0902\u0917\u0947\u0964\",\"Wifi\":\"Wifi\",\"Yes\":\"\u0939\u093e\u0902\",\"You are facing Kaaba\":\"\u0906\u092a \u0915\u093e\u092c\u093e \u0915\u0940 \u0913\u0930 \u092e\u0941\u0916 \u0915\u093f\u092f\u0947 \u0939\u0941\u090f \u0939\u0948\u0902\",\"You are not facing Kaaba\":\"\u0906\u092a \u0915\u093e\u092c\u093e \u0915\u0940 \u0913\u0930 \u092e\u0941\u0902\u0939 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\",\"You can access your device Power Manager using the button below.\":\"\u0906\u092a \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092c\u091f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u093e\u0935\u0930 \u092e\u0948\u0928\u0947\u091c\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\",\"You can also paste coords from clipboard\":\"\u0906\u092a \u0915\u094d\u0932\u093f\u092a\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u092d\u0940 \u0915\u094b\u0911\u0930\u0921 \u092a\u0947\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\",\"You can change the language used for lunar calendar\":\"\u0906\u092a \u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092d\u093e\u0937\u093e \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"\u091c\u092c \u0906\u0917\u093e\u092e\u0940 \u0905\u0932\u093e\u0930\u094d\u092e \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0905\u091c\u093c\u093e\u0928 \u092f\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092d\u0947\u091c\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0924\u094b \u0906\u092a \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\",\"You can choose to replace one of calendars with your current location\":\"\u0906\u092a \u0915\u093f\u0938\u0940 \u090f\u0915 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0915\u094b \u0905\u092a\u0928\u0947 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u0925\u093e\u0928 \u0938\u0947 \u092c\u0926\u0932\u0928\u093e \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\",\"You can hide prayer times you don't want to see in the main screen here:\":\" \u092e\u0947\u0902 \u091c\u093f\u0928 \u0928\u092e\u093e\u091c\u093c \u0915\u0947 \u0938\u092e\u092f\u094b\u0902 \u0906\u092a \u092e\u0941\u0916\u094d\u092f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u094b \u0906\u092a \u092f\u0939\u093e\u0902 \u091b\u093f\u092a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902:\",\"You can hide prayer times you don't want to see in the widget here:\":\"\u091c\u093f\u0928 \u0928\u092e\u093e\u091c\u093c\u094b\u0902 \u0915\u0947 \u0935\u0915\u094d\u0924 \u0915\u094b \u0906\u092a \u0935\u093f\u091c\u0947\u091f \u092e\u0947\u0902 \u0928\u0939\u0940 \u0926\u0947\u0916\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u094d\u0939\u0947\u0902 \u0906\u092a \u092f\u0939\u093e\u0902 \u091b\u093f\u092a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902:\",\"You can search for your location offline Or use GPS\":\"\u0906\u092a \u0905\u092a\u0928\u093e \u0938\u094d\u0925\u093e\u0928 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0916\u094b\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u091c\u0940\u092a\u0940\u090f\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"\u0906\u092a\u0915\u094b \u0907\u0938 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u0947 \u0938\u093e\u0925 \u091c\u0940\u090f\u0928\u092f\u0942 \u090f\u092b\u093c\u0947\u0930\u094b \u091c\u0928\u0930\u0932 \u092a\u092c\u094d\u0932\u093f\u0915 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u0940 \u090f\u0915 \u092a\u094d\u0930\u0924\u093f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964 \u092f\u0926\u093f \u0928\u0939\u0940\u0902, \u0924\u094b https://www.gnu.org/licenses/ \u0926\u0947\u0916\u0947\u0902\u0964\",\"Your sounds\":\"\u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c\",\"abdul_basit_abdus_samad\":\"\u0905\u092c\u094d\u0926\u0941\u0932-\u092c\u0938\u093f\u0924 \u0905\u092c\u094d\u0926\u0941\u0938-\u0938\u092e\u0926\",\"about.credits\":\"\u0905\u091c\u093c\u093e\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u094b\u0902 \u0915\u0947 \u0938\u092d\u0940 \u0915\u0949\u092a\u0940\u0930\u093e\u0907\u091f \u0909\u0928\u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092e\u093e\u0932\u093f\u0915 \u0915\u0947 \u0939\u0948\u0902\u0964 translation.io (lingui.js) \u0915\u094b \u0909\u0928\u0915\u0940 \u0905\u0926\u094d\u092d\u0941\u0924 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u0947\u0937 \u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964 \u0938\u092d\u0940 \u0913\u092a\u0928 \u0938\u094b\u0930\u094d\u0938 \u0938\u092e\u0941\u0926\u093e\u092f \u0915\u0947 \u0938\u0926\u0938\u094d\u092f\u094b\u0902 \u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0907\u0938 \u0910\u092a \u0915\u094b \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0928 \u0938\u092d\u0940 \u0905\u0926\u094d\u092d\u0941\u0924 \u092a\u0941\u0938\u094d\u0924\u0915\u093e\u0932\u092f\u094b\u0902 \u0915\u094b \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964\",\"about.credits.google\":\"\u0907\u0938 \u0910\u092a \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0906\u0907\u0915\u0928 \u0917\u0942\u0917\u0932 \u092e\u091f\u0947\u0930\u093f\u092f\u0932 \u0906\u0907\u0915\u0928 \u0915\u0947 \u0939\u0948\u0902\u0964\",\"about_settings\":\"\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902\",\"adjustment.hint\":\"\u0917\u0923\u0928\u093e \u0915\u093f\u090f \u0917\u090f \u0938\u092e\u092f \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092e\u093f\u0928\u091f\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\",\"after\":\"\u092c\u093e\u0926 \u092e\u0947\u0902\",\"ago\":\"\u092a\u0939\u0932\u0947\",\"asr.prayer\":\"\u0905\u0938\u0930 \",\"backup_settings\":\"\u092c\u0948\u0915\u0905\u092a\",\"before\":\"\u0907\u0938 \u0938\u0947 \u092a\u0939\u0932\u0947\",\"calculation_adjustments_settings\":\"\u0938\u092e\u093e\u092f\u094b\u091c\u0928\",\"calculation_advanced_settings\":\"\u0909\u0928\u094d\u0928\u0924 \u0917\u0923\u0928\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938\",\"calculation_settings\":\"\u0917\u0923\u0928\u093e\",\"counter.fast\":\"\u0909\u092a\u0935\u093e\u0938\",\"date.day\":\"\u0926\u093f\u0928\",\"date.hour\":\"\u0918\u0902\u091f\u093e\",\"date.minute\":\"\u092e\u093f\u0928\u091f\",\"date.second\":\"\u0938\u0947\u0915\u0902\u0921\",\"dev_settings\":\"\u0921\u0947\u0935\u0932\u092a\u0930\",\"dhuhr.prayer\":\"\u091c\u093c\u0941\u0939\u0930 \",\"display_settings\":\"\u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947\",\"fajr.prayer\":\"\u092b\u091c\u094d\u0930\",\"favorite_location\":\"\u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0938\u094d\u0925\u093e\u0928\",\"forces all numbers to be in the selected system\":\"\u0938\u092d\u0940 \u0928\u0902\u092c\u0930\u094b\u0902 \u0915\u094b \u091a\u092f\u0928\u093f\u0924 \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0927\u094d\u092f \u0915\u0930\u0924\u093e \u0939\u0948\",\"from North\":\"\u0909\u0924\u094d\u0924\u0930 \u0938\u0947\",\"from settings\":\"\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947\",\"fullscreen_alarm\":\"\u0905\u091c\u093c\u093e\u0928 \u092a\u094d\u0932\u0947 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\",\"hijri.adjustment.hint\":\"\u091a\u0902\u0926\u094d\u0930 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\",\"home\":\"\u0918\u0930\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"\u092f\u0926\u093f \u0938\u0915\u094d\u0937\u092e \u0939\u0948, \u0924\u094b \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0928\u093e \u0915\u0947 \u0938\u092e\u092f \u092f\u093e \u0927\u094d\u0935\u0928\u093f \u0935\u093e\u0932\u0947 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0938\u0947 \u0932\u0917\u092d\u0917 \u090f\u0915 \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947 \u090f\u0915 \u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u090f\u0917\u0940\",\"intro\":\"\u092a\u0930\u093f\u091a\u092f\",\"is prayer time hidden?\":\"\u0915\u094d\u092f\u093e \u0928\u092e\u093e\u091c\u093c \u0915\u093e \u0935\u0915\u094d\u0924 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u0939\u0948?\",\"isha.prayer\":\"\u0907\u0936\u093e\u0902 \",\"later\":\"\u092c\u093e\u0926 \u092e\u0947\u0902\",\"location_settings\":\"\u0938\u094d\u0925\u093e\u0928\",\"maghrib.prayer\":\"\u092e\u0917\u093c\u0930\u093f\u092c\",\"masjid_an_nabawi\":\"\u092e\u0938\u094d\u091c\u093f\u0926 \u0905\u0928 \u0928\u092c\u0935\u0940\",\"minutes\":\"\u092e\u093f\u0928\u091f\",\"moazen_zade\":\"\u092e\u094b\u0905\u091c\u093c\u0928 \u091c\u093c\u093e\u0926\u0947\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"\u092e\u093e\u0938\u093f\u0915 \u0926\u0943\u0936\u094d\u092f\",\"muezzin_settings\":\"\u092e\u0941\u0905\u091c\u093c\u094d\u091c\u093c\u093f\u0928\",\"notification_advanced_settings\":\"\u090f\u0921\u0935\u093e\u0902\u0938 \u0938\u0947\u091f\u093f\u0902\u0917\",\"notification_settings\":\"\u0938\u0942\u091a\u0928\u093e \u0914\u0930 \u0927\u094d\u0935\u0928\u093f\",\"qada_counter\":\"\u0915\u0921\u093c\u093e \u0915\u093e\u0909\u0902\u091f\u0930\",\"qibla_compass\":\"\u0915\u093f\u092c\u0932\u093e \u0915\u092e\u094d\u092a\u093e\u0938\",\"qibla_finder\":\"\u0915\u093f\u092c\u0932\u093e \u0916\u094b\u091c\u0915\",\"qibla_map\":\"\u0915\u093f\u092c\u0932\u093e \u0928\u0915\u094d\u0936\u093e\",\"ragheb_mustafa_ghalwash\":\"\u0930\u093e\u0918\u0947\u092c \u092e\u0941\u0938\u094d\u0924\u092b\u093e \u0917\u0932\u0935\u093e\u0936\",\"reminders_settings\":\"\u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915\",\"settings\":\"\u0938\u092e\u093e\u092f\u094b\u091c\u0928\",\"should notification widget be shown?\":\"\u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0935\u093f\u091c\u0947\u091f \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f?\",\"should {prayerName} be hidden?\":[\"\u0915\u094d\u092f\u093e \",[\"prayerName\"],\" \u091b\u0941\u092a\u093e\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"\u091a\u0942\u0902\u0915\u093f \u0910\u092a \u0915\u093e \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092a\u0942\u0930\u094d\u0935-\u0917\u0923\u0928\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u091a\u0902\u0926\u094d\u0930\u092e\u093e \u0915\u0947 \u0926\u0947\u0916\u0947 \u091c\u093e\u0928\u0947 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u092f\u0939 \u0930\u092e\u091c\u093e\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0914\u0930 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0917\u0932\u0924 \u0924\u093e\u0930\u0940\u0916 \u0926\u093f\u0916\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964\",\"sunnah.midnight\":\"\u092e\u0927\u094d\u092f\u0930\u093e\u0924\u094d\u0930\u093f\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"\u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f\",\"sunset\":\"\u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924\",\"widget_settings\":\"\u0935\u093f\u091c\u0947\u091f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" \u092e\u093f\u0928\u091f \u0915\u0947 \u092c\u093e\u0926 \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" \u092e\u093f\u0928\u091f \u092a\u0939\u0932\u0947 \",[\"prayer\"]],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u090f\u0917\u0940\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" \u0927\u094d\u0935\u0928\u093f \u092c\u091c\u093e\u0908 \u091c\u093e\u090f\u0917\u0940\"]}")}),631,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 menit\",\"15 min\":\"15 menit\",\"30 min\":\"30 menit\",\"30 minutes is added to Isha time during Ramadan in this method\":\"30 menit ditambahkan pada waktu Isya selama bulan Ramadan dalam metode ini\",\"5 min\":\"5 menit\",\"60 min\":\"60 menit\",\"90 min\":\"90 menit\",\"ADHAN_CHANNEL_NAME\":\"Adzan\",\"Abyad\":\"Abyad\",\"Accuracy\":\"Akurasi\",\"Ad-Free\":\"Bebas Iklan\",\"Adaptive Charging\":\"Pengisian Daya Adaptif\",\"Add\":\"Tambah\",\"Add Custom Adhan\":\"Tambah Suara Adzan Kustom\",\"Add Custom Audio\":\"Menambahkan Audio Khusus\",\"Add Reminder\":\"Buat Pengingat\",\"Add Silent Mode\":\"Tambah Mode Senyap\",\"Add new counter\":\"Menambahkan penghitung baru\",\"Add new location\":\"Tambahkan lokasi baru\",\"Adhan\":\"Adzan\",\"Adhan audio file is not downloaded yet\":\"Berkas audio adzan belum diunduh\",\"Adjustments\":\"Penyesuaian\",\"Advanced\":\"Lanjutan\",\"Advanced Calculation Settings\":\"Pengaturan Lanjutan\",\"Advanced Settings\":\"Pengaturan Lanjutan\",\"Ahmer\":\"Ahmer\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Jadwal Sholat\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan didistribusikan dengan harapan dapat bermanfaat, tetapi TANPA GARANSI APAPUN; bahkan tanpa jaminan tersirat akan kelayakan untuk diperjualbelikan atau kesesuaian untuk tujuan tertentu. Lihat Lisensi Publik Umum GNU Affero untuk informasi lebih lanjut.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan adalah perangkat lunak bebas: Anda dapat mendistribusikan ulang dan/atau memodifikasinya di bawah persyaratan Lisensi Publik Umum GNU Affero (v3.0) yang diterbitkan oleh Free Software Foundation.\",\"Alarms Permission\":\"Izin Alarm\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"Semua data yang diberikan kepada Al-Azan hanya disimpan secara lokal di perangkat Anda. Data Anda tidak diunggah ke mana pun. Pengembang Al-Azan tidak memiliki akses ke sana. Data Anda tidak dibagikan dengan pihak ketiga mana pun. Al-Azan tidak menyertakan pustaka iklan atau kode pelacakan (analitik) pihak ketiga, seperti Google Analytics atau Facebook SDK.\",\"An error occured while playing the current track\":\"Eror saat memutar track audio\",\"App features\":\"Fitur aplikasi\",\"Arabic\":\"Bahasa Arab\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"Yakin ingin menghapus \\\"\",[\"0\"],\"\\\" ?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"Apakah Anda yakin ingin menghapus \\\"\",[\"itemName\"],\"\\\" ?\"],\"Are you sure you want to delete this?\":\"Apakah Anda yakin ingin menghapus ini?\",\"Asr Calculation\":\"Perhitungan Waktu Ashar\",\"At least one prayer time must be shown\":\"Setidaknya satu waktu sholat harus ditampilkan\",\"Attention\":\"Perhatian\",\"Auto (Default)\":\"Otomatis (Default)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"Lewati \\\"Jangan Ganggu\\\"?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"Perhitungan Adzan memiliki banyak metode yang berbeda. Setiap metode menghasilkan waktu azan yang berbeda. Pilih motode perhitungan yang sesuai.\",\"Calculation\":\"Perhitungan\",\"Calculation Method\":\"Metode Perhitungan\",\"Calendar\":\"Kalender\",\"Cancel\":\"Batal\",\"Cancel Alarm\":\"Batalkan Alarm\",\"Cancel download\":\"Membatalkan pengunduhan\",\"Choose Asr Calculation Madhab\":\"Pilih Madzhab Perhitungan Waktu Ashar\",\"Choose Calculation Method\":\"Pilih Metode Perhitungan\",\"Choose High Latitude Setting\":\"Pilih Pengaturan Lintang Tinggi\",\"Choose Language\":\"Pilih Bahasa\",\"Choose Polar Resolution\":\"Pilih Resolusi Kutub\",\"Choose Shafaq method\":\"Pilih metode Shafaq\",\"Choose calculation rounding method\":\"Memilih metode pembulatan perhitungan\",\"Choose calendar type\":\"Pilih jenis kalender\",\"Choose lunar calendar language\":\"Memilih bahasa kalender lunar\",\"Choose midnight calculation method\":\"Pilih metode penghitungan tengah malam\",\"Choose numbering system\":\"Pilih sistem penomoran\",\"Choose which calendar to replace\":\"Pilih kalender mana yang akan diganti\",\"City/Area\":\"Kota/Daerah\",\"Clear the coordinates\":\"Menghapus koordinat\",\"Clear the location\":\"Menghapus lokasi\",\"Clipboard data does not contain coordinates\":\"Data clipboard tidak mengandung koordinat\",\"Close\":\"Tutup\",\"Closest City\":\"Kota terdekat\",\"Closest Date\":\"Tanggal terdekat\",\"Compass Lock\":\"Kunci Kompas\",\"Compass sensor unavailable\":\"Sensor kompas tidak tersedia\",\"Confirm\":\"Selesai\",\"Continuous\":\"Berkelanjutan\",\"Coordinates updated\":\"Koordinat diperbarui\",\"Copy\":\"Salin\",\"Count\":\"Menghitung\",\"Country\":\"Negara\",\"Custom\":\"Kustom\",\"Custom sounds and muezzins will not be exported\":\"Suara dan muazin khusus tidak akan diekspor\",\"Custom upcoming alarm time\":\"Menyesuaikan waktu alarm yang akan datang\",\"Dark\":\"Gelap\",\"Date\":\"Tanggal\",\"Decrement\":\"Penurunan\",\"Default\":\"Bawaan\",\"Delete\":\"Hapus\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"Tergantung pada perangkat dan versi android Anda, Terkadang beberapa perangkat mungkin memberhentikan aplikasi di latar belakang untuk menghemat baterai. Hal Ini dapat membuat alarm/notifikasi tidak muncul.\",\"Deselect as Fajr Adhan\":\"Batalkan pilihan sebagai Adzan Subuh\",\"Device sounds\":\"Suara perangkat\",\"Disabled\":\"Tidak Aktif\",\"Disclaimer\":\"Penafian\",\"Dismiss\":\"Hentikan\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"Metode Diyanet yang disediakan di Al-Azan adalah perkiraan waktu resmi. Karena tidak ada dokumentasi yang cukup tersedia tentang bagaimana waktu-waktu tersebut dihitung secara tepat, waktu-waktu tersebut mungkin tidak sama dengan situs web resmi, terutama di luar Turki.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Presidensi Urusan Agama Republik Turki (Diyanet)\",\"Doesn't use any kind of trackers\":\"Tidak menggunakan pelacak apa pun\",\"Don't ask again\":\"Jangan tanya lagi\",\"Don't show again\":\"Jangan tampilkan lagi\",\"Don't show alarm screen?\":\"Tidak menampilkan layar alarm?\",\"Done\":\"Selesai\",\"Download\":\"Unduh\",\"Eastern Arabic\":\"Bahasa Arab Timur\",\"Edit\":\"Sunting\",\"Edit Calculation Parameters\":\"Mengedit Parameter Perhitungan\",\"Edit Counter\":\"Edit Penghitung\",\"Edit Location\":\"Edit Lokasi\",\"Edit Reminder\":\"Ubah Pengingat\",\"Edit Silent Mode\":\"Edit Mode Senyap\",\"Egyptian General Survey Authority\":\"Otoritas Umum Mesir\",\"Enabled\":\"Aktif\",\"End after prayer (minutes)\":\"Berakhir setelah sholat (menit)\",\"Error getting clipboard data\":\"Tidak mendapatkan data clipboard\",\"Error in loading countries\":\"Kesalahan dalam memuat daftar negara\",\"Error while downloading audio\":\"Kesalahan saat mengunduh audio\",\"Error while getting coordinates\":\"Kesalahan saat mendapatkan koordinat\",\"Error: failed to open file\":\"Kesalahan: gagal membuka file\",\"Ethiopic\":\"Etiopia\",\"Export app data\":\"Mengekspor data aplikasi\",\"Export data\":\"Ekspor data\",\"Fajr Angle\":\"Sudut Subuh\",\"Find My Location\":\"Temukan Lokasi Saya\",\"Fix Common Problems\":\"Memperbaiki Masalah Umum\",\"France angle 15\":\"Sudut Prancis 15\",\"France angle 18\":\"Sudut Prancis 18\",\"Friday\":\"Jumat\",\"General (default)\":\"Umum (default)\",\"Getting coordinates\":\"Mendapatkan Koordinat\",\"Got it\":\"Mengerti\",\"Gregorian\":\"Gregorian\",\"Gulf region\":\"Wilayah Gulf\",\"Hanafi\":\"Hanafi\",\"Hidden?\":\"Sembunyikan?\",\"Hide Prayer Times\":\"Sembunyikan Waktu Sholat\",\"Hide times you don't need\":\"Sembunyikan waktu yang tidak Anda perlukan\",\"High\":\"Tinggi\",\"High Latitude\":\"Lintang Tinggi\",\"Highlight current prayer\":\"Sorot doa saat ini\",\"Home\":\"Situs\",\"Homescreen and notification Widgets\":\"Widget Layar Beranda dan pemberitahuan\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Namun, ketika menggunakan layanan online, seperti peta kiblat, aplikasi dapat mengirimkan data minimum yang diperlukan yang mungkin atau mungkin tidak secara unik mengidentifikasi Anda. Harap ingatlah hal ini saat menggunakan aplikasi.\",\"I Understand\":\"Aku mengerti\",\"IMPORTANT_CHANNEL_ID\":\"Penting\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"Jika diaktifkan, ketika notifikasi ditampilkan, maka akan berisi info untuk waktu shalat berikutnya\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"Jika Anda telah mengaktifkan \\\"Pencadangan & Pengaturan Ulang\\\" di pengaturan ponsel Anda (Pengaturan / Pencadangan & Pengaturan Ulang / Cadangkan data saya), Anda harus mengetahui bahwa Android itu sendiri (bukan Al-Azan) akan menyimpan salinan data ponsel Anda secara berkala di server Google. Hal ini memungkinkan Android untuk memulihkan data Anda jika perangkat Anda rusak, atau Anda membeli perangkat baru. Pengembang Al-Azan tidak memiliki akses ke data ini.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"Jika Anda masih memiliki masalah dengan aplikasi yang berhenti setelah beberapa waktu, silakan kunjungi dontkillmyapp.com untuk solusi lebih lanjut.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"Untuk memastikan aplikasi berjalan dengan lancar, Anda perlu menonaktifkan pengoptimalan daya untuk aplikasi ini. Buka halaman pengaturan daya dengan tombol berikut.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"Jika perangkat Anda memiliki pengisian daya adaptif, seperti Google Pixel, dan Anda tidak ingin azan atau pengingat dikenali sebagai alarm, Anda dapat mengaktifkan opsi ini.\",\"Import\":\"Impor\",\"Import app data\":\"Mengimpor data aplikasi\",\"Import successful\":\"Impor berhasil\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"Selain salat lima waktu, jam ini juga memiliki pengaturan untuk salat matahari terbit, terbenam, tengah malam dan malam hari (Tahajjud)\",\"Increment\":\"Kenaikan\",\"Info\":\"Info\",\"Internet connection\":\"Koneksi internet\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"Koneksi internet diperlukan agar peta kiblat dapat berfungsi. Aktifkan wifi atau data seluler Anda dan coba lagi.\",\"Iran\":\"Iran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"Dilokalkan dalam bahasa Inggris, Persia, Arab, Turki, Indonesia, Prancis, Urdu, Hindi, Jerman, Bosnia, Vietnam, Bangla\",\"Isha Angle\":\"Sudut Isya\",\"Isha Interval\":\"Interval Isya\",\"Islamic\":\"Islam\",\"Islamic (Saudi Arabia sighting)\":\"Islam (penampakan Arab Saudi)\",\"Islamic (Umm al-Qura)\":\"Islam (Umm al-Qura)\",\"Islamic (civil)\":\"Islam (sipil)\",\"Islamic (tabular)\":\"Islam (tabular)\",\"Islamic Society of North America (ISNA)\":\"Masyarakat Islam Amerika Utara (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"Sepertinya Anda telah mengimpor cadangan, jangan lupa untuk menonaktifkan pengoptimalan baterai untuk aplikasi ini\",\"Just now\":\"Baru saja\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Kementrian Agama Republik Indonesia (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\",\"Kuwait\":\"Kuwait\",\"Label\":\"Judul\",\"Language\":\"Bahasa\",\"Latitude\":\"Latitud\",\"Latitude is invalid\":\"Latitud tidak valid\",\"License\":\"Lisensi\",\"Light\":\"Terang\",\"Light and Dark theme\":\"Tema Terang dan Gelap\",\"Light/Dark theme\":\"Tema terang/gelap\",\"List is empty\":\"Daftar kosong\",\"Loading\":\"Memuat\",\"Location\":\"Lokasi\",\"Location settings\":\"Pengaturan lokasi\",\"Longitude\":\"Longitud\",\"Longitude is invalid\":\"Longitud tidak valid\",\"Low\":\"Rendah\",\"Lunar Calendar\":\"Kalender Lunar\",\"Lunar Calendar Language\":\"Bahasa Kalender Imlek\",\"Maghrib Angle\":\"Sudut Maghrib\",\"Make a Copy\":\"Buat Salinan\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Banyak pilihan untuk perhitungan Adzan (\u0627\u0630\u0627\u0646)\",\"Medium\":\"Sedang\",\"Middle of the Night\":\"Pertengahan malam\",\"Midnight Method\":\"Metode Tengah Malam\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"Kementerian Agama dan Wakaf, Aljazair\",\"Ministry of Religious Affairs of Tunisia\":\"Kementerian Agama Tunisia\",\"Mobile Data\":\"Data Seluler\",\"Modified\":\"Dimodifikasi\",\"Monday\":\"Senin\",\"Moonsighting Committee\":\"Komite Moonsighting Sedunia (MCW)\",\"Muslim World League\":\"Liga Muslim Dunia\",\"Name\":\"Nama\",\"Nearest\":\"Terdekat\",\"New Counter\":\"Penghitung Baru\",\"New Location\":\"Lokasi Baru\",\"New Reminder\":\"Buat Pengingat\",\"New Silent Mode\":\"Mode Senyap Baru\",\"Next\":\"Lanjut\",\"Next Day\":\"Hari Brkut\",\"Next Month\":\"Bulan Depan\",\"No\":\"Tidak\",\"No Data\":\"Tidak ada data\",\"No Results\":\"Tidak ada hasil\",\"None\":\"Tidak ada\",\"None (Automatic)\":\"Tidak ada (Otomatis)\",\"Normal mode restored\":\"Mode normal dipulihkan\",\"Not now\":\"Tidak sekarang\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"Harap diperhatikan bahwa karena kesalahan perangkat lunak dan perangkat keras, arah kiblat yang ditunjukkan oleh aplikasi ini, khususnya dalam mode kompas, bisa saja salah.\",\"Notification\":\"Notifikasi\",\"Notification & Sound\":\"Notifikasi & Suara\",\"Notifications Permission\":\"Izin Pemberitahuan\",\"Numbering system\":\"Sistem penomoran\",\"Off\":\"Mati\",\"Okay\":\"Oke\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"Pada Android 12 dan yang lebih baru, aplikasi ini juga memerlukan izin alarm agar berfungsi dengan baik, jadi Anda harus mengizinkannya juga.\",\"Once\":\"Sekali\",\"One-Seventh of the Night\":\"Sepertujuh Malam\",\"Only once?\":\"Hanya sekali?\",\"Only six items can be shown at the same time\":\"Hanya enam item yang dapat ditampilkan secara bersamaan\",\"Open Battery Optimization Settings\":\"Buka Pengaturan\",\"Open Power Manager Settings\":\"Buka Pengaturan\",\"Open source repository\":\"Repositori sumber terbuka\",\"Open-source\":\"Sumber terbuka\",\"Options\":\"Opsi\",\"Or if you have a backup, you can import it\":\"Atau jika Anda memiliki cadangan, Anda dapat mengimpornya\",\"Orientation Lock: Landscape\":\"Kunci Orientasi: Lanskap\",\"Orientation Lock: Portrait\":\"Kunci Orientasi: Potret\",\"Orientation: Unlocked\":\"Orientasi: Tidak terkunci\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"Perangkat magnetik lainnya dapat mengganggu kompas ponsel Anda dan kompas Anda mungkin perlu dikalibrasi.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Mode Senyap\",\"PRE_ADHAN_CHANNEL_NAME\":\"Adzan yang akan datang\",\"PRE_REMINDER_CHANNEL_NAME\":\"Pengingat yang akan datang\",\"Pakistan\":\"Pakistan\",\"Paste\":\"Tempel\",\"Persian\":\"Persia\",\"Phone State Permission\":\"Izin Status Telepon\",\"Play\":\"Bermain\",\"Please enable location service\":\"Harap aktifkan layanan lokasi\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"Harap diperhatikan bahwa mengaktifkan opsi ini dapat menyebabkan adzan dan pengingat berbunyi dengan penundaan atau tidak berbunyi sama sekali dalam beberapa kasus. Aktifkan ini dengan hati-hati.\",\"Polar Resolution\":\"Resolusi Kutub\",\"Power Manager\":\"Pengelola Daya\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"Waktu Sholat\",\"Prayer list\":\"Daftar doa\",\"Press to search\":\"Tekan untuk mencari\",\"Press to select a method\":\"Tekan untuk memilih metode\",\"Prev Day\":\"Hari Sblum\",\"Prev Month\":\"Bulan Sebelumnya\",\"Privacy Policy\":\"Kebijakan Privasi\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"Aplikasi Adzan dan kiblat sumber terbuka yang mengutamakan privasi\",\"Qada counter\":\"Penghitung Qada\",\"Qatar\":\"Qatar\",\"Qibla\":\"Kiblat\",\"Qibla finder\":\"Penunjuk arah kiblat\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"Pencari kiblat membutuhkan layanan lokasi. Jika tidak diaktifkan, lokasi dari pengaturan aplikasi akan digunakan.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"Peta kiblat saat ini tidak tersedia dalam versi F-Droid. Peta ini mungkin akan tersedia dalam pembaruan di masa yang akan datang.\",\"REMINDER_CHANNEL_NAME\":\"Pengingat\",\"Ramadan is ending,\":\"Ramadan telah berakhir,\",\"Ramadan is near,\":\"Ramadan sudah dekat,\",\"Remaining till\":\"Sisa sampai\",\"Remind me next year\":\"Ingatkan saya tahun depan\",\"Reminder\":\"Pengingat\",\"Repeat\":\"Ulangi\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"Pengaturan yang diperlukan tidak lengkap. Agar aplikasi menampilkan waktu sholat, proses pengaturan perlu dilanjutkan kembali nanti.\",\"Rounding Method\":\"Metode Pembulatan\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"Perangkat Samsung memiliki Power Manajer kustom mereka sendiri yang disebut \\\"Perawatan Perangkat\\\" (Device Care). Setelah menekan tombol di bawah, Anda akan diarahkan ke menu Baterai (Battery) di Perawatan Perangkat (Device Care). Di menu Baterai (Battery), ketuk \\\"Manajemen daya aplikasi\\\" (App power management), lalu ketuk \\\"Aplikasi yang tidak akan ditidurkan\\\" (Apps that won't be put to sleep), dan tambahkan aplikasi ini ke daftar.\",\"Saturday\":\"Sabtu\",\"Saudi Arabia\":\"Arab Saudi\",\"Search\":\"Pencarian\",\"Secondary Calendar\":\"Kalender Sekunder\",\"See favorite locations\":\"Lihat lokasi favorit\",\"Select as Fajr Adhan\":\"Pilih sebagai Adzan Subuh\",\"Select different Adhan audio for Fajr namaz\":\"Pilih audio Adzan yang berbeda untuk azan Subuh\",\"Selected\":\"Dipilih\",\"Selected as adhan\":\"Dipilih sebagai adzan\",\"Selected as fajr adhan\":\"Dipilih sebagai azan subuh\",\"Selecting a name is required\":\"Nama wajib diisi\",\"Set custom Adhan audio\":\"Mengatur audio Adzan khusus\",\"Set reminders before or after a prayer time\":\"Mengatur pengingat sebelum atau sesudah waktu salat\",\"Shafaq\":\"Shafaq\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"Shafaq digunakan metode Komite Moonsighting untuk menentukan jenis senja yang digunakan untuk menentukan waktu Isya'\",\"Shafi, Maliki, Hanbali (Default)\":\"Syafi'i, Maliki, Hanbali (Default)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"Shia Ithna Ashari, Leva Institute, Qum\\n\",\"Shia, Institute of Geophysics, University of Tehran\":\"Shia, Institute of Geophysics, University of Tehran\",\"Should app highlight current prayer instead of next prayer?\":\"Haruskah aplikasi menyoroti doa saat ini dan bukannya doa berikutnya?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"Haruskah aplikasi tetap memutar adzan ketika \\\"Jangan Ganggu\\\" aktif?\",\"Should app stop playing adhan when the volume button is pressed?\":\"Haruskah aplikasi berhenti memutar adzan ketika tombol volume ditekan?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"Haruskah ponsel bergetar saat adzan atau pengingat mulai diputar?\",\"Show Adhan Options\":\"Tampilkan Pilihan Adzan\",\"Show Today\":\"Hari Ini\",\"Show countdown?\":\"Tampilkan hitungan mundur?\",\"Show current\":\"Tampilkan saat ini\",\"Show me\":\"Tunjukkan padaku\",\"Show next in notification?\":\"Tampilkan pemberitahuan berikutnya?\",\"Show notification widget?\":\"Tampilkan widget notifikasi?\",\"Show settings\":\"Tampilkan pengaturan\",\"Show upcoming alarm notification?\":\"Tampilkan pemberitahuan alarm yang akan datang?\",\"Silent\":\"Diam\",\"Silent Mode Ended\":\"Mode Senyap Berakhir\",\"Silent Mode Name\":\"Nama Mode Senyap\",\"Silent Mode Started\":\"Mode Senyap Dimulai\",\"Silent mode activated\":\"Mode senyap diaktifkan\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"Karena kami tidak menggunakan pelacak atau analisis kerusakan apa pun, silakan laporkan masalah atau saran apa pun yang Anda miliki di repo github kami\",\"Singapore\":\"Singapura\",\"Skip\":\"Lewati\",\"Software License\":\"Lisensi Perangkat Lunak\",\"Solar Hijri\":\"Matahari Hijriah\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"Beberapa perangkat memerlukan pengaturan tambahan pada Power Manager untuk mencegah aplikasi berhenti di latar belakang. Nonaktifkan opsi hemat daya untuk aplikasi ini.\",\"Sound\":\"Suara\",\"Spiritual Administration of Muslims of Russia\":\"Administrasi Keagamaan Muslim Rusia\",\"Start before prayer (minutes)\":\"Mulai sebelum sholat (menit)\",\"Status\":\"Status\",\"Stop\":\"Berhenti\",\"Sunday\":\"Minggu\",\"Sunset to Fajr (Default)\":\"Matahari terbenam hingga Subuh (Standar)\",\"Sunset to Sunrise\":\"Matahari Terbenam hingga Matahari Terbit\",\"System Default\":\"Default Sistem\",\"Tahajjud time mentioned in the app is the last third of the night\":\"Waktu Tahajjud yang disebutkan dalam aplikasi adalah sepertiga malam terakhir\",\"Thai Solar\":\"Thai Solar\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"Terima kasih telah memilih Al-Azan! Lakukan pengaturan awal sebelum mulai menggunakan aplikasi ini.\",\"The Gulf Region (Dubai)\":\"The Gulf Region (Dubai)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"Kalender lunar aplikasi ini telah dihitung sebelumnya dan mungkin tidak akurat karena tidak berdasarkan penampakan bulan. Hal ini sangat penting untuk diperhatikan terutama untuk awal dan akhir Ramadan.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"Teks yang terdapat di situs web dan aplikasi ini mungkin tidak akurat dalam bahasa lain, jadi dalam hal apa pun, hanya versi bahasa Inggris yang harus dipertimbangkan.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Jenis kalender yang ditampilkan di atas layar beranda dan di samping kalender lunar di widget\",\"The type of lunar calendar shown in main screen and widgets\":\"Jenis kalender lunar yang ditampilkan di layar utama dan widget\",\"Theme Color\":\"Warna Tema\",\"Thursday\":\"Kamis\",\"Time\":\"Waktu\",\"Time condition\":\"Kondisi waktu\",\"Time format\":\"Format waktu\",\"Time list\":\"Daftar waktu\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"Lokasi dibutuhkan untuk menghitung waktu adzan. Gunakan tombol \\\"Temukan Lokasi Saya\\\", atau gunakan pencarian negara dan kota/daerah, atau masukkan koordinat secara manual.\",\"To see notifications about adhan, we need your permission.\":\"Untuk melihat pemberitahuan tentang adzan, kami memerlukan izin Anda.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"Untuk berhenti memainkan adzan ketika Anda menerima panggilan, kami perlu membaca status telepon Anda. tidak mengizinkan izin ini hanya akan menonaktifkan fitur tersebut.\",\"Tomorrow\":\"Besok\",\"Tuesday\":\"Selasa\",\"Turn Left\":\"Belok Kiri\",\"Turn Right\":\"Belok Kanan\",\"Turn history off\":\"Matikan riwayat\",\"Turn history on\":\"Mengaktifkan riwayat\",\"Twilight Angle\":\"Sudut Senja\",\"Umm al-Qura University, Makkah\":\"Komite Ummul Qura, Mekah\",\"Union Organization Islamic de France\":\"Serikat Organisasi Islam Perancis (UOIF)\",\"University of Islamic Sciences, Karachi\":\"Universitas Ilmu Islam, Karachi\",\"Unknown Error\":\"Kesalahan Tidak Dikenal\",\"Unreliable\":\"Tidak dapat diandalkan\",\"Unresolved (default)\":\"Tidak ada (default)\",\"Unsupported\":\"Tidak didukung\",\"Up\":\"Up\",\"Upcoming alarm\":\"Alarm selanjutnya\",\"Updating widgets\":\"Memperbarui widget\",\"Use 24-Hour format\":\"Gunakan format 24 Jam\",\"Use Compass\":\"Gunakan Kompas\",\"Use Map\":\"Gunakan Peta\",\"Use a different alarm type?\":\"Menggunakan jenis alarm yang berbeda?\",\"Use adaptive theme?\":\"Gunakan tema adaptif?\",\"Use headphones when available?\":\"Gunakan headphone jika tersedia?\",\"Using Coordinates\":\"Menggunakan Koordinat\",\"Using GPS\":\"Menggunakan GPS\",\"Using Search\":\"Menggunakan Pencarian\",\"Version\":\"Versi\",\"Vibration Mode\":\"Mode Getaran\",\"Vibration on call\":\"Getar saat panggilan\",\"Volume button stops adhan\":\"Tombol volume menghentikan adzan\",\"WIDGET_CHANNEL_NAME\":\"Widget\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"Pembaruan Widget\",\"We'll help you do them quickly.\":\"Pengaturan hanya butuh beberapa langkah saja.\",\"Wednesday\":\"Rabu\",\"Welcome\":\"Selamat Datang!\",\"Western Arabic\":\"Bahasa Arab Barat\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Ketika diaktifkan, layar akan tetap mati ketika adzan atau pengingat mulai diputar, dan layar alarm tidak akan ditampilkan\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"Apabila diaktifkan, ketika menggunakan headphone, semua audio hanya akan diputar pada headphone.\",\"Wifi\":\"Wifi\",\"Yes\":\"Ya\",\"You are facing Kaaba\":\"Anda menghadap Ka'bah\",\"You are not facing Kaaba\":\"Anda tidak menghadap Ka'bah\",\"You can access your device Power Manager using the button below.\":\"Akses pengaturan Power Manager menggunakan tombol di bawah ini.\",\"You can also paste coords from clipboard\":\"Anda juga dapat menempelkan koordinat dari clipboard\",\"You can change the language used for lunar calendar\":\"Anda dapat mengubah bahasa yang digunakan untuk kalender lunar\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"Anda dapat mengubah kapan notifikasi alarm yang akan datang dikirim sebelum azan atau pengingat\",\"You can choose to replace one of calendars with your current location\":\"Anda dapat memilih untuk mengganti salah satu kalender dengan lokasi Anda saat ini\",\"You can hide prayer times you don't want to see in the main screen here:\":\"Menyembunyikan waktu sholat agar tidak ditampilkan di layar utama:\",\"You can hide prayer times you don't want to see in the widget here:\":\"Menyembunyikan waktu sholat agar tidak tampil pada widget:\",\"You can search for your location offline Or use GPS\":\"Anda dapat mencari lokasi Anda secara offline Atau menggunakan GPS\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"Anda seharusnya telah menerima salinan Lisensi Publik Umum GNU Affero bersama dengan program ini. Jika tidak, lihat https://www.gnu.org/licenses/.\",\"Your sounds\":\"Suara Anda\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"Semua hak cipta untuk suara adzan adalah milik masing-masing pemiliknya. Terima kasih khusus kepada translation.io (lingui.js) untuk layanan mereka yang luar biasa. Terima kasih kepada semua anggota komunitas open source yang membuat semua library luar biasa ini yang akhirnya memungkinkan aplikasi ini rilis.\",\"about.credits.google\":\"Sebagian besar ikon yang digunakan dalam aplikasi ini berasal dari ikon material Google.\",\"about_settings\":\"Tentang\",\"adjustment.hint\":\"Jumlah menit yang akan ditambahkan ke waktu yang dihitung\",\"after\":\"setelah\",\"ago\":\"yang lalu\",\"asr.prayer\":\"Ashar\",\"backup_settings\":\"Cadangan\",\"before\":\"sebelum\",\"calculation_adjustments_settings\":\"Penyesuaian\",\"calculation_advanced_settings\":\"Pengaturan Lanjutan\",\"calculation_settings\":\"Perhitungan\",\"counter.fast\":\"puasa\",\"date.day\":\"hari\",\"date.hour\":\"jam\",\"date.minute\":\"menit\",\"date.second\":\"detik\",\"dev_settings\":\"Pengembang\",\"dhuhr.prayer\":\"Dhuhur\",\"display_settings\":\"Tampilan\",\"fajr.prayer\":\"Subuh\",\"favorite_location\":\"Lokasi Favorit\",\"forces all numbers to be in the selected system\":\"Set semua nomor menyesuaikan sistem\",\"from North\":\"dari Utara\",\"from settings\":\"dari pengaturan\",\"fullscreen_alarm\":\"Putar Adzan\",\"hijri.adjustment.hint\":\"Jumlah hari yang akan ditambahkan ke kalender lunar\",\"home\":\"Situs\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"jika diaktifkan, notifikasi akan ditampilkan sekitar satu jam sebelum waktu sholat atau pengingat yang memiliki suara\",\"intro\":\"intro\",\"is prayer time hidden?\":\"apakah waktu sholat tersembunyi?\",\"isha.prayer\":\"Isya'\",\"later\":\"nanti\",\"location_settings\":\"Lokasi\",\"maghrib.prayer\":\"Maghrib\",\"masjid_an_nabawi\":\"Masjid Nabawi\",\"minutes\":\"menit\",\"moazen_zade\":\"Moazen Zade\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"Tampilan Bulanan\",\"muezzin_settings\":\"Muazin\",\"notification_advanced_settings\":\"Pengaturan Lanjutan\",\"notification_settings\":\"Notifikasi & Suara\",\"qada_counter\":\"Penghitung Qada\",\"qibla_compass\":\"Kompas Kiblat\",\"qibla_finder\":\"Penunjuk Arah Kiblat\",\"qibla_map\":\"Peta Kiblat\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"Pengingat\",\"settings\":\"Pengaturan\",\"should notification widget be shown?\":\"Apakah ingin menampilkan widget notifikasi?\",\"should {prayerName} be hidden?\":[\"Apakah \",[\"prayerName\"],\" disembunyikan?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"karena kalender aplikasi ini sudah dihitung sebelumnya dan tidak berdasarkan penampakan bulan, aplikasi ini mungkin menunjukkan tanggal yang salah untuk awal dan akhir Ramadan.\",\"sunnah.midnight\":\"Tengah malam\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"Terbit\",\"sunset\":\"Terbenam\",\"widget_settings\":\"Pengaturan Widget\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" menit setelah \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" menit sebelum \",[\"prayer\"]],\"{prayerName} notification will be shown\":[\"Pemberitahuan waktu \",[\"prayerName\"],\" akan ditampilkan\"],\"{prayerName} sound will be played\":[\"Suara adzan \",[\"prayerName\"],\" akan diputar\"]}")}),632,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 dk.\",\"15 min\":\"15 dk.\",\"30 min\":\"30 dk.\",\"30 minutes is added to Isha time during Ramadan in this method\":\"Bu y\xf6ntemde ramazan boyunca yats\u0131 vaktine 30 dakika eklenir\",\"5 min\":\"15 dk.\",\"60 min\":\"60 dk.\",\"90 min\":\"90 dk.\",\"ADHAN_CHANNEL_NAME\":\"Ezan\",\"Abyad\":\"Abyad (Beyazl\u0131k)\",\"Accuracy\":\"Do\u011fruluk\",\"Ad-Free\":\"Reklams\u0131z\",\"Adaptive Charging\":\"Uyarlanabilir \u015earj\",\"Add\":\"Ekle\",\"Add Custom Adhan\":\"Ezan sesini ki\u015fiselle\u015ftir\",\"Add Custom Audio\":\"\xd6zel Ses Ekleme\",\"Add Reminder\":\"Hat\u0131rlat\u0131c\u0131 ekle\",\"Add Silent Mode\":\"Sessiz Mod Ekle\",\"Add new counter\":\"Yeni saya\xe7 ekle\",\"Add new location\":\"Yeni konum ekle\",\"Adhan\":\"Ezan\",\"Adhan audio file is not downloaded yet\":\"Ezan sesleri hen\xfcz indirilmedi\",\"Adjustments\":\"Ayarlamalar\",\"Advanced\":\"Geli\u015fmi\u015f\",\"Advanced Calculation Settings\":\"Geli\u015fmi\u015f hesaplama ayarlar\u0131\",\"Advanced Settings\":\"Geli\u015fmi\u015f Ayarlar\",\"Ahmer\":\"Ahmer (K\u0131z\u0131ll\u0131k)\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Namaz Vakitleri\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan, yararl\u0131 olaca\u011f\u0131 umuduyla, ancak HERHANG\u0130 B\u0130R GARANT\u0130 OLMAKSIZIN; hatta ZIMN\u0130 T\u0130CAR\u0130 ELVER\u0130\u015eL\u0130L\u0130K veya BEL\u0130RL\u0130 B\u0130R AMACA UYGUNLUK garantisi olmaks\u0131z\u0131n da\u011f\u0131t\u0131lmaktad\u0131r. Daha fazla ayr\u0131nt\u0131 i\xe7in GNU Affero Genel Kamu Lisans\u0131na bak\u0131n\u0131z.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan \xf6zg\xfcr bir yaz\u0131l\u0131md\u0131r: \xd6zg\xfcr Yaz\u0131l\u0131m Vakf\u0131 taraf\u0131ndan yay\u0131nlanan GNU Affero Genel Kamu Lisans\u0131 (v3.0) ko\u015fullar\u0131 alt\u0131nda yeniden da\u011f\u0131tabilir ve/veya de\u011fi\u015ftirebilirsiniz.\",\"Alarms Permission\":\"Alarm izni\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"Al-Azan'a sa\u011flanan t\xfcm veriler yaln\u0131zca cihaz\u0131n\u0131zda yerel olarak saklan\u0131r. Verileriniz hi\xe7bir yere y\xfcklenmez. Al-Azan'\u0131n geli\u015ftiricilerinin bu verilere eri\u015fimi yoktur. Verileriniz herhangi bir \xfc\xe7\xfcnc\xfc tarafla payla\u015f\u0131lmaz. Al-Azan, herhangi bir reklam k\xfct\xfcphanesi veya Google Analytics veya Facebook SDK gibi herhangi bir 3. taraf izleme (analitik) kodu i\xe7ermez.\",\"An error occured while playing the current track\":\"Ge\xe7erli ses \xe7al\u0131n\u0131rken bir hata olu\u015ftu\",\"App features\":\"Uygulama \xf6zellikleri\",\"Arabic\":\"Arap\xe7a\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\\\"\",[\"0\"],\"\\\" dosyas\u0131n\u0131 silmek istedi\u011finizden emin misiniz?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\\\"\",[\"itemName\"],\"\\\" silmek istedi\u011finizden emin misiniz?\"],\"Are you sure you want to delete this?\":\"Silmek istedi\u011finizden emin misiniz?\",\"Asr Calculation\":\"\u0130kindi hesaplama\",\"At least one prayer time must be shown\":\"En az bir namaz vakti g\xf6sterilmelidir\",\"Attention\":\"Dikkat\",\"Auto (Default)\":\"Otomatik (Varsay\u0131lan)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"\\\"Rahats\u0131z Etmeyin \\\"i atlamak m\u0131?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"Ezan hesaplaman\u0131n bir\xe7ok farkl\u0131 y\xf6ntemi vard\u0131r. Her y\xf6ntem farkl\u0131 sonu\xe7lar verir. Do\u011fru y\xf6ntemi bulmak ve kullanmak sizin sorumlulu\u011funuzdad\u0131r.\",\"Calculation\":\"Hesaplama\",\"Calculation Method\":\"Hesaplama y\xf6ntemi\",\"Calendar\":\"Takvim\",\"Cancel\":\"\u0130ptal\",\"Cancel Alarm\":\"Alarm\u0131 \u0130ptal Et\",\"Cancel download\":\"\u0130ndirmeyi iptal et\",\"Choose Asr Calculation Madhab\":\"\u0130kindi hesaplama mezhebini se\xe7in\",\"Choose Calculation Method\":\"Hesaplama y\xf6ntemini se\xe7in\",\"Choose High Latitude Setting\":\"Y\xfcksek enlem ayar\u0131n\u0131 se\xe7in\",\"Choose Language\":\"Dil se\xe7iniz\",\"Choose Polar Resolution\":\"Kutuplar i\xe7in \xe7\xf6z\xfcm\",\"Choose Shafaq method\":\"\u015eafak hesaplama methodu\",\"Choose calculation rounding method\":\"Hesaplama yuvarlama y\xf6ntemini se\xe7in\",\"Choose calendar type\":\"Takvim t\xfcr\xfcn\xfc se\xe7in\",\"Choose lunar calendar language\":\"Ay takvimi dilini se\xe7in\",\"Choose midnight calculation method\":\"Gece yar\u0131s\u0131 hesaplama y\xf6ntemini se\xe7in\",\"Choose numbering system\":\"Say\u0131 sistemini se\xe7in\",\"Choose which calendar to replace\":\"Hangi takvimin de\u011fi\u015ftirilece\u011fini se\xe7in\",\"City/Area\":\"\u015eehir/B\xf6lge\",\"Clear the coordinates\":\"Koordinatlar\u0131 temizleyin\",\"Clear the location\":\"Konumu temizleyin\",\"Clipboard data does not contain coordinates\":\"Kopyalanan veriler koordinat i\xe7ermiyor\",\"Close\":\"Kapat\",\"Closest City\":\"En yak\u0131n \u015fehir\",\"Closest Date\":\"En yak\u0131n tarih\",\"Compass Lock\":\"Pusula kilidi\",\"Compass sensor unavailable\":\"Pusula sens\xf6r\xfc kullan\u0131lam\u0131yor\",\"Confirm\":\"Onayla\",\"Continuous\":\"S\xfcrekli\",\"Coordinates updated\":\"Koordinatlar g\xfcncellendi\",\"Copy\":\"Anla\u015f\u0131ld\u0131\",\"Count\":\"Say\",\"Country\":\"\xdclke\",\"Custom\":\"\xd6zel\",\"Custom sounds and muezzins will not be exported\":\"\xd6zel sesler ve m\xfcezzinler d\u0131\u015fa aktar\u0131lmayacakt\u0131r\",\"Custom upcoming alarm time\":\"\xd6zel yakla\u015fan alarm zaman\u0131\",\"Dark\":\"Koyu\",\"Date\":\"Tarih\",\"Decrement\":\"Azalma\",\"Default\":\"Varsay\u0131lan\",\"Delete\":\"Sil\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"Cihaz\u0131n\u0131za ve Android s\xfcr\xfcm\xfcn\xfcze ba\u011fl\u0131 olarak, bazen cihaz\u0131n\u0131z pilden tasarruf etmek i\xe7in uygulamay\u0131 arka planda kapatabilir. Bu durum, alarmlar\u0131n/bildirimlerin iletilmesini engel olabilir.\",\"Deselect as Fajr Adhan\":\"Fecr ezan\u0131 se\xe7imini kald\u0131r\",\"Device sounds\":\"Cihaz sesleri\",\"Disabled\":\"Devre d\u0131\u015f\u0131 b\u0131rak\u0131ld\u0131\",\"Disclaimer\":\"Sorumluluk reddi\",\"Dismiss\":\"Reddet\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"Al-Azan'da verilen Diyanet y\xf6ntemi resmi saatlerin yakla\u015f\u0131k bir de\u011feridir. Zamanlar\u0131n tam olarak nas\u0131l hesapland\u0131\u011f\u0131na dair yeterli belge bulunmad\u0131\u011f\u0131ndan, \xf6zellikle T\xfcrkiye d\u0131\u015f\u0131nda zamanlar resmi web sitesiyle uyumlu olmayabilir.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, T\xfcrkiye\",\"Doesn't use any kind of trackers\":\"Herhangi bir izleyici kullanmaz\",\"Don't ask again\":\"Bir daha sorma\",\"Don't show again\":\"Bir daha g\xf6sterme\",\"Don't show alarm screen?\":\"Alarm ekran\u0131n\u0131 g\xf6stermiyor mu?\",\"Done\":\"Tamamland\u0131\",\"Download\":\"\u0130ndir\",\"Eastern Arabic\":\"Do\u011fu Arap\xe7as\u0131\",\"Edit\":\"D\xfczenle\",\"Edit Calculation Parameters\":\"Hesaplama Parametrelerini D\xfczenle\",\"Edit Counter\":\"Sayac\u0131 d\xfczenle\",\"Edit Location\":\"Konumu D\xfczenle\",\"Edit Reminder\":\"Hat\u0131rlat\u0131c\u0131y\u0131 d\xfczenle\",\"Edit Silent Mode\":\"Sessiz Modu D\xfczenle\",\"Egyptian General Survey Authority\":\"M\u0131s\u0131r Genel Ara\u015ft\u0131rma Kurumu\",\"Enabled\":\"Etkinle\u015ftir\",\"End after prayer (minutes)\":\"Namaz sonras\u0131 bitir (dakika)\",\"Error getting clipboard data\":\"Kopyalanan veriler al\u0131n\u0131rken hata olu\u015ftu\",\"Error in loading countries\":\"\xdclkeler y\xfcklenirken hata olu\u015ftu\",\"Error while downloading audio\":\"Sesler indirilirken hata olu\u015ftu\",\"Error while getting coordinates\":\"Koordinatlar al\u0131n\u0131rken hata olu\u015ftu\",\"Error: failed to open file\":\"Hata: dosya a\xe7\u0131lamad\u0131\",\"Ethiopic\":\"Etiyopya\",\"Export app data\":\"Uygulama verilerini d\u0131\u015fa aktar\",\"Export data\":\"Verileri d\u0131\u015fa aktar\",\"Fajr Angle\":\"Fecr A\xe7\u0131s\u0131\",\"Find My Location\":\"Konumumu bul\",\"Fix Common Problems\":\"Yayg\u0131n Sorunlar\u0131 Giderin\",\"France angle 15\":\"Fransa a\xe7\u0131 15\",\"France angle 18\":\"Fransa a\xe7\u0131s\u0131 18\",\"Friday\":\"Cuma\",\"General (default)\":\"Genel (varsay\u0131lan)\",\"Getting coordinates\":\"Koordinatlar\u0131 al\",\"Got it\":\"Anla\u015f\u0131ld\u0131\",\"Gregorian\":\"Gregoryen\",\"Gulf region\":\"K\xf6rfez b\xf6lgesi\",\"Hanafi\":\"Hanefi\",\"Hidden?\":\"Gizlensin mi?\",\"Hide Prayer Times\":\"Namaz vakitlerini gizle\",\"Hide times you don't need\":\"\u0130htiyac\u0131n\u0131z olmayan zamanlar\u0131 gizleme\",\"High\":\"Y\xfcksek\",\"High Latitude\":\"Y\xfcksek enlem\",\"Highlight current prayer\":\"Mevcut duay\u0131 vurgulay\u0131n\",\"Home\":\"Anasayfa\",\"Homescreen and notification Widgets\":\"Ana ekran ve bildirim Widget'ler\u0131\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Ancak, K\u0131ble haritas\u0131 gibi \xe7evrimi\xe7i hizmetleri kullan\u0131rken, uygulama sizi benzersiz bir \u015fekilde tan\u0131mlayabilecek veya tan\u0131mlamayabilecek minimum gerekli verileri iletebilir. L\xfctfen uygulamay\u0131 kullan\u0131rken bunu akl\u0131n\u0131zda bulundurun.\",\"I Understand\":\"Anl\u0131yorum\",\"IMPORTANT_CHANNEL_ID\":\"\xd6nemli\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"Etkinle\u015ftirilirse, bir sonraki namaz vakti bilgisini bildirim ekran\u0131ndan g\xf6sterir\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"Telefon ayarlar\u0131n\u0131zda \\\"Yedekle ve S\u0131f\u0131rla\\\" se\xe7ene\u011fini etkinle\u015ftirdiyseniz (Ayarlar / Yedekle ve S\u0131f\u0131rla / Verilerimi yedekle), Android'in kendisinin (Al-Azan'\u0131n de\u011fil) telefonunuzun verilerinin bir kopyas\u0131n\u0131 periyodik olarak Google sunucular\u0131na kaydedece\u011fini bilmelisiniz. Bu, cihaz\u0131n\u0131z\u0131n hasar g\xf6rmesi ya da yeni bir cihaz sat\u0131n alman\u0131z durumunda Android'in verilerinizi kurtarmas\u0131n\u0131 sa\u011flar. Al-Azan geli\u015ftiricilerinin bu verilere eri\u015fimi yoktur.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"Bir s\xfcre sonra uygulaman\u0131n durmas\u0131yla ilgili hala sorun ya\u015f\u0131yorsan\u0131z, daha fazla \xe7\xf6z\xfcm i\xe7in l\xfctfen dontkillmyapp.com adresini ziyaret edin.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"Uygulaman\u0131n sa\u011fl\u0131kl\u0131 bir \u015fekilde \xe7al\u0131\u015fabilmesi i\xe7in pil optimizasyonunu devre d\u0131\u015f\u0131 b\u0131rakman\u0131z gerekir. A\u015fa\u011f\u0131daki d\xfc\u011fmeyi kullanarak ilgili ayarlar\u0131 a\xe7abilirsiniz.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"Cihaz\u0131n\u0131z Google Pixel gibi uyarlanabilir \u015farj \xf6zelli\u011fine sahipse ve ezan veya hat\u0131rlat\u0131c\u0131lar\u0131n alarm olarak alg\u0131lanmas\u0131n\u0131 istemiyorsan\u0131z bu se\xe7ene\u011fi etkinle\u015ftirebilirsiniz.\",\"Import\":\"\u0130\xe7e aktarma\",\"Import app data\":\"Uygulama verilerini i\xe7e aktar\",\"Import successful\":\"\u0130\xe7e aktarma ba\u015far\u0131l\u0131\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"Be\u015f vakit namaza ek olarak G\xfcn Do\u011fumu, G\xfcn Bat\u0131m\u0131, Gece Yar\u0131s\u0131 ve Gece Namaz\u0131 (Tehecc\xfcd) ayarlar\u0131 vard\u0131r\",\"Increment\":\"Art\u0131\u015f\",\"Info\":\"Bilgi\",\"Internet connection\":\"\u0130nternet ba\u011flant\u0131s\u0131\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"K\u0131ble haritas\u0131n\u0131n \xe7al\u0131\u015fmas\u0131 i\xe7in internet ba\u011flant\u0131s\u0131 gereklidir. L\xfctfen kablosuz a\u011f\u0131 veya mobil verinizi etkinle\u015ftirin ve tekrar deneyin.\",\"Iran\":\"\u0130ran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0130ngilizce, Fars\xe7a, Arap\xe7a, T\xfcrk\xe7e, Endonezce, Frans\u0131zca, Urduca, Hint\xe7e, Almanca, Bo\u015fnak\xe7a, Vietnamca, Bangla dillerinde yerelle\u015ftirilmi\u015ftir\",\"Isha Angle\":\"Isha Angle\",\"Isha Interval\":\"Isha Interval\",\"Islamic\":\"\u0130slami\",\"Islamic (Saudi Arabia sighting)\":\"\u0130slami (Suudi Arabistan'a g\xf6re g\xf6r\xfcn\xfcm)\",\"Islamic (Umm al-Qura)\":\"\u0130slami (Umm al-Qura)\",\"Islamic (civil)\":\"\u0130slami (Sivil)\",\"Islamic (tabular)\":\"\u0130slami (Cetvele g\xf6re hesaplanm\u0131\u015f)\",\"Islamic Society of North America (ISNA)\":\"Kuzey Amerika \u0130slam Toplumu (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"G\xf6r\xfcn\xfc\u015fe g\xf6re bir yede\u011fi i\xe7e aktard\u0131n\u0131z, bu uygulama i\xe7in pil optimizasyonlar\u0131n\u0131 devre d\u0131\u015f\u0131 b\u0131rakmay\u0131 unutmay\u0131n\",\"Just now\":\"Hemen \u015fimdi\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Endonezya Diyanet \u0130\u015fleri Bakanl\u0131\u011f\u0131 (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\",\"Kuwait\":\"Kuveyt\",\"Label\":\"Etiket\",\"Language\":\"Dil\",\"Latitude\":\"Enlem\",\"Latitude is invalid\":\"Enlem ge\xe7ersiz\",\"License\":\"Lisans\",\"Light\":\"Ayd\u0131nl\u0131k\",\"Light and Dark theme\":\"A\xe7\u0131k/Koyu tema\",\"Light/Dark theme\":\"A\xe7\u0131k/Koyu tema\",\"List is empty\":\"Liste bo\u015f\",\"Loading\":\"Y\xfckleniyor\",\"Location\":\"Konum\",\"Location settings\":\"Konum ayarlar\u0131\",\"Longitude\":\"Boylam\",\"Longitude is invalid\":\"Boylam ge\xe7ersiz\",\"Low\":\"D\xfc\u015f\xfck\",\"Lunar Calendar\":\"Ay Takvimi\",\"Lunar Calendar Language\":\"Ay Takvimi Dili\",\"Maghrib Angle\":\"Maghrib A\xe7\u0131s\u0131\",\"Make a Copy\":\"Bir Kopya Olu\u015fturun\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Ezan hesaplamas\u0131 i\xe7in bir\xe7ok se\xe7enek\",\"Medium\":\"Orta\",\"Middle of the Night\":\"Gece yar\u0131s\u0131\",\"Midnight Method\":\"Gece Yar\u0131s\u0131 Y\xf6ntemi\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"Diyanet \u0130\u015fleri ve Vak\u0131flar Bakanl\u0131\u011f\u0131, Cezayir\",\"Ministry of Religious Affairs of Tunisia\":\"Tunus Din \u0130\u015fleri Bakanl\u0131\u011f\u0131\",\"Mobile Data\":\"Mobil veri\",\"Modified\":\"De\u011fi\u015ftirilmi\u015f\",\"Monday\":\"Pazartesi\",\"Moonsighting Committee\":\"Ay G\xf6zlem Komitesi\",\"Muslim World League\":\"D\xfcnya M\xfcsl\xfcman Birli\u011fi\",\"Name\":\"Ad\",\"Nearest\":\"En yak\u0131n\",\"New Counter\":\"Yeni saya\xe7\",\"New Location\":\"Yeni Konum\",\"New Reminder\":\"Yeni hat\u0131rlat\u0131c\u0131\",\"New Silent Mode\":\"Yeni Sessiz Mod\",\"Next\":\"Sonraki\",\"Next Day\":\"Ertesi g\xfcn\",\"Next Month\":\"Gelecek Ay\",\"No\":\"Hay\u0131r\",\"No Data\":\"Veri yok\",\"No Results\":\"Sonu\xe7 yok\",\"None\":\"Hi\xe7biri\",\"None (Automatic)\":\"Yok (Otomatik)\",\"Normal mode restored\":\"Normal mod geri y\xfcklendi\",\"Not now\":\"\u015eimdi olmaz\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"Yaz\u0131l\u0131m ve donan\u0131m hatalar\u0131 nedeniyle, bu uygulama taraf\u0131ndan \xf6zellikle pusula modunda g\xf6sterilen k\u0131ble y\xf6n\xfcn\xfcn yanl\u0131\u015f olabilece\u011fini unutmay\u0131n.\",\"Notification\":\"Bildirim\",\"Notification & Sound\":\"Bildirim & Ses\",\"Notifications Permission\":\"Bildirim izni\",\"Numbering system\":\"Say\u0131 sistemi\",\"Off\":\"Kapal\u0131\",\"Okay\":\"Tamam\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"Android 12 ve daha yeni s\xfcr\xfcmlerde, uygulaman\u0131n d\xfczg\xfcn \xe7al\u0131\u015fmas\u0131 i\xe7in alarm iznine de ihtiyac\u0131 vard\u0131r, bu nedenle buna da izin vermelisiniz.\",\"Once\":\"Bir kez\",\"One-Seventh of the Night\":\"Gecenin yedide biri\",\"Only once?\":\"Sadece bir kez mi?\",\"Only six items can be shown at the same time\":\"Ayn\u0131 anda yaln\u0131zca alt\u0131 \xf6\u011fe g\xf6sterilebilir\",\"Open Battery Optimization Settings\":\"Pil optimizasyon ayarlar\u0131n\u0131 a\xe7\",\"Open Power Manager Settings\":\"G\xfc\xe7 y\xf6netimi ayarlar\u0131n\u0131 a\xe7\",\"Open source repository\":\"A\xe7\u0131k kaynak deposu\",\"Open-source\":\"A\xe7\u0131k kaynak\",\"Options\":\"Se\xe7enekler\",\"Or if you have a backup, you can import it\":\"Veya bir yede\u011finiz varsa, onu i\xe7e aktarabilirsiniz\",\"Orientation Lock: Landscape\":\"Y\xf6nlendirme Kilidi: Yatay\",\"Orientation Lock: Portrait\":\"Y\xf6n Kilidi: Portre\",\"Orientation: Unlocked\":\"Y\xf6nlendirme: Kilitli de\u011fil\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"Di\u011fer manyetik cihazlar telefonunuzun pusulas\u0131n\u0131 etkileyebilir ve pusulan\u0131z\u0131n kalibre edilmesi gerekebilir.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Sessiz Mod\",\"PRE_ADHAN_CHANNEL_NAME\":\"Yakla\u015fan ezan\",\"PRE_REMINDER_CHANNEL_NAME\":\"Yakla\u015fan hat\u0131rlatma\",\"Pakistan\":\"Pakistan\",\"Paste\":\"Yap\u0131\u015ft\u0131r\",\"Persian\":\"Fars\xe7a\",\"Phone State Permission\":\"Telefon durumu izni\",\"Play\":\"Oyun\",\"Please enable location service\":\"L\xfctfen konum hizmetini etkinle\u015ftirin\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"Bu se\xe7ene\u011fin etkinle\u015ftirilmesinin ezan ve hat\u0131rlat\u0131c\u0131lar\u0131n gecikmeli olarak devreye girmesine veya baz\u0131 durumlarda hi\xe7 devreye girmemesine neden olabilece\u011fini l\xfctfen unutmay\u0131n. Bunu dikkatli bir \u015fekilde etkinle\u015ftirin.\",\"Polar Resolution\":\"Kutuplar i\xe7in hesaplama y\xf6ntemi\",\"Power Manager\":\"G\xfc\xe7 y\xf6neticisi\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"Namaz Vakitleri\",\"Prayer list\":\"Dua listesi\",\"Press to search\":\"Aramak i\xe7in bas\u0131n\",\"Press to select a method\":\"Bir y\xf6ntem se\xe7mek i\xe7in bas\u0131n\",\"Prev Day\":\"\xd6nceki g\xfcn\",\"Prev Month\":\"\xd6nceki Ay\",\"Privacy Policy\":\"Gizlilik Politikas\u0131\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"Mahremiyete sayg\u0131l\u0131 a\xe7\u0131k kaynak Ezan (\u0130slami namaz vakitleri) ve k\u0131ble uygulamas\u0131\",\"Qada counter\":\"Kaza namaz\u0131 sayac\u0131\",\"Qatar\":\"Katar\",\"Qibla\":\"K\u0131ble\",\"Qibla finder\":\"K\u0131ble bulucu\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"K\u0131ble bulucu konum servisine ihtiya\xe7 duyar. Etkinle\u015ftirilmezse, uygulama ayarlar\u0131ndaki konum kullan\u0131lacakt\u0131r.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"K\u0131ble haritas\u0131 \u015fu anda F-Droid s\xfcr\xfcmlerinde kullan\u0131lamamaktad\u0131r. Gelecekteki g\xfcncellemelerde kullan\u0131labilir hale gelebilir.\",\"REMINDER_CHANNEL_NAME\":\"Hat\u0131rlat\u0131c\u0131\",\"Ramadan is ending,\":\"Ramazan bitiyor,\",\"Ramadan is near,\":\"Ramazan yakla\u015f\u0131yor,\",\"Remaining till\":\"Kalan s\xfcre\",\"Remind me next year\":\"Gelecek y\u0131l hat\u0131rlat bana\",\"Reminder\":\"Hat\u0131rlat\u0131c\u0131\",\"Repeat\":\"Tekrarla\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"Gerekli ayarlar tamamlanmad\u0131. Uygulaman\u0131n namaz vakitlerini g\xf6stermesi i\xe7in daha sonra ayarlardan yap\u0131land\u0131rman\u0131z gerekmektedir.\",\"Rounding Method\":\"Yuvarlama Y\xf6ntemi\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"Samsung cihazlar\u0131n\u0131n \\\"Cihaz Bak\u0131m\u0131\\\" ad\u0131 verilen kendi \xf6zel G\xfc\xe7 Y\xf6neticisi vard\u0131r. A\u015fa\u011f\u0131daki d\xfc\u011fmeye bast\u0131ktan sonra, Cihaz Bak\u0131m\u0131n\u0131n Pil men\xfcs\xfcne y\xf6nlendirileceksiniz. Pil men\xfcs\xfcnde \\\"Uygulama g\xfc\xe7 y\xf6netimi\\\"ne ve ard\u0131ndan \\\"Uykuya al\u0131nmayacak uygulamalar\\\"a dokunun ve bu uygulamay\u0131 listeye ekleyin.\",\"Saturday\":\"Cumartesi\",\"Saudi Arabia\":\"Suudi Arabistan\",\"Search\":\"Ara\",\"Secondary Calendar\":\"\u0130kincil takvim\",\"See favorite locations\":\"Favori konumlar\u0131 g\xf6r\xfcn\",\"Select as Fajr Adhan\":\"Fecr ezan\u0131 olarak se\xe7\",\"Select different Adhan audio for Fajr namaz\":\"Sabah namaz\u0131 i\xe7in farkl\u0131 Ezan sesi se\xe7me\",\"Selected\":\"Se\xe7ilmi\u015f\",\"Selected as adhan\":\"Ezan olarak se\xe7ildi\",\"Selected as fajr adhan\":\"Fecr ezan\u0131 olarak se\xe7ildi\",\"Selecting a name is required\":\"Bir isim gerekli\",\"Set custom Adhan audio\":\"\xd6zel Ezan sesi ayarlama\",\"Set reminders before or after a prayer time\":\"Dua zaman\u0131ndan \xf6nce veya sonra hat\u0131rlat\u0131c\u0131 ayarlama\",\"Shafaq\":\"\u015eafak\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\u015eafak tipi se\xe7imi, sabah namaz\u0131n\u0131n zaman\u0131n\u0131 belirlemek i\xe7in MoonsightingCommittee'nin hesap y\xf6nteminde kullan\u0131l\u0131r.\",\"Shafi, Maliki, Hanbali (Default)\":\"\u015eafi, Maliki, Hanbeli (Varsay\u0131lan)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u015eii Ithna Ashari, Leva Enstit\xfcs\xfc, Kum\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u015eii, Jeofizik Enstit\xfcs\xfc, Tahran \xdcniversitesi\",\"Should app highlight current prayer instead of next prayer?\":\"Uygulama bir sonraki dua yerine mevcut duay\u0131 vurgulamal\u0131 m\u0131?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\\\"Rahats\u0131z Etmeyin\\\" aktifken uygulama hala ezan \xe7almal\u0131 m\u0131?\",\"Should app stop playing adhan when the volume button is pressed?\":\"Ses d\xfc\u011fmesine bas\u0131ld\u0131\u011f\u0131nda uygulama ezan \xe7almay\u0131 durdursun mu?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"Ezan veya hat\u0131rlatma \xe7almaya ba\u015flad\u0131\u011f\u0131nda telefon titremeli mi?\",\"Show Adhan Options\":\"Ezan se\xe7eneklerini g\xf6ster\",\"Show Today\":\"Bug\xfcn\xfc g\xf6ster\",\"Show countdown?\":\"Geri say\u0131m g\xf6sterilsin mi?\",\"Show current\":\"Ge\xe7erli g\xf6ster\",\"Show me\":\"G\xf6ster bana\",\"Show next in notification?\":\"Sonraki bildirim g\xf6sterilsin mi?\",\"Show notification widget?\":\"Bildirim gereci g\xf6sterilsin mi?\",\"Show settings\":\"Ayarlar\u0131 g\xf6ster\",\"Show upcoming alarm notification?\":\"Yakla\u015fan alarm bildirimi g\xf6sterilsin mi?\",\"Silent\":\"Sessiz\",\"Silent Mode Ended\":\"Sessiz Mod Sona Erdi\",\"Silent Mode Name\":\"Sessiz Mod Ad\u0131\",\"Silent Mode Started\":\"Sessiz Mod Ba\u015flad\u0131\",\"Silent mode activated\":\"Sessiz mod etkinle\u015ftirildi\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"Herhangi bir izleyici veya \xe7\xf6kme analizi kullanmad\u0131\u011f\u0131m\u0131z i\xe7in, l\xfctfen ya\u015fad\u0131\u011f\u0131n\u0131z herhangi bir sorunu veya \xf6nerilerinizi github repomuza bildirin\",\"Singapore\":\"Singapur\",\"Skip\":\"Atla\",\"Software License\":\"Yaz\u0131l\u0131m Lisans\u0131\",\"Solar Hijri\":\"G\xfcne\u015f Hicri\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"Baz\u0131 cihazlarda, uygulaman\u0131n arka planda \xe7al\u0131\u015fmaya devam edebilmesi i\xe7in G\xfc\xe7 Y\xf6neticilerinde ek ayarlara ihtiyac\u0131 vard\u0131r. Uygulaman\u0131n arkaplanda \xe7al\u0131\u015fabilmesi i\xe7in g\xfc\xe7 tasarrufu se\xe7ene\u011fini devre d\u0131\u015f\u0131 b\u0131rak\u0131n.\",\"Sound\":\"Ses\",\"Spiritual Administration of Muslims of Russia\":\"Rusya M\xfcsl\xfcmanlar\u0131n\u0131n Ruhani Y\xf6netimi\",\"Start before prayer (minutes)\":\"Namaz \xf6ncesi ba\u015flat (dakika)\",\"Status\":\"Durum\",\"Stop\":\"Dur\",\"Sunday\":\"Pazar\",\"Sunset to Fajr (Default)\":\"G\xfcnbat\u0131m\u0131ndan Fecr'e (Varsay\u0131lan)\",\"Sunset to Sunrise\":\"G\xfcnbat\u0131m\u0131ndan G\xfcndo\u011fumuna\",\"System Default\":\"Sistem varsay\u0131lan\u0131\",\"Tahajjud time mentioned in the app is the last third of the night\":\"Uygulamada belirtilen tehecc\xfcd vakti gecenin son \xfc\xe7te biridir\",\"Thai Solar\":\"Thai Solar\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"Uygulamam\u0131z\u0131 se\xe7ti\u011finiz i\xe7in te\u015fekk\xfcrler! Uygulamam\u0131z\u0131 kullanmaya ba\u015flamadan \xf6nce yapman\u0131z gereken baz\u0131 \u015feyler var.\",\"The Gulf Region (Dubai)\":\"K\xf6rfez B\xf6lgesi (Dubai)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"Uygulaman\u0131n ay takvimi \xf6nceden hesaplanm\u0131\u015ft\u0131r ve ay g\xf6zlemlerine dayanmad\u0131\u011f\u0131 i\xe7in do\u011fru olmayabilir. Bu \xf6zellikle Ramazan'\u0131n ba\u015flang\u0131c\u0131 ve biti\u015fi i\xe7in \xf6nemlidir.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"Bu web sitesinde ve uygulamada bulunan metin di\u011fer dillerde do\u011fru olmayabilir, bu nedenle her durumda yaln\u0131zca \u0130ngilizce s\xfcr\xfcm dikkate al\u0131nmal\u0131d\u0131r.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Ana ekran\u0131n \xfcst\xfcnde ve widget'larda ay takviminin yan\u0131nda g\xf6sterilen takvim t\xfcr\xfc\",\"The type of lunar calendar shown in main screen and widgets\":\"Ana ekranda ve widget'larda g\xf6sterilen ay takvimi t\xfcr\xfc\",\"Theme Color\":\"Tema rengi\",\"Thursday\":\"Per\u015fembe\",\"Time\":\"Vakit\",\"Time condition\":\"Zaman ko\u015fulu\",\"Time format\":\"Zaman format\u0131\",\"Time list\":\"Zaman listesi\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"Ezan vaktini hesaplamak i\xe7in konumunuza ihtiyac\u0131m\u0131z var. \\\"Konumumu Bul\\\" d\xfc\u011fmesini kullanabilir, \xfclke ve \u015fehir/b\xf6lge aramas\u0131n\u0131 kullanabilir veya koordinatlar\u0131n\u0131z\u0131 manuel olarak girebilirsiniz.\",\"To see notifications about adhan, we need your permission.\":\"Ezanla ilgili bildirimleri g\xf6rmek i\xe7in izninize ihtiyac\u0131m\u0131z var.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"Bir \xe7a\u011fr\u0131 ald\u0131\u011f\u0131n\u0131zda ezan \xe7almay\u0131 durdurmak i\xe7in telefon durumuna eri\u015fmemiz gerekir. Bu eri\u015fime izin vermemek bu \xf6zelli\u011fi devre d\u0131\u015f\u0131 b\u0131rak\u0131r.\",\"Tomorrow\":\"Yar\u0131n\",\"Tuesday\":\"Sal\u0131\",\"Turn Left\":\"Sola D\xf6n\",\"Turn Right\":\"Sa\u011fa D\xf6n\",\"Turn history off\":\"Ge\xe7mi\u015fi kapat\u0131n\",\"Turn history on\":\"Ge\xe7mi\u015fi a\xe7\u0131n\",\"Twilight Angle\":\"G\xfcne\u015f ufuk a\xe7\u0131s\u0131\",\"Umm al-Qura University, Makkah\":\"Umm al-Qura \xdcniversitesi, Mekke \",\"Union Organization Islamic de France\":\"Fransa \u0130slam organizasyon birli\u011fi\",\"University of Islamic Sciences, Karachi\":\"\u0130slami \u0130limler \xdcniversitesi, Kara\xe7i\",\"Unknown Error\":\"Bilinmeyen hata\",\"Unreliable\":\"G\xfcvenilmez\",\"Unresolved (default)\":\"\xc7\xf6z\xfcmlenmemi\u015f (varsay\u0131lan)\",\"Unsupported\":\"Desteklenmiyor\",\"Up\":\"Yukar\u0131\",\"Upcoming alarm\":\"Yakla\u015fan alarm\",\"Updating widgets\":\"Widget'lar\u0131 g\xfcncelle\",\"Use 24-Hour format\":\"24 Saat bi\xe7imini kullan\",\"Use Compass\":\"Pusulay\u0131 kullan\",\"Use Map\":\"Kullan\u0131m haritas\u0131\",\"Use a different alarm type?\":\"Farkl\u0131 bir alarm t\xfcr\xfc m\xfc kullan\u0131yorsunuz?\",\"Use adaptive theme?\":\"Uyarlanabilir bir tema m\u0131 kullan\u0131yorsunuz?\",\"Use headphones when available?\":\"Uygun oldu\u011funda kulakl\u0131k kullan\u0131ls\u0131n m\u0131?\",\"Using Coordinates\":\"Koordinatlar\u0131 kullan\",\"Using GPS\":\"GPS kullan\",\"Using Search\":\"Aramay\u0131 kullan\",\"Version\":\"S\xfcr\xfcm\",\"Vibration Mode\":\"Titre\u015fim Modu\",\"Vibration on call\":\"Arama s\u0131ras\u0131nda titre\u015fim\",\"Volume button stops adhan\":\"Ses d\xfc\u011fmesi ezan\u0131 durdursun\",\"WIDGET_CHANNEL_NAME\":\"Widget\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"Widgeti g\xfcncelle\",\"We'll help you do them quickly.\":\"H\u0131zl\u0131 bir \u015fekilde yapman\u0131za yard\u0131mc\u0131 olaca\u011f\u0131z.\",\"Wednesday\":\"\xc7ar\u015famba\",\"Welcome\":\"Ho\u015f geldiniz\",\"Western Arabic\":\"Bat\u0131 Arap\xe7as\u0131\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Etkinle\u015ftirildi\u011finde, ezan veya hat\u0131rlatma \xe7almaya ba\u015flad\u0131\u011f\u0131nda ekran kapal\u0131 kal\u0131r ve alarm ekran\u0131 g\xf6sterilmez\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"Etkinle\u015ftirildi\u011finde, kulakl\u0131k tak\u0131l\u0131yken t\xfcm ses yaln\u0131zca kulakl\u0131kta \xe7al\u0131n\u0131r.\",\"Wifi\":\"Kablosuz a\u011f\",\"Yes\":\"Evet\",\"You are facing Kaaba\":\"Kabe'ye bak\u0131yorsunuz\",\"You are not facing Kaaba\":\"K\xe2be'ye d\xf6n\xfck de\u011filsin\",\"You can access your device Power Manager using the button below.\":\"A\u015fa\u011f\u0131daki d\xfc\u011fmeyi kullanarak cihaz\u0131n\u0131z\u0131n G\xfc\xe7 Y\xf6neticisine eri\u015febilirsiniz.\",\"You can also paste coords from clipboard\":\"Ayr\u0131ca panodan kordinatlar\u0131 yap\u0131\u015ft\u0131rabilirsiniz\",\"You can change the language used for lunar calendar\":\"Ay takvimi i\xe7in kullan\u0131lan dili de\u011fi\u015ftirebilirsiniz\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"Yakla\u015fan alarm bildiriminin ezan veya hat\u0131rlatmadan \xf6nce ne zaman g\xf6nderilece\u011fini de\u011fi\u015ftirebilirsiniz\",\"You can choose to replace one of calendars with your current location\":\"Takvimlerden birini ge\xe7erli konumunuzla de\u011fi\u015ftirmeyi se\xe7ebilirsiniz\",\"You can hide prayer times you don't want to see in the main screen here:\":\"Ana ekranda g\xf6r\xfcnmesini istemedi\u011finiz vakitleri buradan gizleyebilirsiniz:\",\"You can hide prayer times you don't want to see in the widget here:\":\"Widget'ta g\xf6r\xfcnmesini istemedi\u011finiz vakitleri buradan gizleyebilirsiniz:\",\"You can search for your location offline Or use GPS\":\"Konumunuzu \xe7evrimd\u0131\u015f\u0131 arayabilir veya GPS kullanabilirsiniz\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"Bu programla birlikte GNU Affero Genel Kamu Lisans\u0131n\u0131n bir kopyas\u0131n\u0131 alm\u0131\u015f olmal\u0131s\u0131n\u0131z. De\u011filse, https://www.gnu.org/licenses/ adresine bak\u0131n.\",\"Your sounds\":\"Sesleriniz\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samed\",\"about.credits\":\"Ezan seslerinin telif haklar\u0131 sahiplerine aittir.\\nHarika hizmetleri i\xe7in translation.io'ya (lingui.js) \xf6zel te\u015fekk\xfcrler.\\nBu uygulamay\u0131 m\xfcmk\xfcn k\u0131lan harika k\xfct\xfcphaneler i\xe7in t\xfcm a\xe7\u0131k kaynak toplulu\u011funa te\u015fekk\xfcrler.\",\"about.credits.google\":\"Bu uygulamada kullan\u0131lan simgelerin \xe7o\u011fu Google Material simgelerinden al\u0131nm\u0131\u015ft\u0131r.\",\"about_settings\":\"Hakk\u0131nda\",\"adjustment.hint\":\"Hesaplanan s\xfcrelere eklenecek dakika say\u0131s\u0131\",\"after\":\"sonra\",\"ago\":\"\xf6nce\",\"asr.prayer\":\"\u0130kindi\",\"backup_settings\":\"Yedekleme\",\"before\":\"\xf6nce\",\"calculation_adjustments_settings\":\"Ayarlamalar\",\"calculation_advanced_settings\":\"Geli\u015fmi\u015f hesaplama ayarlar\u0131\",\"calculation_settings\":\"Hesaplama\",\"counter.fast\":\"Oru\xe7\",\"date.day\":\"g\xfcn\",\"date.hour\":\"saat\",\"date.minute\":\"dakika\",\"date.second\":\"saniye\",\"dev_settings\":\"Geli\u015ftirici\",\"dhuhr.prayer\":\"\xd6\u011fle\",\"display_settings\":\"G\xf6r\xfcn\xfcm\",\"fajr.prayer\":\"Sabah\",\"favorite_location\":\"Favori Mekanlar\",\"forces all numbers to be in the selected system\":\"t\xfcm say\u0131lar\u0131 se\xe7ilen sistemde olmaya zorlar\",\"from North\":\"kuzey'den\",\"from settings\":\"ayarlardan\",\"fullscreen_alarm\":\"Ezan\u0131 dinle\",\"hijri.adjustment.hint\":\"Ay takvimine eklenecek g\xfcn say\u0131s\u0131\",\"home\":\"Anasayfa\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"etkinle\u015ftirilirse, herhangi bir namaz vaktinden veya sesli hat\u0131rlat\u0131c\u0131dan yakla\u015f\u0131k bir saat \xf6nce bir bildirim g\xf6sterilecektir\",\"intro\":\"g\u0130R\u0130\u015e\",\"is prayer time hidden?\":\"namaz vakti gizlensin mi?\",\"isha.prayer\":\"Yats\u0131\",\"later\":\"daha sonra\",\"location_settings\":\"Konum\",\"maghrib.prayer\":\"Ak\u015fam\",\"masjid_an_nabawi\":\"Mescid-i Nebev\xee\",\"minutes\":\"dakika\",\"moazen_zade\":\"Moazen Zade\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"Ayl\u0131k G\xf6r\xfcn\xfcm\",\"muezzin_settings\":\"M\xfcezzin\",\"notification_advanced_settings\":\"Geli\u015fmi\u015f Ayarlar\",\"notification_settings\":\"Bildirim & Ses\",\"qada_counter\":\"Kaza sayac\u0131\",\"qibla_compass\":\"K\u0131ble pusulas\u0131\",\"qibla_finder\":\"K\u0131ble Bulucu\",\"qibla_map\":\"K\u0131ble haritas\u0131\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"Hat\u0131rlat\u0131c\u0131lar\",\"settings\":\"Ayarlar\",\"should notification widget be shown?\":\"bildirim widget'\u0131 g\xf6sterilmeli mi?\",\"should {prayerName} be hidden?\":[[\"prayerName\"],\" gizlensin mi?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"uygulaman\u0131n takvimi \xf6nceden hesapland\u0131\u011f\u0131ndan ve ay g\xf6zlemlerine dayanmad\u0131\u011f\u0131ndan, Ramazan'\u0131n ba\u015flang\u0131c\u0131 ve biti\u015fi i\xe7in yanl\u0131\u015f tarih g\xf6sterebilir.\",\"sunnah.midnight\":\"Gece yar\u0131s\u0131\",\"sunnah.tahajjud\":\"Tehecc\xfcd\",\"sunrise\":\"G\xfcne\u015f\",\"sunset\":\"G\xfcn bat\u0131m\u0131\",\"widget_settings\":\"Widget ayarlar\u0131\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"prayer\"],\" vaktinden \",[\"durationInMinutes\"],\" dakika sonra\"],\"{durationInMinutes} min before {prayer}\":[[\"prayer\"],\" vaktinden \",[\"durationInMinutes\"],\" dakika \xf6nce\"],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" bildirimi g\xf6sterilecek\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" sesi \xe7al\u0131nacak\"]}")}),633,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 \u0645\u0646\u0679\",\"15 min\":\"15 \u0645\u0646\u0679\",\"30 min\":\"30 \u0645\u0646\u0679\",\"30 minutes is added to Isha time during Ramadan in this method\":\"\u0627\u0633 \u0637\u0631\u06cc\u0642\u06c1 \u0633\u06d2 \u0631\u0645\u0636\u0627\u0646 \u0645\u06cc\u06ba \u0639\u0634\u0627\u0621 \u06a9\u06d2 \u0648\u0642\u062a \u0645\u06cc\u06ba 30 \u0645\u0646\u0679 \u06a9\u0627 \u0627\u0636\u0627\u0641\u06c1 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4\",\"5 min\":\"5 \u0645\u0646\u0679\",\"60 min\":\"60 \u0645\u0646\u0679\",\"90 min\":\"90 \u0645\u0646\u0679\",\"ADHAN_CHANNEL_NAME\":\"\u0627\u0630\u0627\u0646\",\"Abyad\":\"\u0627\u0628\u06cc\u0627\u062f\",\"Accuracy\":\"\u062f\u0631\u0633\u062a\u06af\u06cc\",\"Ad-Free\":\"\u0627\u0634\u062a\u06c1\u0627\u0631 \u0633\u06d2 \u067e\u0627\u06a9\",\"Adaptive Charging\":\"\u0627\u0688\u0627\u067e\u0679\u06cc\u0648 \u0686\u0627\u0631\u062c\u0646\u06af\",\"Add\":\"\u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Add Custom Adhan\":\"\u0627\u067e\u0646\u06cc \u0645\u0631\u0636\u06cc \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0627\u0630\u0627\u0646 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\",\"Add Custom Audio\":\"\u062d\u0633\u0628 \u0636\u0631\u0648\u0631\u062a \u0622\u0688\u06cc\u0648 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Add Reminder\":\"\u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Add Silent Mode\":\"Add Silent Mode\",\"Add new counter\":\"\u0646\u06cc\u0627 \u06a9\u0627\u0624\u0646\u0679\u0631 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Add new location\":\"\u0646\u06cc\u0627 \u0645\u0642\u0627\u0645 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Adhan\":\"\u0627\u0630\u0627\u0646\",\"Adhan audio file is not downloaded yet\":\"\u0627\u0630\u0627\u0646 \u0622\u0688\u06cc\u0648 \u0641\u0627\u0626\u0644 \u0627\u0628\u06be\u06cc \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u0626\u06cc \u06c1\u06d2\u06d4\",\"Adjustments\":\"\u0627\u06cc\u0688\u062c\u0633\u0679\u0645\u0646\u0679\u0633\",\"Advanced\":\"\u0627\u0639\u0644\u06cc \u062f\u0631\u062c\u06d2 \u06a9\u06cc\",\"Advanced Calculation Settings\":\"\u0627\u0639\u0644\u06cc \u062f\u0631\u062c\u06d2 \u06a9\u06cc \u062d\u0633\u0627\u0628 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"Advanced Settings\":\"\u0627\u0639\u0644\u06cc \u062f\u0631\u062c\u06d2 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"Ahmer\":\"\u0627\u062d\u0645\u0631\",\"Al-Azan\":\"\u0627\u0644\u0627\u0630\u0627\u0646\",\"Al-Azan - Prayer Times\":\"\u0627\u0644\u0627\u0630\u0627\u0646 - \u0627\u0648\u0642\u0627\u062a \u0646\u0645\u0627\u0632\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"\u0627\u0644\u0627\u0630\u0627\u0646 \u06a9\u0648 \u0627\u0633 \u0627\u0645\u06cc\u062f \u067e\u0631 \u062a\u0642\u0633\u06cc\u0645 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u0645\u0641\u06cc\u062f \u062b\u0627\u0628\u062a \u06c1\u0648\u06af\u0627\u060c \u0644\u06cc\u06a9\u0646 \u0628\u063a\u06cc\u0631 \u06a9\u0633\u06cc \u0648\u0627\u0631\u0646\u0679\u06cc \u06a9\u06d2\u061b \u06cc\u06c1\u0627\u06ba \u062a\u06a9 \u06a9\u06c1 \u06a9\u0633\u06cc \u062e\u0627\u0635 \u0645\u0642\u0635\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u062a\u062c\u0627\u0631\u062a\u06cc \u0642\u0627\u0628\u0644\u06cc\u062a \u06cc\u0627 \u0641\u0679\u0646\u0633 \u06a9\u06cc \u0645\u0636\u0645\u0631 \u0648\u0627\u0631\u0646\u0679\u06cc \u06a9\u06d2 \u0628\u063a\u06cc\u0631\u06d4 \u0645\u0632\u06cc\u062f \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 GNU Affero General Public License \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u06d4\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"\u0627\u0644\u0627\u0630\u0627\u0646 \u0645\u0641\u062a \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631 \u06c1\u06d2: \u0622\u067e \u0627\u0633\u06d2 GNU Affero General Public License (v3.0) \u06a9\u06cc \u0634\u0631\u0627\u0626\u0637 \u06a9\u06d2 \u062a\u062d\u062a \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u0642\u0633\u06cc\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631/\u06cc\u0627 \u0627\u0633 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u0641\u0631\u06cc \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631 \u0641\u0627\u0624\u0646\u0688\u06cc\u0634\u0646 \u0646\u06d2 \u0634\u0627\u0626\u0639 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4\",\"Alarms Permission\":\"\u0627\u0644\u0627\u0631\u0645 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"\u0627\u0644\u0627\u0630\u0627\u0646 \u06a9\u0648 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u062a\u0645\u0627\u0645 \u0688\u06cc\u0679\u0627 \u0635\u0631\u0641 \u0645\u0642\u0627\u0645\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0622\u067e \u06a9\u06d2 \u0622\u0644\u06d2 \u0645\u06cc\u06ba \u0645\u062d\u0641\u0648\u0638 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u0627 \u0688\u06cc\u0679\u0627 \u06a9\u06c1\u06cc\u06ba \u0628\u06be\u06cc \u0627\u067e \u0644\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u0627 \u06c1\u06d2\u06d4 \u0627\u0644\u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0688\u0648\u06cc\u0644\u067e\u0631\u0632 \u06a9\u0648 \u0627\u0633 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u0627 \u0688\u06cc\u0679\u0627 \u06a9\u0633\u06cc \u062a\u06cc\u0633\u0631\u06d2 \u0641\u0631\u06cc\u0642 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u06cc\u0626\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u0644\u0627\u0630\u0627\u0646 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0627\u0634\u062a\u06c1\u0627\u0631\u06cc \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc \u06cc\u0627 \u06a9\u0648\u0626\u06cc \u062a\u06be\u0631\u0688 \u067e\u0627\u0631\u0679\u06cc \u0679\u0631\u06cc\u06a9\u0646\u06af (\u062a\u062c\u0632\u06cc\u06c1) \u06a9\u0648\u0688 \u0634\u0627\u0645\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u062c\u06cc\u0633\u06d2 \u06af\u0648\u06af\u0644 \u062a\u062c\u0632\u06cc\u0627\u062a \u06cc\u0627 \u0641\u06cc\u0633 \u0628\u06a9 SDK\u06d4\",\"An error occured while playing the current track\":\"\u0679\u0631\u06cc\u06a9 \u06a9\u0648 \u0686\u0644\u0627\u0646\u06d2 \u06a9\u06d2 \u062f\u0648\u0631\u0627\u0646 \u0627\u06cc\u06a9 \u062e\u0631\u0627\u0628\u06cc \u067e\u06cc\u0634 \u0622\u06af\u0626\u06cc\",\"App features\":\"\u0627\u06cc\u067e \u06a9\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a\",\"Arabic\":\"\u0639\u0631\u0628\u06cc\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\u06a9\u06cc\u0627 \u0622\u067e \u0648\u0627\u0642\u0639\u06cc \\\"\",[\"0\"],\"\\\" \u06a9\u0648 \u062d\u0630\u0641 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u061f\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\u06a9\u06cc\u0627 \u0622\u067e \u0648\u0627\u0642\u0639\u06cc \\\"\",[\"itemName\"],\"\\\" \u06a9\u0648 \u062d\u0630\u0641 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u061f\"],\"Are you sure you want to delete this?\":\"\u06a9\u06cc\u0627 \u0622\u067e \u0648\u0627\u0642\u0639\u06cc \u0627\u0633\u06d2 \u062d\u0630\u0641 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u061f\",\"Asr Calculation\":\"\u0639\u0635\u0631 \u06a9\u0627 \u062d\u0633\u0627\u0628\",\"At least one prayer time must be shown\":\"\u06a9\u0645 \u0627\u0632 \u06a9\u0645 \u0627\u06cc\u06a9 \u0646\u0645\u0627\u0632 \u06a9\u0627 \u0648\u0642\u062a \u0636\u0631\u0648\u0631 \u062f\u06a9\u06be\u0627\u06cc\u0627 \u062c\u0627\u0626\u06d2\u06d4\",\"Attention\":\"\u062a\u0648\u062c\u06c1\",\"Auto (Default)\":\"\u062e\u0648\u062f\u06a9\u0627\u0631 (\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0637\u06d2 \u0634\u062f\u06c1)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"\u0628\u0627\u0626\u06cc \u067e\u0627\u0633 \\\"\u0688\u0633\u0679\u0631\u0628 \u0646\u06c1 \u06a9\u0631\u06cc\u06ba\\\"\u061f\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"\u0627\u0630\u0627\u0646 \u06a9\u0627 \u062d\u0633\u0627\u0628 \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u06c1\u062a \u0633\u06d2 \u0637\u0631\u06cc\u0642\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06c1\u0631 \u0637\u0631\u06cc\u0642\u06c1 \u0645\u062e\u062a\u0644\u0641 \u0646\u062a\u0627\u0626\u062c \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0635\u062d\u06cc\u062d \u0637\u0631\u06cc\u0642\u06c1 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u0627 \u0627\u0648\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0627 \u0622\u067e \u06a9\u06cc \u0630\u0645\u06c1 \u062f\u0627\u0631\u06cc \u06c1\u06d2\u06d4\",\"Calculation\":\"\u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628\",\"Calculation Method\":\"\u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1\",\"Calendar\":\"\u06a9\u06cc\u0644\u0646\u0688\u0631\",\"Cancel\":\"\u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u06cc\u06ba\u06d4\",\"Cancel Alarm\":\"\u0627\u0644\u0627\u0631\u0645 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u06cc\u06ba\u06d4\",\"Cancel download\":\"\u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose Asr Calculation Madhab\":\"\u0639\u0635\u0631 \u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose Calculation Method\":\"\u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose High Latitude Setting\":\"\u0627\u0639\u0644\u06cc \u0639\u0631\u0636 \u0628\u0644\u062f \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose Language\":\"\u0632\u0628\u0627\u0646 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose Polar Resolution\":\"\u067e\u0648\u0644\u0631 \u0631\u06cc\u0632\u0648\u0644\u0648\u0634\u0646 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose Shafaq method\":\"\u0634\u0641\u0642 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose calculation rounding method\":\"\u06a9\u06cc\u0644\u06a9\u0648\u0644\u06cc\u0634\u0646 \u0631\u0627\u0624\u0646\u0688\u0646\u06af \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose calendar type\":\"\u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06cc \u0642\u0633\u0645 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose lunar calendar language\":\"\u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06cc \u0632\u0628\u0627\u0646 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose midnight calculation method\":\"\u0622\u062f\u06be\u06cc \u0631\u0627\u062a \u06a9\u06d2 \u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose numbering system\":\"\u0646\u0645\u0628\u0631\u0646\u06af \u0633\u0633\u0679\u0645 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Choose which calendar to replace\":\"\u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u06a9\u0648\u0646 \u0633\u0627 \u06a9\u06cc\u0644\u0646\u0688\u0631 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u0646\u0627 \u06c1\u06d2\u06d4\",\"City/Area\":\"\u0634\u06c1\u0631/\u0639\u0644\u0627\u0642\u06c1\",\"Clear the coordinates\":\"\u0646\u0642\u0627\u0637 \u06a9\u0648 \u0635\u0627\u0641 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Clear the location\":\"\u0645\u0642\u0627\u0645 \u0635\u0627\u0641 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Clipboard data does not contain coordinates\":\"\u06a9\u0644\u067e \u0628\u0648\u0631\u0688 \u0688\u06cc\u0679\u0627 \u0645\u06cc\u06ba \u0646\u0642\u0627\u0637 \u067e\u0631 \u0645\u0634\u062a\u0645\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4\",\"Close\":\"\u0628\u0646\u062f \u06a9\u0631\u06cc\u06ba\",\"Closest City\":\"\u0642\u0631\u06cc\u0628 \u062a\u0631\u06cc\u0646 \u0634\u06c1\u0631\",\"Closest Date\":\"\u0642\u0631\u06cc\u0628 \u062a\u0631\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e\",\"Compass Lock\":\"\u06a9\u0645\u067e\u0627\u0633 \u0644\u0627\u06a9\",\"Compass sensor unavailable\":\"\u06a9\u0645\u067e\u0627\u0633 \u0633\u06cc\u0646\u0633\u0631 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4\",\"Confirm\":\"\u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Continuous\":\"\u0645\u0633\u0644\u0633\u0644\",\"Coordinates updated\":\"\u06a9\u0648\u0622\u0631\u0688\u06cc\u0646\u06cc\u0679\u0633 \u0627\u067e \u0688\u06cc\u0679 \u06c1\u0648 \u06af\u0626\u06d2\u06d4\",\"Copy\":\"\u06a9\u0627\u067e\u06cc\",\"Count\":\"\u0634\u0645\u0627\u0631\",\"Country\":\"\u0645\u0644\u06a9\",\"Custom\":\"\u0627\u067e\u0646\u06cc \u0645\u0631\u0636\u06cc \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642\",\"Custom sounds and muezzins will not be exported\":\"\u0627\u067e\u0646\u06cc \u0645\u0631\u0636\u06cc \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0622\u0648\u0627\u0632\u06cc\u06ba \u0627\u0648\u0631 \u0645\u0648\u0632\u0646\u0632 \u0628\u0631\u0622\u0645\u062f \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4\",\"Custom upcoming alarm time\":\"\u062d\u0633\u0628 \u0636\u0631\u0648\u0631\u062a \u0622\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u0644\u0627\u0631\u0645 \u06a9\u0627 \u0648\u0642\u062a\",\"Dark\":\"\u0627\u0646\u062f\u06be\u06cc\u0631\u0627\",\"Date\":\"\u062a\u0627\u0631\u06cc\u062e\",\"Decrement\":\"\u06a9\u0645\u06cc\",\"Default\":\"\u0637\u06d2 \u0634\u062f\u06c1\",\"Delete\":\"\u062d\u0630\u0641 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"\u0622\u067e \u06a9\u06d2 \u0622\u0644\u06d2 \u0627\u0648\u0631 android \u0648\u0631\u0698\u0646 \u067e\u0631 \u0645\u0646\u062d\u0635\u0631 \u06c1\u06d2\u060c \u0628\u0639\u0636 \u0627\u0648\u0642\u0627\u062a \u0622\u067e \u06a9\u0627 \u0622\u0644\u06c1 \u0628\u06cc\u0679\u0631\u06cc \u0628\u0686\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u0633 \u0645\u0646\u0638\u0631 \u0645\u06cc\u06ba \u0645\u0648\u062c\u0648\u062f \u0627\u06cc\u067e \u06a9\u0648 \u062e\u062a\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0627\u0644\u0627\u0631\u0645/\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0648 \u0688\u06cc\u0644\u06cc\u0648\u0631 \u06c1\u0648\u0646\u06d2 \u0633\u06d2 \u0631\u0648\u06a9 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\",\"Deselect as Fajr Adhan\":\"\u0641\u062c\u0631 \u06a9\u06cc \u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u063a\u06cc\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Device sounds\":\"\u0688\u06cc\u0648\u0627\u0626\u0633 \u06a9\u06cc \u0622\u0648\u0627\u0632\u06cc\u06ba\u06d4\",\"Disabled\":\"\u063a\u06cc\u0631 \u0641\u0639\u0627\u0644\",\"Disclaimer\":\"\u0688\u0633 \u06a9\u0644\u06cc\u0645\u0631\",\"Dismiss\":\"\u0628\u0631\u0637\u0631\u0641 \u06a9\u0631\u0646\u0627\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"\u0627\u0644\u0627\u0632\u0627\u0646 \u0645\u06cc\u06ba \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u062f\u06cc\u0627\u0646\u06cc\u062a \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u0633\u0631\u06a9\u0627\u0631\u06cc \u0627\u0648\u0642\u0627\u062a \u06a9\u0627 \u062a\u062e\u0645\u06cc\u0646\u06c1 \u06c1\u06d2\u06d4 \u0686\u0648\u0646\u06a9\u06c1 \u0627\u0648\u0642\u0627\u062a \u06a9\u0627 \u0635\u062d\u06cc\u062d \u062d\u0633\u0627\u0628 \u06a9\u06cc\u0633\u06d2 \u0644\u06af\u0627\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u0627\u0633 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06a9\u0627\u0641\u06cc \u062f\u0633\u062a\u0627\u0648\u06cc\u0632\u0627\u062a \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba\u060c \u06c1\u0648 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0642\u0627\u062a \u0633\u0631\u06a9\u0627\u0631\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0646\u06c1 \u06c1\u0648\u06ba\u060c \u062e\u0627\u0635 \u0637\u0648\u0631 \u067e\u0631 \u062a\u0631\u06a9\u06cc \u0633\u06d2 \u0628\u0627\u06c1\u0631\u06d4\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131\u060c \u062a\u0631\u06a9\u06cc\",\"Doesn't use any kind of trackers\":\"\u06a9\u0633\u06cc \u0628\u06be\u06cc \u0642\u0633\u0645 \u06a9\u06d2 \u0679\u0631\u06cc\u06a9\u0631\u0632 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4\",\"Don't ask again\":\"\u062f\u0648\u0628\u0627\u0631\u06c1 \u0645\u062a \u067e\u0648\u0686\u06be\u0648\",\"Don't show again\":\"\u062f\u0648\u0628\u0627\u0631\u06c1 \u0645\u062a \u062f\u06a9\u06be\u0627\u0646\u0627\",\"Don't show alarm screen?\":\"\u0627\u0644\u0627\u0631\u0645 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0646\u06c1 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u061f\",\"Done\":\"\u06c1\u0648 \u06af\u06cc\u0627\",\"Download\":\"\u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\",\"Eastern Arabic\":\"\u0645\u0634\u0631\u0642\u06cc \u0639\u0631\u0628\u06cc\u06d4\",\"Edit\":\"\u062a\u0631\u0645\u06cc\u0645\",\"Edit Calculation Parameters\":\"\u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u06d2 \u067e\u06cc\u0631\u0627\u0645\u06cc\u0679\u0631\u0632 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Edit Counter\":\"\u06a9\u0627\u0624\u0646\u0679\u0631 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Edit Location\":\"\u0645\u0642\u0627\u0645 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Edit Reminder\":\"\u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Edit Silent Mode\":\"Edit Silent Mode\",\"Egyptian General Survey Authority\":\"\u0645\u0635\u0631\u06cc \u062c\u0646\u0631\u0644 \u0633\u0631\u0648\u06d2 \u0627\u062a\u06be\u0627\u0631\u0679\u06cc\",\"Enabled\":\"\u0641\u0639\u0627\u0644\",\"End after prayer (minutes)\":\"End after prayer (minutes)\",\"Error getting clipboard data\":\"\u06a9\u0644\u067e \u0628\u0648\u0631\u0688 \u0688\u06cc\u0679\u0627 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u0633\u0644\u0626\u06c1 \",\"Error in loading countries\":\"\u0645\u0645\u0627\u0644\u06a9 \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u0633\u0644\u0626\u06c1\u06d4\",\"Error while downloading audio\":\"\u0622\u0688\u06cc\u0648 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a \u0645\u0633\u0626\u0644\u06c1 \",\"Error while getting coordinates\":\"\u0646\u0642\u0627\u0637 \u062d\u0627\u0635\u0644 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a \u0645\u0633\u0644\u0626\u06c1\u06d4\",\"Error: failed to open file\":\"\u062e\u0631\u0627\u0628\u06cc: \u0641\u0627\u0626\u0644 \u06a9\u0648 \u06a9\u06be\u0648\u0644\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645\",\"Ethiopic\":\"\u0627\u06cc\u062a\u06be\u0648\u067e\u06cc\u06a9\",\"Export app data\":\"\u0627\u06cc\u067e \u0688\u06cc\u0679\u0627 \u0627\u06cc\u06a9\u0633\u067e\u0648\u0631\u0679 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Export data\":\"\u0688\u06cc\u0679\u0627 \u0627\u06cc\u06a9\u0633\u067e\u0648\u0631\u0679 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Fajr Angle\":\"\u0641\u062c\u0631 \u0632\u0627\u0648\u06cc\u06c1\",\"Find My Location\":\"\u0645\u06cc\u0631\u0627 \u0645\u0642\u0627\u0645 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Fix Common Problems\":\"\u0639\u0627\u0645 \u0645\u0633\u0627\u0626\u0644 \u06a9\u0648 \u0679\u06be\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4\",\"France angle 15\":\"\u0641\u0631\u0627\u0646\u0633 \u0632\u0627\u0648\u06cc\u06c1 15\",\"France angle 18\":\"\u0641\u0631\u0627\u0646\u0633 \u0632\u0627\u0648\u06cc\u06c1 18\",\"Friday\":\"\u062c\u0645\u0639\u06c1\",\"General (default)\":\"\u0639\u0645\u0648\u0645\u06cc (\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0637\u06d2 \u0634\u062f\u06c1)\",\"Getting coordinates\":\"\u06a9\u0648\u0622\u0631\u0688\u06cc\u0646\u06cc\u0679 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u0627\",\"Got it\":\"\u06cc\u06c1 \u0645\u0644 \u06af\u06cc\u0627\",\"Gregorian\":\"\u06af\u0631\u06cc\u06af\u0648\u0631\u06cc\u0646\",\"Gulf region\":\"\u062e\u0644\u06cc\u062c\u06cc \u0639\u0644\u0627\u0642\u06c1\",\"Hanafi\":\"\u062d\u0646\u0641\u06cc\",\"Hidden?\":\"\u0686\u06be\u067e\u0627 \u06c1\u0648\u0627\u061f\",\"Hide Prayer Times\":\"\u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a \u0686\u06be\u067e\u0627\u0626\u06cc\u06ba\u06d4\",\"Hide times you don't need\":\"\u0627\u06cc\u0633\u06d2 \u0627\u0648\u0642\u0627\u062a \u0686\u06be\u067e\u0627\u0626\u06cc\u06ba \u062c\u0646 \u06a9\u06cc \u0622\u067e \u06a9\u0648 \u0636\u0631\u0648\u0631\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4\",\"High\":\"\u0627\u0639\u0644\u06cc\",\"High Latitude\":\"\u06c1\u0627\u0626\u06cc \u0639\u0631\u0636 \u0628\u0644\u062f\",\"Highlight current prayer\":\"\u0645\u0648\u062c\u0648\u062f\u06c1 \u0646\u0645\u0627\u0632 \u06a9\u0648 \u0646\u0645\u0627\u06cc\u0627\u06ba \u06a9\u0631\u06cc\u06ba\u06d4\",\"Home\":\"\u06af\u06be\u0631\",\"Homescreen and notification Widgets\":\"\u06c1\u0648\u0645 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0627\u0648\u0631 \u0646\u0648\u0679\u06cc\u0641\u06a9\u06cc\u0634\u0646 \u0648\u062c\u06cc\u0679\u0633\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"\u062a\u0627\u06c1\u0645\u060c \u0642\u0628\u0644\u06c1 \u0646\u0642\u0634\u06c1 \u062c\u06cc\u0633\u06cc \u0622\u0646 \u0644\u0627\u0626\u0646 \u062e\u062f\u0645\u0627\u062a \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a\u060c \u0627\u06cc\u067e \u06a9\u0645 \u0633\u06d2 \u06a9\u0645 \u0636\u0631\u0648\u0631\u06cc \u0688\u06cc\u0679\u0627 \u0645\u0646\u062a\u0642\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06cc \u06c1\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u06cc \u0645\u0646\u0641\u0631\u062f \u0634\u0646\u0627\u062e\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06cc \u06c1\u06d2 \u06cc\u0627 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0633\u06a9\u062a\u06cc\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u06cc\u067e \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a \u0627\u0633\u06d2 \u0630\u06c1\u0646 \u0645\u06cc\u06ba \u0631\u06a9\u06be\u06cc\u06ba\u06d4\",\"I Understand\":\"\u0645\u06cc\u06ba \u0633\u0645\u062c\u06be\u062a\u0627 \u06c1\u0648\u06ba\u06d4\",\"IMPORTANT_CHANNEL_ID\":\"\u0627\u06c1\u0645\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"\u0641\u0639\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u067e\u0631\u060c \u062c\u0628 \u06a9\u0648\u0626\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\u060c \u062a\u0648 \u0627\u0633 \u0645\u06cc\u06ba \u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0627\u06af\u0644\u06d2 \u0648\u0642\u062a \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06c1\u0648\u06af\u06cc\u06d4\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"\u0627\u06af\u0631 \u0622\u067e \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u0641\u0648\u0646 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a (\u0633\u06cc\u0679\u0646\u06af\u0632 / \u0628\u06cc\u06a9 \u0627\u067e \u0627\u0648\u0631 \u0631\u06cc \u0633\u06cc\u0679 / \u0628\u06cc\u06a9 \u0627\u067e \u0645\u06cc\u0631\u0627 \u0688\u06cc\u0679\u0627) \u0645\u06cc\u06ba \\\"\u0628\u06cc\u06a9 \u0627\u067e \u0627\u0648\u0631 \u0631\u06cc \u0633\u06cc\u0679\\\" \u06a9\u0648 \u0627\u06cc\u06a9\u0679\u06cc\u0648\u06cc\u0679 \u06a9\u0631 \u0631\u06a9\u06be\u0627 \u06c1\u06d2\u060c \u062a\u0648 \u0622\u067e \u06a9\u0648 \u0622\u06af\u0627\u06c1 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2 \u06a9\u06c1 \u0627\u06cc\u0646\u0688\u0631\u0627\u0626\u06cc\u0688 \u062e\u0648\u062f (\u0627\u0644\u0627\u0630\u0627\u0646 \u0646\u06c1\u06cc\u06ba) \u0648\u0642\u062a\u0627\u064b \u0641\u0648\u0642\u062a\u0627\u064b \u0622\u067e \u06a9\u06d2 \u0641\u0648\u0646 \u06a9\u06d2 \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u0627\u06cc\u06a9 \u06a9\u0627\u067e\u06cc \u06af\u0648\u06af\u0644 \u0645\u06cc\u06ba \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06d2 \u06af\u0627\u06d4 \u0633\u0631\u0648\u0631\u0632 \u06cc\u06c1 \u0627\u06cc\u0646\u0688\u0631\u0648\u0626\u06cc\u0688 \u06a9\u0648 \u0622\u067e \u06a9\u0627 \u0688\u06cc\u0679\u0627 \u0628\u0627\u0632\u06cc\u0627\u0641\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u062a\u0627 \u06c1\u06d2 \u0627\u06af\u0631 \u0622\u067e \u06a9\u0627 \u0622\u0644\u06c1 \u062e\u0631\u0627\u0628 \u06c1\u0648 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u06cc\u0627 \u0622\u067e \u06a9\u0648\u0626\u06cc \u0646\u06cc\u0627 \u0622\u0644\u06c1 \u062e\u0631\u06cc\u062f\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u0644\u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0688\u0648\u06cc\u0644\u067e\u0631\u0632 \u06a9\u0648 \u0627\u0633 \u0688\u06cc\u0679\u0627 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"\u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u06a9\u0686\u06be \u0648\u0642\u062a \u06a9\u06d2 \u0628\u0639\u062f \u0628\u06be\u06cc \u0627\u06cc\u067e \u0628\u0646\u062f \u06c1\u0648\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u0633\u0626\u0644\u06c1 \u062f\u0631\u067e\u06cc\u0634 \u06c1\u06d2 \u062a\u0648 \u0645\u0632\u06cc\u062f \u062d\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 dontkillmyapp.com \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"\u0627\u06af\u0631 \u0622\u067e \u06cc\u06c1 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0627\u06cc\u067e \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u060c \u062a\u0648 \u0622\u067e \u06a9\u0648 \u0627\u0633 \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u0627\u0648\u0631 \u0622\u067e\u0679\u06cc\u0645\u0627\u0626\u0632\u06cc\u0634\u0646 \u06a9\u0648 \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4 \u0622\u067e \u0646\u06cc\u0686\u06d2 \u062f\u06cc\u0626\u06d2 \u06af\u0626\u06d2 \u0628\u0679\u0646 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u06be\u0648\u0644 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"\u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u0622\u0644\u06d2 \u0645\u06cc\u06ba Google Pixel \u06a9\u06cc \u0637\u0631\u062d \u0627\u0688\u0627\u067e\u0679\u06cc\u0648 \u0686\u0627\u0631\u062c\u0646\u06af \u06c1\u06d2 \u0627\u0648\u0631 \u0622\u067e \u0646\u06c1\u06cc\u06ba \u0686\u0627\u06c1\u062a\u06d2 \u06a9\u06c1 \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f\u062f\u06c1\u0627\u0646\u06cc \u06a9\u0648 \u0627\u0644\u0627\u0631\u0645 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u067e\u06c1\u0686\u0627\u0646\u0627 \u062c\u0627\u0626\u06d2\u060c \u062a\u0648 \u0622\u067e \u0627\u0633 \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"Import\":\"\u062f\u0631\u0622\u0645\u062f \u06a9\u0631\u06cc\u06ba\u06d4\",\"Import app data\":\"\u0627\u06cc\u067e \u0688\u06cc\u0679\u0627 \u062f\u0631\u0622\u0645\u062f \u06a9\u0631\u06cc\u06ba\u06d4\",\"Import successful\":\"\u062f\u0631\u0622\u0645\u062f \u06a9\u0627\u0645\u06cc\u0627\u0628\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"\u0631\u0648\u0632\u0627\u0646\u06c1 \u067e\u0627\u0646\u0686 \u0646\u0645\u0627\u0632\u0648\u06ba \u06a9\u06d2 \u0639\u0644\u0627\u0648\u06c1\u060c \u0627\u0633 \u0645\u06cc\u06ba \u0637\u0644\u0648\u0639 \u0622\u0641\u062a\u0627\u0628\u060c \u063a\u0631\u0648\u0628 \u0622\u0641\u062a\u0627\u0628\u060c \u0622\u062f\u06be\u06cc \u0631\u0627\u062a \u0627\u0648\u0631 \u0631\u0627\u062a \u06a9\u06cc \u0646\u0645\u0627\u0632 (\u062a\u06c1\u062c\u062f) \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628 \u06c1\u06d2\u06d4\",\"Increment\":\"\u0627\u0636\u0627\u0641\u06c1\",\"Info\":\"\u0645\u0639\u0644\u0648\u0645\u0627\u062a\",\"Internet connection\":\"\u0627\u0646\u0679\u0631\u0646\u06cc\u0679 \u06a9\u0646\u06a9\u0634\u0646\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"\u0642\u0628\u0644\u06c1 \u0646\u0642\u0634\u06c1 \u06a9\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0646\u0679\u0631\u0646\u06cc\u0679 \u06a9\u0646\u06a9\u0634\u0646 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u0627 \u0648\u0627\u0626\u06cc \u0641\u0627\u0626\u06cc \u06cc\u0627 \u0645\u0648\u0628\u0627\u0626\u0644 \u0688\u06cc\u0679\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Iran\":\"\u0627\u06cc\u0631\u0627\u0646\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0627\u0646\u06af\u0631\u06cc\u0632\u06cc\u060c \u0641\u0627\u0631\u0633\u06cc\u060c \u0639\u0631\u0628\u06cc\u060c \u062a\u0631\u06a9\u06cc\u060c \u0627\u0646\u0688\u0648\u0646\u06cc\u0634\u06cc\u060c \u0641\u0631\u0627\u0646\u0633\u06cc\u0633\u06cc\u060c \u0627\u0631\u062f\u0648\u060c \u06c1\u0646\u062f\u06cc\u060c \u062c\u0631\u0645\u0646\u060c \u0628\u0648\u0633\u0646\u06cc\u0627\u0626\u06cc\u060c \u0648\u06cc\u062a\u0646\u0627\u0645\u06cc\u060c \u0628\u0646\u06af\u0644\u06c1 \u0645\u06cc\u06ba \u0645\u0642\u0627\u0645\u06cc \u06c1\u06d2\",\"Isha Angle\":\"\u0639\u0634\u0627\u0621 \u0632\u0627\u0648\u06cc\u06c1\",\"Isha Interval\":\"\u0639\u0634\u0627\u0621 \u06a9\u0627 \u0648\u0642\u0641\u06c1\",\"Islamic\":\"\u0627\u0633\u0644\u0627\u0645\u06cc\",\"Islamic (Saudi Arabia sighting)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0633\u0639\u0648\u062f\u06cc \u0639\u0631\u0628 \u06a9\u0627 \u0646\u0638\u0627\u0631\u06c1)\",\"Islamic (Umm al-Qura)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0627\u0645 \u0627\u0644\u0642\u0631\u0627\u0621)\",\"Islamic (civil)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0633\u0648\u0644)\",\"Islamic (tabular)\":\"\u0627\u0633\u0644\u0627\u0645\u06cc (\u0679\u06cc\u0628\u0644\u0631)\",\"Islamic Society of North America (ISNA)\":\"\u0627\u0633\u0644\u0627\u0645\u06a9 \u0633\u0648\u0633\u0627\u0626\u0679\u06cc \u0622\u0641 \u0646\u0627\u0631\u062a\u06be \u0627\u0645\u0631\u06cc\u06a9\u06c1 (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"\u0627\u06cc\u0633\u0627 \u0644\u06af\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u0628\u06cc\u06a9 \u0627\u067e \u062f\u0631\u0622\u0645\u062f \u06a9\u06cc\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u06cc\u0679\u0631\u06cc \u06a9\u06cc \u0627\u0635\u0644\u0627\u062d \u06a9\u0648 \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631\u0646\u0627 \u0646\u06c1 \u0628\u06be\u0648\u0644\u06cc\u06ba\",\"Just now\":\"\u0627\u0628\u06be\u06cc \u0627\u0628\u06be\u06cc\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"\u06a9\u06cc\u0645\u06cc\u0646\u0679\u0631\u06cc\u0646 \u0627\u06af\u0627\u0645\u0627 \u0631\u06cc\u067e\u0628\u0644\u06a9 \u0627\u0646\u0688\u0648\u0646\u06cc\u0634\u06cc\u0627 (\u06a9\u06cc\u0645\u06cc\u0646\u0627\u06af)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"\u06a9\u06cc\u0645\u06cc\u0646\u0679\u0631\u06cc\u0646 \u06c1\u0627\u0644 \u0627\u06cc\u06c1\u0648\u0627\u0644 \u06cc\u0648\u06af\u0627\u0645\u0627 (\u0628\u0631\u0648\u0646\u0627\u0626\u06cc \u062f\u0627\u0631\u0627\u0644\u0633\u0644\u0627\u0645)\",\"Kuwait\":\"\u06a9\u0648\u06cc\u062a\",\"Label\":\"\u0644\u06cc\u0628\u0644\",\"Language\":\"\u0632\u0628\u0627\u0646\",\"Latitude\":\"\u0637\u0648\u0644\",\"Latitude is invalid\":\"\u0639\u0631\u0636 \u0627\u0644\u0628\u0644\u062f \u063a\u0644\u0637 \u06c1\u06d2\u06d4\",\"License\":\"\u0644\u0627\u0626\u0633\u0646\u0633\",\"Light\":\"\u0631\u0648\u0634\u0646\u06cc\",\"Light and Dark theme\":\"\u06c1\u0644\u06a9\u06cc/\u06af\u06c1\u0631\u0627 \u062a\u06be\u06cc\u0645\",\"Light/Dark theme\":\"\u06c1\u0644\u06a9\u06cc/\u06af\u06c1\u0631\u0627 \u062a\u06be\u06cc\u0645\",\"List is empty\":\"\u0641\u06c1\u0631\u0633\u062a \u062e\u0627\u0644\u06cc \u06c1\u06d2\u06d4\",\"Loading\":\"\u0644\u0648\u0688 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4\",\"Location\":\"\u0645\u0642\u0627\u0645\",\"Location settings\":\"\u0645\u0642\u0627\u0645 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"Longitude\":\"\u0637\u0648\u0644 \u0627\u0644\u0628\u0644\u062f\",\"Longitude is invalid\":\"\u0637\u0648\u0644 \u0627\u0644\u0628\u0644\u062f \u063a\u0644\u0637 \u06c1\u06d2\u06d4\",\"Low\":\"\u06a9\u0645\",\"Lunar Calendar\":\"\u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0691\u0631\",\"Lunar Calendar Language\":\"\u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06cc \u0632\u0628\u0627\u0646\",\"Maghrib Angle\":\"\u0645\u063a\u0631\u0628 \u0632\u0627\u0648\u06cc\u06c1\",\"Make a Copy\":\"\u0627\u06cc\u06a9 \u06a9\u0627\u067e\u06cc \u0628\u0646\u0627\u0626\u06cc\u06ba\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"\u0627\u0630\u0627\u0646 (\u0627\u0630\u0627\u0646) \u06a9\u06d2 \u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u06d2 \u0628\u06c1\u062a \u0633\u06d2 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a\",\"Medium\":\"\u062f\u0631\u0645\u06cc\u0627\u0646\u06c1\",\"Middle of the Night\":\"\u0622\u062f\u06be\u06cc \u0631\u0627\u062a\",\"Midnight Method\":\"\u0622\u062f\u06be\u06cc \u0631\u0627\u062a \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"\u0648\u0632\u0627\u0631\u062a \u0645\u0630\u06c1\u0628\u06cc \u0627\u0645\u0648\u0631 \u0627\u0648\u0631 \u0648\u0642\u0641\u060c \u0627\u0644\u062c\u0632\u0627\u0626\u0631\",\"Ministry of Religious Affairs of Tunisia\":\"\u062a\u06cc\u0648\u0646\u0633 \u06a9\u06cc \u0648\u0632\u0627\u0631\u062a \u0645\u0630\u06c1\u0628\u06cc \u0627\u0645\u0648\u0631\",\"Mobile Data\":\"\u0645\u0648\u0628\u0627\u0626\u0644 \u0688\u06cc\u0679\u0627\",\"Modified\":\"\u062a\u0631\u0645\u06cc\u0645 \u0634\u062f\u06c1\",\"Monday\":\"\u067e\u06cc\u0631\",\"Moonsighting Committee\":\"\u0686\u0627\u0646\u062f \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06cc \u06a9\u0645\u06cc\u0679\u06cc\",\"Muslim World League\":\"\u0645\u0633\u0644\u0645 \u0648\u0631\u0644\u0688 \u0644\u06cc\u06af\",\"Name\":\"\u0646\u0627\u0645\",\"Nearest\":\"\u0642\u0631\u06cc\u0628 \u062a\u0631\u06cc\u0646\",\"New Counter\":\"\u0646\u06cc\u0627 \u06a9\u0627\u0624\u0646\u0679\u0631\",\"New Location\":\"\u0646\u06cc\u0627 \u0645\u0642\u0627\u0645\",\"New Reminder\":\"\u0646\u0626\u06cc \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\",\"New Silent Mode\":\"New Silent Mode\",\"Next\":\"\u0627\u06af\u0644\u06d2\",\"Next Day\":\"\u0627\u06af\u0644\u06d2 \u062f\u0646\",\"Next Month\":\"\u0627\u06af\u0644\u06d2 \u0645\u0627\u06c1\",\"No\":\"\u0646\u06c1\u06cc\u06ba\",\"No Data\":\"\u06a9\u0648\u0626\u06cc \u0645\u0648\u0627\u062f \u0646\u06c1\u06cc\u06ba\",\"No Results\":\"\u06a9\u0648\u0626\u06cc \u0646\u062a\u06cc\u062c\u06c1 \u0646\u06c1\u06cc\u06ba\",\"None\":\"\u06a9\u0648\u0626\u06cc \u0646\u06c1\u06cc\u06ba\u06d4\",\"None (Automatic)\":\"\u06a9\u0648\u0626\u06cc \u0646\u06c1\u06cc\u06ba (\u062e\u0648\u062f\u06a9\u0627\u0631)\",\"Normal mode restored\":\"Normal mode restored\",\"Not now\":\"\u0627\u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"\u0646\u0648\u0679 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631 \u0627\u0648\u0631 \u06c1\u0627\u0631\u0688\u0648\u06cc\u0626\u0631 \u06a9\u06cc \u062e\u0631\u0627\u0628\u06cc\u0648\u06ba \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2\u060c \u0627\u0633 \u0627\u06cc\u067e \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u062f\u06a9\u06be\u0627\u0626\u06cc \u06af\u0626\u06cc \u0642\u0628\u0644\u06c1 \u0633\u0645\u062a\u060c \u062e\u0627\u0635 \u0637\u0648\u0631 \u067e\u0631 \u06a9\u0645\u067e\u0627\u0633 \u0645\u0648\u0688 \u0645\u06cc\u06ba\u060c \u063a\u0644\u0637 \u06c1\u0648 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4\",\"Notification\":\"\u0627\u0637\u0644\u0627\u0639\",\"Notification & Sound\":\"\u0627\u0637\u0644\u0627\u0639 \u0627\u0648\u0631 \u0622\u0648\u0627\u0632\",\"Notifications Permission\":\"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a\",\"Numbering system\":\"\u0646\u0645\u0628\u0631 \u0633\u0627\u0632\u06cc \u06a9\u0627 \u0646\u0638\u0627\u0645\",\"Off\":\"\u0628\u0646\u062f\",\"Okay\":\"\u0679\u06be\u06cc\u06a9 \u06c1\u06d2\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"\u0627\u06cc\u0646\u0688\u0631\u0627\u0626\u06cc\u0688 12 \u0627\u0648\u0631 \u062c\u062f\u06cc\u062f \u062a\u0631 \u067e\u0631\u060c \u0627\u06cc\u067e \u06a9\u0648 \u0628\u06be\u06cc \u0645\u0646\u0627\u0633\u0628 \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0644\u0627\u0631\u0645 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06d2\u060c \u0644\u06c1\u0630\u0627 \u0622\u067e \u06a9\u0648 \u0627\u0633 \u06a9\u06cc \u0628\u06be\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u0646\u06cc \u06c1\u0648\u06af\u06cc\u06d4\",\"Once\":\"\u0627\u06cc\u06a9 \u0628\u0627\u0631\",\"One-Seventh of the Night\":\"\u0631\u0627\u062a \u06a9\u0627 \u0633\u0627\u062a\u0648\u0627\u06ba \u062d\u0635\u06c1\",\"Only once?\":\"\u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0628\u0627\u0631\u061f\",\"Only six items can be shown at the same time\":\"\u0627\u06cc\u06a9 \u06c1\u06cc \u0648\u0642\u062a \u0645\u06cc\u06ba \u0635\u0631\u0641 \u0686\u06be \u0627\u0634\u06cc\u0627\u0621 \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4\",\"Open Battery Optimization Settings\":\"\u0628\u06cc\u0679\u0631\u06cc \u0622\u067e\u0679\u06cc\u0645\u0627\u0626\u0632\u06cc\u0634\u0646 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u06be\u0648\u0644\u06cc\u06ba\u06d4\",\"Open Power Manager Settings\":\"\u067e\u0627\u0648\u0631 \u0645\u06cc\u0646\u06cc\u062c\u0631 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u06be\u0648\u0644\u06cc\u06ba\u06d4\",\"Open source repository\":\"\u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633 \u0631\u06cc\u067e\u0648\u0632\u0679\u0631\u06cc\",\"Open-source\":\"\u0622\u0632\u0627\u062f \u0645\u0635\u062f\u0631\",\"Options\":\"\u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a\",\"Or if you have a backup, you can import it\":\"\u06cc\u0627 \u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u067e\u0627\u0633 \u0628\u06cc\u06a9 \u0627\u067e \u06c1\u06d2 \u062a\u0648 \u0622\u067e \u0627\u0633\u06d2 \u062f\u0631\u0622\u0645\u062f \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"Orientation Lock: Landscape\":\"\u0627\u0648\u0631\u06cc\u0646\u0679\u06cc\u0634\u0646 \u0644\u0627\u06a9: \u0644\u06cc\u0646\u0688 \u0627\u0633\u06a9\u06cc\u067e\",\"Orientation Lock: Portrait\":\"\u0627\u0648\u0631\u06cc\u0646\u0679\u06cc\u0634\u0646 \u0644\u0627\u06a9: \u067e\u0648\u0631\u0679\u0631\u06cc\u0679\",\"Orientation: Unlocked\":\"\u0648\u0627\u0642\u0641\u06cc\u062a: \u063a\u06cc\u0631 \u0645\u0642\u0641\u0644\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"\u062f\u06cc\u06af\u0631 \u0645\u0642\u0646\u0627\u0637\u06cc\u0633\u06cc \u0622\u0644\u0627\u062a \u0622\u067e \u06a9\u06d2 \u0641\u0648\u0646 \u06a9\u06d2 \u06a9\u0645\u067e\u0627\u0633 \u0645\u06cc\u06ba \u0645\u062f\u0627\u062e\u0644\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0622\u067e \u06a9\u06d2 \u06a9\u0645\u067e\u0627\u0633 \u06a9\u0648 \u0627\u0646\u0634\u0627\u0646\u06a9\u0646 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u0648 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4\",\"PRAYER_MODE_CHANNEL_NAME\":\"Silent Mode\",\"PRE_ADHAN_CHANNEL_NAME\":\"\u0622\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0627\u0630\u0627\u0646\",\"PRE_REMINDER_CHANNEL_NAME\":\"\u0622\u0646\u06d2 \u0648\u0627\u0644\u06cc \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\",\"Pakistan\":\"\u067e\u0627\u06a9\u0633\u062a\u0627\u0646\",\"Paste\":\"\u0686\u0633\u067e\u0627\u06ba \u06a9\u0631\u06cc\u06ba\u06d4\",\"Persian\":\"\u0641\u0627\u0631\u0633\u06cc\",\"Phone State Permission\":\"\u0641\u0648\u0646 \u0627\u0633\u0679\u06cc\u0679 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a\",\"Play\":\"\u06a9\u06be\u06cc\u0644\u06cc\u06ba\",\"Please enable location service\":\"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0645\u0642\u0627\u0645 \u06a9\u06cc \u062e\u062f\u0645\u062a \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0646\u0648\u0679 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0627\u0633 \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0648 \u0641\u0639\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0627\u0630\u0627\u0646 \u0627\u0648\u0631 \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\u0648\u06ba \u06a9\u0648 \u062a\u0627\u062e\u06cc\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0641\u0627\u0626\u0631 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u06cc\u0627 \u0628\u0639\u0636 \u0635\u0648\u0631\u062a\u0648\u06ba \u0645\u06cc\u06ba \u0628\u0627\u0644\u06a9\u0644 \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba\u06d4 \u0627\u0633\u06d2 \u0627\u062d\u062a\u06cc\u0627\u0637 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0641\u0639\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Polar Resolution\":\"\u067e\u0648\u0644\u0631 \u0631\u06cc\u0632\u0648\u0644\u0648\u0634\u0646\",\"Power Manager\":\"\u067e\u0627\u0648\u0631 \u0645\u06cc\u0646\u06cc\u062c\u0631\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"\u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a\",\"Prayer list\":\"\u062f\u0639\u0627\u0624\u06ba \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a\",\"Press to search\":\"\u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0628\u0627\u0626\u06cc\u06ba\u06d4\",\"Press to select a method\":\"\u0637\u0631\u06cc\u0642\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0628\u0627\u0626\u06cc\u06ba\u06d4\",\"Prev Day\":\"\u067e\u0686\u06be\u0644\u0627 \u062f\u0646\",\"Prev Month\":\"\u067e\u0686\u06be\u0644\u0627 \u0645\u06c1\u06cc\u0646\u06c1\",\"Privacy Policy\":\"\u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"\u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0633\u06cc \u067e\u06c1\u0644\u0627 \u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633 \u0645\u0633\u0644\u0645 \u0627\u0630\u0627\u0646 (\u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u0648\u0642\u0627\u062a) \u0627\u0648\u0631 \u0642\u0628\u0644\u06c1 \u0627\u06cc\u067e\",\"Qada counter\":\"\u0642\u0636\u0627 \u06a9\u0627\u0624\u0646\u0679\u0631\",\"Qatar\":\"\u0642\u0637\u0631\",\"Qibla\":\"\u0642\u0628\u0644\u06c1\",\"Qibla finder\":\"\u0642\u0628\u0644\u06c1 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u0627\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"\u0642\u0628\u0644\u06c1 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u06a9\u0648 \u0645\u0642\u0627\u0645 \u06a9\u06cc \u062e\u062f\u0645\u062a \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u06d4 \u0627\u06af\u0631 \u0641\u0639\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u062a\u0648\u060c \u0627\u06cc\u067e \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0633\u06d2 \u0645\u0642\u0627\u0645 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"\u0642\u0628\u0644\u06c1 \u06a9\u0627 \u0646\u0642\u0634\u06c1 \u0641\u06cc \u0627\u0644\u062d\u0627\u0644 F-Droid \u06a9\u06cc \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u0645\u06cc\u06ba \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0645\u0633\u062a\u0642\u0628\u0644 \u06a9\u06cc \u062a\u0627\u0632\u06c1 \u06a9\u0627\u0631\u06cc\u0648\u06ba \u0645\u06cc\u06ba \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u0648\u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\",\"REMINDER_CHANNEL_NAME\":\"\u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\",\"Ramadan is ending,\":\"\u0631\u0645\u0636\u0627\u0646 \u062e\u062a\u0645 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2\u060c\",\"Ramadan is near,\":\"\u0631\u0645\u0636\u0627\u0646 \u0642\u0631\u06cc\u0628 \u06c1\u06d2\u060c\",\"Remaining till\":\"\u062a\u06a9 \u0628\u0627\u0642\u06cc \u06c1\u06d2\u06d4\",\"Remind me next year\":\"\u0627\u06af\u0644\u06d2 \u0633\u0627\u0644 \u0645\u062c\u06be\u06d2 \u06cc\u0627\u062f \u062f\u0644\u0627\u0626\u06cc\u06ba\u06d4\",\"Reminder\":\"\u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\",\"Repeat\":\"\u062f\u06c1\u0631\u0627\u0626\u06cc\u06ba\u06d4\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"\u0645\u0637\u0644\u0648\u0628\u06c1 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0646\u0627\u0645\u06a9\u0645\u0644 \u06c1\u06cc\u06ba\u06d4 \u0627\u06cc\u067e \u06a9\u0648 \u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a \u062f\u06a9\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0622\u067e \u06a9\u0648 \u0627\u0633\u06d2 \u0628\u0639\u062f \u0645\u06cc\u06ba \u0633\u06cc\u0679\u0646\u06af\u0632 \u0633\u06d2 \u06a9\u0646\u0641\u06cc\u06af\u0631 \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u0627\u06d4\",\"Rounding Method\":\"\u06af\u0648\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"\u0633\u0627\u0645 \u0633\u0646\u06af \u0688\u06cc\u0648\u0627\u0626\u0633\u0632 \u06a9\u0627 \u0627\u067e\u0646\u0627 \u062d\u0633\u0628 \u0636\u0631\u0648\u0631\u062a \u067e\u0627\u0648\u0631 \u0645\u06cc\u0646\u06cc\u062c\u0631 \u06c1\u06d2 \u062c\u0633\u06d2 \\\"\u0688\u06cc\u0648\u0627\u0626\u0633 \u06a9\u06cc\u0626\u0631\\\" \u06a9\u06c1\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0646\u06cc\u0686\u06d2 \u062f\u06cc\u0626\u06d2 \u06af\u0626\u06d2 \u0628\u0679\u0646 \u06a9\u0648 \u062f\u0628\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0622\u067e \u06a9\u0648 \u0688\u06cc\u0648\u0627\u0626\u0633 \u06a9\u06cc\u0626\u0631 \u06a9\u06d2 \u0628\u06cc\u0679\u0631\u06cc \u0645\u06cc\u0646\u0648 \u0645\u06cc\u06ba \u0644\u06d2 \u062c\u0627\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0628\u06cc\u0679\u0631\u06cc \u0645\u06cc\u0646\u0648 \u0645\u06cc\u06ba \\\"\u0627\u06cc\u067e \u067e\u0627\u0648\u0631 \u0645\u06cc\u0646\u062c\u0645\u0646\u0679\\\" \u06a9\u0648 \u062a\u06be\u067e\u062a\u06be\u067e\u0627\u0626\u06cc\u06ba\u060c \u0627\u0648\u0631 \u067e\u06be\u0631 \\\"\u0627\u06cc\u0633\u06d2 \u0627\u06cc\u067e\u0633 \u06a9\u0648 \u062a\u06be\u067e\u062a\u06be\u067e\u0627\u0626\u06cc\u06ba \u062c\u0648 \u0646\u06cc\u0646\u062f \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0622\u0626\u06cc\u06ba \u06af\u06cc\\\"\u060c \u0627\u0648\u0631 \u0627\u0633 \u0627\u06cc\u067e \u06a9\u0648 \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Saturday\":\"\u06c1\u0641\u062a\u06c1\",\"Saudi Arabia\":\"\u0633\u0639\u0648\u062f\u06cc \u0639\u0631\u0628\",\"Search\":\"\u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Secondary Calendar\":\"\u062b\u0627\u0646\u0648\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631\",\"See favorite locations\":\"\u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u0645\u0642\u0627\u0645\u0627\u062a \u062f\u06cc\u06a9\u06be\u06cc\u06ba\",\"Select as Fajr Adhan\":\"\u0641\u062c\u0631 \u06a9\u06cc \u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Select different Adhan audio for Fajr namaz\":\"\u0641\u062c\u0631 \u06a9\u06cc \u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062e\u062a\u0644\u0641 \u0627\u0630\u0627\u0646 \u0622\u0688\u06cc\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Selected\":\"\u0645\u0646\u062a\u062e\u0628 \u0634\u062f\u06c1\",\"Selected as adhan\":\"\u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4\",\"Selected as fajr adhan\":\"\u0641\u062c\u0631 \u06a9\u06cc \u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4\",\"Selecting a name is required\":\"\u0646\u0627\u0645 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4\",\"Set custom Adhan audio\":\"\u0627\u067e\u0646\u06cc \u0645\u0631\u0636\u06cc \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0627\u0630\u0627\u0646 \u0622\u0688\u06cc\u0648 \u0633\u06cc\u0679 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Set reminders before or after a prayer time\":\"\u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0648\u0642\u062a \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u06cc\u0627 \u0628\u0639\u062f \u0645\u06cc\u06ba \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\u0627\u06ba \u062a\u0631\u062a\u06cc\u0628 \u062f\u06cc\u06ba\u06d4\",\"Shafaq\":\"\u0634\u0641\u0642\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\u0634\u0641\u0642 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 MoonsightingCommittee \u0637\u0631\u06cc\u0642\u06c1 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0627\u06a9\u06c1 \u06cc\u06c1 \u0645\u0639\u0644\u0648\u0645 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u06d2 \u06a9\u06c1 \u0639\u0634\u0627\u0621 \u06a9\u06d2 \u0648\u0642\u062a \u06a9\u0627 \u062a\u0639\u06cc\u0646 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0633 \u0642\u0633\u0645 \u06a9\u06cc \u06af\u0648\u062f\u06be\u0648\u0644\u06cc \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0627 \u06c1\u06d2\u06d4\",\"Shafi, Maliki, Hanbali (Default)\":\"\u0634\u0627\u0641\u0639\u06cc\u060c \u0645\u0627\u0644\u06a9\u06cc\u060c \u062d\u0646\u0628\u0644\u06cc (\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0637\u06d2 \u0634\u062f\u06c1)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u0634\u06cc\u0639\u06c1 \u0627\u062a\u06be\u0646\u0627 \u0627\u0634\u0639\u0631\u06cc\u060c \u0644\u06cc\u0648\u0627 \u0627\u0646\u0633\u0679\u06cc \u0679\u06cc\u0648\u0679\u060c \u0642\u0645\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u0634\u06cc\u0639\u06c1\u060c \u0627\u0646\u0633\u0679\u06cc \u0679\u06cc\u0648\u0679 \u0622\u0641 \u062c\u06cc\u0648 \u0641\u0632\u06a9\u0633\u060c \u06cc\u0648\u0646\u06cc\u0648\u0631\u0633\u0679\u06cc \u0622\u0641 \u062a\u06c1\u0631\u0627\u0646\",\"Should app highlight current prayer instead of next prayer?\":\"\u06a9\u06cc\u0627 \u0627\u06cc\u067e \u06a9\u0648 \u0627\u06af\u0644\u06cc \u0646\u0645\u0627\u0632 \u06a9\u06cc \u0628\u062c\u0627\u0626\u06d2 \u0645\u0648\u062c\u0648\u062f\u06c1 \u0646\u0645\u0627\u0632 \u06a9\u0648 \u0646\u0645\u0627\u06cc\u0627\u06ba \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\u06a9\u06cc\u0627 \u0627\u06cc\u067e \u06a9\u0648 \\\"\u0688\u0633\u0679\u0631\u0628 \u0646\u06c1 \u06a9\u0631\u06cc\u06ba\\\" \u06a9\u06d2 \u0641\u0639\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u067e\u0631 \u0628\u06be\u06cc \u0627\u0630\u0627\u0646 \u0628\u062c\u0627\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2\u061f\",\"Should app stop playing adhan when the volume button is pressed?\":\"\u06a9\u06cc\u0627 \u0648\u0627\u0644\u06cc\u0648\u0645 \u0628\u0679\u0646 \u062f\u0628\u0627\u0646\u06d2 \u067e\u0631 \u0627\u06cc\u067e \u06a9\u0648 \u0627\u0630\u0627\u0646 \u0628\u062c\u0627\u0646\u0627 \u0628\u0646\u062f \u06a9\u0631 \u062f\u06cc\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f\",\"Should phone vibrate when adhan or reminder starts playing?\":\"\u06a9\u06cc\u0627 \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc \u0634\u0631\u0648\u0639 \u06c1\u0648\u0646\u06d2 \u067e\u0631 \u0641\u0648\u0646 \u0648\u0627\u0626\u0628\u0631\u06cc\u0679 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f\",\"Show Adhan Options\":\"\u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4\",\"Show Today\":\"\u0622\u062c \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4\",\"Show countdown?\":\"\u0627\u0644\u0679\u06cc \u06af\u0646\u062a\u06cc \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u061f\",\"Show current\":\"\u06a9\u0631\u0646\u0679 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4\",\"Show me\":\"\u0645\u062c\u06be\u06d2 \u062f\u06a9\u06be\u0627\",\"Show next in notification?\":\"\u0627\u0637\u0644\u0627\u0639 \u0645\u06cc\u06ba \u0627\u06af\u0644\u0627 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u061f\",\"Show notification widget?\":\"\u0627\u0637\u0644\u0627\u0639 \u0648\u06cc\u062c\u06cc\u0679 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u061f\",\"Show settings\":\"\u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4\",\"Show upcoming alarm notification?\":\"\u0622\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u0644\u0627\u0631\u0645 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u061f\",\"Silent\":\"\u062e\u0627\u0645\u0648\u0634\",\"Silent Mode Ended\":\"Silent Mode Ended\",\"Silent Mode Name\":\"Silent Mode Name\",\"Silent Mode Started\":\"Silent Mode Started\",\"Silent mode activated\":\"Silent mode activated\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"\u0686\u0648\u0646\u06a9\u06c1 \u06c1\u0645 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0642\u0633\u0645 \u06a9\u0627 \u0679\u0631\u06cc\u06a9\u0631 \u06cc\u0627 \u06a9\u0631\u06cc\u0634 \u0627\u06cc\u0646\u0627\u0644\u06cc\u0679\u06a9\u0633 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06c1\u0645\u0627\u0631\u06d2 \u06af\u06cc\u062a\u06be\u0628 \u0631\u06cc\u067e\u0648 \u067e\u0631 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u0633\u0626\u0644\u06d2 \u06cc\u0627 \u062a\u062c\u0648\u06cc\u0632 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06cc\u06ba\u06d4\",\"Singapore\":\"\u0633\u0646\u06af\u0627\u067e\u0648\u0631\",\"Skip\":\"\u0622\u06af\u06d2 \u0628\u0691\u06be\u06cc\u06ba \",\"Software License\":\"\u0633\u0627\u0641\u0679 \u0648\u06cc\u0626\u0631 \u0644\u0627\u0626\u0633\u0646\u0633\",\"Solar Hijri\":\"\u0634\u0645\u0633\u06cc \u06c1\u062c\u0631\u06cc\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"\u06a9\u0686\u06be \u0622\u0644\u0627\u062a \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u067e\u0627\u0648\u0631 \u0645\u06cc\u0646\u06cc\u062c\u0631 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u0636\u0627\u0641\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u062a\u0627\u06a9\u06c1 \u0627\u06cc\u067e \u06a9\u0648 \u067e\u0633 \u0645\u0646\u0638\u0631 \u0645\u06cc\u06ba \u06c1\u0644\u0627\u06a9 \u06c1\u0648\u0646\u06d2 \u0633\u06d2 \u0628\u0686\u0627\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u06d2\u06d4 \u0627\u0633 \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u062c\u0644\u06cc \u06a9\u06cc \u0628\u0686\u062a \u06a9\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0622\u067e\u0634\u0646 \u06a9\u0648 \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631 \u062f\u06cc\u06ba\u06d4\",\"Sound\":\"\u0622\u0648\u0627\u0632\",\"Spiritual Administration of Muslims of Russia\":\"\u0631\u0648\u0633 \u06a9\u06d2 \u0645\u0633\u0644\u0645\u0627\u0646\u0648\u06ba \u06a9\u06cc \u0631\u0648\u062d\u0627\u0646\u06cc \u0627\u0646\u062a\u0638\u0627\u0645\u06cc\u06c1\",\"Start before prayer (minutes)\":\"Start before prayer (minutes)\",\"Status\":\"\u062d\u0627\u0644\u062a\",\"Stop\":\"\u0631\u06a9 \u062c\u0627\u0624\",\"Sunday\":\"\u0627\u062a\u0648\u0627\u0631\",\"Sunset to Fajr (Default)\":\"\u063a\u0631\u0648\u0628 \u0622\u0641\u062a\u0627\u0628 \u0633\u06d2 \u0641\u062c\u0631 \u062a\u06a9 (\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0637\u06d2 \u0634\u062f\u06c1)\",\"Sunset to Sunrise\":\"\u063a\u0631\u0648\u0628 \u0622\u0641\u062a\u0627\u0628 \u0633\u06d2 \u0637\u0644\u0648\u0639 \u0622\u0641\u062a\u0627\u0628\",\"System Default\":\"\u0633\u0633\u0679\u0645 \u0688\u06cc\u0641\u0627\u0644\u0679\",\"Tahajjud time mentioned in the app is the last third of the night\":\"\u0627\u06cc\u067e \u0645\u06cc\u06ba \u062a\u06c1\u062c\u062f \u06a9\u0627 \u0648\u0642\u062a \u0631\u0627\u062a \u06a9\u0627 \u0622\u062e\u0631\u06cc \u062a\u06c1\u0627\u0626\u06cc \u062d\u0635\u06c1 \u06c1\u06d2\u06d4\",\"Thai Solar\":\"\u062a\u06be\u0627\u0626\u06cc \u0633\u0648\u0644\u0631\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"\u0627\u0633 \u0627\u06cc\u067e \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0634\u06a9\u0631\u06cc\u06c1! \u0627\u0633 \u0627\u06cc\u067e \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0634\u0631\u0648\u0639 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0622\u067e \u06a9\u0648 \u06a9\u0686\u06be \u0686\u06cc\u0632\u06cc\u06ba \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u06c1\u06d2\u06d4\",\"The Gulf Region (Dubai)\":\"\u062e\u0644\u06cc\u062c\u06cc \u0639\u0644\u0627\u0642\u06c1 (\u062f\u0628\u0626\u06cc)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"\u0627\u06cc\u067e \u06a9\u0627 \u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0634\u0645\u0627\u0631 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0645\u0645\u06a9\u0646 \u06c1\u06d2 \u062f\u0631\u0633\u062a \u0646\u06c1 \u06c1\u0648 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u06cc\u06c1 \u0686\u0627\u0646\u062f \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u0622\u063a\u0627\u0632 \u0627\u0648\u0631 \u0627\u062e\u062a\u062a\u0627\u0645 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1 \u062e\u0627\u0635 \u0637\u0648\u0631 \u067e\u0631 \u0627\u06c1\u0645 \u06c1\u06d2\u06d4\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"\u0627\u0633 \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u0627\u0648\u0631 \u0627\u06cc\u067e \u0645\u06cc\u06ba \u067e\u0627\u06cc\u0627 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0645\u062a\u0646 \u062f\u0648\u0633\u0631\u06cc \u0632\u0628\u0627\u0646\u0648\u06ba \u0645\u06cc\u06ba \u062f\u0631\u0633\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u0648 \u0633\u06a9\u062a\u0627\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba\u060c \u0635\u0631\u0641 \u0627\u0646\u06af\u0631\u06cc\u0632\u06cc \u0648\u0631\u0698\u0646 \u067e\u0631 \u06c1\u06cc \u063a\u0648\u0631 \u06a9\u06cc\u0627 \u062c\u0627\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u06d4\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"\u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06cc \u0648\u06c1 \u0642\u0633\u0645 \u062c\u0648 \u06c1\u0648\u0645 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u06a9\u06d2 \u0627\u0648\u067e\u0631 \u0627\u0648\u0631 \u0648\u062c\u06cc\u0679\u0633 \u0645\u06cc\u06ba \u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4\",\"The type of lunar calendar shown in main screen and widgets\":\"\u0645\u0631\u06a9\u0632\u06cc \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0627\u0648\u0631 \u0648\u06cc\u062c\u0679 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06d2 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06cc \u0642\u0633\u0645\",\"Theme Color\":\"\u062a\u06be\u06cc\u0645 \u06a9\u0627 \u0631\u0646\u06af\",\"Thursday\":\"\u062c\u0645\u0639\u0631\u0627\u062a\",\"Time\":\"\u0648\u0642\u062a\",\"Time condition\":\"\u0648\u0642\u062a \u06a9\u06cc \u062d\u0627\u0644\u062a\",\"Time format\":\"\u0648\u0642\u062a \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\",\"Time list\":\"\u0648\u0642\u062a \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"\u0627\u0630\u0627\u0646 \u06a9\u0627 \u062d\u0633\u0627\u0628 \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u0645\u06cc\u06ba \u0622\u067e \u06a9\u0627 \u0645\u0642\u0627\u0645 \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06d2\u06d4 \u0622\u067e \\\"\u0645\u06cc\u0631\u0627 \u0645\u0642\u0627\u0645 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba\\\" \u0628\u0679\u0646 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u06cc\u0627 \u0645\u0644\u06a9 \u0627\u0648\u0631 \u0634\u06c1\u0631/\u0639\u0644\u0627\u0642\u06d2 \u06a9\u06cc \u062a\u0644\u0627\u0634 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u067e\u0646\u06d2 \u0646\u0642\u0627\u0637 \u06a9\u0648 \u062f\u0633\u062a\u06cc \u0637\u0648\u0631 \u067e\u0631 \u062f\u0631\u062c \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"To see notifications about adhan, we need your permission.\":\"\u0627\u0630\u0627\u0646 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06d2\u06d4\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"\u062c\u0628 \u0622\u067e \u06a9\u0648 \u06a9\u0627\u0644 \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u0627\u0630\u0627\u0646 \u0628\u062c\u0627\u0646\u0627 \u0628\u0646\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u06c1\u0645\u06cc\u06ba \u0622\u067e \u06a9\u06d2 \u0641\u0648\u0646 \u06a9\u06cc \u062d\u0627\u0644\u062a \u067e\u0691\u06be\u0646\u06cc \u06c1\u0648\u06af\u06cc\u06d4 \u0627\u0633 \u0627\u062c\u0627\u0632\u062a \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u0646\u06c1 \u062f\u06cc\u0646\u0627 \u0635\u0631\u0641 \u062e\u0635\u0648\u0635\u06cc\u062a \u06a9\u0648 \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631 \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u06d4\",\"Tomorrow\":\"\u06a9\u0644\",\"Tuesday\":\"\u0645\u0646\u06af\u0644\",\"Turn Left\":\"\u0628\u0627\u0626\u06cc\u06ba \u0645\u0691\u0648\",\"Turn Right\":\"\u062f\u0627\u0626\u06cc\u06ba \u0645\u0691\u06cc\u06ba\",\"Turn history off\":\"\u062a\u0627\u0631\u06cc\u062e \u06a9\u0648 \u0622\u0641 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Turn history on\":\"\u062a\u0627\u0631\u06cc\u062e \u06a9\u0648 \u0622\u0646 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Twilight Angle\":\"\u06af\u0648\u062f\u06be\u0648\u0644\u06cc \u06a9\u0627 \u0632\u0627\u0648\u06cc\u06c1\",\"Umm al-Qura University, Makkah\":\"\u0627\u0645 \u0627\u0644\u0642\u0631\u06cc \u06cc\u0648\u0646\u06cc\u0648\u0631\u0633\u0679\u06cc \u0645\u06a9\u06c1 \u0645\u06a9\u0631\u0645\u06c1\",\"Union Organization Islamic de France\":\"\u06cc\u0648\u0646\u06cc\u0646 \u0622\u0631\u06af\u0646\u0627\u0626\u0632\u06cc\u0634\u0646 \u0627\u0633\u0644\u0627\u0645\u06a9 \u0688\u06cc \u0641\u0631\u0627\u0646\u0633\",\"University of Islamic Sciences, Karachi\":\"\u062c\u0627\u0645\u0639\u06c1 \u0627\u0633\u0644\u0627\u0645\u06cc\u06c1\u060c \u06a9\u0631\u0627\u0686\u06cc\",\"Unknown Error\":\"\u0646\u0627\u0645\u0639\u0644\u0648\u0645 \u062e\u0627\u0645\u06cc\",\"Unreliable\":\"\u0646\u0627\u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0628\u0627\u0631\",\"Unresolved (default)\":\"\u063a\u06cc\u0631 \u062d\u0644 \u0634\u062f\u06c1 (\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0637\u06d2 \u0634\u062f\u06c1)\",\"Unsupported\":\"\u063a\u06cc\u0631 \u062a\u0639\u0627\u0648\u0646 \u06cc\u0627\u0641\u062a\u06c1\",\"Up\":\"\u0627\u0648\u067e\u0631\",\"Upcoming alarm\":\"\u0622\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0627\u0644\u0627\u0631\u0645\",\"Updating widgets\":\"\u0648\u06cc\u062c\u0679 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u0627\",\"Use 24-Hour format\":\"24 \u06af\u06be\u0646\u0679\u06d2 \u06a9\u0627 \u0641\u0627\u0631\u0645\u06cc\u0679 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Use Compass\":\"\u06a9\u0645\u067e\u0627\u0633 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Use Map\":\"\u0646\u0642\u0634\u06c1 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\",\"Use a different alarm type?\":\"\u0627\u06cc\u06a9 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0627\u0631\u0645 \u06a9\u06cc \u0642\u0633\u0645 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u061f\",\"Use adaptive theme?\":\"\u0627\u0646\u06a9\u0648\u0644\u06cc \u062a\u06be\u06cc\u0645 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u061f\",\"Use headphones when available?\":\"\u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u0648\u0646\u06d2 \u067e\u0631 \u06c1\u06cc\u0688 \u0641\u0648\u0646 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u061f\",\"Using Coordinates\":\"\u06a9\u0648\u0622\u0631\u0688\u06cc\u0646\u06cc\u0679\u0633 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644\",\"Using GPS\":\"GPS \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0627\",\"Using Search\":\"\u062a\u0644\u0627\u0634 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2\",\"Version\":\"\u0648\u0631\u0698\u0646\",\"Vibration Mode\":\"\u0648\u0627\u0626\u0628\u0631\u06cc\u0634\u0646 \u0645\u0648\u0688\",\"Vibration on call\":\"Vibration on call\",\"Volume button stops adhan\":\"\u0648\u0627\u0644\u06cc\u0648\u0645 \u0628\u0679\u0646 \u0627\u0630\u0627\u0646 \u06a9\u0648 \u0631\u0648\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\",\"WIDGET_CHANNEL_NAME\":\"\u0648\u06cc\u062c\u06cc\u0679\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"\u0648\u06cc\u062c\u06cc\u0679 \u0627\u067e \u0688\u06cc\u0679\",\"We'll help you do them quickly.\":\"\u06c1\u0645 \u0627\u0646 \u06a9\u0648 \u062c\u0644\u062f\u06cc \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06cc \u0645\u062f\u062f \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u06d4\",\"Wednesday\":\"\u0628\u062f\u06be\",\"Welcome\":\"\u062e\u0648\u0634 \u0622\u0645\u062f\u06cc\u062f\",\"Western Arabic\":\"\u0645\u063a\u0631\u0628\u06cc \u0639\u0631\u0628\u06cc\u06d4\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"\u0641\u0639\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u067e\u0631\u060c \u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc \u0634\u0631\u0648\u0639 \u06c1\u0648\u0646\u06d2 \u067e\u0631 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0628\u0646\u062f \u0631\u06c1\u06d2 \u06af\u06cc\u060c \u0627\u0648\u0631 \u0627\u0644\u0627\u0631\u0645 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0646\u06c1\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"\u0641\u0639\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u067e\u0631\u060c \u06c1\u06cc\u0688 \u0641\u0648\u0646 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u0648\u0642\u062a\u060c \u062a\u0645\u0627\u0645 \u0622\u0688\u06cc\u0648 \u0635\u0631\u0641 \u06c1\u06cc\u0688 \u0641\u0648\u0646 \u067e\u0631 \u0686\u0644\u06cc\u06ba \u06af\u06d2\u06d4\",\"Wifi\":\"\u0648\u0627\u0626\u06cc \u0641\u0627\u0626\u06cc\",\"Yes\":\"\u062c\u06cc \u06c1\u0627\u06ba\",\"You are facing Kaaba\":\"\u0622\u067e \u06a9\u0627 \u0631\u062e \u06a9\u0639\u0628\u06c1 \u06c1\u06d2\u06d4\",\"You are not facing Kaaba\":\"\u0622\u067e \u06a9\u0627 \u0631\u062e \u06a9\u0639\u0628\u06c1 \u06a9\u06cc \u0637\u0631\u0641 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4\",\"You can access your device Power Manager using the button below.\":\"\u0622\u067e \u0646\u06cc\u0686\u06d2 \u062f\u06cc\u0626\u06d2 \u06af\u0626\u06d2 \u0628\u0679\u0646 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u0688\u06cc\u0648\u0627\u0626\u0633 \u067e\u0627\u0648\u0631 \u0645\u06cc\u0646\u06cc\u062c\u0631 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can also paste coords from clipboard\":\"\u0622\u067e \u06a9\u0644\u067e \u0628\u0648\u0631\u0688 \u0633\u06d2 \u0628\u06be\u06cc \u06a9\u0648\u0688 \u067e\u06cc\u0633\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can change the language used for lunar calendar\":\"\u0622\u067e \u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0632\u0628\u0627\u0646 \u06a9\u0648 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"\u0627\u0630\u0627\u0646 \u06cc\u0627 \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0622\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u0644\u0627\u0631\u0645 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u0628\u06be\u06cc\u062c\u06d2 \u062c\u0627\u0646\u06d2 \u067e\u0631 \u0622\u067e \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can choose to replace one of calendars with your current location\":\"\u0622\u067e \u0627\u067e\u0646\u06d2 \u0645\u0648\u062c\u0648\u062f\u06c1 \u0645\u0642\u0627\u0645 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u06cc\u0644\u0646\u0688\u0631\u0632 \u0645\u06cc\u06ba \u0633\u06d2 \u06a9\u0633\u06cc \u0627\u06cc\u06a9 \u06a9\u0648 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can hide prayer times you don't want to see in the main screen here:\":\"\u0622\u067e \u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0648\u06c1 \u0627\u0648\u0642\u0627\u062a \u0686\u06be\u067e\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0646\u06c1\u06cc\u06ba \u0622\u067e \u0645\u0631\u06a9\u0632\u06cc \u0633\u06a9\u0631\u06cc\u0646 \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can hide prayer times you don't want to see in the widget here:\":\"\u0622\u067e \u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0648\u06c1 \u0627\u0648\u0642\u0627\u062a \u0686\u06be\u067e\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0646\u06c1\u06cc\u06ba \u0622\u067e \u0648\u06cc\u062c\u06cc\u0679 \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You can search for your location offline Or use GPS\":\"\u0622\u067e \u0627\u067e\u0646\u0627 \u0645\u0642\u0627\u0645 \u0622\u0641 \u0644\u0627\u0626\u0646 \u062a\u0644\u0627\u0634 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 GPS \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"\u0622\u067e \u06a9\u0648 \u0627\u0633 \u067e\u0631\u0648\u06af\u0631\u0627\u0645 \u06a9\u06d2 \u0633\u0627\u062a\u06be GNU Affero \u062c\u0646\u0631\u0644 \u067e\u0628\u0644\u06a9 \u0644\u0627\u0626\u0633\u0646\u0633 \u06a9\u06cc \u0627\u06cc\u06a9 \u06a9\u0627\u067e\u06cc \u0645\u0644\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2 \u062a\u06be\u06cc\u06d4 \u0627\u06af\u0631 \u0646\u06c1\u06cc\u06ba\u060c \u062a\u0648 https://www.gnu.org/licenses/ \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u06d4\",\"Your sounds\":\"\u0622\u067e \u06a9\u06cc \u0622\u0648\u0627\u0632\u06cc\u06ba\",\"abdul_basit_abdus_samad\":\"\u0639\u0628\u062f\u0627\u0644\u0628\u0627\u0633\u0637 \u0639\u0628\u062f\u0627\u0644\u0635\u0645\u062f\",\"about.credits\":\"\u0627\u0630\u0627\u0646 \u06a9\u06cc \u0622\u0648\u0627\u0632\u0648\u06ba \u06a9\u06d2 \u062a\u0645\u0627\u0645 \u06a9\u0627\u067e\u06cc \u0631\u0627\u0626\u0679\u0633 \u0627\u0646 \u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0645\u0627\u0644\u06a9\u0627\u0646 \u06a9\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u0646 \u06a9\u06cc \u0634\u0627\u0646\u062f\u0627\u0631 \u062e\u062f\u0645\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 translation.io (lingui.js) \u06a9\u0627 \u062e\u0635\u0648\u0635\u06cc \u0634\u06a9\u0631\u06cc\u06c1\u06d4 \u062a\u0645\u0627\u0645 \u0627\u0648\u067e\u0646 \u0633\u0648\u0631\u0633 \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u0645\u0645\u0628\u0631\u0627\u0646 \u06a9\u0627 \u0634\u06a9\u0631\u06cc\u06c1 \u062c\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06cc\u06c1 \u062a\u0645\u0627\u0645 \u0634\u0627\u0646\u062f\u0627\u0631 \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc\u0627\u06ba \u0628\u0646\u0627\u0626\u06cc\u06ba \u062c\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0627\u0633 \u0627\u06cc\u067e \u06a9\u0648 \u0645\u0645\u06a9\u0646 \u0628\u0646\u0627\u06cc\u0627\u06d4\",\"about.credits.google\":\"\u0627\u0633 \u0627\u06cc\u067e \u0645\u06cc\u06ba \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u062a\u0631 \u0634\u0628\u06cc\u06c1\u06cc\u06ba \u06af\u0648\u06af\u0644 \u0645\u06cc\u0679\u0631\u06cc\u0644 \u0622\u0626\u06cc\u06a9\u0646\u0632 \u0633\u06d2 \u06c1\u06cc\u06ba\u06d4\",\"about_settings\":\"\u0645\u0639\u0644\u0648\u0645\u0627\u062a\",\"adjustment.hint\":\"\u0645\u0646\u0679\u0648\u06ba \u06a9\u06cc \u062a\u0639\u062f\u0627\u062f \u062c\u0648 \u0634\u0645\u0627\u0631 \u0634\u062f\u06c1 \u0627\u0648\u0642\u0627\u062a \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06a9\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4\",\"after\":\"\u06a9\u06d2 \u0628\u0639\u062f\",\"ago\":\"\u067e\u06c1\u0644\u06d2\",\"asr.prayer\":\"\u0639\u0635\u0631\",\"backup_settings\":\"\u0628\u06cc\u06a9 \u0627\u067e\",\"before\":\"\u067e\u06c1\u0644\u06d2\",\"calculation_adjustments_settings\":\"\u0627\u06cc\u0688\u062c\u0633\u0679\u0645\u0646\u0679\u0633\",\"calculation_advanced_settings\":\"\u0627\u0639\u0644\u06cc \u062f\u0631\u062c\u06d2 \u06a9\u06cc \u062d\u0633\u0627\u0628 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"calculation_settings\":\"\u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628\",\"counter.fast\":\"\u0631\u0648\u0632\u06c1\",\"date.day\":\"\u062f\u0646\",\"date.hour\":\"\u06af\u06be\u0646\u0679\u06c1\",\"date.minute\":\"\u0645\u0646\u0679\",\"date.second\":\"\u0633\u06cc\u06a9\u0646\u0688\",\"dev_settings\":\"\u0688\u0648\u06cc\u0644\u067e\u0631\",\"dhuhr.prayer\":\"\u0638\u06c1\u0631\",\"display_settings\":\"\u0688\u0633\u067e\u0644\u06d2\",\"fajr.prayer\":\"\u0641\u062c\u0631\",\"favorite_location\":\"\u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u0645\u0642\u0627\u0645\u0627\u062a\",\"forces all numbers to be in the selected system\":\"\u062a\u0645\u0627\u0645 \u0646\u0645\u0628\u0631\u0648\u06ba \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u0646\u0638\u0627\u0645 \u0645\u06cc\u06ba \u06c1\u0648\u0646\u06d2 \u067e\u0631 \u0645\u062c\u0628\u0648\u0631 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4\",\"from North\":\"\u0634\u0645\u0627\u0644 \u0633\u06d2\",\"from settings\":\"\u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0633\u06d2\",\"fullscreen_alarm\":\"\u0627\u0630\u0627\u0646 \u0686\u0644\u0627\u0626\u06cc\u06ba\",\"hijri.adjustment.hint\":\"\u062f\u0646\u0648\u06ba \u06a9\u06cc \u062a\u0639\u062f\u0627\u062f \u062c\u0648 \u0642\u0645\u0631\u06cc \u06a9\u06cc\u0644\u0646\u0688\u0631 \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06a9\u06cc\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4\",\"home\":\"\u06af\u06be\u0631\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"\u0627\u06af\u0631 \u0641\u0639\u0627\u0644 \u06c1\u0648 \u062a\u0648\u060c \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0646\u0645\u0627\u0632 \u06a9\u06d2 \u0648\u0642\u062a \u06cc\u0627 \u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc \u0633\u06d2 \u062a\u0642\u0631\u06cc\u0628\u0627\u064b \u0627\u06cc\u06a9 \u06af\u06be\u0646\u0679\u06c1 \u067e\u06c1\u0644\u06d2 \u0627\u06cc\u06a9 \u0627\u0637\u0644\u0627\u0639 \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc \u062c\u0633 \u0645\u06cc\u06ba \u0622\u0648\u0627\u0632 \u06c1\u06d2\u06d4\",\"intro\":\"\u062a\u0639\u0627\u0631\u0641\",\"is prayer time hidden?\":\"\u06a9\u06cc\u0627 \u0646\u0645\u0627\u0632 \u06a9\u0627 \u0648\u0642\u062a \u0645\u062e\u0641\u06cc \u06c1\u06d2\u061f\",\"isha.prayer\":\"\u0639\u0634\u0627\u0621\",\"later\":\"\u0628\u0639\u062f \u0645\u06cc\u06ba\",\"location_settings\":\"\u0645\u0642\u0627\u0645\",\"maghrib.prayer\":\"\u0645\u063a\u0631\u0628\",\"masjid_an_nabawi\":\"\u0645\u0633\u062c\u062f \u0646\u0628\u0648\u06cc\",\"minutes\":\"\u0645\u0646\u0679\",\"moazen_zade\":\"\u0645\u0639\u0632\u0646 \u0632\u0627\u062f\u06d2 \u06d4\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"\u0645\u0627\u06c1\u0627\u0646\u06c1 \u0645\u0646\u0638\u0631\",\"muezzin_settings\":\"\u0645\u0624\u0630\u0646\",\"notification_advanced_settings\":\"\u0627\u0639\u0644\u06cc \u062f\u0631\u062c\u06d2 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"notification_settings\":\"\u0627\u0637\u0644\u0627\u0639 \u0627\u0648\u0631 \u0622\u0648\u0627\u0632\",\"qada_counter\":\"\u0642\u0636\u0627 \u06a9\u0627\u0624\u0646\u0679\u0631\",\"qibla_compass\":\"\u0642\u0628\u0644\u06c1 \u06a9\u0645\u067e\u0627\u0633\",\"qibla_finder\":\"\u0642\u0628\u0644\u06c1 \u062a\u0644\u0627\u0634 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u0627\",\"qibla_map\":\"\u0642\u0628\u0644\u06c1 \u0646\u0642\u0634\u06c1\",\"ragheb_mustafa_ghalwash\":\"\u0631\u0627\u063a\u0628 \u0645\u0635\u0637\u0641\u06cc\u0670 \u063a\u0644\u0648\u0627\u0634\",\"reminders_settings\":\"\u06cc\u0627\u062f \u062f\u06c1\u0627\u0646\u06cc\u0627\u06ba\",\"settings\":\"\u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"should notification widget be shown?\":\"\u06a9\u06cc\u0627 \u0646\u0648\u0679\u06cc\u0641\u06a9\u06cc\u0634\u0646 \u0648\u06cc\u062c\u06cc\u0679 \u062f\u06a9\u06be\u0627\u06cc\u0627 \u062c\u0627\u0646\u0627 \u0686\u0627\u06c1\u0626\u06d2\u061f\",\"should {prayerName} be hidden?\":[\"\u06a9\u06cc\u0627 \",[\"prayerName\"],\" \u06a9\u0648 \u0686\u06be\u067e\u0627\u06cc\u0627 \u062c\u0627\u0646\u0627 \u0686\u0627\u06c1\u0626\u06d2\u061f\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"\u0686\u0648\u0646\u06a9\u06c1 \u0627\u06cc\u067e \u06a9\u0627 \u06a9\u06cc\u0644\u0646\u0688\u0631 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u062d\u0633\u0627\u0628 \u0634\u062f\u06c1 \u06c1\u06d2 \u0627\u0648\u0631 \u0686\u0627\u0646\u062f \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u06cc\u06c1 \u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u0622\u063a\u0627\u0632 \u0627\u0648\u0631 \u0627\u062e\u062a\u062a\u0627\u0645 \u06a9\u06cc \u063a\u0644\u0637 \u062a\u0627\u0631\u06cc\u062e \u062f\u06a9\u06be\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4\",\"sunnah.midnight\":\"\u0622\u062f\u06be\u06cc \u0631\u0627\u062a\",\"sunnah.tahajjud\":\"\u062a\u06c1\u062c\u062f\",\"sunrise\":\"\u0637\u0644\u0648\u0639 \u0622\u0641\u062a\u0627\u0628\",\"sunset\":\"\u063a\u0631\u0648\u0628 \u0622\u0641\u062a\u0627\u0628\",\"widget_settings\":\"\u0648\u06cc\u062c\u06cc\u0679 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" \u0645\u0646\u0679 \u0628\u0639\u062f \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" \u0645\u0646\u0679 \u067e\u06c1\u0644\u06d2 \",[\"prayer\"]],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" \u0627\u0637\u0644\u0627\u0639 \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" \u0622\u0648\u0627\u0632 \u0686\u0644\u0627\u0626\u06cc \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4\"]}")}),634,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 min\",\"15 min\":\"15 min\",\"30 min\":\"Pola Sata\",\"30 minutes is added to Isha time during Ramadan in this method\":\"30 minuta se dodaje na Jaciju tokom Ramazana u ovoj metodi\",\"5 min\":\"5 min\",\"60 min\":\"Sat Vremena\",\"90 min\":\"Sat i Po\",\"ADHAN_CHANNEL_NAME\":\"Ezan\",\"Abyad\":\"Ebd\u017eed\",\"Accuracy\":\"Preciznost\",\"Ad-Free\":\"Bez oglasa\",\"Adaptive Charging\":\"Adaptivno Punjenje\",\"Add\":\"Dodaj\",\"Add Custom Adhan\":\"Dodajte Prilago\u0111eni Ezan\",\"Add Custom Audio\":\"Dodajte Prilago\u0111eni Audio\",\"Add Reminder\":\"Dodajte Podsjetnik\",\"Add Silent Mode\":\"Add Silent Mode\",\"Add new counter\":\"Dodajte novi broja\u010d\",\"Add new location\":\"Dodajte novu lokaciju\",\"Adhan\":\"Ezan\",\"Adhan audio file is not downloaded yet\":\"Zvu\u010dni snimak za Ezan jo\u0161 nije skinut\",\"Adjustments\":\"Prilago\u0111enja\",\"Advanced\":\"Napredno\",\"Advanced Calculation Settings\":\"Napredne Postavke Kalkulacije\",\"Advanced Settings\":\"Napredne postavke\",\"Ahmer\":\"Amar\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Vremena Molitve\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan je distribuiran u nadi da \u0107e biti koristan, ali BEZ IKAKVE GARANCIJE; \u010dak i bez implicitne garancije o PRODAJNOSTI ili PRIKLADNOSTI ZA ODRE\u0110ENU NAMJENU. Za vi\u0161e detalja pogledajte GNU Affero Op\u0107u Javnu Dozvolu.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan je besplatan program: mo\u017eete ga preraspodjeliti i(li) izmjeniti pod uslovima GNU Affero Op\u0107e Javne Dozvole (v3.0) koju je objavila Osnova za Slobodni Softver.\",\"Alarms Permission\":\"Dozvole za Alarm\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"Svi podaci dostavljeni Al-Azanu pohranjuju se samo lokalno na va\u0161em ure\u0111aju. Va\u0161i podaci se nigdje ne u\u010ditavaju. Programeri Al-Azana nemaju pristup njemu. Va\u0161i podaci se ne dijele s tre\u0107im licima. Al-Azan ne uklju\u010duje biblioteke oglasa ili bilo koji kod za pra\u0107enje (analiti\u010dki) tre\u0107e strane, kao \u0161to su Google Analitike ili Facebook SRP.\",\"An error occured while playing the current track\":\"Do\u0161lo je do gre\u0161ke prilikom pokretanja trenutnog snimka\",\"App features\":\"Funkcije aplikacije\",\"Arabic\":\"arapski\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"Jeste li sigurni da \u017eelite izbrisati \\\"\",[\"0\"],\"\\\" ?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"Jeste li sigurni da \u017eelite izbrisati \\\"\",[\"itemName\"],\"\\\" ?\"],\"Are you sure you want to delete this?\":\"Jeste li sigurni da \u017eelite ovo izbrisati?\",\"Asr Calculation\":\"Kalkulacija Ikindije\",\"At least one prayer time must be shown\":\"Mora biti prikazano najmanje jedno vrijeme namaza\",\"Attention\":\"Pa\u017enja\",\"Auto (Default)\":\"automatski (zadano)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"Zaobi\u0111ite \\\"Ne smjetaj\\\" napomenu?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"Kalkulacija Ezana ima mnogo razli\u010ditih metoda. Svaka metoda daje razli\u010dite rezultate. Va\u0161a je odgovornost da na\u0111ete i iskoristite pravu metodu.\",\"Calculation\":\"Kalkulacija\",\"Calculation Method\":\"Metoda Kalkulacije\",\"Calendar\":\"Kalendar\",\"Cancel\":\"Otka\u017eite\",\"Cancel Alarm\":\"Otka\u017ei alarm\",\"Cancel download\":\"Otka\u017eite preuzimanje\",\"Choose Asr Calculation Madhab\":\"Odaberite Mezheb Kalkulaciju Ikindije\",\"Choose Calculation Method\":\"Odaberite Metodu Kalkulacije\",\"Choose High Latitude Setting\":\"Odaberite Postavku Velike Geografske \u0160irine\",\"Choose Language\":\"Odaberite Jezik\",\"Choose Polar Resolution\":\"Odaberite Polarnu Procjenu Razmaka\",\"Choose Shafaq method\":\"Odaberite \u0160afak metodu\",\"Choose calculation rounding method\":\"Odaberite metodu zaokru\u017eivanja izra\u010duna\",\"Choose calendar type\":\"Odaberite tip kalndara\",\"Choose lunar calendar language\":\"Odaberite jezik lunarnog kalendara\",\"Choose midnight calculation method\":\"Odaberite metodu izra\u010duna pono\u0107i\",\"Choose numbering system\":\"Odaberite brojni sistem\",\"Choose which calendar to replace\":\"Odaberite koji kalendar \u017eelite zamijeniti\",\"City/Area\":\"Grad/Okru\u017eenje\",\"Clear the coordinates\":\"Obri\u0161ite koordinate\",\"Clear the location\":\"Obri\u0161ite lokaciju\",\"Clipboard data does not contain coordinates\":\"Podaci me\u0111uspremnika ne sadr\u017ee koordinate\",\"Close\":\"Zatvori\",\"Closest City\":\"Najbli\u017ei Grad\",\"Closest Date\":\"Najbli\u017ei Datum\",\"Compass Lock\":\"Klju\u010dnica Kompas\",\"Compass sensor unavailable\":\"Senzor kompasa je nedostupan\",\"Confirm\":\"Potvrdite\",\"Continuous\":\"Kontinuirano\",\"Coordinates updated\":\"Koordinati su a\u017eurirani\",\"Copy\":\"Kopiraj\",\"Count\":\"Zbroj\",\"Country\":\"Zemlja\",\"Custom\":\"Prilago\u0111eno\",\"Custom sounds and muezzins will not be exported\":\"Prilago\u0111eni zvukovi i mujezini ne\u0107e biti izvezeni\",\"Custom upcoming alarm time\":\"Prilago\u0111eno vrijeme nadolaze\u0107eg alarma\",\"Dark\":\"Mra\u010dna\",\"Date\":\"Datum\",\"Decrement\":\"Uni\u017eavanje\",\"Default\":\"Zadano\",\"Delete\":\"Izbri\u0161ite\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"Ovisno o va\u0161em ure\u0111aju i verziji Androida, ponekad va\u0161 ure\u0111aj mo\u017ee ugasiti aplikaciju u pozadini kako bi u\u0161tedio bateriju. Ovo mo\u017ee sprije\u010diti isporuku alarma/obavje\u0161tenja.\",\"Deselect as Fajr Adhan\":\"Poni\u0161tite odabir kao Sabah Ezan\",\"Device sounds\":\"Zvukovi ure\u0111aja\",\"Disabled\":\"Isklju\u010deno\",\"Disclaimer\":\"Odricanje\",\"Dismiss\":\"Odbaci\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"Diyanet metoda navedena u Al-Azanu je pribli\u017enost slu\u017ebenog vremena. Budu\u0107i da nema dovoljno dokumentacije o tome kako se ta\u010dno ra\u010dunaju vremena, vremena mogu\u0107e ne\u0107e biti uskla\u0111ena sa slu\u017ebenim web stranicama, posebno izvan Turske.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Predsjedni\u0161tvo za vjerska pitanja, Turska\",\"Doesn't use any kind of trackers\":\"Ne koristi nikakvu vrstu traga\u010da\",\"Don't ask again\":\"Ne pitaj opet\",\"Don't show again\":\"Ne prikazuj ponovo\",\"Don't show alarm screen?\":\"Ne prikazati ekran alarma?\",\"Done\":\"Gotovo\",\"Download\":\"Skinuti\",\"Eastern Arabic\":\"Isto\u010dno-Arapski\",\"Edit\":\"Uredi\",\"Edit Calculation Parameters\":\"Uredi Parametre Izra\u010duna\",\"Edit Counter\":\"Uredite Broja\u010d\",\"Edit Location\":\"Uredi Lokaciju\",\"Edit Reminder\":\"Uredite Podsjetnik\",\"Edit Silent Mode\":\"Edit Silent Mode\",\"Egyptian General Survey Authority\":\"Egipatska Generalna Geodetska Uprava\",\"Enabled\":\"Uklju\u010deno\",\"End after prayer (minutes)\":\"End after prayer (minutes)\",\"Error getting clipboard data\":\"Gre\u0161ka pri preuzimanju podataka me\u0111uspremnika\",\"Error in loading countries\":\"Gre\u0161ka pri u\u010ditavanju zemalja\",\"Error while downloading audio\":\"Gre\u0161ka pri skidanju audia\",\"Error while getting coordinates\":\"Gre\u0161ka pri dobivanju koordinata\",\"Error: failed to open file\":\"Gre\u0161ka: nije se mogla datoteka otvoriti\",\"Ethiopic\":\"Etiopski\",\"Export app data\":\"Izvezite podatke aplikacije\",\"Export data\":\"Izvezite podatke\",\"Fajr Angle\":\"Kut Sabaha\",\"Find My Location\":\"Na\u0111ite Moju Lokaciju\",\"Fix Common Problems\":\"Popravite uobi\u010dajene probleme\",\"France angle 15\":\"Francuska ugao 15\",\"France angle 18\":\"Francuska ugao 18\",\"Friday\":\"Petak\",\"General (default)\":\"Op\u0107enito (zadano)\",\"Getting coordinates\":\"Koordinate se preuzimaju\",\"Got it\":\"Uspjelo je\",\"Gregorian\":\"Gregorijanski\",\"Gulf region\":\"Zaljevsko podru\u010dje\",\"Hanafi\":\"Hanefijski\",\"Hidden?\":\"Skriveno?\",\"Hide Prayer Times\":\"Sakrij Vremena Molitve\",\"Hide times you don't need\":\"Sakrijte vremena koja vam nisu potrebna\",\"High\":\"Visoka\",\"High Latitude\":\"Visoka Geografska \u0160irina\",\"Highlight current prayer\":\"Istaknite trenutnu molitvu\",\"Home\":\"Po\u010detna\",\"Homescreen and notification Widgets\":\"Po\u010detni ekran i vid\u017eeti za obave\u0161tenja\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Me\u0111utim, kada koristite online usluge, kao \u0161to je Qibla mapa, aplikacija mo\u017ee prenijeti minimalne potrebne podatke koji vas mogu, ali ne moraju, jedinstveno identificirati. \u010cuvajte to na umu dok koristite aplikaciju.\",\"I Understand\":\"Ja Razumijem\",\"IMPORTANT_CHANNEL_ID\":\"Bitno\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"Ako je omogu\u0107eno, kada se prika\u017ee obavijest, sadr\u017eavat \u0107e informacije za sljede\u0107e vrijeme molitve\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"Ako ste aktivirali \u201cRezervi\u0161i i Resetuj\u201d u postavkama va\u0161eg telefona (Postavke / Sigurnosna kopija i resetiranje / Sigurnosna kopija mojih podataka), treba da budete svjesni da \u0107e sam Android (ne Al-Azan) povremeno spremati kopiju podataka va\u0161eg telefona u Google-ove servere. Ovo omogu\u0107ava Androidu da povrati va\u0161e podatke u slu\u010daju da se va\u0161 ure\u0111aj o\u0161teti ili da kupite novi ure\u0111aj. Programeri Al-Azana nemaju pristup ovim podacima.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"Ako ste i dalje imali problema sa zaustavljanjem aplikacije nakon nekog vremena, molim vas da posjetite dontkillmyapp.com za vi\u0161e rje\u0161enja.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"Ako \u017eelite biti sigurni da aplikacija mo\u017ee raditi pouzdano, morate onemogu\u0107iti optimizaciju napajanja za ovu aplikaciju. Povezane postavke mo\u017eete otvoriti koriste\u0107i dugme ispod.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"Ako va\u0161 ure\u0111aj ima prilagodljivo punjenje, kao \u0161to je Google Pixel, i ne \u017eelite da se ezan ili podsjetnici prepoznaju kao alarm, mo\u017eete omogu\u0107iti ovu opciju.\",\"Import\":\"Uvezite\",\"Import app data\":\"Uvezite podatke aplikacije\",\"Import successful\":\"Uvoz je uspje\u0161an\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"Pored pet dnevnih namaza, ima postavke za izlazak sunca, zalazak sunca, pono\u0107 i no\u0107ni namaz (tahad\u017eud)\",\"Increment\":\"Pove\u0107anje\",\"Info\":\"Info\",\"Internet connection\":\"Internet veza\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"Internet veza je neophodna da bi karta kible radila. Molimo vas da omogu\u0107ite WiFi ili mobilnu mre\u017eu i probajte ponovo.\",\"Iran\":\"Iran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"Lokaliziran je na engleski, perzijski, arapski, turski, indonezijski, francuski, urdu, hindi, njema\u010dki, bosanski, vijetnamski, bangla\",\"Isha Angle\":\"Kut Jacije\",\"Isha Interval\":\"Interval Jacije\",\"Islamic\":\"Islamski\",\"Islamic (Saudi Arabia sighting)\":\"Islamski (Saudijsko posmatranje)\",\"Islamic (Umm al-Qura)\":\"Islamski (Um al-Kura)\",\"Islamic (civil)\":\"Islamski (civilni)\",\"Islamic (tabular)\":\"Islamski (tabelarni)\",\"Islamic Society of North America (ISNA)\":\"Islamsko dru\u0161tvo Sjeverne Amerike (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"\u010cini se da ste uvezli sigurnosnu kopiju, ne zaboravite onemogu\u0107iti optimizaciju baterije za ovu aplikaciju\",\"Just now\":\"Tek sad\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Ministarstvo Vjera Republike Indonezije (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Ministarstvo za Vjerska Pitanja (Brunej)\",\"Kuwait\":\"Kuvajt\",\"Label\":\"Oznaka\",\"Language\":\"Jezik\",\"Latitude\":\"Geografska \u0160irina\",\"Latitude is invalid\":\"Geografska \u0160irina ne va\u017ei\",\"License\":\"Dozvola\",\"Light\":\"Svjetla\",\"Light and Dark theme\":\"Svjetla/mra\u010dna tema\",\"Light/Dark theme\":\"Svjetla/mra\u010dna tema\",\"List is empty\":\"Lista je prazna\",\"Loading\":\"U\u010ditavanje\",\"Location\":\"Lokacija\",\"Location settings\":\"Postavke za lokaciju\",\"Longitude\":\"Geografska Du\u017eina\",\"Longitude is invalid\":\"Geografska Du\u017eina ne va\u017ei\",\"Low\":\"Niska\",\"Lunar Calendar\":\"Lunarni kalendar\",\"Lunar Calendar Language\":\"Jezik lunarnog kalendara\",\"Maghrib Angle\":\"Kut Ak\u0161ama\",\"Make a Copy\":\"Napravite Kopiju\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Mnogo opcija za izra\u010dunavanje ezana (\u0627\u0630\u0627\u0646)\",\"Medium\":\"Srednja\",\"Middle of the Night\":\"Usred No\u0107i\",\"Midnight Method\":\"Pono\u0107na Metoda\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"Ministarstvo Vjerskih Poslova i Vakfa, Al\u017eir\",\"Ministry of Religious Affairs of Tunisia\":\"Ministarstvo za vjerska pitanja Tunisa\",\"Mobile Data\":\"Mobilna Mre\u017ea\",\"Modified\":\"Izmijenjeno\",\"Monday\":\"Ponedjeljak\",\"Moonsighting Committee\":\"Odbor za Promatranje Mjeseca\",\"Muslim World League\":\"Svjetska Liga Muslimana\",\"Name\":\"Naziv\",\"Nearest\":\"Najbli\u017ei\",\"New Counter\":\"Novi Broja\u010d\",\"New Location\":\"Nova Lokacija\",\"New Reminder\":\"Novi Podsjetnik\",\"New Silent Mode\":\"New Silent Mode\",\"Next\":\"Sljede\u0107i\",\"Next Day\":\"Sljede\u0107i Dan\",\"Next Month\":\"Sljede\u0107i Mjesec\",\"No\":\"Ne\",\"No Data\":\"Nema Date\",\"No Results\":\"Nema Rezultata\",\"None\":\"Nema\",\"None (Automatic)\":\"Ni\u0161ta (Automatski)\",\"Normal mode restored\":\"Normal mode restored\",\"Not now\":\"Ne sad\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"\u010cuvajte na umu da zbog softverskih i hardverskih gre\u0161aka, smjer Kabe koji pokazuje ova aplikacija, posebno u kompas modu, mo\u017ee biti pogre\u0161an.\",\"Notification\":\"Obavijest\",\"Notification & Sound\":\"Obavijest i Zvuk\",\"Notifications Permission\":\"Dozvole za Obavijesti\",\"Numbering system\":\"Sistem Numerisanja\",\"Off\":\"Isklju\u010deno\",\"Okay\":\"U redu\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"Na Androidu 12 i novijem, aplikaciji je potrebna i dozvola za alarme da bi ispravno radila, pa bi trebali i ovo dozvoliti.\",\"Once\":\"Jednom\",\"One-Seventh of the Night\":\"Jedna Sedmina Ve\u010deri\",\"Only once?\":\"Samo jednom?\",\"Only six items can be shown at the same time\":\"Samo \u0161est stvari mo\u017ee biti pokazano istovremeno\",\"Open Battery Optimization Settings\":\"Otvorite Postavke za Optimizaciju Baterije\",\"Open Power Manager Settings\":\"Otvorite Postavke Napojnog Menad\u017eera\",\"Open source repository\":\"Otvoreno spremi\u0161te\",\"Open-source\":\"Otvorenog izvora\",\"Options\":\"Postavke\",\"Or if you have a backup, you can import it\":\"Ili ako imate rezervnu kopiju, mo\u017eete je uvesti\",\"Orientation Lock: Landscape\":\"Zaklju\u010davanje Orijentacije: Pejza\u017e\",\"Orientation Lock: Portrait\":\"Zaklju\u010davanje Orijentacije: Portret\",\"Orientation: Unlocked\":\"Orijentacija: Otklju\u010dano\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"Drugi magnetni ure\u0111aji mogu ometati kompas va\u0161eg telefona i kompas \u0107e mo\u017eda trebati kalibrirati.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Silent Mode\",\"PRE_ADHAN_CHANNEL_NAME\":\"Nadolaze\u0107i ezan\",\"PRE_REMINDER_CHANNEL_NAME\":\"Nadolaze\u0107a podsjeta\",\"Pakistan\":\"Pakistan\",\"Paste\":\"Zalijepi\",\"Persian\":\"Perzijski\",\"Phone State Permission\":\"Dozvola Stanja Telefona\",\"Play\":\"Pokreni\",\"Please enable location service\":\"Molimo vas da omogu\u0107ite uslugu lokacije\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"Imajte na umu da omogu\u0107avanje ove postavke mo\u017ee uzrokovati pokretanje ezana i podsjetnika sa zaka\u0161njenjem ili nikako u nekim slu\u010dajevima. Omogu\u0107ite ovo s oprezom.\",\"Polar Resolution\":\"Polarna Procjena Razmaka\",\"Power Manager\":\"Napojni Menad\u017eer\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"Vremena Molitve\",\"Prayer list\":\"Molitvena lista\",\"Press to search\":\"Pritisnite za pretragu\",\"Press to select a method\":\"Pritisnite za odabir metode\",\"Prev Day\":\"Pro\u0161li Dan\",\"Prev Month\":\"Prethodni Mjesec\",\"Privacy Policy\":\"Politika Privatnosti\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"Prva privatna-bezoglasna otvorena muslimanska aplikacija za Ezan i kiblu\",\"Qada counter\":\"Kada broja\u010d\",\"Qatar\":\"Katar\",\"Qibla\":\"Kibla\",\"Qibla finder\":\"Kibla pronalaznik\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"Pronalazniku Kible treba usluga lokacije. Ako nije omogu\u0107ena, koristit \u0107e se lokacija iz postavkih aplikacije.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"Mapa Kible trenutno nije dostupna u F-Droid verzijama aplikacije. Mo\u017eda \u0107e postati dostupna u budu\u0107im a\u017euriranjima.\",\"REMINDER_CHANNEL_NAME\":\"Podsjetnik\",\"Ramadan is ending,\":\"Ramazan se zavr\u0161ava,\",\"Ramadan is near,\":\"Ramazan je blizu,\",\"Remaining till\":\"Ostaje do\",\"Remind me next year\":\"Podsjeti me tek sljede\u0107e godine\",\"Reminder\":\"Podsjetnik\",\"Repeat\":\"Ponovite\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"Potrebne postavke su nepotpune. Da bi aplikacija prikazivala vremena molitve, morate je kasnije konfigurirati iz postavkih.\",\"Rounding Method\":\"Metoda zaokru\u017eivanja\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"Samsung ure\u0111aji imaju vlastiti prilago\u0111eni Napojni Menad\u017eer pod nazivom \\\"Njega Ure\u0111aja\\\".\\nNakon \u0161to pritisnete dugme ispod, bi\u0107ete usmjereni prema Baterijskom meniju u Njezi Ure\u0111aja.\\nU Baterijskom meniju tapnite \\\"Upravljanje napajanjem aplikacija\\\", a zatim dodirnite \\\"Aplikacije koje se ne\u0107e staviti u stanje mirovanja\\\",\\ni dodajte ovu aplikaciju u listu.\",\"Saturday\":\"Subota\",\"Saudi Arabia\":\"Saudijska Arabija\",\"Search\":\"Tra\u017eite\",\"Secondary Calendar\":\"Sekundarni Kalendar\",\"See favorite locations\":\"Pogledajte omiljene lokacije\",\"Select as Fajr Adhan\":\"Odaberite ko Sabah Ezan\",\"Select different Adhan audio for Fajr namaz\":\"Odaberite razli\u010dite zvuke ezana za Sabah\",\"Selected\":\"Odabrano\",\"Selected as adhan\":\"Odabrano kao ezan\",\"Selected as fajr adhan\":\"Odabrano kao sabah ezan\",\"Selecting a name is required\":\"Odabir imena je potrebno\",\"Set custom Adhan audio\":\"Postavite prilago\u0111eni zvuk za Ezan\",\"Set reminders before or after a prayer time\":\"Postavite podsjetnike prije ili poslije molitvenog vremena\",\"Shafaq\":\"\u0160afak\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\u0160afak koristi metode Odbora za Promatranje Mjeseca da\\nodredi koju vrstu sumraka da koristi kako biste\\nodredili vrijeme za Jaciju\",\"Shafi, Maliki, Hanbali (Default)\":\"\u0160afija, Malikija, Hanbelija (Zadano)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u0160iizam Itna A\u0161ari, Leva Institut, Kom\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u0160iizam, Institut za Geofiziku, Univerzitet u Teheranu\",\"Should app highlight current prayer instead of next prayer?\":\"Treba li aplikacija istaknuti trenutnu molitvu umjesto sljede\u0107e?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"Treba li aplikacija i dalje pu\u0161tati ezan kada je \\\"Ne smjetaj\\\" postavka aktivna?\",\"Should app stop playing adhan when the volume button is pressed?\":\"Da li aplikacija treba da prestane da pu\u0161ta ezan kada se pritisne dugme za ja\u010dinu zvuka?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"Da li telefon treba da se trese i zuji kada ezan ili podsjetnik po\u010dne svirati?\",\"Show Adhan Options\":\"Prika\u017eite Postavke za Ezan\",\"Show Today\":\"Prika\u017eite Danas\",\"Show countdown?\":\"Prika\u017eite odbrojavanje?\",\"Show current\":\"Prika\u017ei trenutni\",\"Show me\":\"Poka\u017ei mi\",\"Show next in notification?\":\"Prika\u017eite sljede\u0107e u obavje\u0161tenju?\",\"Show notification widget?\":\"Prika\u017eite vid\u017eet za obavje\u0161tenje?\",\"Show settings\":\"Prika\u017eite Postavke\",\"Show upcoming alarm notification?\":\"Prika\u017eite nadolaze\u0107a obavje\u0161tenja o alarmu?\",\"Silent\":\"Tiho\",\"Silent Mode Ended\":\"Silent Mode Ended\",\"Silent Mode Name\":\"Silent Mode Name\",\"Silent Mode Started\":\"Silent Mode Started\",\"Silent mode activated\":\"Silent mode activated\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"Budu\u0107i da ne koristimo nikakvu vrstu traga\u010da ili analitike ru\u0161enja, molimo prijavite svaki problem ili prijedlog koji imate na na\u0161em github repozitoruju\",\"Singapore\":\"Singapur\",\"Skip\":\"Presko\u010di\",\"Software License\":\"Softverska Dozvola\",\"Solar Hijri\":\"Iranski Kalendar\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"Nekim ure\u0111ajima trebaju dodatne postavke unutar svog\\nNapojnog Menad\u017eera da sprije\u010dite uni\u0161tenje aplikacije u pozadini.\\nU tom slu\u010daju onemogu\u0107ite bilo koju opciju u\u0161tede energije za aplikaciju.\",\"Sound\":\"Zvuk\",\"Spiritual Administration of Muslims of Russia\":\"Duhovna Uprava Muslimana Rusije\",\"Start before prayer (minutes)\":\"Start before prayer (minutes)\",\"Status\":\"Stanje\",\"Stop\":\"Stani\",\"Sunday\":\"Nedelja\",\"Sunset to Fajr (Default)\":\"Zalazak sunca do Fad\u017era (zadano)\",\"Sunset to Sunrise\":\"Od zalaska do izlaska sunca\",\"System Default\":\"Sistemski Zadana\",\"Tahajjud time mentioned in the app is the last third of the night\":\"No\u0107ni Namaz naveden u aplikaciji je zadnja tre\u0107ina no\u0107i\",\"Thai Solar\":\"Tajlandski Solarni Kalendar\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"Hvala vam \u0161to ste odabrali ovu aplikaciju!\\nPostoje stvari koje morate u\u010diniti prije\\nnego \u0161to mo\u017eete po\u010deti koristiti ovu aplikaciju.\",\"The Gulf Region (Dubai)\":\"Zaljevsko podru\u010dje (Dubaj)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"Lunarni kalendar aplikacije je unaprijed izra\u010dunat i mo\u017eda ne\u0107e biti ta\u010dan jer nije zasnovan na vi\u0111enjima mjeseca. Ovo je posebno va\u017eno napomenuti za po\u010detak i kraj Ramazana.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"Tekst koji se nalazi na ovoj web stranici i u aplikaciji mo\u017eda nije ta\u010dan na drugim jezicima, tako da u svakom slu\u010daju treba uzeti u obzir samo englesku verziju.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Tip kalendara koji se prikazuje na vrhu po\u010detnog ekrana i pored lunarnog kalendara u widgetima\",\"The type of lunar calendar shown in main screen and widgets\":\"Tip lunarnog kalendara prikazanog na glavnom ekranu i vid\u017eetima\",\"Theme Color\":\"Boja Teme\",\"Thursday\":\"\u010cetvrtak\",\"Time\":\"Vrijeme\",\"Time condition\":\"Vremensko stanje\",\"Time format\":\"Vremenski format\",\"Time list\":\"Vremenski spisak\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"Za izra\u010dunavanje ezana, potrebna nam je va\u0161a lokacija. Mo\u017eete koristiti dugme \\\"Prona\u0111i moju lokaciju\\\", ili pretragu zemlje i grada/podru\u010dja, ili ru\u010dno unesite svoje koordinate.\",\"To see notifications about adhan, we need your permission.\":\"Da vidimo obavje\u0161tenja o ezanu, potrebna nam je va\u0161a dozvola.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"Da prestanemo da sviramo ezan kada primite poziv, moramo pro\u010ditati stanje va\u0161eg telefona. Nedopu\u0161tanje ove dozvole jednostavno onemogu\u0107ava funkciju.\",\"Tomorrow\":\"Sutra\",\"Tuesday\":\"Utorak\",\"Turn Left\":\"Skrenite lijevo\",\"Turn Right\":\"Skrenite desno\",\"Turn history off\":\"Isklju\u010dite povijest\",\"Turn history on\":\"Uklju\u010dite povijest\",\"Twilight Angle\":\"Ugao Sumraka\",\"Umm al-Qura University, Makkah\":\"Um al-Kura Univerzitet, Mekka\",\"Union Organization Islamic de France\":\"Islamska Organizacija Francuske\",\"University of Islamic Sciences, Karachi\":\"Univerzitet Islamskih Nauka, Kara\u010di\",\"Unknown Error\":\"Nepoznata Gre\u0161ka\",\"Unreliable\":\"Nepouzdano\",\"Unresolved (default)\":\"Nerije\u0161eno (zadano)\",\"Unsupported\":\"Nepodr\u017eano\",\"Up\":\"Gore\",\"Upcoming alarm\":\"Predstoje\u0107i alarm\",\"Updating widgets\":\"A\u017euriraju je vid\u017eeti\",\"Use 24-Hour format\":\"Koristite 24-satni format\",\"Use Compass\":\"Koristite Kompas\",\"Use Map\":\"Koristite Kartu\",\"Use a different alarm type?\":\"Koristite drugu vrstu alarma?\",\"Use adaptive theme?\":\"Koristite adaptivnu temu?\",\"Use headphones when available?\":\"Koristite slu\u0161alice kad je dostupno?\",\"Using Coordinates\":\"Koordinati su u Koristi\",\"Using GPS\":\"GPS je u Koristi\",\"Using Search\":\"Pretraga je u Koristi\",\"Version\":\"Verzija\",\"Vibration Mode\":\"Mod Tresanja\",\"Vibration on call\":\"Vibration on call\",\"Volume button stops adhan\":\"Dugme za ja\u010dinu zvuka zaustavlja ezan\",\"WIDGET_CHANNEL_NAME\":\"Vid\u017eet\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"Vid\u017eet za A\u017euriranje\",\"We'll help you do them quickly.\":\"Pomo\u0107i \u0107emo vam da ih brzo obavite.\",\"Wednesday\":\"Srijeda\",\"Welcome\":\"Dobrodo\u0161li\",\"Western Arabic\":\"Zapadno-Arapski\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Kada je omogu\u0107eno, ekran \u0107e ostati isklju\u010den kada ezan ili podsjetnik po\u010dne svirati, a ekran alarma ne\u0107e biti prikazan\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"Kada je omogu\u0107eno, kada koristite slu\u0161alice, sav zvuk \u0107e se pokretati samo na slu\u0161alicama.\",\"Wifi\":\"WiFi\",\"Yes\":\"Da\",\"You are facing Kaaba\":\"Okrenuti ste Kabi\",\"You are not facing Kaaba\":\"Niste okrenuti ka Kabi\",\"You can access your device Power Manager using the button below.\":\"Mo\u017eete pristupiti Napojnom Menad\u017eeru svog ure\u0111aja koriste\u0107i dugme ispod.\",\"You can also paste coords from clipboard\":\"Mo\u017eete tako\u0111er zalijepiti koordinate iz me\u0111uspremnika\",\"You can change the language used for lunar calendar\":\"Mo\u017eete promijeniti jezik koji se koristi za lunarni kalendar\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"Mo\u017eete promijeniti kada \u0107e nadolaze\u0107i alarm ko obavje\u0161tenje se poslati prije ezana kao podsjetnik\",\"You can choose to replace one of calendars with your current location\":\"Mo\u017eete odabrati da zamijenite jedan od kalendara svojom trenutnom lokacijom\",\"You can hide prayer times you don't want to see in the main screen here:\":\"Mo\u017eete ovdje sakriti molitvena vremena koja ne \u017eelite da vidite na glavnom ekranu:\",\"You can hide prayer times you don't want to see in the widget here:\":\"Mo\u017eete sakriti vremena molitve koja ne \u017eelite da vidite u vid\u017eetu ovdje:\",\"You can search for your location offline Or use GPS\":\"Mo\u017eete na\u0107i svoju lokaciju bez interneta ili koriste\u0107i GPS\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"Trebali ste dobiti kopiju GNU Affero Op\u0107e Javne Dozvole zajedno s ovim programom. Ako niste, pogledajte https://www.gnu.org/licenses/.\",\"Your sounds\":\"Va\u0161i zvukovi\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"Sva autorska prava za glasove ezana pripadaju njihovim vlasnicima.\\nPosebno zahvaljujemo translation.io (lingui.js) za njihovim divnim uslugama.\\nHvala svim \u010dlanovima zajednice otvorenog izvora koji su napravili sve ove divne biblioteke koje su omogu\u0107ile stvaranje ove aplikacije.\",\"about.credits.google\":\"Ve\u0107ina ikona koje se koriste u ovoj aplikaciji su iz Google Materijalskog Dizajna.\",\"about_settings\":\"O Aplikaciji\",\"adjustment.hint\":\"Broj minuta koji \u0107e se dodati izra\u010dunatim vremenima\",\"after\":\"nakon\",\"ago\":\"prije\",\"asr.prayer\":\"Ikindija\",\"backup_settings\":\"Rezerva\",\"before\":\"prije\",\"calculation_adjustments_settings\":\"Prilago\u0111enja\",\"calculation_advanced_settings\":\"Napredne Postavke Kalkulacije\",\"calculation_settings\":\"Kalkulacija\",\"counter.fast\":\"Brzo\",\"date.day\":\"dan\",\"date.hour\":\"sat\",\"date.minute\":\"minuta\",\"date.second\":\"sekunda\",\"dev_settings\":\"Razvodni\u010dke Postavke\",\"dhuhr.prayer\":\"Podne\",\"display_settings\":\"Prikaz\",\"fajr.prayer\":\"Sabah\",\"favorite_location\":\"Omiljene Lokacije\",\"forces all numbers to be in the selected system\":\"prisiljava sve brojeve da budu u odabranom sistemu\",\"from North\":\"sa Sjevera\",\"from settings\":\"iz postavkih\",\"fullscreen_alarm\":\"Ezan je u toku\",\"hijri.adjustment.hint\":\"Broj dana koji \u0107e biti dodati lunarnom kalendaru\",\"home\":\"Po\u010detna\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"ako je omogu\u0107eno, obavijest \u0107e se prikazati oko jedan sat prije vremena molitve ili podsjetnika koji ima zvuk\",\"intro\":\"intro\",\"is prayer time hidden?\":\"da li je vrijeme molitve skriveno?\",\"isha.prayer\":\"Jacija\",\"later\":\"poslije\",\"location_settings\":\"Lokacija\",\"maghrib.prayer\":\"Ak\u0161am\",\"masjid_an_nabawi\":\"Poslanikova D\u017eamija\",\"minutes\":\"minuta\",\"moazen_zade\":\"Mujezin Zade\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"Mjese\u010dni Prikaz\",\"muezzin_settings\":\"Mujezin\",\"notification_advanced_settings\":\"Napredne postavke\",\"notification_settings\":\"Obavijesti i Zvuk\",\"qada_counter\":\"Kadski Broja\u010d\",\"qibla_compass\":\"Kibla Kompas\",\"qibla_finder\":\"Kibla Pronalaznik\",\"qibla_map\":\"Kibla Karta\",\"ragheb_mustafa_ghalwash\":\"Rahib Mustafa Galva\u0161\",\"reminders_settings\":\"Podsjetnici\",\"settings\":\"Postavke\",\"should notification widget be shown?\":\"bi li vid\u017eet za obavje\u0161tenje trebao biti prikazan?\",\"should {prayerName} be hidden?\":[\"bi li \",[\"prayerName\"],\" trebalo biti sakriveno?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"budu\u0107i da je kalendar aplikacije unaprijed izra\u010dunat i nije zasnovan na vi\u0111anjima mjeseca, mo\u017ee prikazati neta\u010dan datum po\u010detka i kraja Ramazana.\",\"sunnah.midnight\":\"Pono\u0107\",\"sunnah.tahajjud\":\"No\u0107ni Namaz\",\"sunrise\":\"Izlazak\",\"sunset\":\"Zalazak\",\"widget_settings\":\"Postavke za Vid\u017eete\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" minuta poslije \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" minuta prije \",[\"prayer\"]],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" obavijest \u0107e biti prikazana\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" zvuk \u0107e biti pokrenut\"]}")}),635,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"10 ph\xfat\",\"15 min\":\"15 ph\xfat\",\"30 min\":\"30 ph\xfat\",\"30 minutes is added to Isha time during Ramadan in this method\":\"30 ph\xfat \u0111\u01b0\u1ee3c th\xeam v\xe0o th\u1eddi gian Isha trong th\xe1ng Ramadan theo ph\u01b0\u01a1ng ph\xe1p n\xe0y\",\"5 min\":\"5 ph\xfat\",\"60 min\":\"60 ph\xfat\",\"90 min\":\"90 ph\xfat\",\"ADHAN_CHANNEL_NAME\":\"Azan\",\"Abyad\":\"Abyad\",\"Accuracy\":\"\u0110\u1ed9 ch\xednh x\xe1c\",\"Ad-Free\":\"Kh\xf4ng qu\u1ea3ng c\xe1o\",\"Adaptive Charging\":\"S\u1ea1c Th\xedch \u1ee9ng\",\"Add\":\"Th\xeam\",\"Add Custom Adhan\":\"Th\xeam Azan t\xf9y ch\u1ec9nh\",\"Add Custom Audio\":\"Th\xeam \xc2m b\xe1o T\xf9y ch\u1ec9nh\",\"Add Reminder\":\"Th\xeam L\u1eddi nh\u1eafc\",\"Add Silent Mode\":\"Add Silent Mode\",\"Add new counter\":\"Th\xeam b\u1ed9 \u0111\u1ebfm m\u1edbi\",\"Add new location\":\"Th\xeam v\u1ecb tr\xed m\u1edbi\",\"Adhan\":\"Azan\",\"Adhan audio file is not downloaded yet\":\"T\u1ec7p \xe2m b\xe1o Azan ch\u01b0a \u0111\u01b0\u1ee3c t\u1ea3i xu\u1ed1ng\",\"Adjustments\":\"\u0110i\u1ec1u ch\u1ec9nh\",\"Advanced\":\"N\xe2ng cao\",\"Advanced Calculation Settings\":\"C\xe0i \u0111\u1eb7t T\xednh to\xe1n N\xe2ng cao\",\"Advanced Settings\":\"C\xe0i \u0111\u1eb7t n\xe2ng cao\",\"Ahmer\":\"Ahmer\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Gi\u1edd C\u1ea7u Nguy\u1ec7n Salah\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan \u0111\u01b0\u1ee3c ph\xe2n ph\u1ed1i v\u1edbi hy v\u1ecdng r\u1eb1ng n\xf3 s\u1ebd h\u1eefu \xedch, nh\u01b0ng KH\xd4NG C\xd3 B\u1ea4T K\u1ef2 B\u1ea2O H\xc0NH N\xc0O; th\u1eadm ch\xed kh\xf4ng c\xf3 b\u1ea3o h\xe0nh cho KH\u1ea2 N\u0102NG B\xc1N \u0110\u01af\u1ee2C hay PH\xd9 H\u1ee2P CHO M\u1ed8T M\u1ee4C \u0110\xcdCH C\u1ee4 TH\u1ec2. Xem Gi\u1ea5y ph\xe9p C\xf4ng c\u1ed9ng GNU Affero \u0111\u1ec3 bi\u1ebft th\xeam chi ti\u1ebft.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan l\xe0 ph\u1ea7n m\u1ec1m mi\u1ec5n ph\xed: b\u1ea1n c\xf3 th\u1ec3 ph\xe2n ph\u1ed1i l\u1ea1i v\xe0/ho\u1eb7c s\u1eeda \u0111\u1ed5i n\xf3 theo c\xe1c \u0111i\u1ec1u kho\u1ea3n c\u1ee7a Gi\u1ea5y ph\xe9p C\xf4ng c\u1ed9ng Chung GNU Affero (v3.0) do T\u1ed5 ch\u1ee9c Ph\u1ea7n m\u1ec1m Mi\u1ec5n ph\xed xu\u1ea5t b\u1ea3n.\",\"Alarms Permission\":\"Quy\u1ec1n B\xe1o Th\u1ee9c\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"T\u1ea5t c\u1ea3 d\u1eef li\u1ec7u \u0111\u01b0\u1ee3c cung c\u1ea5p cho Al-Azan ch\u1ec9 \u0111\u01b0\u1ee3c l\u01b0u tr\u1eef c\u1ee5c b\u1ed9 trong thi\u1ebft b\u1ecb c\u1ee7a b\u1ea1n. D\u1eef li\u1ec7u n\xe0y kh\xf4ng b\u1ecb \u0111\u0103ng l\xean b\u1ea5t c\u1ee9 \u0111\xe2u. C\xe1c nh\xe0 ph\xe1t tri\u1ec3n c\u1ee7a Al-Azan kh\xf4ng c\xf3 quy\u1ec1n truy c\u1eadp v\xe0o n\xf3. D\u1eef li\u1ec7u c\u1ee7a b\u1ea1n kh\xf4ng b\u1ecb chia s\u1ebb v\u1edbi b\xean th\u1ee9 ba n\xe0o. Al-Azan kh\xf4ng ch\u1ee9a b\u1ea5t k\u1ef3 th\u01b0 vi\u1ec7n qu\u1ea3ng c\xe1o hay m\xe3 theo d\xf5i (ph\xe2n t\xedch) n\xe0o c\u1ee7a b\xean th\u1ee9 ba, v\xed d\u1ee5 nh\u01b0 Google Analytics hay Facebook SDK.\",\"An error occured while playing the current track\":\"\u0110\xe3 x\u1ea3y ra l\u1ed7i khi ph\xe1t \xe2m b\xe1o hi\u1ec7n t\u1ea1i\",\"App features\":\"T\xednh n\u0103ng \u1ee9ng d\u1ee5ng\",\"Arabic\":\"ti\u1ebfng \u1ea2 R\u1eadp\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"B\u1ea1n c\xf3 ch\u1eafc ch\u1eafn mu\u1ed1n x\xf3a \\\"\",[\"0\"],\"\\\" kh\xf4ng?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"B\u1ea1n c\xf3 ch\u1eafc ch\u1eafn mu\u1ed1n x\xf3a \\\"\",[\"itemName\"],\"\\\" kh\xf4ng?\"],\"Are you sure you want to delete this?\":\"B\u1ea1n c\xf3 ch\u1eafc ch\u1eafn mu\u1ed1n x\xf3a c\xe1i n\xe0y kh\xf4ng?\",\"Asr Calculation\":\"T\xednh Asr\",\"At least one prayer time must be shown\":\"\xcdt nh\u1ea5t m\u1ed9t l\u1ea7n c\u1ea7u nguy\u1ec7n ph\u1ea3i \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb\",\"Attention\":\"Ch\xfa \xfd\",\"Auto (Default)\":\"T\u1ef1 \u0111\u1ed9ng (M\u1eb7c \u0111\u1ecbnh)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"Ph\u1edbt l\u1edd ch\u1ebf \u0111\u1ed9 \\\"Kh\xf4ng l\xe0m phi\u1ec1n\\\"?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"T\xednh to\xe1n Azan c\xf3 nhi\u1ec1u ph\u01b0\u01a1ng ph\xe1p kh\xe1c nhau. M\u1ed7i ph\u01b0\u01a1ng ph\xe1p cho k\u1ebft qu\u1ea3 kh\xe1c nhau. B\u1ea1n c\xf3 tr\xe1ch nhi\u1ec7m t\xecm ki\u1ebfm v\xe0 s\u1eed d\u1ee5ng \u0111\xfang ph\u01b0\u01a1ng ph\xe1p.\",\"Calculation\":\"Ph\xe9p t\xednh\",\"Calculation Method\":\"Ph\u01b0\u01a1ng ph\xe1p T\xednh\",\"Calendar\":\"L\u1ecbch\",\"Cancel\":\"H\u1ee7y\",\"Cancel Alarm\":\"H\u1ee7y b\xe1o th\u1ee9c\",\"Cancel download\":\"H\u1ee7y t\u1ea3i xu\u1ed1ng\",\"Choose Asr Calculation Madhab\":\"Ch\u1ecdn t\xednh to\xe1n Asr Madhab\",\"Choose Calculation Method\":\"Ch\u1ecdn ph\u01b0\u01a1ng ph\xe1p t\xednh\",\"Choose High Latitude Setting\":\"Ch\u1ecdn C\xe0i \u0111\u1eb7t V\u0129 \u0111\u1ed9 Cao\",\"Choose Language\":\"Ch\u1ecdn ng\xf4n ng\u1eef\",\"Choose Polar Resolution\":\"Ch\u1ecdn ph\xe2n gi\u1ea3i v\xf9ng B\u1eafc & Nam c\u1ef1c\",\"Choose Shafaq method\":\"Ch\u1ecdn ph\u01b0\u01a1ng ph\xe1p Shafaq\",\"Choose calculation rounding method\":\"Ch\u1ecdn ph\u01b0\u01a1ng ph\xe1p l\xe0m tr\xf2n\",\"Choose calendar type\":\"Ch\u1ecdn lo\u1ea1i l\u1ecbch\",\"Choose lunar calendar language\":\"Ch\u1ecdn ng\xf4n ng\u1eef \xe2m l\u1ecbch\",\"Choose midnight calculation method\":\"Ch\u1ecdn c\xe1ch t\xednh n\u1eeda \u0111\xeam\",\"Choose numbering system\":\"Ch\u1ecdn h\u1ec7 th\u1ed1ng s\u1ed1 \u0111\u1ebfm\",\"Choose which calendar to replace\":\"Ch\u1ecdn l\u1ecbch \u0111\u1ec3 thay th\u1ebf\",\"City/Area\":\"Th. ph\u1ed1/Khu v\u1ef1c\",\"Clear the coordinates\":\"X\xf3a t\u1ecda \u0111\u1ed9\",\"Clear the location\":\"X\xf3a v\u1ecb tr\xed\",\"Clipboard data does not contain coordinates\":\"D\u1eef li\u1ec7u nh\u1edb t\u1ea1m kh\xf4ng ch\u1ee9a t\u1ecda \u0111\u1ed9\",\"Close\":\"\u0110\xf3ng\",\"Closest City\":\"Th\xe0nh ph\u1ed1 g\u1ea7n nh\u1ea5t\",\"Closest Date\":\"Ng\xe0y g\u1ea7n nh\u1ea5t\",\"Compass Lock\":\"Kh\xf3a La B\xe0n\",\"Compass sensor unavailable\":\"C\u1ea3m bi\u1ebfn la b\xe0n kh\xf4ng kh\u1ea3 d\u1ee5ng\",\"Confirm\":\"X\xe1c nh\u1eadn\",\"Continuous\":\"Li\xean t\u1ee5c\",\"Coordinates updated\":\"\u0110\xe3 c\u1eadp nh\u1eadt t\u1ecda \u0111\u1ed9\",\"Copy\":\"Sao ch\xe9p\",\"Count\":\"\u0110\u1ebfm\",\"Country\":\"Qu\u1ed1c gia\",\"Custom\":\"T\xf9y ch\u1ecdn\",\"Custom sounds and muezzins will not be exported\":\"\xc2m b\xe1o v\xe0 muezzin t\xf9y ch\u1ec9nh s\u1ebd kh\xf4ng \u0111\u01b0\u1ee3c xu\u1ea5t\",\"Custom upcoming alarm time\":\"T\xf9y ch\u1ec9nh gi\u1edd b\xe1o th\u1ee9c s\u1eafp t\u1edbi\",\"Dark\":\"T\u1ed1i\",\"Date\":\"Ng\xe0y\",\"Decrement\":\"Gi\u1ea3m\",\"Default\":\"M\u1eb7c \u0111\u1ecbnh\",\"Delete\":\"X\xf3a\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"T\xf9y thu\u1ed9c v\xe0o thi\u1ebft b\u1ecb v\xe0 phi\xean b\u1ea3n Android c\u1ee7a b\u1ea1n, \u0110\xf4i khi thi\u1ebft b\u1ecb c\u1ee7a b\u1ea1n c\xf3 th\u1ec3 t\u1eaft \u1ee9ng d\u1ee5ng ch\u1ea1y n\u1ec1n \u0111\u1ec3 ti\u1ebft ki\u1ec7m pin. \u0110i\u1ec1u n\xe0y c\xf3 th\u1ec3 ng\u0103n vi\u1ec7c hi\u1ec7n b\xe1o th\u1ee9c/th\xf4ng b\xe1o.\",\"Deselect as Fajr Adhan\":\"B\u1ecf ch\u1ecdn l\xe0m Fajr Azan\",\"Device sounds\":\"\xc2m thanh thi\u1ebft b\u1ecb\",\"Disabled\":\"\u0110\xe3 t\u1eaft\",\"Disclaimer\":\"L\u01b0u \xfd\",\"Dismiss\":\"B\u1ecf qua\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"Ph\u01b0\u01a1ng ph\xe1p Diyanet \u0111\u01b0\u1ee3c cung c\u1ea5p \u1edf Al-Azan l\xe0 ph\u01b0\u01a1ng ph\xe1p g\u1ea7n \u0111\xfang v\u1edbi th\u1eddi gian ch\xednh th\u1ee9c. V\xec kh\xf4ng c\xf3 \u0111\u1ee7 t\xe0i li\u1ec7u v\u1ec1 c\xe1ch t\xednh to\xe1n ch\xednh x\xe1c th\u1eddi gian n\xean th\u1eddi gian c\xf3 th\u1ec3 kh\xf4ng kh\u1edbp v\u1edbi trang web ch\xednh th\u1ee9c, \u0111\u1eb7c bi\u1ec7t l\xe0 ngo\xe0i Th\u1ed5 Nh\u0129 K\u1ef3.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Th\u1ed5 Nh\u0129 K\u1ef3\",\"Doesn't use any kind of trackers\":\"Kh\xf4ng s\u1eed d\u1ee5ng b\u1ea5t k\u1ef3 tr\xecnh theo d\xf5i n\xe0o\",\"Don't ask again\":\"\u0110\u1eebng h\u1ecfi l\u1ea1i\",\"Don't show again\":\"Kh\xf4ng hi\u1ec3n th\u1ecb l\u1ea1i\",\"Don't show alarm screen?\":\"Kh\xf4ng hi\u1ec3n th\u1ecb m\xe0n h\xecnh b\xe1o th\u1ee9c?\",\"Done\":\"Xong\",\"Download\":\"T\u1ea3i xu\u1ed1ng\",\"Eastern Arabic\":\"\u0110\xf4ng \u1ea2 R\u1eadp\",\"Edit\":\"S\u1eeda\",\"Edit Calculation Parameters\":\"Ch\u1ec9nh s\u1eeda Th\xf4ng s\u1ed1 T\xednh to\xe1n\",\"Edit Counter\":\"Ch\u1ec9nh s\u1eeda B\u1ed9 \u0111\u1ebfm\",\"Edit Location\":\"S\u1eeda V\u1ecb tr\xed\",\"Edit Reminder\":\"S\u1eeda L\u1eddi nh\u1eafc\",\"Edit Silent Mode\":\"Edit Silent Mode\",\"Egyptian General Survey Authority\":\"T\u1ed5ng c\u1ee5c Kh\u1ea3o s\xe1t Ai C\u1eadp\",\"Enabled\":\"\u0110\xe3 b\u1eadt\",\"End after prayer (minutes)\":\"End after prayer (minutes)\",\"Error getting clipboard data\":\"L\u1ed7i khi nh\u1eadn d\u1eef li\u1ec7u khay nh\u1edb t\u1ea1m\",\"Error in loading countries\":\"L\u1ed7i khi t\u1ea3i qu\u1ed1c gia\",\"Error while downloading audio\":\"L\u1ed7i khi t\u1ea3i \xe2m b\xe1o\",\"Error while getting coordinates\":\"L\u1ed7i khi l\u1ea5y t\u1ecda \u0111\u1ed9\",\"Error: failed to open file\":\"L\u1ed7i: kh\xf4ng m\u1edf \u0111\u01b0\u1ee3c t\u1ec7p\",\"Ethiopic\":\"L\u1ecbch \xca-ti-\xf4-pi-a\",\"Export app data\":\"Xu\u1ea5t d\u1eef li\u1ec7u \u1ee9ng d\u1ee5ng\",\"Export data\":\"Xu\u1ea5t d\u1eef li\u1ec7u\",\"Fajr Angle\":\"G\xf3c Fajr\",\"Find My Location\":\"T\xecm V\u1ecb tr\xed c\u1ee7a T\xf4i\",\"Fix Common Problems\":\"Kh\u1eafc ph\u1ee5c S\u1ef1 c\u1ed1 Th\u01b0\u1eddng g\u1eb7p\",\"France angle 15\":\"Ph\xe1p g\xf3c 15\",\"France angle 18\":\"Ph\xe1p g\xf3c 18\",\"Friday\":\"Th\u1ee9 6\",\"General (default)\":\"Chung (m\u1eb7c \u0111\u1ecbnh)\",\"Getting coordinates\":\"L\u1ea5y t\u1ecda \u0111\u1ed9\",\"Got it\":\"Hi\u1ec3u r\u1ed3i\",\"Gregorian\":\"D\u01b0\u01a1ng l\u1ecbch\",\"Gulf region\":\"V\xf9ng V\u1ecbnh\",\"Hanafi\":\"Hanafi\",\"Hidden?\":\"\u1ea8n?\",\"Hide Prayer Times\":\"\u1ea8n L\u1ea7n C\u1ea7u nguy\u1ec7n\",\"Hide times you don't need\":\"\u1ea8n l\u1ea7n b\u1ea1n kh\xf4ng c\u1ea7n\",\"High\":\"Cao\",\"High Latitude\":\"V\u0129 \u0111\u1ed9 cao\",\"Highlight current prayer\":\"T\xf4 s\xe1ng gi\u1edd c\u1ea7u nguy\u1ec7n hi\u1ec7n t\u1ea1i\",\"Home\":\"Trang ch\u1ee7\",\"Homescreen and notification Widgets\":\"M\xe0n h\xecnh ch\xednh v\xe0 Ti\u1ec7n \xcdch th\xf4ng b\xe1o\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Tuy nhi\xean, khi d\xf9ng c\xe1c d\u1ecbch v\u1ee5 tr\u1ef1c tuy\u1ebfn, ch\u1eb3ng h\u1ea1n nh\u01b0 b\u1ea3n \u0111\u1ed3 Qibla, \u1ee9ng d\u1ee5ng c\xf3 th\u1ec3 truy\u1ec1n d\u1eef li\u1ec7u c\u1ea7n thi\u1ebft v\xe0 n\xf3 c\xf3 th\u1ec3 nh\u1eadn d\u1ea1ng b\u1ea1n ho\u1eb7c kh\xf4ng. H\xe3y ghi nh\u1edb \u0111i\u1ec1u n\xe0y khi s\u1eed d\u1ee5ng \u1ee9ng d\u1ee5ng.\",\"I Understand\":\"T\xf4i hi\u1ec3u\",\"IMPORTANT_CHANNEL_ID\":\"Quan tr\u1ecdng\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"N\u1ebfu b\u1eadt, khi m\u1ed9t th\xf4ng b\xe1o \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb, n\xf3 s\u1ebd ch\u1ee9a th\xf4ng tin cho l\u1ea7n c\u1ea7u nguy\u1ec7n ti\u1ebfp theo\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"N\u1ebfu b\u1ea1n \u0111\xe3 k\xedch ho\u1ea1t \u201cSao l\u01b0u & Kh\xf4i ph\u1ee5c\u201d trong c\xe0i \u0111\u1eb7t \u0111i\u1ec7n tho\u1ea1i c\u1ee7a m\xecnh (C\xe0i \u0111\u1eb7t / Sao l\u01b0u & Kh\xf4i ph\u1ee5c / Sao l\u01b0u d\u1eef li\u1ec7u c\u1ee7a t\xf4i), b\u1ea1n n\xean l\u01b0u \xfd r\u1eb1ng ch\xednh Android (kh\xf4ng ph\u1ea3i Al-Azan) s\u1ebd l\u01b0u \u0111\u1ecbnh k\u1ef3 m\u1ed9t b\u1ea3n sao d\u1eef li\u1ec7u \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n tr\xean m\xe1y ch\u1ee7 c\u1ee7a Google. \u0110i\u1ec1u n\xe0y cho ph\xe9p Android kh\xf4i ph\u1ee5c d\u1eef li\u1ec7u c\u1ee7a b\u1ea1n n\u1ebfu thi\u1ebft b\u1ecb c\u1ee7a b\u1ea1n b\u1ecb h\u1ecfng ho\u1eb7c b\u1ea1n mua m\u1ed9t thi\u1ebft b\u1ecb m\u1edbi. C\xe1c nh\xe0 ph\xe1t tri\u1ec3n c\u1ee7a Azan kh\xf4ng c\xf3 quy\u1ec1n truy c\u1eadp d\u1eef li\u1ec7u n\xe0y.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"N\u1ebfu b\u1ea1n v\u1eabn g\u1eb7p s\u1ef1 c\u1ed1 d\u1eebng \u1ee9ng d\u1ee5ng sau m\u1ed9t th\u1eddi gian, vui l\xf2ng truy c\u1eadp dontkillmyapp.com \u0111\u1ec3 bi\u1ebft th\xeam gi\u1ea3i ph\xe1p.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"N\u1ebfu b\u1ea1n mu\u1ed1n \u0111\u1ea3m b\u1ea3o \u1ee9ng d\u1ee5ng c\xf3 th\u1ec3 ho\u1ea1t \u0111\u1ed9ng \u1ed5n \u0111\u1ecbnh, B\u1ea1n ph\u1ea3i t\u1eaft t\xednh n\u0103ng t\u1ed1i \u01b0u h\xf3a pin cho \u1ee9ng d\u1ee5ng n\xe0y. B\u1ea1n c\xf3 th\u1ec3 m\u1edf c\xe1c c\xe0i \u0111\u1eb7t li\xean quan b\u1eb1ng c\xe1ch s\u1eed d\u1ee5ng n\xfat b\xean d\u01b0\u1edbi.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"N\u1ebfu thi\u1ebft b\u1ecb c\u1ee7a b\u1ea1n c\xf3 t\xednh n\u0103ng s\u1ea1c th\xedch \u1ee9ng, ch\u1eb3ng h\u1ea1n nh\u01b0 Google Pixel v\xe0 b\u1ea1n kh\xf4ng mu\u1ed1n Azan ho\u1eb7c L\u1eddi nh\u1eafc b\u1ecb nh\u1eadn d\u1ea1ng l\xe0 b\xe1o th\u1ee9c, th\xec b\u1ea1n c\xf3 th\u1ec3 b\u1eadt t\xf9y ch\u1ecdn n\xe0y.\",\"Import\":\"Nh\u1eadp d\u1eef li\u1ec7u\",\"Import app data\":\"Nh\u1eadp d\u1eef li\u1ec7u \u1ee9ng d\u1ee5ng\",\"Import successful\":\"Nh\u1eadp th\xe0nh c\xf4ng\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"Ngo\xe0i 5 l\u1ea7n c\u1ea7u nguy\u1ec7n h\xe0ng ng\xe0y, n\xf3 c\xf2n c\xf3 c\xe0i \u0111\u1eb7t cho c\xe1c l\u1ea7n c\u1ea7u nguy\u1ec7n l\xfac M\u1eb7t tr\u1eddi m\u1ecdc, M\u1eb7t tr\u1eddi l\u1eb7n, N\u1eeda \u0110\xeam v\xe0 Ban \u0110\xeam (Tahajjud)\",\"Increment\":\"T\u0103ng\",\"Info\":\"Th\xf4ng tin\",\"Internet connection\":\"K\u1ebft n\u1ed1i Internet\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"K\u1ebft n\u1ed1i Internet l\xe0 c\u1ea7n thi\u1ebft \u0111\u1ec3 b\u1ea3n \u0111\u1ed3 qibla ho\u1ea1t \u0111\u1ed9ng. Vui l\xf2ng b\u1eadt wifi ho\u1eb7c d\u1eef li\u1ec7u di \u0111\u1ed9ng c\u1ee7a b\u1ea1n v\xe0 th\u1eed l\u1ea1i.\",\"Iran\":\"Iran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0110\u01b0\u1ee3c b\u1ea3n \u0111\u1ecba h\xf3a b\u1eb1ng ti\u1ebfng Anh, ti\u1ebfng Ba T\u01b0, ti\u1ebfng \u1ea2 R\u1eadp, ti\u1ebfng Th\u1ed5 Nh\u0129 K\u1ef3, ti\u1ebfng Indonesia, ti\u1ebfng Ph\xe1p, ti\u1ebfng Urdu, ti\u1ebfng Hindi, ti\u1ebfng \u0110\u1ee9c, ti\u1ebfng Bosnia, ti\u1ebfng Vi\u1ec7t, ti\u1ebfng Bangla\",\"Isha Angle\":\"G\xf3c Isha\",\"Isha Interval\":\"Khung Isha\",\"Islamic\":\"H\u1ed3i gi\xe1o\",\"Islamic (Saudi Arabia sighting)\":\"H\u1ed3i gi\xe1o (Ng\u1eafm t\u1ea1i \u1ea2 R\u1eadp Saudi)\",\"Islamic (Umm al-Qura)\":\"H\u1ed3i gi\xe1o (Umm al-Qura)\",\"Islamic (civil)\":\"H\u1ed3i gi\xe1o (d\xe2n s\u1ef1)\",\"Islamic (tabular)\":\"H\u1ed3i gi\xe1o (b\u1ea3ng)\",\"Islamic Society of North America (ISNA)\":\"Hi\u1ec7p h\u1ed9i H\u1ed3i gi\xe1o B\u1eafc M\u1ef9 (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"C\xf3 v\u1ebb nh\u01b0 b\u1ea1n \u0111\xe3 nh\u1eadp m\u1ed9t b\u1ea3n sao l\u01b0u, \u0111\u1eebng qu\xean t\u1eaft t\u1ed1i \u01b0u h\xf3a pin cho \u1ee9ng d\u1ee5ng n\xe0y\",\"Just now\":\"V\u1eeba n\xe3y\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Kementrian Agama Republik Indonesia (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\",\"Kuwait\":\"C\xf4-o\xe9t\",\"Label\":\"T\xean\",\"Language\":\"Ng\xf4n ng\u1eef\",\"Latitude\":\"V\u0129 \u0111\u1ed9\",\"Latitude is invalid\":\"V\u0129 \u0111\u1ed9 kh\xf4ng h\u1ee3p l\u1ec7\",\"License\":\"Gi\u1ea5y ph\xe9p\",\"Light\":\"S\xe1ng\",\"Light and Dark theme\":\"Ch\u1ee7 \u0111\u1ec1 S\xe1ng/T\u1ed1i\",\"Light/Dark theme\":\"Ch\u1ee7 \u0111\u1ec1 S\xe1ng/T\u1ed1i\",\"List is empty\":\"Danh s\xe1ch tr\u1ed1ng\",\"Loading\":\"\u0110ang t\u1ea3i\",\"Location\":\"V\u1ecb tr\xed\",\"Location settings\":\"C\xe0i \u0111\u1eb7t v\u1ecb tr\xed\",\"Longitude\":\"Kinh \u0111\u1ed9\",\"Longitude is invalid\":\"Kinh \u0111\u1ed9 kh\xf4ng h\u1ee3p l\u1ec7\",\"Low\":\"Th\u1ea5p\",\"Lunar Calendar\":\"\xc2m l\u1ecbch\",\"Lunar Calendar Language\":\"Ng\xf4n ng\u1eef \xe2m l\u1ecbch\",\"Maghrib Angle\":\"G\xf3c Maghrib\",\"Make a Copy\":\"T\u1ea1o B\u1ea3n sao\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Nhi\u1ec1u t\xf9y ch\u1ecdn \u0111\u1ec3 t\xednh to\xe1n Azan (\u0627\u0630\u0627\u0646)\",\"Medium\":\"Trung b\xecnh\",\"Middle of the Night\":\"N\u1eeda \u0111\xeam\",\"Midnight Method\":\"Ph\u01b0\u01a1ng ph\xe1p n\u1eeda \u0111\xeam\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"B\u1ed9 T\xf4n gi\xe1o v\xe0 Wakfs, Algeria\",\"Ministry of Religious Affairs of Tunisia\":\"B\u1ed9 T\xf4n gi\xe1o Tunisia\",\"Mobile Data\":\"D\u1eef li\u1ec7u di \u0111\u1ed9ng\",\"Modified\":\"\u0111\xe3 s\u1eeda \u0111\u1ed5i\",\"Monday\":\"Th\u1ee9 2\",\"Moonsighting Committee\":\"\u1ee6y ban Ng\u1eafm tr\u0103ng\",\"Muslim World League\":\"Li\xean \u0111o\xe0n H\u1ed3i gi\xe1o Th\u1ebf gi\u1edbi\",\"Name\":\"T\xean\",\"Nearest\":\"G\u1ea7n nh\u1ea5t\",\"New Counter\":\"B\u1ed9 \u0111\u1ebfm m\u1edbi\",\"New Location\":\"V\u1ecb tr\xed m\u1edbi\",\"New Reminder\":\"L\u1eddi nh\u1eafc M\u1edbi\",\"New Silent Mode\":\"New Silent Mode\",\"Next\":\"Ti\u1ebfp\",\"Next Day\":\"Ng\xe0y Sau\",\"Next Month\":\"Th\xe1ng Sau\",\"No\":\"Kh\xf4ng\",\"No Data\":\"Kh\xf4ng c\xf3 d\u1eef li\u1ec7u\",\"No Results\":\"Kh\xf4ng k\u1ebft qu\u1ea3\",\"None\":\"Kh\xf4ng l\xe0m tr\xf2n\",\"None (Automatic)\":\"Kh\xf4ng c\xf3 (T\u1ef1 \u0111\u1ed9ng)\",\"Normal mode restored\":\"Normal mode restored\",\"Not now\":\"Kh\xf4ng ph\u1ea3i b\xe2y gi\u1edd\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"L\u01b0u \xfd r\u1eb1ng do l\u1ed7i ph\u1ea7n m\u1ec1m v\xe0 ph\u1ea7n c\u1ee9ng, h\u01b0\u1edbng Qibla do \u1ee9ng d\u1ee5ng n\xe0y hi\u1ec3n th\u1ecb, \u0111\u1eb7c bi\u1ec7t l\xe0 \u1edf ch\u1ebf \u0111\u1ed9 la b\xe0n, c\xf3 th\u1ec3 b\u1ecb sai.\",\"Notification\":\"Th\xf4ng b\xe1o\",\"Notification & Sound\":\"Th\xf4ng b\xe1o & \xc2m b\xe1o\",\"Notifications Permission\":\"Quy\u1ec1n th\xf4ng b\xe1o\",\"Numbering system\":\"H\u1ec7 th\u1ed1ng s\u1ed1 \u0111\u1ebfm\",\"Off\":\"T\u1eaft\",\"Okay\":\"OK\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"T\u1eeb Android 12 tr\u1edf l\xean, \u1ee9ng d\u1ee5ng c\u0169ng c\u1ea7n c\xf3 quy\u1ec1n b\xe1o th\u1ee9c \u0111\u1ec3 ho\u1ea1t \u0111\u1ed9ng b\xecnh th\u01b0\u1eddng, v\xec v\u1eady b\u1ea1n c\u0169ng ph\u1ea3i cho ph\xe9p \u0111i\u1ec1u n\xe0y.\",\"Once\":\"M\u1ed9t l\u1ea7n\",\"One-Seventh of the Night\":\"M\u1ed9t ph\u1ea7n b\u1ea3y \u0111\xeam\",\"Only once?\":\"Ch\u1ec9 m\u1ed9t l\u1ea7n?\",\"Only six items can be shown at the same time\":\"Ch\u1ec9 c\xf3 s\xe1u m\u1ee5c c\xf3 th\u1ec3 \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb c\xf9ng m\u1ed9t l\xfac\",\"Open Battery Optimization Settings\":\"M\u1edf c\xe0i \u0111\u1eb7t T\u1ed1i \u01b0u h\xf3a Pin\",\"Open Power Manager Settings\":\"M\u1edf c\xe0i \u0111\u1eb7t Tr\xecnh qu\u1ea3n l\xfd Pin\",\"Open source repository\":\"Kho m\xe3 ngu\u1ed3n m\u1edf\",\"Open-source\":\"M\xe3 ngu\u1ed3n m\u1edf\",\"Options\":\"T\xf9y ch\u1ecdn\",\"Or if you have a backup, you can import it\":\"Ho\u1eb7c n\u1ebfu b\u1ea1n c\xf3 m\u1ed9t b\u1ea3n sao l\u01b0u, b\u1ea1n c\xf3 th\u1ec3 nh\u1eadp n\xf3\",\"Orientation Lock: Landscape\":\"Kh\xf3a xoay: Ngang\",\"Orientation Lock: Portrait\":\"Kh\xf3a xoay: D\u1ecdc\",\"Orientation: Unlocked\":\"\u0110\u1ecbnh h\u01b0\u1edbng: T\u1ef1 xoay\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"C\xe1c thi\u1ebft b\u1ecb t\u1eeb t\xednh kh\xe1c c\xf3 th\u1ec3 g\xe2y nhi\u1ec5u la b\xe0n \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n v\xe0 la b\xe0n c\u1ee7a b\u1ea1n c\xf3 th\u1ec3 c\u1ea7n hi\u1ec7u ch\u1ec9nh.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Silent Mode\",\"PRE_ADHAN_CHANNEL_NAME\":\"Azan s\u1eafp t\u1edbi\",\"PRE_REMINDER_CHANNEL_NAME\":\"L\u1eddi nh\u1eafc s\u1eafp t\u1edbi\",\"Pakistan\":\"Pakistan\",\"Paste\":\"D\xe1n\",\"Persian\":\"Ba T\u01b0\",\"Phone State Permission\":\"Quy\u1ec1n Tr\u1ea1ng th\xe1i Thi\u1ebft b\u1ecb\",\"Play\":\"Ph\xe1t\",\"Please enable location service\":\"Vui l\xf2ng b\u1eadt d\u1ecbch v\u1ee5 \u0111\u1ecbnh v\u1ecb\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"L\u01b0u \xfd r\u1eb1ng vi\u1ec7c b\u1eadt t\xf9y ch\u1ecdn n\xe0y c\xf3 th\u1ec3 khi\u1ebfn Azan v\xe0 L\u1eddi nh\u1eafc b\u1ecb b\xe1o tr\u1ec5 ho\u1eb7c kh\xf4ng b\xe1o trong m\u1ed9t s\u1ed1 tr\u01b0\u1eddng h\u1ee3p. K\xedch ho\u1ea1t t\xednh n\u0103ng n\xe0y m\u1ed9t c\xe1ch th\u1eadn tr\u1ecdng.\",\"Polar Resolution\":\"Ph\xe2n gi\u1ea3i v\xf9ng c\u1ef1c\",\"Power Manager\":\"Qu\u1ea3n l\xfd Pin\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"Gi\u1edd c\u1ea7u nguy\u1ec7n\",\"Prayer list\":\"Danh s\xe1ch c\u1ea7u nguy\u1ec7n\",\"Press to search\":\"Nh\u1ea5n \u0111\u1ec3 t\xecm\",\"Press to select a method\":\"Nh\u1ea5n \u0111\u1ec3 ch\u1ecdn m\u1ed9t ph\u01b0\u01a1ng ph\xe1p\",\"Prev Day\":\"Ng\xe0y Tr\u01b0\u1edbc\",\"Prev Month\":\"Th\xe1ng Tr\u01b0\u1edbc\",\"Privacy Policy\":\"Ch\xednh s\xe1ch b\u1ea3o m\u1eadt\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"\u1ee8ng d\u1ee5ng Azan (gi\u1edd l\u1ec5 nguy\u1ec7n \u0111\u1ea1o H\u1ed3i) v\xe0 qibla ngu\u1ed3n m\u1edf \u01b0u ti\xean quy\u1ec1n ri\xeang t\u01b0\",\"Qada counter\":\"B\u1ed9 \u0111\u1ebfm Qada\",\"Qatar\":\"Ca-ta\",\"Qibla\":\"Qibla\",\"Qibla finder\":\"T\xecm Qibla\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"C\xf4ng c\u1ee5 t\xecm Qibla c\u1ea7n d\u1ecbch v\u1ee5 \u0111\u1ecbnh v\u1ecb. N\u1ebfu kh\xf4ng b\u1eadt, v\u1ecb tr\xed t\u1eeb c\xe0i \u0111\u1eb7t c\u1ee7a \u1ee9ng d\u1ee5ng s\u1ebd \u0111\u01b0\u1ee3c d\xf9ng.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"B\u1ea3n \u0111\u1ed3 Qibla hi\u1ec7n kh\xf4ng kh\u1ea3 d\u1ee5ng trong c\xe1c b\u1ea3n d\u1ef1ng F-Droid. N\xf3 c\xf3 th\u1ec3 s\u1ebd kh\u1ea3 d\u1ee5ng \u1edf c\xe1c b\u1ea3n c\u1eadp nh\u1eadt t\u01b0\u01a1ng lai.\",\"REMINDER_CHANNEL_NAME\":\"L\u1eddi nh\u1eafc\",\"Ramadan is ending,\":\"Ramadan s\u1eafp k\u1ebft th\xfac,\",\"Ramadan is near,\":\"L\u1ec5 Ramadan \u0111\xe3 g\u1ea7n k\u1ec1,\",\"Remaining till\":\"\u0110\u1ebfm ng\u01b0\u1ee3c t\u1edbi\",\"Remind me next year\":\"Nh\u1eafc t\xf4i n\u0103m sau\",\"Reminder\":\"L\u1eddi nh\u1eafc\",\"Repeat\":\"L\u1eb7p l\u1ea1i\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"C\xe0i \u0111\u1eb7t b\u1eaft bu\u1ed9c ch\u01b0a ho\xe0n t\u1ea5t. \u0110\u1ec3 \u1ee9ng d\u1ee5ng hi\u1ec3n th\u1ecb th\u1eddi gian c\u1ea7u nguy\u1ec7n, B\u1ea1n ph\u1ea3i c\u1ea5u h\xecnh n\xf3 sau trong c\xe0i \u0111\u1eb7t.\",\"Rounding Method\":\"Ph\u01b0\u01a1ng ph\xe1p l\xe0m tr\xf2n\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"C\xe1c thi\u1ebft b\u1ecb Samsung c\xf3 Tr\xecnh qu\u1ea3n l\xfd ngu\u1ed3n t\xf9y ch\u1ec9nh c\u1ee7a ri\xeang ch\xfang \u0111\u01b0\u1ee3c g\u1ecdi l\xe0 \\\"Ch\u0103m s\xf3c thi\u1ebft b\u1ecb\\\". Sau khi nh\u1ea5n n\xfat b\xean d\u01b0\u1edbi, B\u1ea1n s\u1ebd \u0111\u01b0\u1ee3c \u0111i\u1ec1u h\u01b0\u1edbng \u0111\u1ebfn menu Pin c\u1ee7a Ch\u0103m s\xf3c thi\u1ebft b\u1ecb. Trong menu Pin, h\xe3y nh\u1ea5n v\xe0o \\\"Qu\u1ea3n l\xfd ngu\u1ed3n \u1ee9ng d\u1ee5ng\\\", sau \u0111\xf3 nh\u1ea5n v\xe0o \\\"\u1ee8ng d\u1ee5ng s\u1ebd kh\xf4ng chuy\u1ec3n sang ch\u1ebf \u0111\u1ed9 ng\u1ee7\\\" v\xe0 th\xeam \u1ee9ng d\u1ee5ng n\xe0y v\xe0o danh s\xe1ch.\",\"Saturday\":\"Th\u1ee9 7\",\"Saudi Arabia\":\"\u1ea2 R\u1eadp Saudi\",\"Search\":\"T\xecm ki\u1ebfm\",\"Secondary Calendar\":\"L\u1ecbch ph\u1ee5\",\"See favorite locations\":\"Xem c\xe1c \u0111\u1ecba \u0111i\u1ec3m y\xeau th\xedch\",\"Select as Fajr Adhan\":\"Ch\u1ecdn l\xe0m Fajr Azan\",\"Select different Adhan audio for Fajr namaz\":\"Ch\u1ecdn \xe2m b\xe1o Azan kh\xe1c nhau cho Fajr namaz\",\"Selected\":\"\u0110\xe3 ch\u1ecdn\",\"Selected as adhan\":\"\u0110\xe3 ch\u1ecdn l\xe0m azan\",\"Selected as fajr adhan\":\"\u0110\xe3 ch\u1ecdn l\xe0m fajr azan\",\"Selecting a name is required\":\"Ch\u1ecdn t\xean l\xe0 b\u1eaft bu\u1ed9c\",\"Set custom Adhan audio\":\"\u0110\u1eb7t \xe2m b\xe1o Azan t\xf9y ch\u1ec9nh\",\"Set reminders before or after a prayer time\":\"\u0110\u1eb7t l\u1eddi nh\u1eafc tr\u01b0\u1edbc ho\u1eb7c sau gi\u1edd c\u1ea7u nguy\u1ec7n\",\"Shafaq\":\"Shafaq\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"Shafaq \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng b\u1edfi ph\u01b0\u01a1ng ph\xe1p U\u1ef7 ban Ng\u1eafm tr\u0103ng\\n\u0111\u1ec3 x\xe1c \u0111\u1ecbnh lo\u1ea1i ch\u1ea1ng v\u1ea1ng s\u1ebd s\u1eed d\u1ee5ng \u0111\u1ec3\\nx\xe1c \u0111\u1ecbnh th\u1eddi gian cho Isha\",\"Shafi, Maliki, Hanbali (Default)\":\"Shafi, Maliki, Hanbali (M\u1eb7c \u0111\u1ecbnh)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"Shia Ithna Ashari, Vi\u1ec7n Leva, Qum\",\"Shia, Institute of Geophysics, University of Tehran\":\"Shia, Vi\u1ec7n \u0110\u1ecba v\u1eadt l\xfd, \u0110\u1ea1i h\u1ecdc Tehran\",\"Should app highlight current prayer instead of next prayer?\":\"\u1ee8ng d\u1ee5ng c\xf3 n\xean t\xf4 s\xe1ng gi\u1edd c\u1ea7u nguy\u1ec7n hi\u1ec7n t\u1ea1i thay v\xec gi\u1edd c\u1ea7u nguy\u1ec7n ti\u1ebfp theo kh\xf4ng?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\u1ee8ng d\u1ee5ng v\u1eabn c\u1ee9 ph\xe1t azan khi ch\u1ebf \u0111\u1ed9 \\\"Kh\xf4ng l\xe0m phi\u1ec1n\\\" \u0111\u01b0\u1ee3c k\xedch ho\u1ea1t?\",\"Should app stop playing adhan when the volume button is pressed?\":\"\u1ee8ng d\u1ee5ng c\xf3 n\xean d\u1eebng ph\xe1t Azan khi nh\u1ea5n n\xfat \xe2m l\u01b0\u1ee3ng kh\xf4ng?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"\u0110i\u1ec7n tho\u1ea1i c\xf3 n\xean rung khi azan ho\u1eb7c l\u1eddi nh\u1eafc b\u1eaft \u0111\u1ea7u ph\xe1t kh\xf4ng?\",\"Show Adhan Options\":\"T\xf9y ch\u1ecdn Hi\u1ec3n th\u1ecb Azan\",\"Show Today\":\"H\xf4m nay\",\"Show countdown?\":\"Hi\u1ec7n \u0111\u1ebfm ng\u01b0\u1ee3c?\",\"Show current\":\"Hi\u1ec3n th\u1ecb hi\u1ec7n t\u1ea1i\",\"Show me\":\"Cho t\xf4i xem\",\"Show next in notification?\":\"Hi\u1ec7n \\\"ti\u1ebfp\\\" trong th\xf4ng b\xe1o?\",\"Show notification widget?\":\"Hi\u1ec7n ti\u1ec7n \xedch th\xf4ng b\xe1o?\",\"Show settings\":\"Hi\u1ec7n c\xe0i \u0111\u1eb7t\",\"Show upcoming alarm notification?\":\"Hi\u1ec7n th\xf4ng b\xe1o b\xe1o th\u1ee9c s\u1eafp t\u1edbi?\",\"Silent\":\"Im l\u1eb7ng\",\"Silent Mode Ended\":\"Silent Mode Ended\",\"Silent Mode Name\":\"Silent Mode Name\",\"Silent Mode Started\":\"Silent Mode Started\",\"Silent mode activated\":\"Silent mode activated\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"V\xec ch\xfang t\xf4i kh\xf4ng s\u1eed d\u1ee5ng b\u1ea5t k\u1ef3 lo\u1ea1i tr\xecnh theo d\xf5i ho\u1eb7c ph\xe2n t\xedch s\u1ef1 c\u1ed1 n\xe0o, vui l\xf2ng b\xe1o c\xe1o b\u1ea5t k\u1ef3 s\u1ef1 c\u1ed1 ho\u1eb7c \u0111\u1ec1 xu\u1ea5t n\xe0o b\u1ea1n c\xf3 tr\xean repo github c\u1ee7a ch\xfang t\xf4i\",\"Singapore\":\"Singapore\",\"Skip\":\"B\u1ecf qua\",\"Software License\":\"B\u1ea3n quy\u1ec1n ph\u1ea7n m\u1ec1m\",\"Solar Hijri\":\"L\u1ecbch Hijri m\u1eb7t tr\u1eddi\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"M\u1ed9t s\u1ed1 thi\u1ebft b\u1ecb c\u1ea7n c\xe0i \u0111\u1eb7t b\u1ed5 sung b\xean trong Tr\xecnh qu\u1ea3n l\xfd ngu\u1ed3n\\n\u0111\u1ec3 ng\u0103n \u1ee9ng d\u1ee5ng b\u1ecb t\u1eaft trong n\u1ec1n. N\u1ebfu v\u1eady,\\nh\xe3y t\u1eaft m\u1ecdi t\xf9y ch\u1ecdn ti\u1ebft ki\u1ec7m n\u0103ng l\u01b0\u1ee3ng cho \u1ee9ng d\u1ee5ng n\xe0y.\",\"Sound\":\"\xc2m b\xe1o\",\"Spiritual Administration of Muslims of Russia\":\"C\u01a1 quan Qu\u1ea3n l\xfd Tinh th\u1ea7n c\u1ee7a ng\u01b0\u1eddi H\u1ed3i gi\xe1o \u1edf Nga\",\"Start before prayer (minutes)\":\"Start before prayer (minutes)\",\"Status\":\"Tr\u1ea1ng th\xe1i\",\"Stop\":\"D\u1eebng\",\"Sunday\":\"C.N\",\"Sunset to Fajr (Default)\":\"Ho\xe0ng h\xf4n \u0111\u1ebfn Fajr (M\u1eb7c \u0111\u1ecbnh)\",\"Sunset to Sunrise\":\"Ho\xe0ng h\xf4n \u0111\u1ebfn m\u1eb7t tr\u1eddi m\u1ecdc\",\"System Default\":\"Theo thi\u1ebft b\u1ecb\",\"Tahajjud time mentioned in the app is the last third of the night\":\"Gi\u1edd Tahajjud \u0111\u01b0\u1ee3c \u0111\u1ec1 c\u1eadp trong \u1ee9ng d\u1ee5ng l\xe0 m\u1ed9t ph\u1ea7n ba cu\u1ed1i c\xf9ng c\u1ee7a \u0111\xeam\",\"Thai Solar\":\"D\u01b0\u01a1ng l\u1ecbch Th\xe1i Lan\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"C\u1ea3m \u01a1n b\u1ea1n \u0111\xe3 ch\u1ecdn \u1ee9ng d\u1ee5ng n\xe0y! C\xf3 m\u1ed9t s\u1ed1 vi\u1ec7c b\u1ea1n c\u1ea7n l\xe0m tr\u01b0\u1edbc khi c\xf3 th\u1ec3 b\u1eaft \u0111\u1ea7u s\u1eed d\u1ee5ng \u1ee9ng d\u1ee5ng n\xe0y.\",\"The Gulf Region (Dubai)\":\"V\xf9ng V\u1ecbnh (Dubai)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"L\u1ecbch \xe2m c\u1ee7a \u1ee9ng d\u1ee5ng \u0111\u01b0\u1ee3c t\xednh to\xe1n tr\u01b0\u1edbc v\xe0 c\xf3 th\u1ec3 kh\xf4ng ch\xednh x\xe1c v\xec n\xf3 kh\xf4ng d\u1ef1a tr\xean c\xe1c l\u1ea7n ng\u1eafm m\u1eb7t tr\u0103ng. \u0110i\u1ec1u n\xe0y \u0111\u1eb7c bi\u1ec7t quan tr\u1ecdng c\u1ea7n l\u01b0u \xfd l\xfac b\u1eaft \u0111\u1ea7u v\xe0 k\u1ebft th\xfac th\xe1ng Ramadan.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"V\u0103n b\u1ea3n t\xecm th\u1ea5y tr\xean trang web n\xe0y v\xe0 trong \u1ee9ng d\u1ee5ng c\xf3 th\u1ec3 kh\xf4ng ch\xednh x\xe1c b\u1eb1ng c\xe1c ng\xf4n ng\u1eef kh\xe1c, v\xec v\u1eady trong m\u1ecdi tr\u01b0\u1eddng h\u1ee3p, ch\u1ec9 n\xean xem x\xe9t phi\xean b\u1ea3n ti\u1ebfng Anh.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Lo\u1ea1i l\u1ecbch \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb tr\xean \u0111\u1ea7u m\xe0n h\xecnh ch\xednh v\xe0 b\xean c\u1ea1nh l\u1ecbch \xe2m trong widget\",\"The type of lunar calendar shown in main screen and widgets\":\"Lo\u1ea1i \xe2m l\u1ecbch hi\u1ec3n th\u1ecb tr\xean m\xe0n h\xecnh ch\xednh v\xe0 ti\u1ec7n \xedch\",\"Theme Color\":\"M\xe0u Ch\u1ee7 \u0111\u1ec1\",\"Thursday\":\"Th\u1ee9 5\",\"Time\":\"L\u1ea7n\",\"Time condition\":\"\u0110i\u1ec1u ki\u1ec7n gi\u1edd\",\"Time format\":\"\u0110\u1ecbnh d\u1ea1ng gi\u1edd\",\"Time list\":\"Danh s\xe1ch gi\u1edd\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"\u0110\u1ec3 t\xednh to\xe1n Azan, ch\xfang t\xf4i c\u1ea7n v\u1ecb tr\xed c\u1ee7a b\u1ea1n. B\u1ea1n c\xf3 th\u1ec3 s\u1eed d\u1ee5ng n\xfat \\\"T\xecm V\u1ecb tr\xed c\u1ee7a T\xf4i\\\" ho\u1eb7c s\u1eed d\u1ee5ng t\xecm ki\u1ebfm qu\u1ed1c gia v\xe0 th\xe0nh ph\u1ed1/khu v\u1ef1c ho\u1eb7c nh\u1eadp t\u1ecda \u0111\u1ed9 th\u1ee7 c\xf4ng.\",\"To see notifications about adhan, we need your permission.\":\"\u0110\u1ec3 xem th\xf4ng b\xe1o v\u1ec1 Azan, ch\xfang t\xf4i c\u1ea7n s\u1ef1 cho ph\xe9p c\u1ee7a b\u1ea1n.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"\u0110\u1ec3 ng\u1eebng ph\xe1t Azan khi b\u1ea1n nghe g\u1ecdi, ch\xfang t\xf4i c\u1ea7n quy\u1ec1n \u0111\u1ecdc tr\u1ea1ng th\xe1i thi\u1ebft b\u1ecb. Kh\xf4ng cho ph\xe9p quy\u1ec1n n\xe0y ch\u1ec9 v\xf4 hi\u1ec7u h\xf3a t\xednh n\u0103ng n\xe0y.\",\"Tomorrow\":\"Ng\xe0y mai\",\"Tuesday\":\"Th\u1ee9 3\",\"Turn Left\":\"R\u1ebd tr\xe1i\",\"Turn Right\":\"R\u1ebd ph\u1ea3i\",\"Turn history off\":\"T\u1eaft l\u1ecbch s\u1eed\",\"Turn history on\":\"B\u1eadt l\u1ecbch s\u1eed\",\"Twilight Angle\":\"G\xf3c ch\u1ea1ng v\u1ea1ng\",\"Umm al-Qura University, Makkah\":\"\u0110\u1ea1i h\u1ecdc Umm al-Qura, Makkah\",\"Union Organization Islamic de France\":\"T\u1ed5 ch\u1ee9c Li\xean minh H\u1ed3i gi\xe1o de France\",\"University of Islamic Sciences, Karachi\":\"\u0110\u1ea1i h\u1ecdc Khoa h\u1ecdc H\u1ed3i gi\xe1o, Karachi\",\"Unknown Error\":\"L\u1ed7i kh\xf4ng r\xf5\",\"Unreliable\":\"Kh\xf4ng tin c\u1eady\",\"Unresolved (default)\":\"Kh\xf4ng d\xf9ng (m\u1eb7c \u0111\u1ecbnh)\",\"Unsupported\":\"Kh\xf4ng h\u1ed7 tr\u1ee3\",\"Up\":\"L\xean\",\"Upcoming alarm\":\"B\xe1o th\u1ee9c s\u1eafp t\u1edbi\",\"Updating widgets\":\"\u0110ang c\u1eadp nh\u1eadt ti\u1ec7n \xedch\",\"Use 24-Hour format\":\"D\xf9ng \u0111\u1ecbnh d\u1ea1ng 24 gi\u1edd\",\"Use Compass\":\"D\xf9ng La b\xe0n\",\"Use Map\":\"D\xf9ng B\u1ea3n \u0111\u1ed3\",\"Use a different alarm type?\":\"S\u1eed d\u1ee5ng m\u1ed9t lo\u1ea1i b\xe1o th\u1ee9c kh\xe1c?\",\"Use adaptive theme?\":\"S\u1eed d\u1ee5ng ch\u1ee7 \u0111\u1ec1 th\xedch \u1ee9ng?\",\"Use headphones when available?\":\"S\u1eed d\u1ee5ng tai nghe khi \u0111\u01b0\u1ee3c c\u1eafm?\",\"Using Coordinates\":\"D\xf9ng T\u1ecda \u0111\u1ed9\",\"Using GPS\":\"D\xf9ng GPS\",\"Using Search\":\"D\xf9ng T\xecm ki\u1ebfm\",\"Version\":\"Phi\xean b\u1ea3n\",\"Vibration Mode\":\"Ch\u1ebf \u0111\u1ed9 rung\",\"Vibration on call\":\"Vibration on call\",\"Volume button stops adhan\":\"N\xfat \xe2m l\u01b0\u1ee3ng d\u1eebng Azan\",\"WIDGET_CHANNEL_NAME\":\"Ti\u1ec7n \xedch\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"C\u1eadp nh\u1eadt Ti\u1ec7n \xedch\",\"We'll help you do them quickly.\":\"Ch\xfang t\xf4i s\u1ebd gi\xfap b\u1ea1n th\u1ef1c hi\u1ec7n nhanh th\xf4i.\",\"Wednesday\":\"Th\u1ee9 4\",\"Welcome\":\"Ch\xe0o m\u1eebng\",\"Western Arabic\":\"T\xe2y \u1ea2 R\u1eadp\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Khi k\xedch ho\u1ea1t, m\xe0n h\xecnh s\u1ebd v\u1eabn t\u1eaft khi azan ho\u1eb7c l\u1eddi nh\u1eafc k\xeau v\xe0 m\xe0n h\xecnh b\xe1o th\u1ee9c s\u1ebd kh\xf4ng hi\u1ec7n l\xean\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"N\u1ebfu b\u1eadt, khi s\u1eed d\u1ee5ng tai nghe, t\u1ea5t c\u1ea3 \xe2m b\xe1o s\u1ebd ch\u1ec9 ph\xe1t tr\xean tai nghe.\",\"Wifi\":\"Wifi\",\"Yes\":\"\u0110\u01b0\u1ee3c\",\"You are facing Kaaba\":\"B\u1ea1n \u0111ang h\u01b0\u1edbng v\u1ec1 Kaaba\",\"You are not facing Kaaba\":\"B\u1ea1n ch\u01b0a h\u01b0\u1edbng v\u1ec1 Kaaba\",\"You can access your device Power Manager using the button below.\":\"B\u1ea1n c\xf3 th\u1ec3 truy c\u1eadp Tr\xecnh qu\u1ea3n l\xfd Pin \u0111i\u1ec7n c\u1ee7a thi\u1ebft b\u1ecb b\u1eb1ng c\xe1ch \u1ea5n n\xfat b\xean d\u01b0\u1edbi.\",\"You can also paste coords from clipboard\":\"B\u1ea1n c\u0169ng c\xf3 th\u1ec3 d\xe1n to\u1ea1 \u0111\u1ed9 t\u1eeb khay nh\u1edb t\u1ea1m\",\"You can change the language used for lunar calendar\":\"B\u1ea1n c\xf3 th\u1ec3 thay \u0111\u1ed5i ng\xf4n ng\u1eef s\u1eed d\u1ee5ng cho \xe2m l\u1ecbch\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"B\u1ea1n c\xf3 th\u1ec3 thay \u0111\u1ed5i l\xfac m\xe0 th\xf4ng b\xe1o b\xe1o th\u1ee9c s\u1eafp t\u1edbi hi\u1ec7n tr\u01b0\u1edbc azan v\xe0 l\u1eddi nh\u1eafc\",\"You can choose to replace one of calendars with your current location\":\"B\u1ea1n c\xf3 th\u1ec3 ch\u1ecdn thay th\u1ebf m\u1ed9t trong c\xe1c l\u1ecbch b\u1eb1ng v\u1ecb tr\xed hi\u1ec7n t\u1ea1i c\u1ee7a m\xecnh\",\"You can hide prayer times you don't want to see in the main screen here:\":\"B\u1ea1n c\xf3 th\u1ec3 \u1ea9n l\u1ea7n c\u1ea7u nguy\u1ec7n kh\xf4ng mu\u1ed1n th\u1ea5y \u1edf m\xe0n h\xecnh ch\xednh t\u1ea1i \u0111\xe2y:\",\"You can hide prayer times you don't want to see in the widget here:\":\"B\u1ea1n c\xf3 th\u1ec3 \u1ea9n l\u1ea7n c\u1ea7u nguy\u1ec7n m\xe0 b\u1ea1n kh\xf4ng mu\u1ed1n th\u1ea5y trong ti\u1ec7n \xedch t\u1ea1i \u0111\xe2y:\",\"You can search for your location offline Or use GPS\":\"B\u1ea1n c\xf3 th\u1ec3 t\xecm v\u1ecb tr\xed c\u1ee7a m\xecnh ngo\u1ea1i tuy\u1ebfn Ho\u1eb7c d\xf9ng GPS\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"B\u1ea1n s\u1ebd nh\u1eadn \u0111\u01b0\u1ee3c m\u1ed9t b\u1ea3n sao Gi\u1ea5y ph\xe9p C\xf4ng c\u1ed9ng GNU Affero c\xf9ng v\u1edbi ch\u01b0\u01a1ng tr\xecnh n\xe0y. N\u1ebfu kh\xf4ng, h\xe3y xem https://www.gnu.org/licenses/.\",\"Your sounds\":\"\xc2m b\xe1o c\u1ee7a b\u1ea1n\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"T\u1ea5t c\u1ea3 b\u1ea3n quy\u1ec1n cho gi\u1ecdng azan thu\u1ed9c v\u1ec1 ch\u1ee7 s\u1edf h\u1eefu t\u01b0\u01a1ng \u1ee9ng. Xin g\u1eedi l\u1eddi c\u1ea3m \u01a1n \u0111\u1eb7c bi\u1ec7t \u0111\u1ebfn translation.io (lingui.js) v\xec nh\u1eefng d\u1ecbch v\u1ee5 tuy\u1ec7t v\u1eddi c\u1ee7a h\u1ecd. C\u1ea3m \u01a1n t\u1ea5t c\u1ea3 c\xe1c th\xe0nh vi\xean c\u1ed9ng \u0111\u1ed3ng m\xe3 ngu\u1ed3n m\u1edf, nh\u1eefng ng\u01b0\u1eddi \u0111\xe3 t\u1ea1o ra t\u1ea5t c\u1ea3 c\xe1c th\u01b0 vi\u1ec7n tuy\u1ec7t v\u1eddi n\xe0y gi\xfap \u1ee9ng d\u1ee5ng n\xe0y tr\u1edf n\xean kh\u1ea3 thi.\",\"about.credits.google\":\"H\u1ea7u h\u1ebft c\xe1c bi\u1ec3u t\u01b0\u1ee3ng trong \u1ee9ng d\u1ee5ng n\xe0y l\xe0 t\u1eeb Google material icons.\",\"about_settings\":\"V\u1ec1 \u1ee8ng d\u1ee5ng\",\"adjustment.hint\":\"S\u1ed1 ph\xfat s\u1ebd \u0111\u01b0\u1ee3c th\xeam v\xe0o th\u1eddi gian t\xednh to\xe1n\",\"after\":\"sau\",\"ago\":\"tr\u01b0\u1edbc\",\"asr.prayer\":\"Asr\",\"backup_settings\":\"Sao l\u01b0u\",\"before\":\"tr\u01b0\u1edbc\",\"calculation_adjustments_settings\":\"\u0110i\u1ec1u ch\u1ec9nh\",\"calculation_advanced_settings\":\"C\xe0i \u0111\u1eb7t T\xednh to\xe1n N\xe2ng cao\",\"calculation_settings\":\"Ph\xe9p t\xednh\",\"counter.fast\":\"Nh\u1ecbn Chay\",\"date.day\":\"ng\xe0y\",\"date.hour\":\"gi\u1edd\",\"date.minute\":\"ph\xfat\",\"date.second\":\"gi\xe2y\",\"dev_settings\":\"Nh\xe0 ph\xe1t tri\u1ec3n\",\"dhuhr.prayer\":\"Dhuhr\",\"display_settings\":\"Hi\u1ec3n th\u1ecb\",\"fajr.prayer\":\"Fajr\",\"favorite_location\":\"V\u1ecb tr\xed y\xeau th\xedch\",\"forces all numbers to be in the selected system\":\"Bu\u1ed9c t\u1ea5t c\u1ea3 c\xe1c s\u1ed1 ph\u1ea3i n\u1eb1m trong h\u1ec7 th\u1ed1ng \u0111\xe3 ch\u1ecdn\",\"from North\":\"t\u1eeb ph\xeda B\u1eafc\",\"from settings\":\"t\u1eeb c\xe0i \u0111\u1eb7t\",\"fullscreen_alarm\":\"\u0110ang ph\xe1t Azan\",\"hijri.adjustment.hint\":\"S\u1ed1 ng\xe0y s\u1ebd \u0111\u01b0\u1ee3c th\xeam v\xe0o \xe2m l\u1ecbch\",\"home\":\"Trang ch\u1ee7\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"N\u1ebfu b\u1eadt, m\u1ed9t th\xf4ng b\xe1o s\u1ebd \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb kho\u1ea3ng m\u1ed9t ti\u1ebfng tr\u01b0\u1edbc m\u1ed7i l\u1ea7n c\u1ea7u nguy\u1ec7n ho\u1eb7c l\u1eddi nh\u1eafc n\xe0o c\xf3 \xe2m b\xe1o\",\"intro\":\"gi\u1edbi thi\u1ec7u\",\"is prayer time hidden?\":\"gi\u1edd c\u1ea7u nguy\u1ec7n b\u1ecb \u1ea9n?\",\"isha.prayer\":\"Isha\",\"later\":\"sau \u0111\xf3\",\"location_settings\":\"V\u1ecb tr\xed\",\"maghrib.prayer\":\"Maghrib\",\"masjid_an_nabawi\":\"Masjid An Nabawi\",\"minutes\":\"ph\xfat\",\"moazen_zade\":\"Moazen Zade\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"Ch\u1ebf \u0111\u1ed9 xem th\xe1ng\",\"muezzin_settings\":\"Muezzin\",\"notification_advanced_settings\":\"C\xe0i \u0111\u1eb7t n\xe2ng cao\",\"notification_settings\":\"Th\xf4ng b\xe1o & \xc2m b\xe1o\",\"qada_counter\":\"B\u1ed9 \u0111\u1ebfm Qada\",\"qibla_compass\":\"La b\xe0n Qibla\",\"qibla_finder\":\"T\xecm Qibla\",\"qibla_map\":\"B\u1ea3n \u0111\u1ed3 Qibla\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"L\u1eddi nh\u1eafc\",\"settings\":\"C\xe0i \u0111\u1eb7t\",\"should notification widget be shown?\":\"ti\u1ec7n \xedch th\xf4ng b\xe1o c\xf3 n\xean \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb kh\xf4ng?\",\"should {prayerName} be hidden?\":[\"c\xf3 n\xean \u1ea9n \",[\"prayerName\"],\" kh\xf4ng?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"v\xec l\u1ecbch c\u1ee7a \u1ee9ng d\u1ee5ng \u0111\u01b0\u1ee3c t\xednh to\xe1n tr\u01b0\u1edbc v\xe0 kh\xf4ng d\u1ef1a tr\xean vi\u1ec7c nh\xecn th\u1ea5y m\u1eb7t tr\u0103ng n\xean n\xf3 c\xf3 th\u1ec3 hi\u1ec3n th\u1ecb ng\xe0y b\u1eaft \u0111\u1ea7u v\xe0 k\u1ebft th\xfac c\u1ee7a th\xe1ng Ramadan kh\xf4ng ch\xednh x\xe1c.\",\"sunnah.midnight\":\"N\u1eeda \u0111\xeam\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"M\u1ecdc (m\u1eb7t tr\u1eddi)\",\"sunset\":\"L\u1eb7n (m\u1eb7t tr\u1eddi)\",\"widget_settings\":\"C\xe0i \u0111\u1eb7t Ti\u1ec7n \xedch\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" ph\xfat sau \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" ph\xfat tr\u01b0\u1edbc \",[\"prayer\"]],\"{prayerName} notification will be shown\":[\"Th\xf4ng b\xe1o \",[\"prayerName\"],\" s\u1ebd \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb\"],\"{prayerName} sound will be played\":[\"\xc2m b\xe1o \",[\"prayerName\"],\" s\u1ebd \u0111\u01b0\u1ee3c ph\xe1t\"]}")}),636,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"\u09e7\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f\",\"15 min\":\"\u09e7\u09eb \u09ae\u09bf\u09a8\u09bf\u099f\",\"30 min\":\"\u09e9\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f\",\"30 minutes is added to Isha time during Ramadan in this method\":\"\u098f\u0987 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\u09a4\u09c7 \u09b0\u09ae\u099c\u09be\u09a8\u09c7 \u0987\u09b6\u09be\u09b0 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09e9\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f \u09af\u09cb\u0997 \u0995\u09b0\u09be \u09b9\u09af\u09bc\",\"5 min\":\"\u09eb \u09ae\u09bf\u09a8\u09bf\u099f\",\"60 min\":\"\u09ec\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f\",\"90 min\":\"\u09ef\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f\",\"ADHAN_CHANNEL_NAME\":\"\u0986\u09af\u09be\u09a8\",\"Abyad\":\"\u0986\u09ac\u0987\u09df\u09be\u09a6\",\"Accuracy\":\"\u09af\u09a5\u09be\u09af\u09a5\u09a4\u09be\",\"Ad-Free\":\"\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8-\u09ae\u09c1\u0995\u09cd\u09a4\",\"Adaptive Charging\":\"\u0985\u09cd\u09af\u09be\u09a1\u09be\u09aa\u09cd\u099f\u09bf\u09ad \u099a\u09be\u09b0\u09cd\u099c\u09bf\u0982\",\"Add\":\"\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add Custom Adhan\":\"\u0995\u09be\u09b8\u09cd\u099f\u09ae \u0986\u09af\u09be\u09a8 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add Custom Audio\":\"\u0995\u09be\u09b8\u09cd\u099f\u09ae \u0985\u09a1\u09bf\u0993 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add Reminder\":\"\u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add Silent Mode\":\"Add Silent Mode\",\"Add new counter\":\"\u09a8\u09a4\u09c1\u09a8 \u0995\u09be\u0989\u09a8\u09cd\u099f\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add new location\":\"\u09a8\u09a4\u09c1\u09a8 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Adhan\":\"\u0986\u09af\u09be\u09a8\",\"Adhan audio file is not downloaded yet\":\"\u0986\u09af\u09be\u09a8\u09c7\u09b0 \u0985\u09a1\u09bf\u0993 \u09ab\u09be\u0987\u09b2\u099f\u09bf \u098f\u0996\u09a8\u09cb \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf\",\"Adjustments\":\"\u09b8\u09ae\u09a8\u09cd\u09ac\u09af\u09bc\",\"Advanced\":\"\u0986\u09b0\u0993\",\"Advanced Calculation Settings\":\"\u0986\u09b0\u0993 \u0997\u09a3\u09a8\u09be\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"Advanced Settings\":\"\u09ac\u09bf\u09b6\u09c7\u09b7 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"Ahmer\":\"\u0986\u09b9\u09ae\u09be\u09b0\",\"Al-Azan\":\"\u0986\u09b2-\u0986\u09af\u09be\u09a8\",\"Al-Azan - Prayer Times\":\"\u0986\u09b2-\u0986\u09af\u09be\u09a8 - \u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u09b8\u09c2\u099a\u09bf\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"\u0986\u09b2-\u0986\u099c\u09be\u09a8 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u098f\u0987 \u0986\u09b6\u09be\u09af\u09bc \u09ac\u09bf\u09a4\u09b0\u09a3 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09af\u09c7 \u098f\u099f\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u09aa\u0995\u09be\u09b0\u09bf \u09b9\u09ac\u09c7, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0995\u09cb\u09a8\u09cb \u0993\u09af\u09bc\u09be\u09b0\u09c7\u09a8\u09cd\u099f\u09bf \u09a8\u09c7\u0987; \u098f\u09ae\u09a8\u0995\u09bf \u098f\u0995\u099f\u09bf \u09ac\u09bf\u09b6\u09c7\u09b7 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09af\u09bc\u09bf\u0995\u09a4\u09be \u09ac\u09be \u09ab\u09bf\u099f\u09a8\u09c7\u09b8\u09c7\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09a8\u09bf\u09b9\u09bf\u09a4 \u0995\u09cb\u09a8 \u0993\u09af\u09bc\u09be\u09b0\u09c7\u09a8\u09cd\u099f\u09bf \u09a8\u09c7\u0987\u0964 \u0986\u09b0\u09cb \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u099c\u09be\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af GNU Affero \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u09b2 \u09aa\u09be\u09ac\u09b2\u09bf\u0995 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8 \u09a6\u09c7\u0996\u09c1\u09a8\u0964\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"\u0986\u09b2-\u0986\u099c\u09be\u09a8 \u098f\u0995\u099f\u09bf \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u09b0 \u09b8\u09ab\u09cd\u099f\u0993\u09af\u09bc\u09cd\u09af\u09be\u09b0: \u0986\u09aa\u09a8\u09bf \u09ab\u09cd\u09b0\u09bf \u09b8\u09ab\u099f\u0993\u09af\u09bc\u09cd\u09af\u09be\u09b0 \u09ab\u09be\u0989\u09a8\u09cd\u09a1\u09c7\u09b6\u09a8 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09bf\u09a4 GNU Affero \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u09b2 \u09aa\u09be\u09ac\u09b2\u09bf\u0995 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8 (v3.0) \u098f\u09b0 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0\u09b0 \u0985\u09a7\u09c0\u09a8\u09c7 \u098f\u099f\u09bf\u0995\u09c7 \u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u09ac\u09bf\u09a4\u09b0\u09a3 \u098f\u09ac\u0982/\u0985\u09a5\u09ac\u09be \u09b8\u0982\u09b6\u09cb\u09a7\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\",\"Alarms Permission\":\"\u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae\u09c7\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"\u0986\u09b2-\u0986\u099c\u09be\u09a8\u09c7 \u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09a1\u09c7\u099f\u09be \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u0995\u09cb\u09a5\u09be\u0993 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09a8\u09be\u0964 \u0986\u09b2-\u0986\u099c\u09be\u09a8\u09c7\u09b0 \u09ac\u09bf\u0995\u09be\u09b6\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u098f\u099f\u09bf\u09a4\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u09a8\u09c7\u0987\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ad\u09be\u0997 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09a8\u09be. \u0986\u09b2-\u0986\u099c\u09be\u09a8 \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8 \u09b2\u09be\u0987\u09ac\u09cd\u09b0\u09c7\u09b0\u09bf \u09ac\u09be \u0995\u09cb\u09a8\u09cb 3\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09bf\u0982 (\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3) \u0995\u09cb\u09a1 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c7 \u09a8\u09be, \u09af\u09c7\u09ae\u09a8 Google Analytics \u09ac\u09be Facebook SDK\u0964\",\"An error occured while playing the current track\":\"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09be\u0989\u09a8\u09cd\u09a1 \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995\u099f\u09bf \u099a\u09be\u09b2\u09be\u09a8\u09cb\u09b0 \u09b8\u09ae\u09af\u09bc \u098f\u0995\u099f\u09bf \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b9\u09df\u09c7\u099b\u09c7\u0964\",\"App features\":\"\u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u09b8\u09ae\u09c1\u09b9\",\"Arabic\":\"\u0986\u09b0\u09ac\u09bf\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \\\"\",[\"0\"],\"\\\" \u09ae\u09c1\u099b\u09a4\u09c7 \u09ab\u09c7\u09b2\u09a4\u09c7 \u099a\u09be\u09a8?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u09af\u09c7 \\\"\",[\"itemName\"],\"\\\" \u0995\u09c7 \u09ae\u09c1\u099b\u09a4\u09c7 \u099a\u09be\u09a8?\"],\"Are you sure you want to delete this?\":\"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u098f\u099f\u09bf \u09ae\u09c1\u099b\u09a4\u09c7 \u099a\u09be\u09a8?\",\"Asr Calculation\":\"\u0986\u09b8\u09b0\u09c7\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac\",\"At least one prayer time must be shown\":\"\u0985\u09a8\u09cd\u09a4\u09a4 \u098f\u0995\u099f\u09bf \u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09a6\u09c7\u0996\u09be\u09a4\u09c7 \u09b9\u09ac\u09c7\",\"Attention\":\"\u09ae\u09a8\u09cb\u09af\u09cb\u0997\",\"Auto (Default)\":\"\u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc (\u09a1\u09bf\u09ab\u09b2\u09cd\u099f)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"\u09ac\u09be\u0987\u09aa\u09be\u09b8 \\\"\u09a1\u09c1 \u09a8\u099f \u09a1\u09bf\u09b8\u09cd\u099f\u09be\u09b0\u09cd\u09ac\\\"?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"\u0986\u09af\u09be\u09a8 \u0997\u09a3\u09a8\u09be\u09b0 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09ad\u09bf\u09a8\u09cd\u09a8 \u09ab\u09b2\u09be\u09ab\u09b2 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u0964 \u09b8\u09a0\u09bf\u0995 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a6\u09be\u09af\u09bc\u09bf\u09a4\u09cd\u09ac\u0964\",\"Calculation\":\"\u09b9\u09bf\u09b8\u09be\u09ac\",\"Calculation Method\":\"\u09b9\u09bf\u09b8\u09be\u09ac \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\",\"Calendar\":\"\u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\",\"Cancel\":\"\u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09c1\u09a8\",\"Cancel Alarm\":\"\u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09c1\u09a8\",\"Cancel download\":\"\u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09c1\u09a8\",\"Choose Asr Calculation Madhab\":\"\u0986\u09b8\u09b0 \u0997\u09a3\u09a8\u09be \u09ae\u09be\u09a7\u09ac \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose Calculation Method\":\"\u0997\u09a3\u09a8\u09be \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose High Latitude Setting\":\"\u0989\u099a\u09cd\u099a \u0985\u0995\u09cd\u09b7\u09be\u0982\u09b6\u09c7\u09b0 \u09b8\u09c7\u099f\u09bf\u0982 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose Language\":\"\u09ad\u09be\u09b7\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose Polar Resolution\":\"\u09aa\u09cb\u09b2\u09be\u09b0 \u09b0\u09c7\u099c\u09cb\u09b2\u09bf\u0989\u09b6\u09a8 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose Shafaq method\":\"\u09b6\u09be\u09ab\u09be\u0995\u09c7\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"Choose calculation rounding method\":\"\u0997\u09a3\u09a8\u09be\u09b0 \u09b0\u09be\u0989\u09a8\u09cd\u09a1\u09bf\u0982 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"Choose calendar type\":\"\u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09a7\u09b0\u09a8 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"Choose lunar calendar language\":\"\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09ad\u09be\u09b7\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose midnight calculation method\":\"\u09ae\u09a7\u09cd\u09af\u09b0\u09be\u09a4 \u0997\u09a3\u09a8\u09be \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Choose numbering system\":\"\u09a8\u09be\u09ae\u09cd\u09ac\u09be\u09b0\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"Choose which calendar to replace\":\"\u0995\u09cb\u09a8 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7 \u09a4\u09be \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"City/Area\":\"\u09b6\u09b9\u09b0/\u098f\u09b2\u09be\u0995\u09be\",\"Clear the coordinates\":\"\u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09c1\u09a8\",\"Clear the location\":\"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09c1\u09a8\",\"Clipboard data does not contain coordinates\":\"\u0995\u09cd\u09b2\u09bf\u09aa\u09ac\u09cb\u09b0\u09cd\u09a1 \u09a1\u09c7\u099f\u09be\u09df \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 \u09a8\u09c7\u0987\",\"Close\":\"\u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\",\"Closest City\":\"\u09a8\u09bf\u0995\u099f\u09a4\u09ae \u09b6\u09b9\u09b0\",\"Closest Date\":\"\u09a8\u09bf\u0995\u099f\u09a4\u09ae \u09a4\u09be\u09b0\u09bf\u0996\",\"Compass Lock\":\"\u0995\u09ae\u09cd\u09aa\u09be\u09b8 \u09b2\u0995\",\"Compass sensor unavailable\":\"\u0995\u09ae\u09cd\u09aa\u09be\u09b8 \u09b8\u09c7\u09a8\u09cd\u09b8\u09b0 \u09a8\u09c7\u0987\",\"Confirm\":\"\u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8\",\"Continuous\":\"\u098f\u0995\u099f\u09be\u09a8\u09be\",\"Coordinates updated\":\"\u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Copy\":\"\u0995\u09aa\u09bf \u0995\u09b0\u09c1\u09a8\",\"Count\":\"\u0997\u09a3\u09a8\u09be\",\"Country\":\"\u09a6\u09c7\u09b6\",\"Custom\":\"\u0995\u09be\u09b8\u09cd\u099f\u09ae\",\"Custom sounds and muezzins will not be exported\":\"\u0995\u09be\u09b8\u09cd\u099f\u09ae \u09b6\u09ac\u09cd\u09a6 \u098f\u09ac\u0982 \u09ae\u09c1\u09af\u09bc\u09be\u099c\u09cd\u099c\u09bf\u09a8 \u098f\u0995\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u09a8\u09be\",\"Custom upcoming alarm time\":\"\u0995\u09be\u09b8\u09cd\u099f\u09ae \u0986\u09b8\u09a8\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\",\"Dark\":\"\u0985\u09a8\u09cd\u09a7\u0995\u09be\u09b0\",\"Date\":\"\u09a4\u09be\u09b0\u09bf\u0996\",\"Decrement\":\"\u09b9\u09cd\u09b0\u09be\u09b8\",\"Default\":\"\u09a1\u09bf\u09ab\u09b2\u09cd\u099f\",\"Delete\":\"\u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u098f\u09ac\u0982 \u0985\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09cd\u09b0\u09af\u09bc\u09c7\u09a1 \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7, \u0995\u0996\u09a8\u0993 \u0995\u0996\u09a8\u0993 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09ac\u09cd\u09af\u09be\u099f\u09be\u09b0\u09bf \u09ac\u09be\u0981\u099a\u09be\u09a4\u09c7 \u09ac\u09cd\u09af\u09be\u0995\u0997\u09cd\u09b0\u09be\u0989\u09a8\u09cd\u09a1\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u0995\u09c7  \u09a5\u09be\u09ae\u09bf\u09df\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u098f\u099f\u09bf \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae/\u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a1\u09c7\u09b2\u09bf\u09ad\u09be\u09b0\u09bf \u09b9\u0993\u09af\u09bc\u09be \u09a5\u09c7\u0995\u09c7 \u0986\u099f\u0995\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\",\"Deselect as Fajr Adhan\":\"\u09ab\u099c\u09b0\u09c7\u09b0 \u0986\u09af\u09be\u09a8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u09ae\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8\",\"Device sounds\":\"\u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09b6\u09ac\u09cd\u09a6\",\"Disabled\":\"\u09ac\u09a8\u09cd\u09a7 \u0986\u099b\u09c7\",\"Disclaimer\":\"\u09a6\u09be\u09ac\u09bf\u09a4\u09cd\u09af\u09be\u0997\",\"Dismiss\":\"\u0996\u09be\u09b0\u09bf\u099c\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"\u09a6\u09bf\u09af\u09bc\u09be\u09a8\u09c7\u099f \u09a5\u09c7\u0995\u09c7 \u0986\u09b8\u09be \u09b8\u09ae\u09df\u09b8\u09ae\u09c2\u09b9 \u0985\u09ab\u09bf\u09b8\u09bf\u09af\u09bc\u09be\u09b2 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u0986\u09a8\u09c1\u09ae\u09be\u09a8\u09bf\u0995\u0964 \u09af\u09c7\u09b9\u09c7\u09a4\u09c1 \u09b8\u09ae\u09af\u09bc \u09a0\u09bf\u0995 \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09b8\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09af\u09a5\u09c7\u09b7\u09cd\u099f \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b6\u09a8 \u09a8\u09c7\u0987, \u09a4\u09be\u0987 \u09b8\u09ae\u09af\u09bc\u0997\u09c1\u09b2\u09bf \u0985\u09ab\u09bf\u09b8\u09bf\u09af\u09bc\u09be\u09b2 \u0993\u09af\u09bc\u09c7\u09ac\u09b8\u09be\u0987\u099f\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a8\u09be\u0993 \u09ae\u09bf\u09b2\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7, \u09ac\u09bf\u09b6\u09c7\u09b7 \u0995\u09b0\u09c7 \u09a4\u09c1\u09b0\u09b8\u09cd\u0995\u09c7\u09b0 \u09ac\u09be\u0987\u09b0\u09c7\u0964\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, \u09a4\u09c1\u09b0\u09b8\u09cd\u0995\",\"Doesn't use any kind of trackers\":\"\u0995\u09cb\u09a8\u09cb \u09a7\u09b0\u09a8\u09c7\u09b0 \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09be\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u09a8\u09be\",\"Don't ask again\":\"\u0986\u09ac\u09be\u09b0 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09be \u0995\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\",\"Don't show again\":\"\u0986\u09ac\u09be\u09b0 \u09a6\u09c7\u0996\u09be\u09ac\u09c7\u09a8 \u09a8\u09be\",\"Don't show alarm screen?\":\"\u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09b8\u09cd\u0995\u09cd\u09b0\u09c0\u09a8 \u09a6\u09c7\u0996\u09be\u09ac\u09c7\u09a8 \u09a8\u09be?\",\"Done\":\"\u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8\",\"Download\":\"\u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\",\"Eastern Arabic\":\"\u09aa\u09c2\u09b0\u09cd\u09ac \u0986\u09b0\u09ac\",\"Edit\":\"\u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8\",\"Edit Calculation Parameters\":\"\u0997\u09a3\u09a8\u09be\u09b0 \u09aa\u09b0\u09be\u09ae\u09bf\u09a4\u09bf \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8\",\"Edit Counter\":\"\u0995\u09be\u0989\u09a8\u09cd\u099f\u09be\u09b0 \u098f\u09a1\u09bf\u099f \u0995\u09b0\u09c1\u09a8\",\"Edit Location\":\"\u09b8\u09cd\u09a5\u09be\u09a8 \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09c1\u09a8\",\"Edit Reminder\":\"\u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0 \u098f\u09a1\u09bf\u099f \u0995\u09b0\u09c1\u09a8\",\"Edit Silent Mode\":\"Edit Silent Mode\",\"Egyptian General Survey Authority\":\"\u09ae\u09bf\u09b6\u09b0\u09c0\u09af\u09bc \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u099c\u09b0\u09bf\u09aa \u0995\u09b0\u09cd\u09a4\u09c3\u09aa\u0995\u09cd\u09b7\",\"Enabled\":\"\u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0986\u099b\u09c7\",\"End after prayer (minutes)\":\"End after prayer (minutes)\",\"Error getting clipboard data\":\"\u0995\u09cd\u09b2\u09bf\u09aa\u09ac\u09cb\u09b0\u09cd\u09a1 \u09a5\u09c7\u0995\u09c7 \u09a1\u09c7\u099f\u09be \u09aa\u09c7\u09a4\u09c7 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09df\u09c7\u099b\u09c7\",\"Error in loading countries\":\"\u09a6\u09c7\u09b6\u0997\u09c1\u09b2\u09bf\u09b0 \u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09df\u09c7\u099b\u09c7\",\"Error while downloading audio\":\"\u0985\u09a1\u09bf\u0993 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09df\u09c7\u099b\u09c7\",\"Error while getting coordinates\":\"\u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995\u0997\u09c1\u09b2\u09bf \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09df\u09c7\u099b\u09c7\",\"Error: failed to open file\":\"\u098f\u09b0\u09b0: \u09ab\u09be\u0987\u09b2 \u0996\u09c1\u09b2\u09a4\u09c7 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u09f7\",\"Ethiopic\":\"\u0987\u09a5\u09bf\u0993\u09aa\u09bf\u0995\",\"Export app data\":\"\u0985\u09cd\u09af\u09be\u09aa \u09a1\u09c7\u099f\u09be \u098f\u0995\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09c1\u09a8\",\"Export data\":\"\u09a1\u09c7\u099f\u09be \u098f\u0995\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f\",\"Fajr Angle\":\"\u09ab\u099c\u09b0\u09c7\u09b0 \u0995\u09cb\u09a3\",\"Find My Location\":\"\u0986\u09ae\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0996\u09c1\u0981\u099c\u09c1\u09a8\",\"Fix Common Problems\":\"\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09a0\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\",\"France angle 15\":\"\u09ab\u09cd\u09b0\u09be\u09a8\u09cd\u09b8 \u0995\u09cb\u09a3 15\",\"France angle 18\":\"\u09ab\u09cd\u09b0\u09be\u09a8\u09cd\u09b8 \u0995\u09cb\u09a3 18\",\"Friday\":\"\u09b6\u09c1\u0995\u09cd\u09b0\u09ac\u09be\u09b0\",\"General (default)\":\"\u09b8\u09be\u09a7\u09be\u09b0\u09a3 (\u09a1\u09bf\u09ab\u09b2\u09cd\u099f)\",\"Getting coordinates\":\"\u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 \u09aa\u09be\u0993\u09af\u09bc\u09be\",\"Got it\":\"\u09ac\u09c1\u099d\u09c7\u099b\u09bf\",\"Gregorian\":\"\u0997\u09cd\u09b0\u09c7\u0997\u09b0\u09bf\u09af\u09bc\u09be\u09a8\",\"Gulf region\":\"\u0989\u09aa\u09b8\u09be\u0997\u09b0\u09c0\u09af\u09bc \u0985\u099e\u09cd\u099a\u09b2\",\"Hanafi\":\"\u09b9\u09be\u09a8\u09be\u09ab\u09c0\",\"Hidden?\":\"\u09b2\u09c1\u0995\u09be\u09a8\u09cb?\",\"Hide Prayer Times\":\"\u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u09b8\u09c2\u099a\u09bf \u09b2\u09c1\u0995\u09be\u09a8\",\"Hide times you don't need\":\"\u0985\u09aa\u09cd\u09b0\u09df\u099c\u09a8\u09bf\u09df \u09b8\u09ae\u09df \u09b2\u09c1\u0995\u09be\u09a8\",\"High\":\"\u0989\u099a\u09cd\u099a\",\"High Latitude\":\"\u0989\u099a\u09cd\u099a \u0985\u0995\u09cd\u09b7\u09be\u0982\u09b6\",\"Highlight current prayer\":\"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09be\u09b2\u09be\u09a4 \u09b9\u09be\u0987\u09b2\u09be\u0987\u099f \u0995\u09b0\u09c1\u09a8\",\"Home\":\"\u09b9\u09cb\u09ae\",\"Homescreen and notification Widgets\":\"\u09b9\u09cb\u09ae\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8 \u098f\u09ac\u0982 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u0989\u0987\u099c\u09c7\u099f\u09b8\u09ae\u09c1\u09b9\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"\u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0995\u09bf\u09ac\u09b2\u09be \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0\u09c7\u09b0 \u09ae\u09a4\u09cb \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc, \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09a8\u09cd\u09af\u09c2\u09a8\u09a4\u09ae \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09a1\u09c7\u099f\u09be \u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09af\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09a8\u09a8\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u09b8\u09a8\u09be\u0995\u09cd\u09a4 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09ac\u09be \u09a8\u09be\u0993 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u098f\u099f\u09bf \u09ae\u09a8\u09c7 \u09b0\u09be\u0996\u09ac\u09c7\u09a8\u0964\",\"I Understand\":\"\u0986\u09ae\u09bf \u09ac\u09c1\u099d\u09c7\u099b\u09bf\",\"IMPORTANT_CHANNEL_ID\":\"\u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"\u09af\u09a6\u09bf \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u09a5\u09be\u0995\u09c7, \u09af\u0996\u09a8 \u098f\u0995\u099f\u09bf \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09af\u09bc, \u098f\u09a4\u09c7 \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09cd\u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a4\u09a5\u09cd\u09af \u09a5\u09be\u0995\u09ac\u09c7\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09cb\u09a8 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\u09c7 \\\"\u09ac\u09cd\u09af\u09be\u0995\u0986\u09aa \u098f\u09ac\u0982 \u09b0\u09bf\u09b8\u09c7\u099f\\\" \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09c7\u09a8 (\u09b8\u09c7\u099f\u09bf\u0982\u09b8 / \u09ac\u09cd\u09af\u09be\u0995\u0986\u09aa \u098f\u09ac\u0982 \u09b0\u09bf\u09b8\u09c7\u099f / \u0986\u09ae\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09ac\u09cd\u09af\u09be\u0995 \u0986\u09aa \u0995\u09b0\u09c1\u09a8), \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u099a\u09c7\u09a4\u09a8 \u09b9\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4 \u09af\u09c7 \u0985\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09cd\u09b0\u09af\u09bc\u09c7\u09a1 \u09a8\u09bf\u099c\u09c7\u0987 (\u0986\u09b2-\u0986\u099c\u09be\u09a8 \u09a8\u09af\u09bc) \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u0995\u09cd\u09b0\u09ae\u09c7 Google-\u098f \u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09cb\u09a8\u09c7\u09b0 \u09a1\u09c7\u099f\u09be\u09b0 \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09ac\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09b0\u09cd\u09ad\u09be\u09b0\u09c7\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u0995\u09cd\u09b7\u09a4\u09bf\u0997\u09cd\u09b0\u09b8\u09cd\u09a4 \u09b9\u09b2\u09c7 \u09ac\u09be \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u09a8\u09a4\u09c1\u09a8 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u0995\u09bf\u09a8\u09b2\u09c7 \u098f\u099f\u09bf \u0985\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09cd\u09b0\u09af\u09bc\u09c7\u09a1\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09aa\u09c1\u09a8\u09b0\u09c1\u09a6\u09cd\u09a7\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09a6\u09c7\u09af\u09bc\u0964 \u0986\u09b2-\u0986\u099c\u09be\u09a8\u09c7\u09b0 \u09a1\u09c7\u09ad\u09c7\u09b2\u09aa\u09be\u09b0\u09a6\u09c7\u09b0 \u098f\u0987 \u09a1\u09c7\u099f\u09be\u09a4\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u09a8\u09c7\u0987\u0964\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"\u0995\u09bf\u099b\u09c1 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09aa\u09b0\u09c7\u0993 \u0985\u09cd\u09af\u09be\u09aa \u09ac\u09a8\u09cd\u09a7 \u09b9\u09af\u09bc\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09a5\u09be\u0995\u09b2\u09c7, \u0986\u09b0\u0993 \u09b8\u09ae\u09be\u09a7\u09be\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 dontkillmyapp.com -\u098f \u09af\u09be\u09a8\u0964\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8 \u09af\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0\u09af\u09cb\u0997\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c\u09c7\u09b6\u09a8 \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u09a8\u09c0\u099a\u09c7\u09b0 \u09ac\u09be\u099f\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u098f\u0987 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u0996\u09c1\u09b2\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 Google Pixel-\u098f\u09b0 \u09ae\u09a4\u09cb \u0985\u09cd\u09af\u09be\u09a1\u09be\u09aa\u09cd\u099f\u09bf\u09ad \u099a\u09be\u09b0\u09cd\u099c\u09bf\u0982 \u09a5\u09be\u0995\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09bf \u0986\u09a7\u09be\u09a8 \u09ac\u09be \u0985\u09a8\u09c1\u09b8\u09cd\u09ae\u09be\u09b0\u0995\u0997\u09c1\u09b2\u09bf\u0995\u09c7 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u099a\u09bf\u09b9\u09cd\u09a8\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u09a8\u09be \u099a\u09be\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0987 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u099f\u09bf \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u09f7\",\"Import\":\"\u0987\u09ae\u09aa\u09cb\u09b0\u09cd\u099f\",\"Import app data\":\"\u0985\u09cd\u09af\u09be\u09aa \u09a1\u09c7\u099f\u09be \u0987\u09ae\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09c1\u09a8\",\"Import successful\":\"\u0987\u09ae\u09aa\u09cb\u09b0\u09cd\u099f \u09b8\u09ab\u09b2\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"\u09a6\u09c8\u09a8\u09bf\u0995 \u09aa\u09be\u0981\u099a\u099f\u09bf \u09b8\u09be\u09b2\u09be\u09a4 \u099b\u09be\u09a1\u09bc\u09be\u0993 \u098f\u09a4\u09c7 \u09b8\u09c2\u09b0\u09cd\u09af\u09cb\u09a6\u09af\u09bc, \u09b8\u09c2\u09b0\u09cd\u09af\u09be\u09b8\u09cd\u09a4, \u09ae\u09a7\u09cd\u09af\u09b0\u09be\u09a4 \u0993 \u09b0\u09be\u09a4\u09c7\u09b0 \u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 (\u09a4\u09be\u09b9\u09be\u099c\u09cd\u099c\u09c1\u09a6) \u09a6\u09bf\u0995\u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09a8\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964\",\"Increment\":\"\u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09c1\u09a8\",\"Info\":\"\u09a4\u09a5\u09cd\u09af\",\"Internet connection\":\"\u0987\u09a8\u09cd\u099f\u09be\u09b0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"\u0995\u09bf\u09ac\u09b2\u09be \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0987\u09a8\u09cd\u099f\u09be\u09b0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0993\u09af\u09bc\u09be\u0987\u09ab\u09be\u0987 \u09ac\u09be \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a1\u09c7\u099f\u09be \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964\",\"Iran\":\"\u0987\u09b0\u09be\u09a8\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"\u0987\u0982\u09b0\u09c7\u099c\u09bf, \u09ab\u09be\u09b0\u09cd\u09b8\u09bf, \u0986\u09b0\u09ac\u09bf, \u09a4\u09c1\u09b0\u09cd\u0995\u09bf, \u0987\u09a8\u09cd\u09a6\u09cb\u09a8\u09c7\u09b6\u09bf\u09af\u09bc\u09be\u09a8, \u09ab\u09b0\u09be\u09b8\u09bf, \u0989\u09b0\u09cd\u09a6\u09c1, \u09b9\u09bf\u09a8\u09cd\u09a6\u09bf, \u099c\u09be\u09b0\u09cd\u09ae\u09be\u09a8, \u09ac\u09b8\u09a8\u09bf\u09af\u09bc\u09be\u09a8, \u09ad\u09bf\u09af\u09bc\u09c7\u09a4\u09a8\u09be\u09ae\u09c0, \u09ac\u09be\u0982\u09b2\u09be \u09ad\u09be\u09b7\u09be\u09af\u09bc \u09ad\u09be\u09b7\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Isha Angle\":\"\u0987\u09b6\u09be\u09b0 \u0995\u09cb\u09a3\",\"Isha Interval\":\"\u0987\u09b6\u09be\u09b0 \u09ac\u09cd\u09af\u09ac\u09a7\u09be\u09a8\",\"Islamic\":\"\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995\",\"Islamic (Saudi Arabia sighting)\":\"\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 (\u09b8\u09cc\u09a6\u09bf \u0986\u09b0\u09ac \u09a6\u09c7\u0996\u09be \u09af\u09be\u0993\u09df\u09be)\",\"Islamic (Umm al-Qura)\":\"\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 (\u0989\u09ae\u09cd\u09ae\u09c1\u09b2 \u0995\u09c1\u09b0\u09be)\",\"Islamic (civil)\":\"\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 (\u09b8\u09bf\u09ad\u09bf\u09b2)\",\"Islamic (tabular)\":\"\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 (\u09b8\u09be\u09b0\u09a3\u09c0)\",\"Islamic Society of North America (ISNA)\":\"\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 \u09b8\u09cb\u09b8\u09be\u0987\u099f\u09bf \u0985\u09ab \u09a8\u09b0\u09cd\u09a5 \u0986\u09ae\u09c7\u09b0\u09bf\u0995\u09be (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"\u09ae\u09a8\u09c7 \u09b9\u099a\u09cd\u099b\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u09ac\u09cd\u09af\u09be\u0995\u0986\u09aa \u0987\u09ae\u09cd\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09be\u099f\u09be\u09b0\u09bf \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c\u09c7\u09b6\u09a8 \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09a4\u09c7 \u09ad\u09c1\u09b2\u09ac\u09c7\u09a8 \u09a8\u09be\",\"Just now\":\"\u098f\u0995\u09cd\u09b7\u09c1\u09a8\u09bf\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Kementrian Agama Republik Indonesia (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"\u0995\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\u09b0\u09bf\u09af\u09bc\u09be\u09a8 \u09b9\u09be\u09b2 \u098f\u09b9\u0993\u09af\u09bc\u09be\u09b2 \u0989\u0997\u09be\u09ae\u09be (\u09ac\u09cd\u09b0\u09c1\u09a8\u09be\u0987 \u09a6\u09be\u09b0\u09c1\u09b8\u09b8\u09be\u09b2\u09be\u09ae)\",\"Kuwait\":\"\u0995\u09c1\u09af\u09bc\u09c7\u09a4\",\"Label\":\"\u09b2\u09c7\u09ac\u09c7\u09b2\",\"Language\":\"\u09ad\u09be\u09b7\u09be\",\"Latitude\":\"\u0985\u0995\u09cd\u09b7\u09be\u0982\u09b6\",\"Latitude is invalid\":\"\u0985\u09ac\u09c8\u09a7 \u0985\u0995\u09cd\u09b7\u09be\u0982\u09b6\",\"License\":\"\u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8\",\"Light\":\"\u0986\u09b2\u09cb\",\"Light and Dark theme\":\"\u0986\u09b2\u09cb \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09a7\u0995\u09be\u09b0 \u09a5\u09bf\u09ae\",\"Light/Dark theme\":\"\u0986\u09b2\u09cb/\u0985\u09a8\u09cd\u09a7\u0995\u09be\u09b0 \u09a5\u09bf\u09ae\",\"List is empty\":\"\u0996\u09be\u09b2\u09bf \u09a4\u09be\u09b2\u09bf\u0995\u09be\",\"Loading\":\"\u09b2\u09cb\u09a1 \u09b9\u099a\u09cd\u099b\u09c7\",\"Location\":\"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\",\"Location settings\":\"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"Longitude\":\"\u09a6\u09cd\u09b0\u09be\u0998\u09bf\u09ae\u09be\u0982\u09b6\",\"Longitude is invalid\":\"\u0985\u09ac\u09c8\u09a7 \u09a6\u09cd\u09b0\u09be\u0998\u09bf\u09ae\u09be\u0982\u09b6\",\"Low\":\"\u0995\u09ae\",\"Lunar Calendar\":\"\u099a\u09a8\u09cd\u09a6 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\",\"Lunar Calendar Language\":\"\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09ad\u09be\u09b7\u09be\",\"Maghrib Angle\":\"\u09ae\u09be\u0997\u09b0\u09bf\u09ac\u09c7\u09b0 \u0995\u09cb\u09a3\",\"Make a Copy\":\"\u0995\u09aa\u09bf \u0995\u09b0\u09c1\u09a8\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"\u0986\u09af\u09be\u09a8 (\u0627\u0630\u0627\u0646) \u0997\u09a3\u09a8\u09be\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\u09b8\u09ae\u09c2\u09b9\",\"Medium\":\"\u09ae\u09be\u09a7\u09cd\u09af\u09ae\",\"Middle of the Night\":\"\u09b0\u09be\u09a4\u09c7\u09b0 \u09ae\u09be\u099d\u0996\u09be\u09a8\u09c7\",\"Midnight Method\":\"\u09ae\u09a7\u09cd\u09af\u09b0\u09be\u09a4 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"\u09a7\u09b0\u09cd\u09ae \u09ac\u09bf\u09b7\u09af\u09bc\u0995 \u0993 \u0993\u09af\u09bc\u09be\u0995\u09ab \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be\u09b2\u09af\u09bc, \u0986\u09b2\u099c\u09c7\u09b0\u09bf\u09af\u09bc\u09be\",\"Ministry of Religious Affairs of Tunisia\":\"\u09a4\u09bf\u0989\u09a8\u09bf\u09b8\u09bf\u09af\u09bc\u09be\u09b0 \u09a7\u09b0\u09cd\u09ae \u09ac\u09bf\u09b7\u09af\u09bc\u0995 \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be\u09b2\u09af\u09bc\",\"Mobile Data\":\"\u09ae\u09cb\u09ac\u09be\u0987\u09b2\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af\",\"Modified\":\"\u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09bf\u09a4\",\"Monday\":\"\u09b8\u09cb\u09ae\u09ac\u09be\u09b0\",\"Moonsighting Committee\":\"\u099a\u09be\u0981\u09a6 \u09a6\u09c7\u0996\u09be \u0995\u09ae\u09bf\u099f\u09bf\",\"Muslim World League\":\"\u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u09ac\u09bf\u09b6\u09cd\u09ac \u09b2\u09c0\u0997\",\"Name\":\"\u09a8\u09be\u09ae\",\"Nearest\":\"\u09a8\u09bf\u0995\u099f\u09a4\u09ae\",\"New Counter\":\"\u09a8\u09a4\u09c1\u09a8 \u0995\u09be\u0989\u09a8\u09cd\u099f\u09be\u09b0\",\"New Location\":\"\u09a8\u09a4\u09c1\u09a8 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\",\"New Reminder\":\"\u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"New Silent Mode\":\"New Silent Mode\",\"Next\":\"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0\",\"Next Day\":\"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09a6\u09bf\u09a8\",\"Next Month\":\"\u09aa\u09b0\u09c7\u09b0 \u09ae\u09be\u09b8\u09c7\",\"No\":\"\u09a8\u09be\",\"No Data\":\"\u0995\u09cb\u09a8 \u09a1\u09c7\u099f\u09be \u09a8\u09c7\u0987\",\"No Results\":\"\u0995\u09cb\u09a8 \u09ab\u09b2\u09be\u09ab\u09b2 \u09a8\u09c7\u0987\",\"None\":\"\u0995\u09cb\u09a8\u09cb\u099f\u09bf\u0987 \u09a8\u09af\u09bc\",\"None (Automatic)\":\"\u0995\u09cb\u09a8\u099f\u09bf\u0987 \u09a8\u09af\u09bc (\u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc)\",\"Normal mode restored\":\"Normal mode restored\",\"Not now\":\"\u098f\u0996\u09a8 \u09a8\u09be\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"\u09ae\u09a8\u09c7 \u09b0\u09be\u0996\u09ac\u09c7\u09a8 \u09af\u09c7 \u09b8\u09ab\u09cd\u099f\u0993\u09af\u09bc\u09cd\u09af\u09be\u09b0 \u098f\u09ac\u0982 \u09b9\u09be\u09b0\u09cd\u09a1\u0993\u09af\u09bc\u09cd\u09af\u09be\u09b0 \u09a4\u09cd\u09b0\u09c1\u099f\u09bf\u09b0 \u0995\u09be\u09b0\u09a3\u09c7, \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u0995\u09bf\u09ac\u09b2\u09be \u09a6\u09bf\u0995, \u09ac\u09bf\u09b6\u09c7\u09b7 \u0995\u09b0\u09c7 \u0995\u09ae\u09cd\u09aa\u09be\u09b8 \u09ae\u09cb\u09a1\u09c7, \u09ad\u09c1\u09b2 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\",\"Notification\":\"\u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8\",\"Notification & Sound\":\"\u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u098f\u09ac\u0982 \u09b6\u09ac\u09cd\u09a6\",\"Notifications Permission\":\"\u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\u09cb\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\",\"Numbering system\":\"\u09b8\u0982\u0996\u09cd\u09af\u09be \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\",\"Off\":\"\u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\",\"Okay\":\"\u09a0\u09bf\u0995 \u0986\u099b\u09c7\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"\u0985\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09cd\u09b0\u09af\u09bc\u09c7\u09a1 12 \u098f\u09ac\u0982 \u09a8\u09a4\u09c1\u09a8 \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3\u09c7, \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u0995\u09c7 \u09b8\u09a0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae\u09c7\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\u09b0\u0993 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8, \u09a4\u09be\u0987 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u098f\u099f\u09bf\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964\",\"Once\":\"\u098f\u0995\u09ac\u09be\u09b0\",\"One-Seventh of the Night\":\"\u09b0\u09be\u09a4\u09c7\u09b0 \u098f\u0995-\u09b8\u09aa\u09cd\u09a4\u09ae\u09be\u0982\u09b6\",\"Only once?\":\"\u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u098f\u0995\u09ac\u09be\u09b0?\",\"Only six items can be shown at the same time\":\"\u098f\u0995\u0987 \u09b8\u09ae\u09af\u09bc\u09c7 \u09ae\u09be\u09a4\u09cd\u09b0 \u099b\u09af\u09bc\u099f\u09bf \u0986\u0987\u099f\u09c7\u09ae \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09af\u09be\u09ac\u09c7\",\"Open Battery Optimization Settings\":\"\u09ac\u09cd\u09af\u09be\u099f\u09be\u09b0\u09bf \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c\u09c7\u09b6\u09be\u09a8 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u0996\u09c1\u09b2\u09c1\u09a8\",\"Open Power Manager Settings\":\"\u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u09a8\u09c7\u099c\u09be\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u0996\u09c1\u09b2\u09c1\u09a8\",\"Open source repository\":\"\u0993\u09aa\u09c7\u09a8 \u09b8\u09cb\u09b0\u09cd\u09b8 \u09b0\u09bf\u09aa\u09cb\u099c\u09bf\u099f\u09b0\u09bf\",\"Open-source\":\"\u0993\u09aa\u09c7\u09a8 \u09b8\u09cb\u09b0\u09cd\u09b8\",\"Options\":\"\u0985\u09aa\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9\",\"Or if you have a backup, you can import it\":\"\u0985\u09a5\u09ac\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09af\u09a6\u09bf \u09ac\u09cd\u09af\u09be\u0995\u0986\u09aa \u09a5\u09be\u0995\u09c7 \u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u099f\u09bf \u0987\u09ae\u09cd\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\",\"Orientation Lock: Landscape\":\"\u0993\u09b0\u09bf\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09c7\u09b6\u09a8 \u09b2\u0995: \u09b2\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09b8\u09cd\u0995\u09c7\u09aa\",\"Orientation Lock: Portrait\":\"\u0993\u09b0\u09bf\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09c7\u09b6\u09a8 \u09b2\u0995: \u09aa\u09cb\u09b0\u09cd\u099f\u09cd\u09b0\u09c7\u099f\",\"Orientation: Unlocked\":\"\u0993\u09b0\u09bf\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09c7\u09b6\u09a8: \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"\u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u099a\u09cc\u09ae\u09cd\u09ac\u0995\u09c0\u09af\u09bc \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09cb\u09a8\u09c7\u09b0 \u0995\u09ae\u09cd\u09aa\u09be\u09b8\u09c7 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09ae\u09cd\u09aa\u09be\u09b8\u09c7\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09bf\u09ac\u09cd\u09b0\u09c7\u09b6\u09a8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\",\"PRAYER_MODE_CHANNEL_NAME\":\"Silent Mode\",\"PRE_ADHAN_CHANNEL_NAME\":\"\u0986\u09b8\u09a8\u09cd\u09a8 \u0986\u09af\u09be\u09a8\",\"PRE_REMINDER_CHANNEL_NAME\":\"\u0986\u09b8\u09a8\u09cd\u09a8 \u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\",\"Pakistan\":\"\u09aa\u09be\u0995\u09bf\u09b8\u09cd\u09a4\u09be\u09a8\",\"Paste\":\"\u09aa\u09c7\u09b8\u09cd\u099f \u0995\u09b0\u09c1\u09a8\",\"Persian\":\"\u09ab\u09be\u09b0\u09cd\u09b8\u09bf\",\"Phone State Permission\":\"\u09ab\u09cb\u09a8 \u09b8\u09cd\u099f\u09c7\u099f \u0985\u09a8\u09c1\u09ae\u09a4\u09bf\",\"Play\":\"\u09b6\u09c1\u09a8\u09c1\u09a8\",\"Please enable location service\":\"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09ae\u09a8\u09c7 \u09b0\u09be\u0996\u09ac\u09c7\u09a8 \u09af\u09c7 \u098f\u0987 \u0985\u09aa\u09b6\u09a8\u099f\u09bf \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09be\u09b0 \u09ab\u09b2\u09c7 \u0986\u09af\u09be\u09a8 \u098f\u09ac\u0982 \u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\u09b8\u09ae\u09c2\u09b9 \u09ac\u09bf\u09b2\u09ae\u09cd\u09ac\u09bf\u09a4 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u0985\u09a5\u09ac\u09be \u09a8\u09be\u0993 \u09b8\u0982\u0998\u099f\u09bf\u09a4 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u09b8\u09a4\u09b0\u09cd\u0995\u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u099f\u09bf \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8\u0964\",\"Polar Resolution\":\"\u09aa\u09cb\u09b2\u09be\u09b0 \u09b0\u09c7\u099c\u09cb\u09b2\u09bf\u0989\u09b6\u09a8\",\"Power Manager\":\"\u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u09a8\u09c7\u099c\u09be\u09b0\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"\u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\",\"Prayer list\":\"\u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\",\"Press to search\":\"\u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u099f\u09bf\u09aa\u09c1\u09a8\",\"Press to select a method\":\"\u098f\u0995\u099f\u09bf \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09a4\u09c7 \u099f\u09bf\u09aa\u09c1\u09a8\",\"Prev Day\":\"\u0986\u0997\u09c7\u09b0 \u09a6\u09bf\u09a8\",\"Prev Month\":\"\u0986\u0997\u09c7\u09b0 \u09ae\u09be\u09b8\",\"Privacy Policy\":\"\u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09aa\u09b2\u09bf\u09b8\u09bf\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"\u09aa\u09cd\u09b0\u09be\u0987\u09ad\u09c7\u09b8\u09bf-\u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09bf\u0995 \u0993\u09aa\u09c7\u09a8 \u09b8\u09cb\u09b0\u09cd\u09b8 \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u0986\u09af\u09be\u09a8 (\u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 \u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc) \u098f\u09ac\u0982 \u0995\u09bf\u09ac\u09b2\u09be \u0985\u09cd\u09af\u09be\u09aa\",\"Qada counter\":\"\u0995\u09be\u09af\u09be \u0995\u09be\u0989\u09a8\u09cd\u099f\u09be\u09b0\",\"Qatar\":\"\u0995\u09be\u09a4\u09be\u09b0\",\"Qibla\":\"\u0995\u09bf\u09ac\u09b2\u09be\",\"Qibla finder\":\"\u0995\u09bf\u09ac\u09b2\u09be \u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u0995\u09be\u09b0\u09c0\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"\u0995\u09bf\u09ac\u09b2\u09be \u09ab\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09b2\u09cb\u0995\u09c7\u09b6\u09a8 \u09b8\u09be\u09b0\u09cd\u09ad\u09bf\u09b8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u09b8\u09c7\u099f\u09bf \u099a\u09be\u09b2\u09c1 \u09a8\u09be \u09b9\u09b2\u09c7, \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09a5\u09c7\u0995\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"\u0995\u09bf\u09ac\u09b2\u09be \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 F-Droid \u09ac\u09bf\u09b2\u09cd\u09a1\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u09a8\u09c7\u0987\u0964 \u098f\u099f\u09bf \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a4\u09c7 \u09b8\u0982\u09af\u09cb\u099c\u09a8 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\",\"REMINDER_CHANNEL_NAME\":\"\u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\",\"Ramadan is ending,\":\"\u09b0\u09ae\u099c\u09be\u09a8 \u09b6\u09c7\u09b7 \u09b9\u099a\u09cd\u099b\u09c7,\",\"Ramadan is near,\":\"\u09b0\u09ae\u099c\u09be\u09a8 \u09b8\u09a8\u09cd\u09a8\u09bf\u0995\u099f\u09c7,\",\"Remaining till\":\"\u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09ac\u09be\u0995\u09bf\",\"Remind me next year\":\"\u09aa\u09b0\u09c7\u09b0 \u09ac\u099b\u09b0 \u0986\u09ae\u09be\u0995\u09c7 \u09ae\u09a8\u09c7 \u0995\u09b0\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09a8\",\"Reminder\":\"\u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\",\"Repeat\":\"\u09aa\u09c1\u09a8\u09b0\u09be\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c1\u09a8\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"\u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09b8\u09c7\u099f\u09bf\u0982\u09b8\u09b8\u09ae\u09c2\u09b9 \u0985\u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3\u0964 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09a6\u09c7\u0996\u09be\u09a8\u09cb\u09b0 \u099c\u09a8\u09cd\u09af, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09aa\u09b0\u09c7 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09a5\u09c7\u0995\u09c7 \u0995\u09a8\u09ab\u09bf\u0997\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964\",\"Rounding Method\":\"\u09b0\u09be\u0989\u09a8\u09cd\u09a1\u09bf\u0982 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"\u09b8\u09cd\u09af\u09be\u09ae\u09b8\u09be\u0982 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u0997\u09c1\u09b2\u09bf\u09b0 \u09a8\u09bf\u099c\u09b8\u09cd\u09ac \u0995\u09be\u09b8\u09cd\u099f\u09ae \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u09a8\u09c7\u099c\u09be\u09b0 \u09b0\u09af\u09bc\u09c7\u099b\u09c7 \u09af\u09be\u09b0 \u09a8\u09be\u09ae \\\"Device Care\\\"\u0964 \u09a8\u09c0\u099a\u09c7\u09b0 \u09ac\u09be\u099f\u09a8 \u099a\u09be\u09aa\u09be\u09b0 \u09aa\u09b0\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u0995\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u099f\u09be\u09b0\u09bf \u09ae\u09c7\u09a8\u09c1\u09a4\u09c7 \u09a8\u09bf\u09df\u09c7 \u09af\u09be\u0993\u09df\u09be \u09b9\u09ac\u09c7\u0964 \u09ac\u09cd\u09af\u09be\u099f\u09be\u09b0\u09bf \u09ae\u09c7\u09a8\u09c1\u09a4\u09c7 \\\"App power management\\\" \u098f \u099a\u09be\u09aa\u09c1\u09a8, \u098f\u09ac\u0982 \u09a4\u09be\u09b0\u09aa\u09b0\u09c7 \\\"Apps that won't be put to sleep\\\" \u098f \u099a\u09be\u09aa\u09c1\u09a8 \u098f\u09ac\u0982 \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u0995\u09c7 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09af\u09bc \u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8\u09f7\",\"Saturday\":\"\u09b6\u09a8\u09bf\u09ac\u09be\u09b0\",\"Saudi Arabia\":\"\u09b8\u09cc\u09a6\u09bf \u0986\u09b0\u09ac\",\"Search\":\"\u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Secondary Calendar\":\"\u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09df \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\",\"See favorite locations\":\"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\u09b8\u09ae\u09c2\u09b9 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Select as Fajr Adhan\":\"\u09ab\u099c\u09b0\u09c7\u09b0 \u0986\u09af\u09be\u09a8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Select different Adhan audio for Fajr namaz\":\"\u09ab\u099c\u09b0 \u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u0986\u09af\u09be\u09a8 \u0985\u09a1\u09bf\u0993 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Selected\":\"\u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4\",\"Selected as adhan\":\"\u0986\u09af\u09be\u09a8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4\",\"Selected as fajr adhan\":\"\u09ab\u099c\u09b0\u09c7\u09b0 \u0986\u099c\u09be\u09a8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4\",\"Selecting a name is required\":\"\u098f\u0995\u099f\u09bf \u09a8\u09be\u09ae \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\",\"Set custom Adhan audio\":\"\u0995\u09be\u09b8\u09cd\u099f\u09ae \u0986\u09af\u09be\u09a8 \u0985\u09a1\u09bf\u0993 \u09b8\u09c7\u099f \u0995\u09b0\u09c1\u09a8\",\"Set reminders before or after a prayer time\":\"\u09aa\u09cd\u09b0\u09be\u09b0\u09cd\u09a5\u09a8\u09be\u09b0 \u0986\u0997\u09c7 \u09ac\u09be \u09aa\u09b0\u09c7 \u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0 \u09b8\u09c7\u099f \u0995\u09b0\u09c1\u09a8\",\"Shafaq\":\"\u09b6\u09be\u09ab\u09be\u0995\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"\u09b6\u09be\u09ab\u09be\u0995\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u09a7\u09b0\u09a8\u09c7\u09b0 \u0997\u09cb\u09a7\u09c2\u09b2\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7 \u09a4\u09be \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u0981\u09a6 \u09a6\u09c7\u0996\u09be \u0995\u09ae\u09bf\u099f\u09bf\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b6\u09be\u09ab\u09be\u0995 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964\",\"Shafi, Maliki, Hanbali (Default)\":\"\u09b6\u09ab\u09bf, \u09ae\u09be\u09b2\u09bf\u0995\u09bf, \u09b9\u09be\u09ae\u09cd\u09ac\u09b2\u09c0 (\u09a1\u09bf\u09ab\u09b2\u09cd\u099f)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"\u09b6\u09bf\u09af\u09bc\u09be \u0987\u09a5\u09a8\u09be \u0986\u09b6\u0986\u09b0\u09c0, \u09b2\u09c7\u09ad\u09be \u0987\u09a8\u09b8\u09cd\u099f\u09bf\u099f\u09bf\u0989\u099f, \u0995\u09c1\u09ae\",\"Shia, Institute of Geophysics, University of Tehran\":\"\u09b6\u09bf\u09af\u09bc\u09be, \u099c\u09bf\u0993\u09ab\u09bf\u099c\u09bf\u0995\u09cd\u09b8 \u0987\u09a8\u09b8\u09cd\u099f\u09bf\u099f\u09bf\u0989\u099f, \u09a4\u09c7\u09b9\u09b0\u09be\u09a8 \u09ac\u09bf\u09b6\u09cd\u09ac\u09ac\u09bf\u09a6\u09cd\u09af\u09be\u09b2\u09af\u09bc\",\"Should app highlight current prayer instead of next prayer?\":\"\u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u0995\u09bf \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09c7 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09be\u09b2\u09be\u09a4\u0995\u09c7 \u09b9\u09be\u0987\u09b2\u09be\u0987\u099f \u0995\u09b0\u09ac\u09c7?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"\\\"\u09a1\u09c1 \u09a8\u099f \u09a1\u09bf\u09b8\u09cd\u099f\u09be\u09b0\u09cd\u09ac\\\" \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u09a5\u09be\u0995\u09be \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09af\u09bc\u0993 \u0995\u09bf \u0986\u099c\u09be\u09a8 \u09b9\u09ac\u09c7?\",\"Should app stop playing adhan when the volume button is pressed?\":\"\u09ad\u09b2\u09bf\u0989\u09ae \u099a\u09be\u09aa\u09b2\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u0995\u09bf \u0986\u099c\u09be\u09a8 \u09ac\u09be\u099c\u09be\u09a8\u09cb \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09be \u0989\u099a\u09bf\u09a4?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"\u0986\u09af\u09be\u09a8 \u09ac\u09be \u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0 \u09ac\u09be\u099c\u09be\u09a8\u09cb \u09b6\u09c1\u09b0\u09c1 \u09b9\u09b2\u09c7 \u09ab\u09cb\u09a8 \u0995\u09bf \u09ad\u09be\u0987\u09ac\u09cd\u09b0\u09c7\u099f \u0995\u09b0\u09ac\u09c7?\",\"Show Adhan Options\":\"\u0986\u09af\u09be\u09a8 \u0985\u09aa\u09b6\u09a8 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Show Today\":\"\u0986\u099c \u09a6\u09c7\u0996\u09c1\u09a8\",\"Show countdown?\":\"\u0995\u09be\u0989\u09a8\u09cd\u099f\u09a1\u09be\u0989\u09a8 \u09a6\u09c7\u0996\u09ac\u09c7\u09a8?\",\"Show current\":\"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Show me\":\"\u0986\u09ae\u09be\u0995\u09c7 \u09a6\u09c7\u0996\u09be\u0993\",\"Show next in notification?\":\"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8\u09c7 \u09a6\u09c7\u0996\u09ac\u09c7\u09a8?\",\"Show notification widget?\":\"\u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u0989\u0987\u099c\u09c7\u099f \u09a6\u09c7\u0996\u09be\u09ac\u09c7\u09a8?\",\"Show settings\":\"\u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Show upcoming alarm notification?\":\"\u0986\u09b8\u09a8\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae\u09c7\u09b0 \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09ac\u09c7\u09a8?\",\"Silent\":\"\u09a8\u09c0\u09b0\u09ac\",\"Silent Mode Ended\":\"Silent Mode Ended\",\"Silent Mode Name\":\"Silent Mode Name\",\"Silent Mode Started\":\"Silent Mode Started\",\"Silent mode activated\":\"Silent mode activated\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"\u09af\u09c7\u09b9\u09c7\u09a4\u09c1 \u0986\u09ae\u09b0\u09be \u0995\u09cb\u09a8\u09cb \u09a7\u09b0\u09a8\u09c7\u09b0 \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09be\u09b0 \u09ac\u09be \u0995\u09cd\u09b0\u09cd\u09af\u09be\u09b6 \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09bf\u099f\u09bf\u0995\u09cd\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09bf \u09a8\u09be, \u09a4\u09be\u0987 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0997\u09bf\u099f\u09b9\u09be\u09ac \u09b0\u09c7\u09aa\u09cb\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09ac\u09be \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6 \u099c\u09be\u09a8\u09be\u09a8\",\"Singapore\":\"\u09b8\u09bf\u0999\u09cd\u0997\u09be\u09aa\u09c1\u09b0\",\"Skip\":\"\u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\",\"Software License\":\"\u09b8\u09ab\u09cd\u099f\u0993\u09af\u09bc\u09cd\u09af\u09be\u09b0 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8\",\"Solar Hijri\":\"\u09b8\u09cc\u09b0 \u09b9\u09bf\u099c\u09b0\u09c0\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"\u09ac\u09cd\u09af\u09be\u0995\u0997\u09cd\u09b0\u09be\u0989\u09a8\u09cd\u09a1\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u0995\u09c7 \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u09a5\u09be\u09ae\u09be\u09a4\u09c7 \u0995\u09bf\u099b\u09c1 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u09a8\u09c7\u099c\u09be\u09b0\u09c7\u09b0 \u09ad\u09bf\u09a4\u09b0\u09c7 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u09b8\u09c7\u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09c7\u09ad\u09bf\u0982 \u0985\u09aa\u09b6\u09a8 \u09a1\u09bf\u099c\u09c7\u09ac\u09b2 \u0995\u09b0\u09c7 \u09a6\u09bf\u09a8\u0964\",\"Sound\":\"\u09b6\u09ac\u09cd\u09a6\",\"Spiritual Administration of Muslims of Russia\":\"\u09b0\u09be\u09b6\u09bf\u09af\u09bc\u09be\u09b0 \u09ae\u09c1\u09b8\u09b2\u09ae\u09be\u09a8\u09a6\u09c7\u09b0 \u0986\u09a7\u09cd\u09af\u09be\u09a4\u09cd\u09ae\u09bf\u0995 \u09aa\u09cd\u09b0\u09b6\u09be\u09b8\u09a8\",\"Start before prayer (minutes)\":\"Start before prayer (minutes)\",\"Status\":\"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\",\"Stop\":\"\u09a5\u09be\u09ae\u09cb\",\"Sunday\":\"\u09b0\u09ac\u09bf\u09ac\u09be\u09b0\",\"Sunset to Fajr (Default)\":\"\u09b8\u09c2\u09b0\u09cd\u09af\u09be\u09b8\u09cd\u09a4 \u09a5\u09c7\u0995\u09c7 \u09ab\u099c\u09b0 (\u09a1\u09bf\u09ab\u09b2\u09cd\u099f)\",\"Sunset to Sunrise\":\"\u09b8\u09c2\u09b0\u09cd\u09af\u09be\u09b8\u09cd\u09a4 \u09a5\u09c7\u0995\u09c7 \u09b8\u09c2\u09b0\u09cd\u09af\u09cb\u09a6\u09af\u09bc\",\"System Default\":\"\u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u09c7\u09b0 \u09a1\u09bf\u09ab\u09b2\u09cd\u099f\",\"Tahajjud time mentioned in the app is the last third of the night\":\"\u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09a4\u09c7 \u09a4\u09be\u09b9\u09be\u099c\u09cd\u099c\u09c1\u09a6\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09b0\u09be\u09a4\u09c7\u09b0 \u09b6\u09c7\u09b7 \u09a4\u09c3\u09a4\u09c0\u09af\u09bc\u09be\u0982\u09b6\",\"Thai Solar\":\"\u09a5\u09be\u0987 \u09b8\u09cb\u09b2\u09be\u09b0\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"\u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09c7\u099b\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6! \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be\u09b0 \u0986\u0997\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0995\u09bf\u099b\u09c1 \u0995\u09be\u099c \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964\",\"The Gulf Region (Dubai)\":\"\u0989\u09aa\u09b8\u09be\u0997\u09b0\u09c0\u09af\u09bc \u0985\u099e\u09cd\u099a\u09b2 (\u09a6\u09c1\u09ac\u09be\u0987)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"\u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09b0 \u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac-\u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u098f\u09ac\u0982 \u09b8\u09a0\u09bf\u0995 \u09a8\u09be\u0993 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u0995\u09be\u09b0\u09a3 \u098f\u099f\u09bf \u099a\u09be\u0981\u09a6 \u09a6\u09c7\u0996\u09be\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7 \u09a8\u09af\u09bc\u0964 \u09b0\u09ae\u099c\u09be\u09a8\u09c7\u09b0 \u09b6\u09c1\u09b0\u09c1 \u098f\u09ac\u0982 \u09b6\u09c7\u09b7\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u099f\u09bf \u09ac\u09bf\u09b6\u09c7\u09b7\u09ad\u09be\u09ac\u09c7 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3\u0964\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"\u098f\u0987 \u0993\u09af\u09bc\u09c7\u09ac\u09b8\u09be\u0987\u099f \u098f\u09ac\u0982 \u0985\u09cd\u09af\u09be\u09aa\u09c7 \u09aa\u09be\u0993\u09af\u09bc\u09be \u099f\u09c7\u0995\u09cd\u09b8\u099f \u0985\u09a8\u09cd\u09af \u09ad\u09be\u09b7\u09be\u09af\u09bc \u09b8\u09a0\u09bf\u0995 \u09a8\u09be\u0993 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7, \u09a4\u09be\u0987 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7\u0987 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u0987\u0982\u09b0\u09c7\u099c\u09bf \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3 \u09ac\u09bf\u09ac\u09c7\u099a\u09a8\u09be \u0995\u09b0\u09be \u0989\u099a\u09bf\u09a4\u0964\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"\u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09a7\u09b0\u09a8 \u09af\u09be \u09b9\u09cb\u09ae \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0\u09c7 \u098f\u09ac\u0982 \u0989\u0987\u099c\u09c7\u099f\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09aa\u09be\u09b6\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09f7\",\"The type of lunar calendar shown in main screen and widgets\":\"\u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09b8\u09cd\u0995\u09cd\u09b0\u09c0\u09a8 \u098f\u09ac\u0982 \u0989\u0987\u099c\u09c7\u099f\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09a7\u09b0\u09a8\",\"Theme Color\":\"\u09a5\u09bf\u09ae\u09c7\u09b0 \u09b0\u0999\",\"Thursday\":\"\u09ac\u09c3\u09b9\u09b8\u09cd\u09aa\u09a4\u09bf\u09ac\u09be\u09b0\",\"Time\":\"\u09b8\u09ae\u09af\u09bc\",\"Time condition\":\"\u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09b6\u09b0\u09cd\u09a4\",\"Time format\":\"\u09b8\u09ae\u09af\u09bc \u09ab\u09b0\u09cd\u09ae\u09cd\u09af\u09be\u099f\",\"Time list\":\"\u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"\u0986\u09af\u09be\u09a8 \u0997\u09a3\u09a8\u09be \u0995\u09b0\u09a4\u09c7, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \\\"\u0986\u09ae\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0996\u09c1\u0981\u099c\u09c1\u09a8\\\" \u09ac\u09cb\u09a4\u09be\u09ae\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u0985\u09a5\u09ac\u09be \u09a6\u09c7\u09b6 \u098f\u09ac\u0982 \u09b6\u09b9\u09b0/\u098f\u09b2\u09be\u0995\u09be \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u0985\u09a5\u09ac\u09be \u09ae\u09cd\u09af\u09be\u09a8\u09c1\u09af\u09bc\u09be\u09b2\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 \u09b2\u09bf\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\",\"To see notifications about adhan, we need your permission.\":\"\u0986\u099c\u09be\u09a8 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09a4\u09c7, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"\u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u0995\u09b2 \u09aa\u09c7\u09b2\u09c7 \u0986\u09af\u09be\u09a8 \u09ac\u09be\u099c\u09be\u09a8\u09cb \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09a4\u09c7, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09cb\u09a8\u09c7\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u099c\u09be\u09a8\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u098f\u0987 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a8\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09b2\u09c7 \u098f\u0987 \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09bf \u09ac\u09a8\u09cd\u09a7 \u09a5\u09be\u0995\u09ac\u09c7\u0964\",\"Tomorrow\":\"\u0995\u09be\u09b2\u0995\u09c7\",\"Tuesday\":\"\u09ae\u0999\u09cd\u0997\u09b2\u09ac\u09be\u09b0\",\"Turn Left\":\"\u09ac\u09be\u09ae \u09a6\u09bf\u0995\u09c7 \u0998\u09c1\u09b0\u09c1\u09a8\",\"Turn Right\":\"\u09a1\u09be\u09a8\u09c7 \u09a6\u09bf\u0995\u09c7 \u0998\u09c1\u09b0\u09c1\u09a8\",\"Turn history off\":\"\u09b9\u09bf\u09b8\u09cd\u099f\u09b0\u09bf \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\",\"Turn history on\":\"\u09b9\u09bf\u09b8\u09cd\u099f\u09b0\u09bf \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8\",\"Twilight Angle\":\"\u0997\u09cb\u09a7\u09c2\u09b2\u09bf \u0995\u09cb\u09a3\",\"Umm al-Qura University, Makkah\":\"\u0989\u09ae\u09cd\u09ae\u09c1\u09b2 \u0995\u09c1\u09b0\u09be \u09ac\u09bf\u09b6\u09cd\u09ac\u09ac\u09bf\u09a6\u09cd\u09af\u09be\u09b2\u09af\u09bc, \u09ae\u0995\u09cd\u0995\u09be\",\"Union Organization Islamic de France\":\"\u0987\u0989\u09a8\u09bf\u09af\u09bc\u09a8 \u0985\u09b0\u09cd\u0997\u09be\u09a8\u09be\u0987\u099c\u09c7\u09b6\u09a8 \u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 \u09a1\u09bf \u09ab\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\",\"University of Islamic Sciences, Karachi\":\"\u0987\u0989\u09a8\u09bf\u09ad\u09be\u09b0\u09cd\u09b8\u09bf\u099f\u09bf \u0985\u09ac \u0987\u09b8\u09b2\u09be\u09ae\u09bf\u0995 \u09b8\u09be\u09af\u09bc\u09c7\u09a8\u09cd\u09b8\u09c7\u09b8, \u0995\u09b0\u09be\u099a\u09bf\",\"Unknown Error\":\"\u0985\u099c\u09be\u09a8\u09be \u09b8\u09ae\u09b8\u09cd\u09af\u09be\",\"Unreliable\":\"\u0985\u09ac\u09bf\u09b6\u09cd\u09ac\u09b8\u09cd\u09a4\",\"Unresolved (default)\":\"\u0985\u09ae\u09c0\u09ae\u09be\u0982\u09b8\u09bf\u09a4 (\u09a1\u09bf\u09ab\u09b2\u09cd\u099f)\",\"Unsupported\":\"\u0985\u09b8\u09ae\u09b0\u09cd\u09a5\u09bf\u09a4\",\"Up\":\"\u0989\u09aa\u09b0\u09c7\",\"Upcoming alarm\":\"\u0986\u09b8\u09a8\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae\",\"Updating widgets\":\"\u0989\u0987\u099c\u09c7\u099f \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7\",\"Use 24-Hour format\":\"\u09e8\u09ea-\u0998\u09a8\u09cd\u099f\u09be \u09ac\u09bf\u09a8\u09cd\u09af\u09be\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\",\"Use Compass\":\"\u0995\u09ae\u09cd\u09aa\u09be\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\",\"Use Map\":\"\u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\",\"Use a different alarm type?\":\"\u09ad\u09bf\u09a8\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u099f\u09be\u0987\u09aa \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09ac\u09c7\u09a8?\",\"Use adaptive theme?\":\"\u0985\u09cd\u09af\u09be\u09a1\u09be\u09aa\u09cd\u099f\u09bf\u09ad \u09a5\u09bf\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09ac\u09c7\u09a8?\",\"Use headphones when available?\":\"\u09b9\u09c7\u09a1\u09ab\u09cb\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u09b9\u09ac\u09c7 \u09af\u09a6\u09bf \u09a5\u09be\u0995\u09c7?\",\"Using Coordinates\":\"\u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\",\"Using GPS\":\"\u099c\u09bf\u09aa\u09bf\u098f\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\",\"Using Search\":\"\u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c7\",\"Version\":\"\u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3\",\"Vibration Mode\":\"\u09ad\u09be\u0987\u09ac\u09cd\u09b0\u09c7\u09b6\u09a8 \u09ae\u09cb\u09a1\",\"Vibration on call\":\"Vibration on call\",\"Volume button stops adhan\":\"\u09ad\u09b2\u09bf\u0989\u09ae \u09ac\u09be\u099f\u09a8 \u0986\u09af\u09be\u09a8 \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c7 \u09a6\u09c7\u09af\u09bc\",\"WIDGET_CHANNEL_NAME\":\"\u0989\u0987\u099c\u09c7\u099f\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"\u0989\u0987\u099c\u09c7\u099f \u0986\u09aa\u09a1\u09c7\u099f\",\"We'll help you do them quickly.\":\"\u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b8\u09c7\u0997\u09c1\u09b2\u09bf \u0995\u09b0\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09ac\u09f7\",\"Wednesday\":\"\u09ac\u09c1\u09a7\u09ac\u09be\u09b0\",\"Welcome\":\"\u09b8\u09cd\u09ac\u09be\u0997\u09a4\",\"Western Arabic\":\"\u09aa\u09b6\u09cd\u099a\u09bf\u09ae \u0986\u09b0\u09ac\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"\u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u09a5\u09be\u0995\u09be \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09af\u09bc, \u0986\u09af\u09be\u09a8 \u09ac\u09be \u0985\u09a8\u09c1\u09b8\u09cd\u09ae\u09be\u09b0\u0995 \u09ac\u09be\u099c\u09be\u09a8\u09cb \u09b6\u09c1\u09b0\u09c1 \u09b9\u09b2\u09c7 \u09b8\u09cd\u0995\u09cd\u09b0\u09c0\u09a8\u099f\u09bf \u09ac\u09a8\u09cd\u09a7 \u09a5\u09be\u0995\u09ac\u09c7 \u098f\u09ac\u0982 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09b8\u09cd\u0995\u09cd\u09b0\u09c0\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09ac\u09c7 \u09a8\u09be\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"\u09b8\u0995\u09cd\u09b7\u09ae \u09b9\u09b2\u09c7, \u09b9\u09c7\u09a1\u09ab\u09cb\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc, \u09b8\u09ae\u09b8\u09cd\u09a4 \u0985\u09a1\u09bf\u0993 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09b9\u09c7\u09a1\u09ab\u09cb\u09a8\u09c7 \u099a\u09b2\u09ac\u09c7\u0964\",\"Wifi\":\"\u0993\u09af\u09bc\u09be\u0987\u09ab\u09be\u0987\",\"Yes\":\"\u09b9\u09cd\u09af\u09be\u0981\",\"You are facing Kaaba\":\"\u0986\u09aa\u09a8\u09bf \u0995\u09be\u09ac\u09be\u09b0 \u09a6\u09bf\u0995\u09c7 \u09ae\u09c1\u0996 \u0995\u09b0\u09c7 \u0986\u099b\u09c7\u09a8\",\"You are not facing Kaaba\":\"\u0986\u09aa\u09a8\u09bf \u0995\u09be\u09ac\u09be\u09b0 \u09a6\u09bf\u0995\u09c7 \u09ae\u09c1\u0996 \u0995\u09b0\u09c7 \u09a8\u09c7\u0987\",\"You can access your device Power Manager using the button below.\":\"\u0986\u09aa\u09a8\u09bf \u09a8\u09c0\u099a\u09c7\u09b0 \u09ac\u09be\u099f\u09a8\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u09a8\u09c7\u099c\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\",\"You can also paste coords from clipboard\":\"\u0986\u09aa\u09a8\u09bf \u0995\u09cd\u09b2\u09bf\u09aa\u09ac\u09cb\u09b0\u09cd\u09a1 \u09a5\u09c7\u0995\u09c7 \u0995\u09aa\u09bf \u09aa\u09c7\u09b8\u09cd\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\",\"You can change the language used for lunar calendar\":\"\u0986\u09aa\u09a8\u09bf \u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09ad\u09be\u09b7\u09be \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"\u0986\u09af\u09be\u09a8 \u09ac\u09be \u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u0986\u0997\u09c7 \u0986\u09b8\u09a8\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09bf \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\",\"You can choose to replace one of calendars with your current location\":\"\u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0995\u099f\u09bf \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u09f7\",\"You can hide prayer times you don't want to see in the main screen here:\":\"\u0986\u09aa\u09a8\u09bf \u098f\u0996\u09be\u09a8\u09c7 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09b0\u09cd\u09a6\u09be\u09af\u09bc \u09af\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09b8\u09ae\u09df \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u09a8 \u09a8\u09be \u09a4\u09be \u09b2\u09c1\u0995\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8:\",\"You can hide prayer times you don't want to see in the widget here:\":\"\u0986\u09aa\u09a8\u09bf \u098f\u0996\u09be\u09a8\u09c7 \u09af\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u0997\u09c1\u09b2\u09bf \u0989\u0987\u099c\u09c7\u099f\u09c7 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u09a8 \u09a8\u09be \u09a4\u09be \u09b2\u09c1\u0995\u09bf\u09af\u09bc\u09c7 \u09b0\u09be\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8:\",\"You can search for your location offline Or use GPS\":\"\u0986\u09aa\u09a8\u09bf \u0985\u09ab\u09b2\u09be\u0987\u09a8\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u09ac\u09be GPS \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u09f7\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"\u098f\u0987 \u09aa\u09cd\u09b0\u09cb\u0997\u09cd\u09b0\u09be\u09ae\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 GNU Affero \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u09b2 \u09aa\u09be\u09ac\u09b2\u09bf\u0995 \u09b2\u09be\u0987\u09b8\u09c7\u09a8\u09cd\u09b8\u09c7\u09b0 \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u09aa\u09be\u09ac\u09c7\u09a8\u0964 \u09a8\u09be \u09aa\u09c7\u09b2\u09c7, https://www.gnu.org/licenses/ \u09a6\u09c7\u0996\u09c1\u09a8\u0964\",\"Your sounds\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09b6\u09ac\u09cd\u09a6\u09b8\u09ae\u09c2\u09b9\",\"abdul_basit_abdus_samad\":\"\u0986\u09ac\u09cd\u09a6\u09c1\u09b2 \u09ac\u09be\u09b8\u09bf\u09a4 \u0986\u09ac\u09cd\u09a6\u09c1\u09b8 \u09b8\u09be\u09ae\u09be\u09a6\",\"about.credits\":\"\u0986\u09af\u09be\u09a8 \u0995\u09a3\u09cd\u09a0\u09c7\u09b0 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0995\u09aa\u09bf\u09b0\u09be\u0987\u099f \u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u099c \u09a8\u09bf\u099c \u09ae\u09be\u09b2\u09bf\u0995\u09a6\u09c7\u09b0\u0964 Translation.io (lingui.js) \u0995\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u099a\u09ae\u09ce\u0995\u09be\u09b0 \u09b8\u09c7\u09ac\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09b6\u09c7\u09b7 \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6\u0964 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0993\u09aa\u09c7\u09a8 \u09b8\u09cb\u09b0\u09cd\u09b8 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc\u09c7\u09b0 \u09b8\u09a6\u09b8\u09cd\u09af\u09a6\u09c7\u09b0 \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6 \u09af\u09be\u09b0\u09be \u098f\u0987 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09a6\u09c1\u09b0\u09cd\u09a6\u09be\u09a8\u09cd\u09a4 \u09b2\u09be\u0987\u09ac\u09cd\u09b0\u09c7\u09b0\u09bf \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u09af\u09be \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u0995\u09c7 \u09b8\u09ae\u09cd\u09ad\u09ac \u0995\u09b0\u09c7\u099b\u09c7\u0964\",\"about.credits.google\":\"\u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09ac\u09c7\u09b6\u09bf\u09b0\u09ad\u09be\u0997 \u0986\u0987\u0995\u09a8 \u0997\u09c1\u0997\u09b2 \u09ae\u09cd\u09af\u09be\u099f\u09c7\u09b0\u09bf\u09af\u09bc\u09be\u09b2 \u0986\u0987\u0995\u09a8 \u09a5\u09c7\u0995\u09c7\u0964\",\"about_settings\":\"\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4\",\"adjustment.hint\":\"\u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u098f\u09ae\u09a8 \u09ae\u09bf\u09a8\u09bf\u099f\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be\",\"after\":\"\u09aa\u09b0\u09c7\",\"ago\":\"\u0986\u0997\u09c7\",\"asr.prayer\":\"\u0986\u09b8\u09b0\",\"backup_settings\":\"\u09ac\u09cd\u09af\u09be\u0995\u0986\u09aa\",\"before\":\"\u0986\u0997\u09c7\",\"calculation_adjustments_settings\":\"\u09b8\u09ae\u09a8\u09cd\u09ac\u09af\u09bc\",\"calculation_advanced_settings\":\"\u0986\u09b0\u0993 \u0997\u09a3\u09a8\u09be\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"calculation_settings\":\"\u09b9\u09bf\u09b8\u09be\u09ac\",\"counter.fast\":\"\u09b8\u09bf\u09df\u09be\u09ae\",\"date.day\":\"\u09a6\u09bf\u09a8\",\"date.hour\":\"\u0998\u09a8\u09cd\u099f\u09be\",\"date.minute\":\"\u09ae\u09bf\u09a8\u09bf\u099f\",\"date.second\":\"\u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc\",\"dev_settings\":\"\u09a1\u09c7\u09ad\u09c7\u09b2\u09aa\u09be\u09b0\",\"dhuhr.prayer\":\"\u09af\u09cb\u09b9\u09b0\",\"display_settings\":\"\u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8\",\"fajr.prayer\":\"\u09ab\u099c\u09b0\",\"favorite_location\":\"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09b8\u09cd\u09a5\u09be\u09a8\u09b8\u09ae\u09c2\u09b9\",\"forces all numbers to be in the selected system\":\"\u09b8\u09ae\u09b8\u09cd\u09a4 \u09b8\u0982\u0996\u09cd\u09af\u09be\u0995\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u09c7 \u09a5\u09be\u0995\u09a4\u09c7 \u09ac\u09be\u09a7\u09cd\u09af \u0995\u09b0\u09c7\",\"from North\":\"\u0989\u09a4\u09cd\u09a4\u09b0 \u09a5\u09c7\u0995\u09c7\",\"from settings\":\"\u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09a5\u09c7\u0995\u09c7\",\"fullscreen_alarm\":\"\u0986\u09af\u09be\u09a8 \u09b9\u099a\u09cd\u099b\u09c7\",\"hijri.adjustment.hint\":\"\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u09a6\u09bf\u09a8\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be\",\"home\":\"\u09b9\u09cb\u09ae\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"\u09af\u09a6\u09bf \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09be \u09b9\u09af\u09bc, \u09a4\u09be\u09b9\u09b2\u09c7 \u09af\u09c7 \u0995\u09cb\u09a8\u09cb \u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09ac\u09be \u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09be\u09af\u09bc \u098f\u0995 \u0998\u09a3\u09cd\u099f\u09be \u0986\u0997\u09c7 \u098f\u0995\u099f\u09bf \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09ac\u09c7\",\"intro\":\"\u09ad\u09c2\u09ae\u09bf\u0995\u09be\",\"is prayer time hidden?\":\"\u09a8\u09be\u09ae\u09be\u099c\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u0995\u09bf \u09b2\u09c1\u0995\u09be\u09a8\u09cb \u0986\u099b\u09c7?\",\"isha.prayer\":\"\u0987\u09b6\u09be\",\"later\":\"\u09aa\u09b0\u09c7\",\"location_settings\":\"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\",\"maghrib.prayer\":\"\u09ae\u09be\u0997\u09b0\u09bf\u09ac\",\"masjid_an_nabawi\":\"\u09ae\u09b8\u099c\u09bf\u09a6\u09c7 \u09a8\u09ac\u09ac\u09c0\",\"minutes\":\"\u09ae\u09bf\u09a8\u09bf\u099f\",\"moazen_zade\":\"\u09ae\u09cb\u09af\u09bc\u09be\u099c\u09c7\u09a8 \u09af\u09c7\u0987\u09a1\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"\u09ae\u09be\u09b8\u09bf\u0995 \u09ad\u09bf\u0989\",\"muezzin_settings\":\"\u09ae\u09c1\u09af\u09bc\u09be\u099c\u09cd\u099c\u09bf\u09a8\",\"notification_advanced_settings\":\"\u09ac\u09bf\u09b6\u09c7\u09b7 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"notification_settings\":\"\u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u098f\u09ac\u0982 \u09b6\u09ac\u09cd\u09a6\",\"qada_counter\":\"\u0995\u09be\u09af\u09be \u0995\u09be\u0989\u09a8\u09cd\u099f\u09be\u09b0\",\"qibla_compass\":\"\u0995\u09bf\u09ac\u09b2\u09be \u0995\u09ae\u09cd\u09aa\u09be\u09b8\",\"qibla_finder\":\"\u0995\u09bf\u09ac\u09b2\u09be \u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u0995\u09be\u09b0\u09c0\",\"qibla_map\":\"\u0995\u09bf\u09ac\u09b2\u09be \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0\",\"ragheb_mustafa_ghalwash\":\"\u09b0\u09be\u0997\u09c7\u09ac \u09ae\u09cb\u09b8\u09cd\u09a4\u09ab\u09be \u0997\u09be\u09b2\u0993\u09af\u09bc\u09be\u09b6\",\"reminders_settings\":\"\u09b0\u09bf\u09ae\u09be\u0987\u09a8\u09cd\u09a1\u09be\u09b0\u09b8\u09ae\u09c2\u09b9\",\"settings\":\"\u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"should notification widget be shown?\":\"\u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u0989\u0987\u099c\u09c7\u099f \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u0989\u099a\u09bf\u09a4?\",\"should {prayerName} be hidden?\":[[\"prayerName\"],\" \u09b2\u09c1\u0995\u09be\u09a8\u09cb \u0989\u099a\u09bf\u09a4?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"\u09af\u09c7\u09b9\u09c7\u09a4\u09c1 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u0995\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09a1\u09be\u09b0\u099f\u09bf \u09aa\u09cd\u09b0\u09be\u0995-\u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u098f\u09ac\u0982 \u099a\u09be\u0981\u09a6 \u09a6\u09c7\u0996\u09be\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7 \u09a8\u09af\u09bc, \u09a4\u09be\u0987 \u098f\u099f\u09bf \u09b0\u09ae\u099c\u09be\u09a8\u09c7\u09b0 \u09b6\u09c1\u09b0\u09c1 \u098f\u09ac\u0982 \u09b6\u09c7\u09b7\u09c7\u09b0 \u09ad\u09c1\u09b2 \u09a4\u09be\u09b0\u09bf\u0996 \u09a6\u09c7\u0996\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\",\"sunnah.midnight\":\"\u09ae\u09a7\u09cd\u09af\u09b0\u09be\u09a4\",\"sunnah.tahajjud\":\"\u09a4\u09be\u09b9\u09be\u099c\u09cd\u099c\u09c1\u09a6\",\"sunrise\":\"\u09b8\u09c2\u09b0\u09cd\u09af\u09cb\u09a6\u09af\u09bc\",\"sunset\":\"\u09b8\u09c2\u09b0\u09cd\u09af\u09be\u09b8\u09cd\u09a4\",\"widget_settings\":\"\u0989\u0987\u099c\u09c7\u099f \u09b8\u09c7\u099f\u09bf\u0982\u09b8\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" \u09ae\u09bf\u09a8\u09bf\u099f \u09aa\u09b0\u09c7 \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" \u09ae\u09bf\u09a8\u09bf\u099f \u0986\u0997\u09c7 \",[\"prayer\"]],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09ac\u09c7\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" \u09b8\u09be\u0989\u09a8\u09cd\u09a1 \u09ac\u09be\u099c\u09be\u09a8\u09cb \u09b9\u09ac\u09c7\"]}")}),637,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.messages=void 0;e.messages=JSON.parse("{\"10 min\":\"Dakika 10\",\"15 min\":\"Dakika 15\",\"30 min\":\"Dakika 30\",\"30 minutes is added to Isha time during Ramadan in this method\":\"Dakika 30 huongezwa kwa wakati wa Isha wakati wa Ramadhani kwa njia hii\",\"5 min\":\"Dakika 5\",\"60 min\":\"Dakika 60\",\"90 min\":\"Dakika 90\",\"ADHAN_CHANNEL_NAME\":\"Adhana\",\"Abyad\":\"Abyad\",\"Accuracy\":\"Usahihi\",\"Ad-Free\":\"Bila Matangazo\",\"Adaptive Charging\":\"Uingizo wa Moto kwa Betri Inajirekebisha\",\"Add\":\"Ongeza\",\"Add Custom Adhan\":\"Ongeza Adhana Maalum\",\"Add Custom Audio\":\"Ongeza Sauti Maalum\",\"Add Reminder\":\"Ongeza Kikumbusho\",\"Add Silent Mode\":\"Add Silent Mode\",\"Add new counter\":\"Ongeza kihesabu kipya\",\"Add new location\":\"Ongeza eneo jipya\",\"Adhan\":\"Adhana\",\"Adhan audio file is not downloaded yet\":\"Faili ya sauti ya Adhan bado haijapakuliwa\",\"Adjustments\":\"Marekebisho\",\"Advanced\":\"Endelevu\",\"Advanced Calculation Settings\":\"Mipangilio ya Hesabu Endelevu\",\"Advanced Settings\":\"Mipangilio Endelevu\",\"Ahmer\":\"Ahmer\",\"Al-Azan\":\"Al-Azan\",\"Al-Azan - Prayer Times\":\"Al-Azan - Nyakati za Salaa\",\"Al-Azan is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details.\":\"Al-Azan inasambazwa kwa matumaini kwamba itakuwa na manufaa, lakini BILA UDHAMINI WOWOTE; bila hata dhamana iliyodokezwa ya UUZAJI au KUFAA KWA KUSUDI FULANI. Tazama Leseni ya Umma ya GNU Affero kwa maelezo zaidi.\",\"Al-Azan is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License (v3.0) as published by the Free Software Foundation.\":\"Al-Azan ni programu isiyolipishwa: unaweza kuisambaza tena na/au kuirekebisha chini ya masharti ya GNU Affero General Public License (v3.0) kama ilivyochapishwa na Free Software Foundation.\",\"Alarms Permission\":\"Ruhusa ya Kengele\",\"All data provided to Al-Azan is only stored locally in your device. Your data is not uploaded anywhere. The developers of Al-Azan do not have access to it. Your data is not shared with any third parties. Al-Azan does not include any advertisement libraries or any 3rd party tracking (analytics) code, such as Google Analytics or Facebook SDK.\":\"Data yote iliyotolewa kwa Al-Azan inahifadhiwa ndani ya kifaa chako pekee. Data yako haijapakiwa popote. Watengenezaji wa Al-Azan hawana ufikiaji wake. Data yako haijashirikiwa na wahusika wengine. Al-Azan haijumuishi maktaba zozote za matangazo au msimbo wowote wa ufuatiliaji (analytics) wa watu wengine, kama vile Google Analytics au Facebook SDK.\",\"An error occured while playing the current track\":\"Hitilafu ilitokea wakati wa kucheza wimbo wa sasa\",\"App features\":\"Vipengele vya programu\",\"Arabic\":\"Kiarabu\",\"Are you sure you want to delete \\\"{0}\\\" ?\":[\"Je, una uhakika unataka kufuta \\\"\",[\"0\"],\"\\\" ?\"],\"Are you sure you want to delete \\\"{itemName}\\\" ?\":[\"Je, una uhakika unataka kufuta \\\"\",[\"itemName\"],\"\\\" ?\"],\"Are you sure you want to delete this?\":\"Je, una uhakika unataka kufuta hii?\",\"Asr Calculation\":\"Hesabu ya Asr\",\"At least one prayer time must be shown\":\"Lazima wakati mmoja wa salaa uonyeshwe\",\"Attention\":\"Tahadhari\",\"Auto (Default)\":\"Otomatiki (Chaguomsingi)\",\"Bypass \\\"Do Not Disturb\\\"?\":\"Ruka \\\"Usisumbue\\\"?\",\"Calculating Adhan has many different methods. Each method provides different results. It is your responsibility to search and use the right method.\":\"Kukokotoa Adhana kuna njia nyingi tofauti. Kila njia hutoa matokeo tofauti. Ni jukumu lako kutafuta na kutumia njia sahihi.\",\"Calculation\":\"Hesabu\",\"Calculation Method\":\"Njia ya Kuhesabu\",\"Calendar\":\"Kalenda\",\"Cancel\":\"Ghairi\",\"Cancel Alarm\":\"Ghairi Kengele\",\"Cancel download\":\"Ghairi upakuaji\",\"Choose Asr Calculation Madhab\":\"Chagua Madhab ya Kuhesabu Asr\",\"Choose Calculation Method\":\"Chagua Njia ya Kuhesabu\",\"Choose High Latitude Setting\":\"Chagua Mpangilio wa Latitudo ya Juu\",\"Choose Language\":\"Chagua Lugha\",\"Choose Polar Resolution\":\"Chagua Mgawo ya Polar\",\"Choose Shafaq method\":\"Chagua njia ya Shafaq\",\"Choose calculation rounding method\":\"Chagua mwenendo wa hesabu karibia\",\"Choose calendar type\":\"Chagua aina ya kalenda\",\"Choose lunar calendar language\":\"Chagua lugha ya kalenda ya mwezi\",\"Choose midnight calculation method\":\"Chagua njia ya kuhesabu katikati ya usiku (usiku wa manane)\",\"Choose numbering system\":\"Chagua mwenendo wa unambarishaji\",\"Choose which calendar to replace\":\"Chagua ni kalenda ipi ya kubadilisha\",\"City/Area\":\"Jiji/Eneo\",\"Clear the coordinates\":\"Futa majiranukta ya kijiografia\",\"Clear the location\":\"Futa eneo\",\"Clipboard data does not contain coordinates\":\"Tundiko la maandishi haina majiranukta ya kijiografia\",\"Close\":\"Funga\",\"Closest City\":\"Mji Uliokaribu\",\"Closest Date\":\"Tarehe Ilioyokaribu\",\"Compass Lock\":\"Funga Kielekezi\",\"Compass sensor unavailable\":\"Kihisi cha mwelekeo hakipatikani\",\"Confirm\":\"Thibitisha\",\"Continuous\":\"Endelea\",\"Coordinates updated\":\"Majiranukta ya kijiografia zimesasishwa\",\"Copy\":\"Nakili\",\"Count\":\"Hesabu\",\"Country\":\"Nchi\",\"Custom\":\"Maalum\",\"Custom sounds and muezzins will not be exported\":\"Sauti maalum na mwadhini hazitatowa nje\",\"Custom upcoming alarm time\":\"Saa maalum ya kengele yajayo\",\"Dark\":\"Giza\",\"Date\":\"Tarehe\",\"Decrement\":\"Punguza\",\"Default\":\"Chaguomsingi\",\"Delete\":\"Futa\",\"Depending on your device and android version, Sometimes your device may kill the app in the background to save battery. This can prevent alarms/notifications from being delivered.\":\"Kutegemea chombo chako na toleo la Android, muda mwingine, chombo chako kinaweza kuua programu kuokoa moto wa betri.  Hii inaweza kuzuia kengele na vijulishi kuwasilishiana.\",\"Deselect as Fajr Adhan\":\"Kanusha Adhana ya Alfajiri\",\"Device sounds\":\"Sauti za chombo\",\"Disabled\":\"Imelemazwa\",\"Disclaimer\":\"Uhalali\",\"Dismiss\":\"Puuzilia\",\"Diyanet method provided in Al-Azan is an approximation of the official times. Since there's not enough documentation available on how the times are exactly calculated, times may not align with the official website, especially out of Turkey.\":\"Diyaneti ilio kwenye Al-Azan ni kadirio wa mda halali. Kwa sababu uandikaji wa hati ya jinsi gani mida inavyo piga hesabu ni chache, mida haitatukia kabisa na tovuti halisi, sana nje ya Uturuki.\",\"Diyanet \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Turkey\":\"Diyaneti \u0130\u015fleri Ba\u015fkanl\u0131\u011f\u0131, Uturuki\",\"Doesn't use any kind of trackers\":\"Haitumi aina yeyote ya ufuatiliaji\",\"Don't ask again\":\"Usiulize tena\",\"Don't show again\":\"Usionyeshe tena\",\"Don't show alarm screen?\":\"Usionyeshe kionyeshi cha kengele?\",\"Done\":\"Kamilifu\",\"Download\":\"Pakua\",\"Eastern Arabic\":\"Kiarabu cha Mashariki\",\"Edit\":\"Hariri\",\"Edit Calculation Parameters\":\"Hariri Hiari za Kuhesabu\",\"Edit Counter\":\"Hariri Kaunta\",\"Edit Location\":\"Hariri Eneo\",\"Edit Reminder\":\"Hariri Ukumbusho\",\"Edit Silent Mode\":\"Edit Silent Mode\",\"Egyptian General Survey Authority\":\"Mamlaka ya Kijumla Mkuu wa Misri\",\"Enabled\":\"Imewashwa\",\"End after prayer (minutes)\":\"End after prayer (minutes)\",\"Error getting clipboard data\":\"Hitilafu katika kupata data ya ubao wa kunakili\",\"Error in loading countries\":\"Hitilafu katika kupakia nchi\",\"Error while downloading audio\":\"Hitilafu wakati wa kupakua sauti\",\"Error while getting coordinates\":\"Hitilafu wakati wa kupata majiranukta ya kijiografia\",\"Error: failed to open file\":\"Hitilafu: imeshindwa kufungua faili\",\"Ethiopic\":\"Kiethiopia\",\"Export app data\":\"Hamisha data ya programu\",\"Export data\":\"Hamisha data\",\"Fajr Angle\":\"Pembe ya Fajr\",\"Find My Location\":\"Tafuta Mahali Pangu\",\"Fix Common Problems\":\"Rekebisha Matatizo ya Kawaida\",\"France angle 15\":\"Pembe ya Ufaransa 15\",\"France angle 18\":\"Pembe ya Ufaransa 18\",\"Friday\":\"Ijumaa\",\"General (default)\":\"Jumla (chaguomsingi)\",\"Getting coordinates\":\"Kupata majiraukta ya kijiografia\",\"Got it\":\"Nimeelewa\",\"Gregorian\":\"Gregorian\",\"Gulf region\":\"Eneo la Ghuba\",\"Hanafi\":\"Hanafi\",\"Hidden?\":\"Imefichwa?\",\"Hide Prayer Times\":\"Ficha Nyakati za Maombi\",\"Hide times you don't need\":\"Ficha nyakati ambazo hauitaji\",\"High\":\"Juu\",\"High Latitude\":\"Latitudo ya Juu\",\"Highlight current prayer\":\"Angazia sala ya sasa\",\"Home\":\"Nyumbani\",\"Homescreen and notification Widgets\":\"Kiomyesho cha nyumbani na vipande vya ujulisho\",\"However, When using online services, such as Qibla map, app may transmit minimum necessary data that may or may not uniquely identify you. Please keep this in mind while using the app.\":\"Hata hivyo, wakati uatumia huduma za mtandao, kama ramani ya Kibla, programu inaweza kutuma habari chache inayohitaji zinaweza kukutambia. Tafadhali tilia mlaamani wakati unapotumia programu.\",\"I Understand\":\"Na Elewa\",\"IMPORTANT_CHANNEL_ID\":\"Muhimu\",\"If enabled, when a notification is shown, it will contain info for the next prayer time\":\"Kama kimewezeshwa, wakati ujulisho unaonyeshwa, itahusisha habari ya mda wa salaa ufuatao\",\"If you have activated \u201cBackup & Reset\u201d in your phone settings (Settings / Backup & Reset / Back up my data), you should be aware that Android itself (not Al-Azan) will periodically save a copy of your phone\u2019s data in Google\u2019s servers. This allows Android to recover your data in case your device gets damaged, or you purchase a new device. The developers of Al-Azan do not have access to this data.\":\"Kama umewezesha \\\"Hifadhi na Rejesha\\\" kwenye marekebisho ya simu (Mipngilio / Hifadhi na Rudish Upya / Hifadhi data), lazima ujue kwamba Android yenyewe (si Al-Azan) itahifadhi data kutoka simu yako kwa seva za Google. Simu inaharibiwa au ununue simu nyingine, Android inaweza kupakua data yako.  Waandishi wa Al-Azan hawana uwexo wa kupata data hilo.\",\"If you still had problem with app stopping after some time, please visit dontkillmyapp.com for more solutions.\":\"Kama bado ulikuwa na tatizo ya programu hii kusimama baada ya mda, tafadhali tembelea mtandao dontkillmyap.com kwa marekebisho zaidi.\",\"If you want to make sure the app can work reliably, You have to disable power optimization for this app. You can open related settings using the button below.\":\"Kama unataka kuhakikisha programu inaweza kufanya kwa utegemezi lazima uzime sehemu inayosimamia moto ya programu hii. Unaweza kufungua mipangilio hizo na kibonye kilicho hapo chini.\",\"If your device has adaptive charging, like Google Pixel, and you don't want adhan or reminders to be recognized as an alarm, you can enable this option.\":\"Kama chombo chako kina utiaji moto llevu kama Google Pixek na hutaki adhan au vikumbushi kutambulika kama kengele, wezesha chaguo huu.\",\"Import\":\"Ingiza\",\"Import app data\":\"Ingiza data ya programu\",\"Import successful\":\"Ingizo ya data imefaulu\",\"In addition to five daily prayers, it has settings for Sunrise, Sunset, Midnight and Night Prayer (Tahajjud)\":\"Ina sala tano za kila siku, na pia ina mipangilio ya Kuchomoza Jua, Kuzama kwa Jua, Usiku wa manane na Sala ya Usiku (Tahajjud)\",\"Increment\":\"Ongeza\",\"Info\":\"Taarifa\",\"Internet connection\":\"Muunganisho wa mtandao\",\"Internet connection is necessary for qibla map to work. Please enable your wifi or mobile data and try again.\":\"Muunganisho wa mtandao ni muhimu ili ramani ya kibla ifanye kazi. Tafadhali washa wifi yako au data ya simu na ujaribu tena.\",\"Iran\":\"Iran\",\"Is localized in English, Persian, Arabic, Turkish, Indonesian, French, Urdu, Hindi, German, Bosnian, Vietnamese, Bangla\":\"Imejanibishwa katika Kiingereza, Kiajemi, Kiarabu, Kituruki, Kiindonesia, Kifaransa, Kiurdu, Kihindi, Kijerumani, Kibosnia, Kivietinamu, Bangla\",\"Isha Angle\":\"Pembe ya Isha\",\"Isha Interval\":\"Muda wa Isha\",\"Islamic\":\"Kiislamu\",\"Islamic (Saudi Arabia sighting)\":\"Kiislamu (Saudi Arabia kuona)\",\"Islamic (Umm al-Qura)\":\"Kiislamu (Umm al-Qura)\",\"Islamic (civil)\":\"Kiislamu (kiraia)\",\"Islamic (tabular)\":\"Kiislamu (lioorodheshwa)\",\"Islamic Society of North America (ISNA)\":\"Jumuiya ya Kiislamu ya Amerika Kaskazini (ISNA)\",\"It seems that you have imported a backup, don't forget to disable battery optimizations for this app\":\"Inaonekana umeleta nakala rudufu, usisahau kuzima uboreshaji wa betri kwa programu hii\",\"Just now\":\"Sasa hivi\",\"Kementrian Agama Republik Indonesia (KEMENAG)\":\"Kementrian Agama Republik Indonesia (KEMENAG)\",\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\":\"Kementrian Hal Ehwal Ugama (Brunei Darussalam)\",\"Kuwait\":\"Kuwait\",\"Label\":\"Lebo\",\"Language\":\"Lugha\",\"Latitude\":\"Latitudo\",\"Latitude is invalid\":\"Latitudo ni batili\",\"License\":\"Leseni\",\"Light\":\"Mwanga\",\"Light and Dark theme\":\"Mandhari isiyoiva na giza\",\"Light/Dark theme\":\"Mandhari isiyoiva/giza\",\"List is empty\":\"Orodha ni tupu\",\"Loading\":\"Inapakia\",\"Location\":\"Eneo\",\"Location settings\":\"Mipangilio ya eneo\",\"Longitude\":\"Longitudo\",\"Longitude is invalid\":\"Longitude ni batili\",\"Low\":\"Chini\",\"Lunar Calendar\":\"Kalenda ya Mwezi\",\"Lunar Calendar Language\":\"Lugha ya Kalenda ya Mwezi\",\"Maghrib Angle\":\"Pembe ya Maghrib\",\"Make a Copy\":\"Tengeneza Nakala\",\"Many options for Adhan (\u0627\u0630\u0627\u0646) calculation\":\"Chaguo nyingi za hesabu ya Adhan (\u0627\u0630\u0627\u0646).\",\"Medium\":\"Kati\",\"Middle of the Night\":\"Katikati ya Usiku\",\"Midnight Method\":\"Njia ya Usiku wa manane\",\"Ministry of Religious Affairs and Wakfs, Algeria\":\"Wizara ya Masuala ya Kidini na Wakf, Algeria\",\"Ministry of Religious Affairs of Tunisia\":\"Wizara ya Masuala ya Kidini ya Tunisia\",\"Mobile Data\":\"Data ya Simu\",\"Modified\":\"Imebadilishwa\",\"Monday\":\"Jumatatu\",\"Moonsighting Committee\":\"Kamati ya Uangalizi wa Mwezi\",\"Muslim World League\":\"Umoja wa Kiislamu Duniani\",\"Name\":\"Jina\",\"Nearest\":\"Karibu zaidi\",\"New Counter\":\"Kaunta Mpya\",\"New Location\":\"Mahali Mpya\",\"New Reminder\":\"Kikumbusho Kipya\",\"New Silent Mode\":\"New Silent Mode\",\"Next\":\"Inayofuata\",\"Next Day\":\"Kesho yake\",\"Next Month\":\"Mwezi ujao\",\"No\":\"Hapana\",\"No Data\":\"Hakuna Data\",\"No Results\":\"Hakuna Matokeo\",\"None\":\"Tupu\",\"None (Automatic)\":\"Tupu (Inayojiendesha)\",\"Normal mode restored\":\"Normal mode restored\",\"Not now\":\"Si sasa\",\"Note that due to software and hardware errors, Qibla direction shown by this app, particularly in compass mode, can be wrong.\":\"Tilia maanani, kwamba wa hitilafu za programmu na simu, mwelekeo wa Kibla unaoonyeshwa unaweza sio sahihi, hasa katika hali ya kielekezi.\",\"Notification\":\"Ujulisho\",\"Notification & Sound\":\"Ujulisho na Sauti\",\"Notifications Permission\":\"Ruhusa ya Ujulisho\",\"Numbering system\":\"Mwenendo wa unambarishaji\",\"Off\":\"Zime\",\"Okay\":\"Sawa\",\"On Android 12 and newer, the app also needs alarms permission to work properly, so you must allow this as well.\":\"Kwenye Android 12 na mpya muundo huu, pia programmu inahitaji ruhusu ya kengele kufanya kazi, kwa hio lazima uruhusu pia.\",\"Once\":\"Mara moja\",\"One-Seventh of the Night\":\"Moja kwa Saba (1/7) ya Usiku Huo\",\"Only once?\":\"Mara moja tu?\",\"Only six items can be shown at the same time\":\"Sehemu sita zinaweza onyeshwa kwa wakati mmoja\",\"Open Battery Optimization Settings\":\"Fungua Mipangilio ya Kuzidisha Nguvu ya Betri\",\"Open Power Manager Settings\":\"Fungua Meneja wa Utumiaji wa Stima\",\"Open source repository\":\"Hifadhi ya programmu wazi\",\"Open-source\":\"Programmu-wazi\",\"Options\":\"Chaguo\",\"Or if you have a backup, you can import it\":\"Ama kama unahifadhi, unaweza agiza kutoka nje\",\"Orientation Lock: Landscape\":\"Funga Utambulisho: Ulazi\",\"Orientation Lock: Portrait\":\"Kufuli la Mwelekeo: Simami\",\"Orientation: Unlocked\":\"Pembe ya Utambulisho: Imefunguliwa\",\"Other magnetic devices may interfere with your phone's compass and your compass may need calibration.\":\"Vifaa vingine vyenye sumaku vinaweza kuhitalafiana na kielekezi kwenye simu yako na kielekzi chako kitahitaji urekebishaji.\",\"PRAYER_MODE_CHANNEL_NAME\":\"Silent Mode\",\"PRE_ADHAN_CHANNEL_NAME\":\"Adhan ijayu\",\"PRE_REMINDER_CHANNEL_NAME\":\"Ukumbusho ujao\",\"Pakistan\":\"Pakistani\",\"Paste\":\"Bandika\",\"Persian\":\"Kiajemi\",\"Phone State Permission\":\"Ruhusa ya Jimbo la Simu\",\"Play\":\"Cheza\",\"Please enable location service\":\"Tafadhali wezesha huduma ya eneo\",\"Please note that enabling this option may cause adhan and reminders to fire with a delay or not at all in some cases. Enable this with caution.\":\"Tafadhali kumbuka kuwa kuwezesha chaguo hili kunaweza kusababisha adhana na vikumbusho kufyatua kwa kuchelewa au kutofanya kazi kabisa katika baadhi ya matukio. Wezesha hii kwa tahadhari.\",\"Polar Resolution\":\"Mgawo ya Polar\",\"Power Manager\":\"Meneja wa Utumiaji wa Betri\",\"Prayer\":\"Prayer\",\"Prayer Times\":\"Nyakati za Salaa\",\"Prayer list\":\"Orodha ya salaa\",\"Press to search\":\"Bonyeza ili kutafuta\",\"Press to select a method\":\"Bonyeza ili kuchagua mbinu\",\"Prev Day\":\"Siku Iliyotangulia\",\"Prev Month\":\"Mwezi Uliopita\",\"Privacy Policy\":\"Sera ya Faragha\",\"Privacy focused open-source muslim Adhan (islamic prayer times) and qibla app\":\"Faragha iliyolenga chanzo huria ya Adhan ya Kiislamu (nyakati za maombi ya Kiislamu) na programu ya kibla\",\"Qada counter\":\"Kaunta ya Qada\",\"Qatar\":\"Qatar\",\"Qibla\":\"Kibla\",\"Qibla finder\":\"Kitafuta cha Kibla\",\"Qibla finder needs location service. If not enabled, location from app settings will be used.\":\"Kitafutaji cha Kibla kinahitaji huduma ya eneo. Ikiwa haijawashwa, eneo kutoka kwa mipangilio ya programu litatumika.\",\"Qibla map is currently unavailable in F-Droid builds. It may become available in future updates.\":\"Ramani ya Kibla haipatikani kwa sasa katika miundo ya F-Droid. Inaweza kupatikana katika masasisho yajayo.\",\"REMINDER_CHANNEL_NAME\":\"Kikumbusho\",\"Ramadan is ending,\":\"Ramadhan inaisha,\",\"Ramadan is near,\":\"Ramadhan iko karibu,\",\"Remaining till\":\"Imebaki mpaka\",\"Remind me next year\":\"Nikumbushe mwaka ujao\",\"Reminder\":\"Kikumbusho\",\"Repeat\":\"Rudia\",\"Required settings are incomplete. For app to show prayer times, You have to configure it from settings later.\":\"Mipangilio inayohitajika haijakamilika. Ili programu ionyeshe nyakati za maombi, inabidi uisanidi kutoka kwa mipangilio baadaye.\",\"Rounding Method\":\"Njia ya Kuzunguka\",\"Samsung devices have their own custom Power Manager called \\\"Device Care\\\".\\nAfter pressing the button below, You will be navigated to the Battery menu of Device Care.\\nIn the Battery menu tap \\\"App power management\\\", and then tap \\\"Apps that won't be put to sleep\\\",\\nand add this app to the list.\":\"Vifaa vya Samsung vina Kidhibiti cha Nishati maalum kinachoitwa \\\"Utunzaji wa Kifaa\\\". Baada ya kubofya kitufe kilicho hapa chini, Utaelekezwa kwenye menyu ya Betri ya Utunzaji wa Kifaa. Katika menyu ya Betri gusa \\\"Udhibiti wa nguvu ya programu\\\", kisha uguse \\\"Programu ambazo hazitalala\\\", na uongeze programu hii kwenye orodha.\",\"Saturday\":\"Jumamosi\",\"Saudi Arabia\":\"Saudi Arabia\",\"Search\":\"Tafuta\",\"Secondary Calendar\":\"Kalenda ya Sekondari\",\"See favorite locations\":\"Angalia maeneo unayopenda\",\"Select as Fajr Adhan\":\"Chagua kama Fajr Adhan\",\"Select different Adhan audio for Fajr namaz\":\"Chagua sauti tofauti za Adhan kwa Fajr namaz\",\"Selected\":\"Imechaguliwa\",\"Selected as adhan\":\"Imechaguliwa kama adhana\",\"Selected as fajr adhan\":\"Imechaguliwa kama fajr adhan\",\"Selecting a name is required\":\"Inahitajika kuchagua jina\",\"Set custom Adhan audio\":\"Weka sauti maalum ya Adhana\",\"Set reminders before or after a prayer time\":\"Weka vikumbusho kabla au baada ya muda wa maombi\",\"Shafaq\":\"Shafaq\",\"Shafaq is used by the MoonsightingCommittee method to \\ndetermine what type of twilight to use in order to\\ndetermine the time for Isha\":\"Shafaq hutumiwa na njia ya Kamati ya Kutazama Mwezi ili kubainisha ni aina gani ya machweo ya kutumia ili kubainisha wakati wa Isha.\",\"Shafi, Maliki, Hanbali (Default)\":\"Shafi, Maliki, Hanbali (Chaguomsingi)\",\"Shia Ithna Ashari, Leva Institute, Qum\":\"Shia Ithna Ashari, Taasisi ya Leva, Qum\",\"Shia, Institute of Geophysics, University of Tehran\":\"Shia, Taasisi ya Jiofizikia, Chuo Kikuu cha Tehran\",\"Should app highlight current prayer instead of next prayer?\":\"Je, programu inapaswa kuangazia maombi ya sasa badala ya sala inayofuata?\",\"Should app still play adhan when \\\"Do Not Disturb\\\" is active?\":\"Je, programu inapaswa kucheza adhana wakati \\\"Usisumbue\\\" inatumika?\",\"Should app stop playing adhan when the volume button is pressed?\":\"Je, programu inapaswa kuacha kucheza adhana wakati kitufe cha sauti kimebonyezwa?\",\"Should phone vibrate when adhan or reminder starts playing?\":\"Je, simu inapaswa kutetema adhana au kikumbusho kinapoanza kucheza?\",\"Show Adhan Options\":\"Onyesha Chaguzi za Adhana\",\"Show Today\":\"Onyesha Leo\",\"Show countdown?\":\"Onyesha hesabu?\",\"Show current\":\"Onyesha sasa\",\"Show me\":\"Nionyeshe\",\"Show next in notification?\":\"Ungependa kuonyesha kinachofuata katika arifa?\",\"Show notification widget?\":\"Ungependa kuonyesha kipande kia ukumbushu?\",\"Show settings\":\"Onyesha mipangilio\",\"Show upcoming alarm notification?\":\"Ungependa kuonyesha arifa ya kengele inayokuja?\",\"Silent\":\"Kimya\",\"Silent Mode Ended\":\"Silent Mode Ended\",\"Silent Mode Name\":\"Silent Mode Name\",\"Silent Mode Started\":\"Silent Mode Started\",\"Silent mode activated\":\"Silent mode activated\",\"Since we don't use any kind of tracker or crash analytics, please report any problem or suggestion you have on our github repo\":\"Kwa kuwa hatutumii aina yoyote ya kifuatiliaji au uchanganuzi wa ajali, tafadhali ripoti tatizo au pendekezo lolote ulilonalo kwenye github repo yetu.\",\"Singapore\":\"Singapore\",\"Skip\":\"Ruka\",\"Software License\":\"Leseni ya Programu\",\"Solar Hijri\":\"Hijri ya jua\",\"Some devices need extra settings inside their Power Manager \\nto prevent the app from getting killed in the background.\\nIn that case disable any power saving option for the app.\":\"Baadhi ya vifaa vinahitaji mipangilio ya ziada ndani ya Kidhibiti cha Nishati ili kuzuia programu isiuawe chinichini. Katika hali hiyo afya chaguo lolote la kuokoa nishati kwa programu.\",\"Sound\":\"Sauti\",\"Spiritual Administration of Muslims of Russia\":\"Utawala wa Kiroho wa Waislamu wa Urusi\",\"Start before prayer (minutes)\":\"Start before prayer (minutes)\",\"Status\":\"Hali\",\"Stop\":\"Acha\",\"Sunday\":\"Jumapili\",\"Sunset to Fajr (Default)\":\"Machweo hadi Fajr (Chaguomsingi)\",\"Sunset to Sunrise\":\"Machweo hadi Macheo\",\"System Default\":\"Chaguomsingi ya Mfumo\",\"Tahajjud time mentioned in the app is the last third of the night\":\"Wakati wa Tahajjud uliotajwa katika programu ni theluthi ya mwisho ya usiku\",\"Thai Solar\":\"Sola ya Thai\",\"Thanks for choosing this app! There are things you need to do before you can start using this app.\":\"Asante kwa kuchagua programu hii! Kuna mambo unayohitaji kufanya kabla ya kuanza kutumia programu hii.\",\"The Gulf Region (Dubai)\":\"Mkoa wa Ghuba (Dubai)\",\"The app's lunar calendar is pre-calculated and may not be accurate because it isn't based on moon sightings. This is especially important to note for the start and end of Ramadan.\":\"\\nKalenda ya mwandamo ya programu huhesabiwa mapema na huenda isiwe sahihi kwa sababu haitegemei mwonekano wa mwezi. Hili ni muhimu sana kuzingatiwa kwa mwanzo na mwisho wa Ramadhan.\",\"The text found in this website and in the app may not be accurate in other languages, so in any case, only English version should be considered.\":\"Maandishi yanayopatikana katika tovuti hii na katika programu yanaweza yasiwe sahihi katika lugha nyingine, kwa hiyo kwa hali yoyote, toleo la Kiingereza pekee linapaswa kuzingatiwa.\",\"The type of calendar that is shown on top of home screen and beside lunar calendar in widgets\":\"Aina ya kalenda inayoonyeshwa juu ya skrini ya kwanza na kando ya kalenda ya mwezi katika wijeti\",\"The type of lunar calendar shown in main screen and widgets\":\"Aina ya kalenda ya mwezi inayoonyeshwa kwenye skrini kuu na wijeti\",\"Theme Color\":\"Rangi ya Mandhari\",\"Thursday\":\"Alhamisi\",\"Time\":\"Wakati\",\"Time condition\":\"Hali ya wakati\",\"Time format\":\"Umbizo la wakati\",\"Time list\":\"Orodha ya wakati\",\"To calculate Adhan, We need your location. You can use the \\\"Find My Location\\\" button, or use the country and city/area search, or enter your coordinates manually.\":\"Ili kukokotoa Adhana, Tunahitaji eneo lako. Unaweza kutumia kitufe cha \\\"Pata Mahali Pangu\\\", au utumie utafutaji wa nchi na jiji/eneo, au uweke majiranukta ya kijiografia vyako wewe mwenyewe.\",\"To see notifications about adhan, we need your permission.\":\"Ili kuona arifa kuhusu adhana, tunahitaji ruhusa yako.\",\"To stop playing adhan when you receive a call, we need to read your phone state. not allowing this permission simply disables the feature.\":\"Ili kuacha kucheza adhana unapopokea simu, tunahitaji kusoma hali ya simu yako. kutoruhusu ruhusa hii huzima kipengele hiki.\",\"Tomorrow\":\"Kesho\",\"Tuesday\":\"Jumanne\",\"Turn Left\":\"Pinduka Kushoto\",\"Turn Right\":\"Geuka Kulia\",\"Turn history off\":\"Zima historia\",\"Turn history on\":\"Washa historia\",\"Twilight Angle\":\"Pembe ya Utusiutusi wa asubuhi au Jioni\",\"Umm al-Qura University, Makkah\":\"Chuo Kikuu cha Umm al-Qura, Makka\",\"Union Organization Islamic de France\":\"Muungano wa Jumuiya ya Kiislamu ya Ufaransa\",\"University of Islamic Sciences, Karachi\":\"Chuo Kikuu cha Sayansi ya Kiislamu, Karachi\",\"Unknown Error\":\"Hitilafu Isiyojulikana\",\"Unreliable\":\"Isiyotegemewa\",\"Unresolved (default)\":\"Haijatatuliwa (chaguomsingi)\",\"Unsupported\":\"Haitumiki\",\"Up\":\"Juu\",\"Upcoming alarm\":\"Kengele inayokuja\",\"Updating widgets\":\"Inasasisha wijeti\",\"Use 24-Hour format\":\"Tumia umbizo la Saa 24\",\"Use Compass\":\"Tumia Kielekezi\",\"Use Map\":\"Tumia Ramani\",\"Use a different alarm type?\":\"Je, ungependa kutumia aina tofauti ya kengele?\",\"Use adaptive theme?\":\"Je, ungependa kutumia mandhari yanayobadilika?\",\"Use headphones when available?\":\"Je, ungependa kutumia vipokea sauti vinavyobanwa kichwani vinapopatikana?\",\"Using Coordinates\":\"Kutumia Majiranukta ya Kijiografia\",\"Using GPS\":\"Kwa kutumia GPS\",\"Using Search\":\"Kwa kutumia Utafutaji\",\"Version\":\"Toleo\",\"Vibration Mode\":\"Hali ya Mtetemo\",\"Vibration on call\":\"Vibration on call\",\"Volume button stops adhan\":\"Kitufe cha sauti kinasimamisha adhana\",\"WIDGET_CHANNEL_NAME\":\"Kipande\",\"WIDGET_UPDATE_CHANNEL_NAME\":\"Sasisho la Vipande\",\"We'll help you do them quickly.\":\"Tutakusaidia kuyafanya haraka.\",\"Wednesday\":\"Jumatano\",\"Welcome\":\"Karibu\",\"Western Arabic\":\"Kiarabu cha Magharibi\",\"When enabled, the screen will remain off when adhan or reminder starts playing, and alarm screen won't be shown\":\"Ikiwashwa, skrini itasalia imezimwa adhana au kikumbusho kitakapoanza kucheza, na skrini ya kengele haitaonyeshwa.\",\"When enabled, when using headphones, all audio will play only on headphones.\":\"Inapowashwa, unapotumia vipokea sauti vinavyobanwa kichwani, sauti zote zitacheza kwenye vipokea sauti vinavyobanwa kichwani pekee.\",\"Wifi\":\"Wifi\",\"Yes\":\"Ndiyo\",\"You are facing Kaaba\":\"Unaikabili Kaaba\",\"You are not facing Kaaba\":\"Wewe hukukabili Kaaba\",\"You can access your device Power Manager using the button below.\":\"Unaweza kufikia Kidhibiti Nishati cha kifaa chako kwa kutumia kitufe kilicho hapa chini.\",\"You can also paste coords from clipboard\":\"Unaweza pia kubandika majiranukta ya kijiografia kutoka kwenye ubao wa kunakili\",\"You can change the language used for lunar calendar\":\"Unaweza kubadilisha lugha inayotumiwa kwa kalenda ya mwezi\",\"You can change when the upcoming alarm notification is sent before adhan or reminder\":\"Unaweza kubadilisha arifa ya kengele inayokuja inapotumwa kabla ya adhana au kikumbusho\",\"You can choose to replace one of calendars with your current location\":\"Unaweza kuchagua kubadilisha moja ya kalenda na eneo lako la sasa\",\"You can hide prayer times you don't want to see in the main screen here:\":\"Unaweza kuficha nyakati za maombi ambazo hutaki kuona kwenye skrini kuu hapa:\",\"You can hide prayer times you don't want to see in the widget here:\":\"Unaweza kuficha nyakati za maombi ambazo hutaki kuona kwenye wijeti hapa:\",\"You can search for your location offline Or use GPS\":\"Unaweza kutafuta eneo lako nje ya mtandao au kutumia GPS\",\"You should have received a copy of the GNU Affero General Public License along with this program. If not, see https://www.gnu.org/licenses/.\":\"Unapaswa kuwa umepokea nakala ya Leseni ya Jumla ya Umma ya GNU Affero pamoja na mpango huu. Ikiwa sivyo, angalia https://www.gnu.org/licenses/.\",\"Your sounds\":\"Sauti zako\",\"abdul_basit_abdus_samad\":\"Abdul-Basit Abdus-Samad\",\"about.credits\":\"Hakimiliki zote za sauti za adhana ni za wamiliki wao. Shukrani za pekee kwa translation.io (lingui.js) kwa huduma zao nzuri. Shukrani kwa wanajamii wote wa programu huria ambao walifanya maktaba hizi zote nzuri ambazo zilifanya programu hii iwezekane.\",\"about.credits.google\":\"Aikoni nyingi zinazotumiwa katika programu hii zimetoka kwenye aikoni za nyenzo za google.\",\"about_settings\":\"Kuhusu\",\"adjustment.hint\":\"Idadi ya dakika ambazo zitaongezwa kwa nyakati zilizohesabiwa\",\"after\":\"baada ya\",\"ago\":\"iliyopita\",\"asr.prayer\":\"Asr\",\"backup_settings\":\"Hifadhi nakala\",\"before\":\"kabla\",\"calculation_adjustments_settings\":\"Marekebisho\",\"calculation_advanced_settings\":\"Mipangilio ya Hesabu Endelevu\",\"calculation_settings\":\"Hesabu\",\"counter.fast\":\"Haraka\",\"date.day\":\"siku\",\"date.hour\":\"saa\",\"date.minute\":\"dakika\",\"date.second\":\"pili\",\"dev_settings\":\"Msanidi\",\"dhuhr.prayer\":\"Dhuhr\",\"display_settings\":\"Onyesho\",\"fajr.prayer\":\"Fajr\",\"favorite_location\":\"Maeneo Unayopendelea\",\"forces all numbers to be in the selected system\":\"hulazimisha nambari zote kuwa katika mfumo uliochaguliwa\",\"from North\":\"kutoka Kaskazini\",\"from settings\":\"kutoka kwa mipangilio\",\"fullscreen_alarm\":\"Kucheza Adhana\",\"hijri.adjustment.hint\":\"Idadi ya siku ambazo zitaongezwa kwenye kalenda ya mwezi\",\"home\":\"Nyumbani\",\"if enabled, a notification will be shown around one hour before any prayer time or reminder that has sound\":\"ikiwashwa, ujulisho itaonyeshwa karibu saa moja kabla ya wakati wowote wa salaa au ukumbusho ambao una sauti\",\"intro\":\"utangulizi\",\"is prayer time hidden?\":\"muda wa salaa umefichwa?\",\"isha.prayer\":\"Isha\",\"later\":\"baadaye\",\"location_settings\":\"Mahali\",\"maghrib.prayer\":\"Magharibi\",\"masjid_an_nabawi\":\"Masjid An Nabawi\",\"minutes\":\"madakika\",\"moazen_zade\":\"Mwadhini Zade\",\"modes_settings\":\"Silent Mode\",\"monthly_view\":\"Mwangalio wa Kila Mwezi\",\"muezzin_settings\":\"Mwadhini\",\"notification_advanced_settings\":\"Mipangilio Endelevu\",\"notification_settings\":\"Ujulisho na Sauti\",\"qada_counter\":\"Kaunta ya Qada\",\"qibla_compass\":\"Kilekezi cha Kibla\",\"qibla_finder\":\"Kitafuti cha Kibla\",\"qibla_map\":\"Ramani ya Kibla\",\"ragheb_mustafa_ghalwash\":\"Ragheb Mustafa Ghalwash\",\"reminders_settings\":\"Vikumbusho\",\"settings\":\"Mipangilio\",\"should notification widget be shown?\":\"vipande vya ukumbushu vionyeshwe?\",\"should {prayerName} be hidden?\":[\"Je? Ficha \",[\"prayerName\"],\"?\"],\"since the app's calendar is pre-calculated and not based on moon sightings, it may show incorrect date for the start and the end of Ramadan.\":\"Kwa kua kalenda ya programu kimefanyia mahesabu kabla na haijahusishwa na muonekano wa mwezi, inaweza kudanganya mwanzo na mwisho wa mwezi mtukufu wa Ramadhan.\",\"sunnah.midnight\":\"Katikati ya usiku\",\"sunnah.tahajjud\":\"Tahajjud\",\"sunrise\":\"Macheo\",\"sunset\":\"Machweo\",\"widget_settings\":\"Mipangilio ya Vipande\",\"{0} min before {prayer} - {1} min after\":[[\"0\"],\" min before \",[\"prayer\"],\" - \",[\"1\"],\" min after\"],\"{durationInMinutes} min after {prayer}\":[[\"durationInMinutes\"],\" dakika baada ya \",[\"prayer\"]],\"{durationInMinutes} min before {prayer}\":[[\"durationInMinutes\"],\" dakika kabla ya \",[\"prayer\"]],\"{prayerName} notification will be shown\":[[\"prayerName\"],\" ujulisho utaonyeshwa\"],\"{prayerName} sound will be played\":[[\"prayerName\"],\" sauti utachezwa\"]}")}),638,[]);
